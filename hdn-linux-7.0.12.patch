+static int object_unix_accept_result(int server_fd, const char *path,
+				     bool expect_allowed)
+{
+	struct sockaddr_un addr;
+	socklen_t addrlen;
+	int accepted_fd;
+	int client_fd = -1;
+	int saved_errno;
+	int ret;
+
+	if (server_fd < 0)
+		return 2;
+
+	if (!expect_allowed) {
+		errno = 0;
+		accepted_fd = accept4(server_fd, NULL, NULL,
+				      SOCK_CLOEXEC | SOCK_NONBLOCK);
+		saved_errno = errno;
+		if (accepted_fd >= 0) {
+			close(accepted_fd);
+			return 1;
+		}
+		return errno_is_denial(saved_errno) ? 0 : 2;
+	}
+
+	ret = unix_sockaddr_path(path, &addr, &addrlen);
+	if (ret)
+		return 2;
+
+	client_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (client_fd < 0)
+		return 2;
+	if (connect(client_fd, (struct sockaddr *)&addr, addrlen)) {
+		close(client_fd);
+		return 2;
+	}
+
+	accepted_fd = accept4(server_fd, NULL, NULL,
+			      SOCK_CLOEXEC | SOCK_NONBLOCK);
+	saved_errno = errno;
+	close(client_fd);
+	if (accepted_fd >= 0) {
+		close(accepted_fd);
+		return 0;
+	}
+	return saved_errno ? 2 : 1;
+}
