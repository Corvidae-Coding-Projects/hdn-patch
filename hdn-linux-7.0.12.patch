--- linux-7.0.12/tools/testing/selftests/hardening/hdn_stack_compat32.S	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_stack_compat32.S	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Freestanding i386 guest probe: TLS/GDT, mmap/mprotect, COW, fork and wait.
+ * Build: gcc -m32 -nostdlib -static -no-pie -Wl,-z,noexecstack FILE.S -o PROBE
+ * Run only in the disposable hardening guest. Exit 0 means all invariants held;
+ * exit 1 means a syscall, TLS value, child status or parent COW value failed.
+ */
+	.section .text
+	.code32
+	.globl _start
+_start:
+	movl $128, iterations
+.Literation:
+	/* mmap2(NULL, 4096, RW, PRIVATE|ANONYMOUS, -1, 0) */
+	movl $192, %eax
+	xorl %ebx, %ebx
+	movl $4096, %ecx
+	movl $3, %edx
+	movl $0x22, %esi
+	movl $-1, %edi
+	xorl %ebp, %ebp
+	int $0x80
+	cmpl $-4095, %eax
+	jae .Lfailed
+	movl %eax, mapping
+	movl $0x16273849, (%eax)
+	movl %eax, descriptor + 4
+	movl $243, %eax /* set_thread_area; reuses the same slot after round one */
+	movl $descriptor, %ebx
+	int $0x80
+	testl %eax, %eax
+	jnz .Lfailed
+	movl descriptor, %eax
+	shll $3, %eax
+	orl $3, %eax
+	movw %ax, %gs
+	cmpl $0x16273849, %gs:0
+	jne .Lfailed
+	/* Both protection directions exercise page-table mutation from ADDR32. */
+	movl $125, %eax
+	movl mapping, %ebx
+	movl $4096, %ecx
+	movl $1, %edx
+	int $0x80
+	testl %eax, %eax
+	jnz .Lfailed
+	cmpl $0x16273849, %gs:0
+	jne .Lfailed
+	movl $125, %eax
+	movl $3, %edx
+	int $0x80
+	testl %eax, %eax
+	jnz .Lfailed
+	movl $2, %eax /* fork */
+	int $0x80
+	testl %eax, %eax
+	js .Lfailed
+	jz .Lchild
+	movl %eax, child
+.Lwait:
+	movl $7, %eax /* waitpid */
+	movl child, %ebx
+	movl $status, %ecx
+	xorl %edx, %edx
+	int $0x80
+	cmpl $-4, %eax /* retry EINTR */
+	je .Lwait
+	cmpl child, %eax
+	jne .Lfailed
+	cmpl $0, status
+	jne .Lfailed
+	cmpl $0x16273849, %gs:0 /* child's write must not reach the parent */
+	jne .Lfailed
+	xorl %eax, %eax
+	movw %ax, %gs
+	movl $91, %eax
+	movl mapping, %ebx
+	movl $4096, %ecx
+	int $0x80
+	testl %eax, %eax
+	jnz .Lfailed
+	decl iterations
+	jnz .Literation
+	xorl %ebx, %ebx
+	jmp .Lexit
+.Lchild:
+	cmpl $0x16273849, %gs:0
+	jne .Lfailed
+	movl $0x5a6b7c8d, %gs:0
+	movl $158, %eax /* sched_yield, then check the restored TLS view */
+	int $0x80
+	testl %eax, %eax
+	jnz .Lfailed
+	cmpl $0x5a6b7c8d, %gs:0
+	jne .Lfailed
+	xorl %ebx, %ebx
+	jmp .Lexit
+.Lfailed:
+	movl $1, %ebx
+.Lexit:
+	movl $1, %eax
+	int $0x80
+	ud2
+
+	.section .data
+	.balign 4
+descriptor:
+	.long -1, 0, 0xfffff, 0x51
+mapping: .long 0
+iterations: .long 0
+child: .long 0
+status: .long 0
+	.section .note.GNU-stack,"",@progbits
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/testing/selftests/hardening/hdn_status_capability.py linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_status_capability.py
--- linux-7.0.12/tools/testing/selftests/hardening/hdn_status_capability.py	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_status_capability.py	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,62 @@
+#!/usr/bin/python3 -I
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise mandatory-capability summary handling through the real status CLI."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--hdn-status", type=Path, required=True)
+    args = parser.parse_args()
+    cases = {
+        "satisfied": ("0x1", "satisfied", "enforced,hardware",
+                      ("active", "0", "none")),
+        "not-applicable": ("0x1", "satisfied", "not-applicable,none",
+                           ("active", "0", "none")),
+        "unconstrained": ("0x0", "unconstrained", None,
+                          ("active", "0", "none")),
+        "unsatisfied": ("0x1", "unsatisfied", "degraded,software",
+                        ("degraded", "1", "capability_requirements_unsatisfied")),
+        "missing-summary": ("0x1", None, "enforced,hardware",
+                            ("degraded", "1", "capability_requirements_unsatisfied")),
+        "missing-record": ("0x1", "satisfied", None,
+                           ("degraded", "1", "capability_requirements_unsatisfied")),
+        "malformed-summary": ("0x1", "unknown", "enforced,hardware",
+                              ("degraded", "1", "capability_requirements_unsatisfied")),
+        "unknown-mask": ("0x80000000", "satisfied", "enforced,hardware",
+                         ("degraded", "1", "capability_requirements_unsatisfied")),
+        "zero-satisfied": ("0x0", "satisfied", None,
+                           ("degraded", "1", "capability_requirements_unsatisfied")),
+    }
+    with tempfile.TemporaryDirectory(prefix="hdn-status-capability-") as directory:
+        root = Path(directory)
+        for name, (mask, summary, record, expected) in cases.items():
+            status = root / (name + ".status")
+            lines = [
+                "mitigations_sealed: 1", "policy_loaded: 1", "policy_sealed: 1",
+                "phase: runtime", "capability_version: 1",
+                "capability_architecture: fixture",
+                "capability_required_mask: " + mask,
+            ]
+            if summary is not None:
+                lines.append("capability_requirements: " + summary)
+            if record is not None:
+                lines.append("capability.kernel_wx: " + record)
+            status.write_text("\n".join(lines) + "\n")
+            result = subprocess.run(
+                [str(args.hdn_status), "--status-path", str(status)],
+                check=True, capture_output=True, text=True, timeout=10,
+                env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"})
+            values = dict(line.split("=", 1) for line in result.stdout.splitlines()
+                          if "=" in line)
+            actual = (values.get("state"), values.get("attention"),
+                      values.get("attention_reason"))
+            if actual != expected:
+                raise RuntimeError(f"{name}: expected {expected}, got {actual}")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/testing/selftests/hardening/hdn_sysfs_notify.c linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_sysfs_notify.c
--- linux-7.0.12/tools/testing/selftests/hardening/hdn_sysfs_notify.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_sysfs_notify.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Real-interface notification transfer probe. An unrestricted launcher queues
+ * inotify and fanotify events for a classified sysfs node, primes each proc
+ * fdinfo seq_file, and execs a separately signed restricted receiver. The
+ * receiver proves that event data and watched-inode metadata do not survive
+ * the profile boundary. The qualification driver runs this as root so it can
+ * create the fanotify group; the receiver receives no setup privilege.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fanotify.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/inotify.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int parse_fd(const char *text)
+{
+	char *end;
+	long value = strtol(text, &end, 10);
+
+	if (*end || value < 0 || value > 0x7fffffff)
+		return -1;
+	return value;
+}
+
+static int open_fdinfo(int fd)
+{
+	char path[64];
+
+	snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+	return open(path, O_RDONLY);
+}
+
+static int read_fdinfo_without_mark(int fd, const char *needle)
+{
+	char buffer[16384];
+	ssize_t length;
+
+	length = read(fd, buffer, sizeof(buffer) - 1);
+	if (length < 0)
+		return -1;
+	buffer[length] = '\0';
+	return strstr(buffer, needle) ? -1 : 0;
+}
+
+static int require_empty_notification(int fd)
+{
+	struct pollfd pfd = { .fd = fd, .events = POLLIN };
+	char buffer[4096];
+	int bytes = -1;
+
+	if (poll(&pfd, 1, 0) != 0)
+		return -1;
+	if (ioctl(fd, FIONREAD, &bytes) || bytes != 0)
+		return -1;
+	errno = 0;
+	if (read(fd, buffer, sizeof(buffer)) != -1 || errno != EAGAIN)
+		return -1;
+	return 0;
+}
+
+static int trigger_sysfs(const char *path)
+{
+	char byte;
+	int fd = open(path, O_RDONLY);
+	int error = 0;
+
+	if (fd < 0)
+		return -1;
+	if (read(fd, &byte, 1) < 0)
+		error = -1;
+	close(fd);
+	return error;
+}
+
+int main(int argc, char **argv)
+{
+	char ifdarg[32], ffdarg[32], pfdarg[32], ifinfoarg[32], ffinfoarg[32];
+	char helperarg[32];
+	char byte;
+	int ifd, ffd, pfd, ifinfo, ffinfo;
+	pid_t helper;
+
+	if (argc == 4 && !strcmp(argv[1], "transfer")) {
+		char *parent = strdup(argv[3]);
+		char *slash;
+		int inotify_bytes, fanotify_bytes;
+
+		if (!parent)
+			return 1;
+		slash = strrchr(parent, '/');
+		if (!slash || slash == parent)
+			return 2;
+		*slash = '\0';
+		ifd = inotify_init1(IN_NONBLOCK);
+		if (ifd < 0 || inotify_add_watch(ifd, parent,
+				IN_OPEN | IN_ACCESS | IN_ATTRIB) < 0) {
+			perror("inotify setup");
+			return 1;
+		}
+		ffd = syscall(SYS_fanotify_init, FAN_CLASS_NOTIF | FAN_NONBLOCK,
+			      O_RDONLY | O_LARGEFILE);
+		if (ffd < 0 || syscall(SYS_fanotify_mark, ffd,
+				      FAN_MARK_ADD | FAN_MARK_ONLYDIR,
+				      FAN_OPEN | FAN_ACCESS | FAN_EVENT_ON_CHILD,
+				      AT_FDCWD, parent)) {
+			perror("fanotify setup");
+			return 1;
+		}
+		if (trigger_sysfs(argv[3])) {
+			perror("sysfs trigger");
+			return 1;
+		}
+		if (ioctl(ifd, FIONREAD, &inotify_bytes) || inotify_bytes <= 0 ||
+		    ioctl(ffd, FIONREAD, &fanotify_bytes) || fanotify_bytes <= 0)
+			return 1;
+		ifinfo = open_fdinfo(ifd);
+		ffinfo = open_fdinfo(ffd);
+		if (ifinfo < 0 || ffinfo < 0 || read(ifinfo, &byte, 1) != 1 ||
+		    read(ffinfo, &byte, 1) != 1)
+			return 1;
+		pfd = syscall(SYS_fanotify_init, FAN_CLASS_CONTENT | FAN_NONBLOCK,
+			      O_RDONLY | O_LARGEFILE);
+		if (pfd < 0 || syscall(SYS_fanotify_mark, pfd,
+				      FAN_MARK_ADD | FAN_MARK_ONLYDIR,
+				      FAN_OPEN_PERM | FAN_EVENT_ON_CHILD,
+				      AT_FDCWD, parent)) {
+			perror("fanotify permission setup");
+			return 1;
+		}
+		free(parent);
+		helper = fork();
+		if (helper < 0)
+			return 1;
+		if (!helper)
+			_exit(trigger_sysfs(argv[3]) ? 1 : 0);
+		{
+			struct pollfd pfd_poll = { .fd = pfd, .events = POLLIN };
+
+			if (poll(&pfd_poll, 1, 10000) != 1)
+				return 1;
+		}
+		snprintf(ifdarg, sizeof(ifdarg), "%d", ifd);
+		snprintf(ffdarg, sizeof(ffdarg), "%d", ffd);
+		snprintf(pfdarg, sizeof(pfdarg), "%d", pfd);
+		snprintf(ifinfoarg, sizeof(ifinfoarg), "%d", ifinfo);
+		snprintf(ffinfoarg, sizeof(ffinfoarg), "%d", ffinfo);
+		snprintf(helperarg, sizeof(helperarg), "%d", helper);
+		execl(argv[2], argv[2], "receive", ifdarg, ffdarg, pfdarg,
+		      ifinfoarg, ffinfoarg, helperarg, NULL);
+		perror("exec receiver");
+		return 1;
+	}
+
+	if (argc != 8 || strcmp(argv[1], "receive")) {
+		fprintf(stderr, "usage: %s transfer RECEIVER SYSFS_FILE\n", argv[0]);
+		return 2;
+	}
+	ifd = parse_fd(argv[2]);
+	ffd = parse_fd(argv[3]);
+	pfd = parse_fd(argv[4]);
+	ifinfo = parse_fd(argv[5]);
+	ffinfo = parse_fd(argv[6]);
+	helper = parse_fd(argv[7]);
+	if (ifd < 0 || ffd < 0 || pfd < 0 || ifinfo < 0 || ffinfo < 0 ||
+	    helper < 0)
+		return 2;
+	if (require_empty_notification(ifd) || require_empty_notification(ffd) ||
+	    require_empty_notification(pfd))
+		return 1;
+	{
+		int status;
+
+		if (waitpid(helper, &status, 0) != helper || !WIFEXITED(status) ||
+		    WEXITSTATUS(status))
+			return 1;
+	}
+	if (read_fdinfo_without_mark(ifinfo, "inotify wd:") ||
+	    read_fdinfo_without_mark(ffinfo, "fanotify ino:"))
+		return 1;
+	close(ifinfo);
+	close(ffinfo);
+	ifinfo = open_fdinfo(ifd);
+	ffinfo = open_fdinfo(ffd);
+	if (ifinfo < 0 || ffinfo < 0 ||
+	    read_fdinfo_without_mark(ifinfo, "inotify wd:") ||
+	    read_fdinfo_without_mark(ffinfo, "fanotify ino:"))
+		return 1;
+	close(ifd);
+	close(ffd);
+	close(pfd);
+	close(ifinfo);
+	close(ffinfo);
+	puts("sysfs notification view: pass");
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/testing/selftests/hardening/hdn_sysfs_view.c linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_sysfs_view.c
--- linux-7.0.12/tools/testing/selftests/hardening/hdn_sysfs_view.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/testing/selftests/hardening/hdn_sysfs_view.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Real-interface probe. The qualification driver assigns the receiving copy
+ * of this executable a signed HIDE_SYSFS_* profile. The unrestricted launcher
+ * calls: hdn_sysfs_view transfer /receiver /sys/classified/attribute
+ * File, O_PATH, parent-directory and fdinfo descriptors cross exec, including
+ * a byte already buffered by seq_file. No policy mutation or privileged setup
+ * is performed by this probe.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/xattr.h>
+#include <unistd.h>
+
+static void require_hidden(long result, const char *operation)
+{
+	if (result != -1 || errno != ENOENT) {
+		fprintf(stderr, "%s: expected ENOENT, result=%ld errno=%d\n",
+			operation, result, errno);
+		exit(1);
+	}
+}
+
+int main(int argc, char **argv)
+{
+	char buffer[4096], fdarg[32], opatharg[32], dirarg[32], fdinfoarg[32];
+	char fdpath[64], fdinfopath[64];
+	struct stat st;
+	struct statx stx;
+	struct pollfd pollfd;
+	int fd, opath, dirfd, fdinfo;
+	void *mapping;
+
+	if (argc == 4 && !strcmp(argv[1], "transfer")) {
+		char *parent = strdup(argv[3]);
+		char *slash;
+
+		if (!parent)
+			return 1;
+		slash = strrchr(parent, '/');
+		if (!slash)
+			return 2;
+		if (slash == parent)
+			slash[1] = '\0';
+		else
+			*slash = '\0';
+		fd = open(argv[3], O_RDONLY);
+		opath = open(argv[3], O_PATH);
+		dirfd = open(parent, O_RDONLY | O_DIRECTORY);
+		free(parent);
+		if (fd < 0 || opath < 0 || dirfd < 0 || read(fd, buffer, 1) != 1) {
+			perror("open/prefill");
+			return 1;
+		}
+		snprintf(fdinfopath, sizeof(fdinfopath), "/proc/self/fdinfo/%d", fd);
+		fdinfo = open(fdinfopath, O_RDONLY);
+		if (fdinfo < 0)
+			return 1;
+		snprintf(fdarg, sizeof(fdarg), "%d", fd);
+		snprintf(opatharg, sizeof(opatharg), "%d", opath);
+		snprintf(dirarg, sizeof(dirarg), "%d", dirfd);
+		snprintf(fdinfoarg, sizeof(fdinfoarg), "%d", fdinfo);
+		execl(argv[2], argv[2], "receive", fdarg, opatharg, dirarg,
+		      fdinfoarg, argv[3], NULL);
+		perror("exec receiver");
+		return 1;
+	}
+	if (argc != 7 || strcmp(argv[1], "receive")) {
+		fprintf(stderr, "usage: %s transfer RECEIVER SYSFS_FILE\n", argv[0]);
+		return 2;
+	}
+	for (int index = 2; index <= 5; index++) {
+		char *end;
+		long value = strtol(argv[index], &end, 10);
+
+		if (*end || value < 0 || value > 0x7fffffff)
+			return 2;
+		if (index == 2)
+			fd = value;
+		else if (index == 3)
+			opath = value;
+		else if (index == 4)
+			dirfd = value;
+		else
+			fdinfo = value;
+	}
+	require_hidden(open(argv[6], O_RDONLY), "lookup/open");
+	require_hidden(read(fd, buffer, sizeof(buffer)), "buffered read");
+	require_hidden(pread(fd, buffer, sizeof(buffer), 0), "pread");
+	require_hidden(fstat(fd, &st), "fstat");
+	require_hidden(fstat(opath, &st), "O_PATH fstat");
+	require_hidden(statx(opath, "", AT_EMPTY_PATH, STATX_BASIC_STATS, &stx),
+		       "O_PATH statx");
+	require_hidden(fstat(dirfd, &st), "directory fstat");
+	require_hidden(flistxattr(fd, buffer, sizeof(buffer)), "listxattr");
+	require_hidden(fgetxattr(fd, "user.hdn", buffer, sizeof(buffer)), "getxattr");
+	require_hidden(fsetxattr(fd, "user.hdn", "x", 1, 0), "setxattr");
+	require_hidden(lseek(fd, 0, SEEK_SET), "seek");
+	require_hidden(lseek(dirfd, 0, SEEK_SET), "directory seek");
+	require_hidden(fsync(fd), "fsync");
+	require_hidden(syscall(SYS_getdents64, dirfd, buffer, sizeof(buffer)), "readdir");
+	const char *base = strrchr(argv[6], '/');
+	if (!base || !base[1])
+		return 2;
+	require_hidden(openat(dirfd, base + 1, O_RDONLY), "directory-relative lookup");
+	snprintf(fdpath, sizeof(fdpath), "/proc/self/fd/%d", fd);
+	require_hidden(readlink(fdpath, buffer, sizeof(buffer)), "proc fd readlink");
+	snprintf(fdpath, sizeof(fdpath), "/proc/self/fd/%d", opath);
+	require_hidden(readlink(fdpath, buffer, sizeof(buffer)), "proc O_PATH readlink");
+	snprintf(fdinfopath, sizeof(fdinfopath), "/proc/self/fdinfo/%d", fd);
+	require_hidden(open(fdinfopath, O_RDONLY), "proc fdinfo open");
+	require_hidden(read(fdinfo, buffer, sizeof(buffer)), "transferred fdinfo read");
+	pollfd = (struct pollfd){ .fd = fd, .events = POLLIN };
+	if (poll(&pollfd, 1, 0) != 1 || pollfd.revents != POLLERR)
+		return 1;
+	mapping = mmap(NULL, 4096, PROT_READ, MAP_PRIVATE, fd, 0);
+	if (mapping != MAP_FAILED || errno != ENOENT)
+		return 1;
+	close(fd);
+	close(opath);
+	close(dirfd);
+	close(fdinfo);
+	puts("sysfs descriptor view: pass");
+	return 0;
+}
