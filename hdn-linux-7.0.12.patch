+int hdn_authorize_perf_event_open(bool kernel_access, bool namespaces,
+				  pid_t pid, int cpu, unsigned long flags)
+{
+	if (!IS_ENABLED(CONFIG_SECURITY_HARDENING_UNPRIV_PERF_KERNEL))
+		return 0;
