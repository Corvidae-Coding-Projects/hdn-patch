+	if (ret)
+		return 2;
+
+	child = fork();
+	if (child < 0) {
+		unlink(HDN_UNTRUSTED_EXEC);
+		return 2;
+	}
+
+	if (!child) {
+		execl(HDN_UNTRUSTED_EXEC, "hdn-untrusted-exec",
+		      "--exec-sentinel", NULL);
+		_exit(errno_is_denial(errno) ? 0 : 2);
+	}
+
+	if (waitpid(child, &status, 0) < 0) {
+		unlink(HDN_UNTRUSTED_EXEC);
+		return 2;
+	}
+
+	unlink(HDN_UNTRUSTED_EXEC);
+	if (!WIFEXITED(status))
+		return 2;
+	return WEXITSTATUS(status) == 0 ? 0 : 1;
+}
