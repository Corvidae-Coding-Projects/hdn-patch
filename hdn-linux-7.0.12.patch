+	fd = open("/dev/ttyS0", O_RDWR | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
+	if (fd < 0)
+		fd = open("/dev/console",
+			  O_RDWR | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	if (!isatty(fd)) {
+		close(fd);
+		errno = ENOTTY;
+		return -1;
+	}
+
+	return fd;
