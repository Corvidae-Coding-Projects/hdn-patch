+	ssize_t len;
+	int fd;
+
+	snprintf(path, sizeof(path), "/proc/%d/%s", pid, name);
+	errno = 0;
+	fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0) {
+		saved_errno = errno;
+		if (saved_errno == ENOENT)
+			return KSFT_SKIP;
+		if (expect_denied)
+			return errno_is_denial(saved_errno) ? 0 : 2;
+		return 2;
+	}
+
+	errno = 0;
+	len = write(fd, text, strlen(text));
+	if (len < 0)
+		saved_errno = errno;
+	close(fd);
+
+	if (expect_denied) {
+		if (len >= 0)
+			return 1;
+		return errno_is_denial(saved_errno) ? 0 : 2;
+	}
+
+	return len == (ssize_t)strlen(text) ? 0 : 1;
+}
