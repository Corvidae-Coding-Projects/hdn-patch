+	close(pidfd);
+
+	if (waitpid(reader, &status, 0) < 0) {
+		kill(target, SIGKILL);
+		waitpid(target, NULL, 0);
+		return 2;
+	}
+
+	kill(target, SIGKILL);
+	waitpid(target, NULL, 0);
