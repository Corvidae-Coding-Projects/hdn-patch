+				continue;
+			if (edge->kind == HDN_RAP_BPF_PATCH_BYPASS)
+				valid = !target || target == edge->target;
+			else if (edge->kind == HDN_RAP_BPF_PATCH_TAIL) {
+				destination = target ? hdn_rap_bpf_find(target) : NULL;
