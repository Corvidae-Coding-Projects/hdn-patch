+static bool module_address_hidden_token(const char *token)
+{
+	const char *digits;
+
+	if (!strcmp(token, "0x(null)") || !strcmp(token, "(null)"))
+		return true;
+	if (strncmp(token, "0x", 2))
+		return false;
+
+	for (digits = token + 2; *digits; digits++) {
+		if (*digits != '0')
+			return false;
+	}
+
+	return true;
+}
