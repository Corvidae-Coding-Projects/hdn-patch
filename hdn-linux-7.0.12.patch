+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_stack_entry.S	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/asm-offsets.h>
+#include <asm/hdn_rap.h>
+#include <asm/nospec-branch.h>
+#include <asm/unwind_hints.h>
+
+	.pushsection .text, "ax"
+SYM_FUNC_START(__hdn_stack_bootstrap)
+	ANNOTATE_NOENDBR
+	UNWIND_HINT_UNDEFINED
+	movq HDN_STACK_SWITCH_CR3(%rdi), %r11
+	movq HDN_STACK_SWITCH_SP(%rdi), %rdx
+	movq %r11, %cr3
+	movq %rdx, %rsp
+	xorl %ebp, %ebp
+	UNWIND_HINT_END_OF_STACK
+	/* The bootstrap SP is 16-byte aligned before each C ABI call. */
+	HDN_C_CALL hdn_stack_mm_finish
+	HDN_C_CALL hdn_stack_bootstrap_continue
+	ud2
+SYM_FUNC_END(__hdn_stack_bootstrap)
+_ASM_NOKPROBE(__hdn_stack_bootstrap)
+	.popsection
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_stack_internal.h linux-7.0.12-hdn/arch/x86/kernel/hdn_stack_internal.h
--- linux-7.0.12/arch/x86/kernel/hdn_stack_internal.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_stack_internal.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _X86_HDN_STACK_INTERNAL_H
+#define _X86_HDN_STACK_INTERNAL_H
+
+#include <linux/hdn_stack.h>
+#include <linux/workqueue.h>
+#include <asm/page.h>
+
+#define HDN_STACK_BUCKETS 1024
+#define HDN_STACK_PAGES (THREAD_SIZE / PAGE_SIZE)
+#define HDN_STACK_STRIDE (2 * THREAD_SIZE)
+
+struct hdn_stack_storage;
+struct hdn_stack_lifetime {
+	struct rcu_work retire;
+	struct hdn_stack_storage *storage;
+};
+
+/* Every field, including the registry link and publication bit, is read-only
+ * in ordinary CR3s. Only the closed physical window updates these fields. */
+struct hdn_stack_storage {
+	const struct task_struct *owner, *builder;
+	struct hdn_stack_storage *next;
+	struct hdn_stack_lifetime *lifetime;
+	struct vm_struct *backing;
+	void *construction_address;
+	unsigned long begin, generation, slot, published, header_pfn;
+	unsigned long pfns[HDN_STACK_PAGES];
+};
+
+extern unsigned long hdn_stack_region;
+extern unsigned long hdn_stack_boot_retired;
+extern struct hdn_stack_storage *hdn_stack_buckets[HDN_STACK_BUCKETS];
+
+static __always_inline unsigned int hdn_stack_bucket(unsigned long address)
+{
+	return (address / HDN_STACK_STRIDE) & (HDN_STACK_BUCKETS - 1);
+}
+
+/* Caller pins the task stack or keeps local IRQs disabled. Registry removal
+ * waits for an RCU grace period before releasing the immutable descriptor. */
+struct hdn_stack_storage *hdn_stack_lookup(unsigned long address);
+void hdn_stack_store(struct hdn_stack_storage *storage,
+		     unsigned long *word, unsigned long value);
+void hdn_stack_publish_storage(struct hdn_stack_storage *storage);
+int hdn_stack_failure_create(unsigned int cpu, unsigned long *begin, unsigned long *cr3);
+void hdn_stack_account_switch(void);
+void hdn_stack_account_async_root(void);
+void hdn_stack_account_read(bool failed);
+void hdn_stack_account_construct(size_t bytes);
+void hdn_stack_account_publication(void);
+
+#endif
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_svm.c linux-7.0.12-hdn/arch/x86/kernel/hdn_svm.c
--- linux-7.0.12/arch/x86/kernel/hdn_svm.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_svm.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SVM hardware writes physical host-save storage directly. Software accesses
+ * only the fixed fields below, through the private page window. There is no
+ * generally mapped copy of the host's saved RSP, RIP, CR3 or GS base.
+ */
+#include <linux/hdn_execmem.h>
+#include <linux/hdn_pgtable.h>
+#include <linux/hdn_rap.h>
+#include <linux/kvm_types.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <asm/hdn_svm.h>
+#include <asm/msr.h>
+#include <asm/svm.h>
+#include "../mm/hdn_pgtable_internal.h"
+
+static struct hdn_svm_cpu {
+	void *mapping;
+	unsigned long pa, enabled;
+} svm_host[NR_CPUS] __ro_after_init;
+static DEFINE_MUTEX(svm_host_lock);
+
+static void svm_store(unsigned long *slot, unsigned long value)
+{
+	hdn_pt_window_update(__pa_symbol(slot) >> PAGE_SHIFT,
+			    offset_in_page(slot), value, 0, HDN_PT_STORE);
+}
+
+int hdn_svm_cpu_prepare(unsigned int cpu, struct page *page)
+{
+	struct page **pages;
+	void *mapping;
+	int error = -ENOMEM;
+
+	if (!page)
+		return -EINVAL;
+	if (cpu >= nr_cpu_ids || !cpu_possible(cpu) || !hdn_pt_active()) {
+		error = -EINVAL;
+		goto free_page;
+	}
+	pages = kmalloc(sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		goto free_page;
+	pages[0] = page;
+	mapping = vmap(pages, 1, VM_MAP | VM_MAP_PUT_PAGES, PAGE_KERNEL);
+	if (!mapping) {
+		kfree(pages);
+		goto free_page;
+	}
+	/* vmap now owns both the array and the page. */
+	find_vm_area(mapping)->flags |= VM_FLUSH_RESET_PERMS;
+	error = hdn_execmem_claim_hardware(mapping);
+	if (error) {
+		vfree(mapping);
+		return error;
+	}
+	error = hdn_execmem_hide_hardware(mapping);
+	if (error)
+		goto free_owned;
+	mutex_lock(&svm_host_lock);
+	if (svm_host[cpu].mapping) {
+		error = -EBUSY;
+	} else {
+		svm_store(&svm_host[cpu].pa, __sme_page_pa(page));
+		svm_store((unsigned long *)&svm_host[cpu].mapping, (unsigned long)mapping);
+	}
+	mutex_unlock(&svm_host_lock);
+	if (!error)
+		return 0;
+free_owned:
+	hdn_execmem_free(mapping);
+	return error;
+free_page:
+	__free_page(page);
+	return error;
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_cpu_prepare);
+
+void hdn_svm_cpu_release(unsigned int cpu)
+{
+	void *mapping;
+
+	if (cpu >= nr_cpu_ids)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	mutex_lock(&svm_host_lock);
+	if (svm_host[cpu].enabled)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	mapping = svm_host[cpu].mapping;
+	svm_store((unsigned long *)&svm_host[cpu].mapping, 0);
+	svm_store(&svm_host[cpu].pa, 0);
+	mutex_unlock(&svm_host_lock);
+	if (mapping)
+		hdn_execmem_free(mapping);
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_cpu_release);
+
+static struct hdn_svm_cpu *noinstr svm_current(void)
+{
+	struct hdn_svm_cpu *host = &svm_host[hdn_pt_cpu()];
+
+	if (preemptible() || !host->mapping || !host->pa)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	return host;
+}
+
+void hdn_svm_enable(void)
+{
+	struct hdn_svm_cpu *host = svm_current();
+
+	if (host->enabled)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	svm_store(&host->enabled, 1);
+	wrmsrq(MSR_VM_HSAVE_PA, host->pa);
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_enable);
+
+void hdn_svm_disable(void)
+{
+	struct hdn_svm_cpu *host = &svm_host[hdn_pt_cpu()];
+
+	/* Also used by emergency shutdown, which may precede full setup. */
+	wrmsrq(MSR_VM_HSAVE_PA, 0);
+	if (host->enabled)
+		svm_store(&host->enabled, 0);
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_disable);
+
+unsigned long noinstr hdn_svm_host_pa(void)
+{
+	struct hdn_svm_cpu *host = svm_current();
+
+	if (!host->enabled || __rdmsr(MSR_VM_HSAVE_PA) != host->pa)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	return host->pa;
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_host_pa);
+
+static void noinstr svm_save_word(unsigned long pa, unsigned int offset, u64 value)
+{
+	hdn_pt_window_update(__sme_clr(pa) >> PAGE_SHIFT, offset,
+			    value, 0, HDN_PT_STORE);
+}
+
+void noinstr hdn_svm_set_gprs(const struct hdn_svm_gprs *regs)
+{
+	struct hdn_svm_gprs copy = *regs;
+	unsigned long pa = hdn_svm_host_pa();
+
+#define SAVE_GPR(name) svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.name), copy.name)
+	SAVE_GPR(rdi);
+	SAVE_GPR(rsi);
+	SAVE_GPR(rbx);
+	SAVE_GPR(rbp);
+	SAVE_GPR(r12);
+	SAVE_GPR(r13);
+	SAVE_GPR(r14);
+	SAVE_GPR(r15);
+#undef SAVE_GPR
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_set_gprs);
+
+void hdn_svm_set_state(const struct hdn_svm_host_state *state)
+{
+	struct hdn_svm_host_state copy = *state;
+	unsigned long pa = hdn_svm_host_pa(), packed, old;
+	unsigned int offset = offsetof(struct vmcb, host_sev_es_save.pkru);
+
+	BUILD_BUG_ON(offsetof(struct vmcb, host_sev_es_save.tsc_aux) !=
+		     offsetof(struct vmcb, host_sev_es_save.pkru) + 4);
+	BUILD_BUG_ON(offsetof(struct vmcb, host_sev_es_save.r15) + 8 > PAGE_SIZE);
+	svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.xcr0), copy.xcr0);
+	svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.xss), copy.xss);
+	if (copy.debug_swap) {
+		svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.dr0_addr_mask), copy.dr_mask[0]);
+		svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.dr1_addr_mask), copy.dr_mask[1]);
+		svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.dr2_addr_mask), copy.dr_mask[2]);
+		svm_save_word(pa, offsetof(struct vmcb, host_sev_es_save.dr3_addr_mask), copy.dr_mask[3]);
+	}
+	/* PKRU and TSC_AUX share a word; retain the latter when not virtualized. */
+	old = hdn_pt_window_read(__sme_clr(pa) >> PAGE_SHIFT, offset);
+	packed = copy.pkru | ((u64)(copy.tsc_aux_valid ? copy.tsc_aux : old >> 32) << 32);
+	svm_save_word(pa, offset, packed);
+}
+EXPORT_SYMBOL_FOR_KVM(hdn_svm_set_state);
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_text.c linux-7.0.12-hdn/arch/x86/kernel/hdn_text.c
--- linux-7.0.12/arch/x86/kernel/hdn_text.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_text.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/hardening.h>
+#include <linux/highmem.h>
+#include <linux/hdn_execmem.h>
+#include <linux/hdn_kernexec.h>
+#include <linux/irq_work.h>
+#include <linux/nmi.h>
+#include <linux/pgtable.h>
+#include <linux/overflow.h>
+#include <linux/sched.h>
+#include <linux/seqlock.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+#include <asm/hdn_text.h>
+#include <asm/set_memory.h>
+
+enum hdn_text_state {
+	HDN_TEXT_CLOSED,
+	HDN_TEXT_PREPARED,
+	HDN_TEXT_OPEN,
+};
+
+/*
+ * The upstream poking mm has exactly one two-page write window. Its PTE lock
+ * serializes users before they reach this table. Keep the separate raw lock
+ * for status readers and lifecycle checking; never allocate here.
+ */
+static DEFINE_RAW_SPINLOCK(hdn_text_lock);
+static seqcount_raw_spinlock_t hdn_text_seq =
+	SEQCNT_RAW_SPINLOCK_ZERO(hdn_text_seq, &hdn_text_lock);
+static struct {
+	const struct hdn_text_token *token;
+	struct task_struct *owner;
+	pte_t *ptep;
+	u64 generation;
+	unsigned long start;
+	size_t size;
+	unsigned long pfns[2];
+	unsigned int cpu;
+	unsigned int nr_pages;
+	enum hdn_text_kind kind;
+	enum hdn_text_state state;
+} hdn_window;
+static struct hdn_text_window_stats hdn_text_stats;
+static pte_t *hdn_text_expected_ptep __ro_after_init;
+static atomic64_t hdn_text_audit_omitted = ATOMIC64_INIT(0);
+static atomic64_t hdn_text_audit_deferred = ATOMIC64_INIT(0);
+
+/*
+ * Debugger/NMI producers cannot wait for a CPU holding an audit lock. A
+ * bounded, preallocated mailbox defers emission until normal execution.
+ * Slot states are EMPTY -> BUSY -> READY -> BUSY -> EMPTY. Neither an NMI
+ * nor a stopped CPU can make another producer spin on an occupied slot.
+ * No task pointer survives the transition; deferred events are explicitly
+ * kernel events, with no attribution to the workqueue thread.
+ */
+enum { HDN_AUDIT_EMPTY, HDN_AUDIT_BUSY, HDN_AUDIT_READY };
+static struct {
+	unsigned int state;
+	u64 generation;
+	enum hdn_reason reason;
+	enum hdn_transition transition;
+} hdn_text_mailbox[64];
+static bool hdn_text_audit_ready;
+
+static void hdn_text_drain(struct work_struct *work)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(hdn_text_mailbox); i++) {
+		if (cmpxchg_acquire(&hdn_text_mailbox[i].state,
+				    HDN_AUDIT_READY, HDN_AUDIT_BUSY) != HDN_AUDIT_READY)
+			continue;
+		hdn_report_kernel_deferred(hdn_text_mailbox[i].transition,
+					   hdn_text_mailbox[i].generation,
+					   hdn_text_mailbox[i].reason);
+		smp_store_release(&hdn_text_mailbox[i].state, HDN_AUDIT_EMPTY);
+	}
+}
+static DECLARE_WORK(hdn_text_audit_work, hdn_text_drain);
+
+static void hdn_text_wake(struct irq_work *work)
+{
+	schedule_work(&hdn_text_audit_work);
+}
+static struct irq_work hdn_text_audit_irq = IRQ_WORK_INIT(hdn_text_wake);
+
+void hdn_x86_defer_transition(enum hdn_transition transition, u64 generation,
+			       enum hdn_reason reason)
+{
+	unsigned int i;
+
+	if (transition != HDN_TRANS_KERNEL_TEXT && transition != HDN_TRANS_KERNEL_DESCRIPTOR &&
+	    transition != HDN_TRANS_KERNEL_UACCESS)
+		panic("HDN invalid deferred kernel transition");
+	for (i = 0; i < ARRAY_SIZE(hdn_text_mailbox); i++) {
+		if (cmpxchg_acquire(&hdn_text_mailbox[i].state,
+				    HDN_AUDIT_EMPTY, HDN_AUDIT_BUSY) != HDN_AUDIT_EMPTY)
+			continue;
+		hdn_text_mailbox[i].generation = generation;
+		hdn_text_mailbox[i].reason = reason;
+		hdn_text_mailbox[i].transition = transition;
+		smp_store_release(&hdn_text_mailbox[i].state, HDN_AUDIT_READY);
+		atomic64_inc(&hdn_text_audit_deferred);
+		if (smp_load_acquire(&hdn_text_audit_ready))
+			irq_work_queue(&hdn_text_audit_irq);
+		return;
+	}
+	atomic64_inc(&hdn_text_audit_omitted);
+}
+
+static int __init hdn_text_audit_init(void)
+{
+	/* Boot producers can fill mailboxes before workqueues/irq_work exist. */
+	smp_store_release(&hdn_text_audit_ready, true);
+	schedule_work(&hdn_text_audit_work);
+	return 0;
+}
+early_initcall(hdn_text_audit_init);
+
+static __noreturn void hdn_text_reject(void)
+{
+	/* May be in a debugger with every other CPU stopped: take no audit locks. */
+	panic("HDN kernel text transition invariant failed");
+}
+
+void __init hdn_text_bind_window(pte_t *ptep)
+{
+	if (!ptep || hdn_text_expected_ptep || !pte_none(ptep_get(ptep)) ||
+	    !pte_none(ptep_get(ptep + 1)))
+		hdn_text_reject();
+	hdn_text_expected_ptep = ptep;
+}
+
+static bool hdn_text_owner(const struct hdn_text_token *token, pte_t *ptep,
+			   enum hdn_text_state state)
+{
+	return hdn_window.token == token && hdn_window.generation == token->generation &&
+	       hdn_window.owner == current && hdn_window.cpu == raw_smp_processor_id() &&
+	       hdn_window.ptep == ptep && hdn_window.state == state;
+}
+
+static bool hdn_text_page_allowed(struct page *page)
+{
+	unsigned long pfn = page_to_pfn(page);
+
+	if (!hdn_execmem_text_page(page))
+		return false;
+	/* Sealed static data and descriptors cannot borrow the text adapter. */
+	if (hdn_kernel_sealed_data_page(pfn))
+		return false;
+	return true;
+}
+
+void hdn_text_prepare(struct hdn_text_token *token, void *address, size_t size,
+		      struct page **pages, pte_t *ptep, enum hdn_text_kind kind)
+{
+	unsigned long start = (unsigned long)address, end, flags;
+	bool invalid;
+	unsigned int nr = size > PAGE_SIZE - offset_in_page(start) ? 2 : 1;
+
+	lockdep_assert_irqs_disabled();
+	raw_spin_lock_irqsave(&hdn_text_lock, flags);
+	write_seqcount_begin(&hdn_text_seq);
+	invalid = ptep != hdn_text_expected_ptep ||
+		  hdn_window.state != HDN_TEXT_CLOSED || !size ||
+		  size > 2 * PAGE_SIZE - offset_in_page(start) ||
+		  check_add_overflow(start, size, &end) ||
+		  (unsigned int)kind >= HDN_TEXT_KIND_COUNT ||
+		  !pages[0] || (nr == 2 && !pages[1]) ||
+		  (pages[0] && !hdn_text_page_allowed(pages[0])) ||
+		  (nr == 2 && pages[1] && !hdn_text_page_allowed(pages[1])) ||
+		  !pte_none(ptep_get(ptep)) || !pte_none(ptep_get(ptep + 1)) ||
+		  hdn_text_stats.started == U64_MAX;
+	if (invalid) {
+		hdn_text_stats.rejected++;
+	} else {
+		token->generation = ++hdn_text_stats.started;
+		hdn_window.token = token;
+		hdn_window.owner = current;
+		hdn_window.ptep = ptep;
+		hdn_window.generation = token->generation;
+		hdn_window.start = start;
+		hdn_window.size = size;
+		hdn_window.pfns[0] = page_to_pfn(pages[0]);
+		hdn_window.pfns[1] = nr == 2 ? page_to_pfn(pages[1]) : 0;
+		hdn_window.cpu = raw_smp_processor_id();
+		hdn_window.nr_pages = nr;
+		hdn_window.kind = kind;
+		hdn_window.state = HDN_TEXT_PREPARED;
+		hdn_text_stats.active = true;
+	}
+	write_seqcount_end(&hdn_text_seq);
+	raw_spin_unlock_irqrestore(&hdn_text_lock, flags);
+	if (invalid)
+		hdn_text_reject();
+}
+
+void hdn_text_open(struct hdn_text_token *token, pte_t *ptep, void *address,
+		   size_t size, enum hdn_text_kind kind)
+{
+	unsigned long flags;
+	bool invalid;
+	unsigned int i;
+
+	lockdep_assert_irqs_disabled();
+	raw_spin_lock_irqsave(&hdn_text_lock, flags);
+	write_seqcount_begin(&hdn_text_seq);
+	invalid = !hdn_text_owner(token, ptep, HDN_TEXT_PREPARED) ||
+		  hdn_window.start != (unsigned long)address ||
+		  hdn_window.size != size || hdn_window.kind != kind;
+	for (i = 0; !invalid && i < hdn_window.nr_pages; i++) {
+		pte_t pte = ptep_get(ptep + i);
+		pteval_t val = pte_val(pte);
+
+		invalid = !(val & _PAGE_PRESENT) || !(val & _PAGE_RW) ||
+			  (val & (_PAGE_USER | _PAGE_GLOBAL)) ||
+			  (kernel_wx_enforced() && !(val & _PAGE_NX)) ||
+			  pte_pfn(pte) != hdn_window.pfns[i];
+	}
+	if (!invalid && hdn_window.nr_pages == 1)
+		invalid = !pte_none(ptep_get(ptep + 1));
+	if (invalid)
+		hdn_text_stats.rejected++;
+	else
+		hdn_window.state = HDN_TEXT_OPEN;
+	write_seqcount_end(&hdn_text_seq);
+	raw_spin_unlock_irqrestore(&hdn_text_lock, flags);
+	if (invalid)
+		hdn_text_reject();
+}
+
+/* Called only after clearing both aliases, leaving the mm and flushing it. */
+void hdn_text_close(struct hdn_text_token *token, pte_t *ptep)
+{
+	unsigned long flags;
+	bool invalid;
+
+	lockdep_assert_irqs_disabled();
+	raw_spin_lock_irqsave(&hdn_text_lock, flags);
+	write_seqcount_begin(&hdn_text_seq);
+	invalid = !hdn_text_owner(token, ptep, HDN_TEXT_OPEN) ||
+		  !pte_none(ptep_get(ptep)) || !pte_none(ptep_get(ptep + 1));
+	if (invalid) {
+		hdn_text_stats.rejected++;
+	} else {
+		hdn_text_stats.completed++;
+		hdn_text_stats.active = false;
+		memset(&hdn_window, 0, sizeof(hdn_window));
+	}
+	write_seqcount_end(&hdn_text_seq);
+	raw_spin_unlock_irqrestore(&hdn_text_lock, flags);
+	if (invalid)
+		hdn_text_reject();
+}
+
+void hdn_text_report(const struct hdn_text_token *token, enum hdn_text_kind kind)
+{
+	static const enum hdn_reason reasons[HDN_TEXT_KIND_COUNT] = {
+		[HDN_TEXT_LIVE_PATCH] = HDN_REASON_KERNEL_TEXT_PATCH,
+		[HDN_TEXT_DEBUGGER] = HDN_REASON_KERNEL_TEXT_DEBUGGER,
+		[HDN_TEXT_UNUSED_CODE] = HDN_REASON_KERNEL_TEXT_CONSTRUCT,
+		[HDN_TEXT_TRAP_FILL] = HDN_REASON_KERNEL_TEXT_TRAP_FILL,
+	};
+
+	/* The existing bounded audit ring may throttle records; counters do not. */
+	if ((unsigned int)kind >= HDN_TEXT_KIND_COUNT)
+		hdn_text_reject();
+	/* A debugger may stop an audit-ring owner. Never wait on that owner. */
+	if (kind == HDN_TEXT_DEBUGGER || in_nmi()) {
+		hdn_x86_defer_transition(HDN_TRANS_KERNEL_TEXT, token->generation, reasons[kind]);
+		return;
+	}
+	hdn_report_kernel_text_transition(token->generation, reasons[kind], 0);
+}
+
+void hdn_text_get_stats(struct hdn_text_window_stats *stats)
+{
+	unsigned int seq;
+
+	/* Readers must not strand a writer lock when KGDB stops another CPU. */
+	do {
+		seq = read_seqcount_begin(&hdn_text_seq);
+		*stats = hdn_text_stats;
+	} while (read_seqcount_retry(&hdn_text_seq, seq));
+	stats->audit_omitted = atomic64_read(&hdn_text_audit_omitted);
+	stats->audit_deferred = atomic64_read(&hdn_text_audit_deferred);
+}
