+static void print_resource_detail(unsigned long long object)
+{
+	unsigned int resource = object >> 56;
+	unsigned long long wanted =
+		object & ((1ULL << 56) - 1);
+	bool packed_pressure = resource != 0;
+
+	if (!packed_pressure)
+		resource = (unsigned int)object;
+
+	printf(" object_detail=resource resource_id=%u resource=%s",
+	       resource,
+	       lookup_name(resource_names,
+			   sizeof(resource_names) / sizeof(resource_names[0]),
+			   resource));
+	if (packed_pressure)
+		printf(" resource_wanted=%llu", wanted);
+}
+
+static void print_signal_detail(unsigned long long object)
+{
+	unsigned int sig = object >> 56;
+	unsigned long long addr = object & ((1ULL << 56) - 1);
+
+	printf(" object_detail=signal signal_id=%u signal=%s fault_addr_low=0x%llx",
+	       sig,
+	       lookup_name(signal_names,
+			   sizeof(signal_names) / sizeof(signal_names[0]),
+			   sig),
+	       addr);
+}
+
+static void print_signal_number_detail(unsigned int sig)
+{
+	printf(" object_detail=signal signal_id=%u signal=%s",
+	       sig,
+	       lookup_name(signal_names,
+			   sizeof(signal_names) / sizeof(signal_names[0]),
+			   sig));
+}
+
+static void print_socket_create_detail(unsigned long long object)
+{
+	unsigned int family = object >> 32;
+	unsigned int type = (object >> 16) & 0xffff;
+	unsigned int protocol = object & 0xffff;
+
+	printf(" object_detail=socket socket_family_id=%u socket_family=%s socket_type_id=%u socket_type=%s socket_protocol=%u",
+	       family,
+	       lookup_name(socket_family_names,
+			   sizeof(socket_family_names) /
+			   sizeof(socket_family_names[0]), family),
+	       type,
+	       lookup_name(socket_type_names,
+			   sizeof(socket_type_names) /
+			   sizeof(socket_type_names[0]), type),
+	       protocol);
+}
+
+static void print_ipv4_endpoint(unsigned long long object)
+{
+	unsigned int type = (object >> 48) & 0xff;
+	unsigned int port = (object >> 32) & 0xffff;
+	unsigned int addr = object & 0xffffffff;
+	unsigned char octets[4];
+
+	octets[0] = (addr >> 24) & 0xff;
+	octets[1] = (addr >> 16) & 0xff;
+	octets[2] = (addr >> 8) & 0xff;
+	octets[3] = addr & 0xff;
+
+	printf(" object_detail=socket socket_family_id=%u socket_family=AF_INET socket_type_id=%u socket_type=%s socket_port=%u socket_address=%u.%u.%u.%u",
+	       AF_INET, type,
+	       lookup_name(socket_type_names,
+			   sizeof(socket_type_names) /
+			   sizeof(socket_type_names[0]), type),
+	       port, octets[0], octets[1], octets[2], octets[3]);
+}
+
+static void print_ipv6_endpoint(unsigned long long object)
+{
+	unsigned int type = (object >> 48) & 0xff;
+	unsigned int port = (object >> 32) & 0xffff;
+	unsigned int hash = object & 0xffffffff;
+
+	printf(" object_detail=socket socket_family_id=%u socket_family=AF_INET6 socket_type_id=%u socket_type=%s socket_port=%u socket_addr_hash=0x%x",
+	       AF_INET6, type,
+	       lookup_name(socket_type_names,
+			   sizeof(socket_type_names) /
+			   sizeof(socket_type_names[0]), type),
+	       port, hash);
+}
+
+static void print_socket_endpoint_detail(unsigned long long object)
+{
+	unsigned int family = object >> 56;
+
+	if (family == AF_INET) {
+		print_ipv4_endpoint(object);
+		return;
+	}
+	if (family == AF_INET6) {
+		print_ipv6_endpoint(object);
+		return;
+	}
+
+	print_socket_create_detail(object);
+}
+
+static void print_object_detail(const struct hdn_decoded_event *event)
+{
+	switch (event->transition) {
+	case HDN_TRANS_EXEC_ARGS:
+		printf(" object_detail=exec_args argc=%u envc=%u",
+		       (unsigned int)(event->object >> 32),
+		       (unsigned int)(event->object & 0xffffffff));
+		break;
+	case HDN_TRANS_FORK:
+		if (event->object)
+			printf(" object_detail=process related_pid=%llu",
+			       event->object);
+		break;
+	case HDN_TRANS_PROCESS_ACCOUNT:
+		printf(" object_detail=process exit_code=%u",
+		       (unsigned int)event->object);
+		break;
+	case HDN_TRANS_SIGNAL:
+		print_signal_detail(event->object);
+		break;
+	case HDN_TRANS_COREDUMP:
+		print_signal_number_detail((unsigned int)event->object);
+		break;
+	case HDN_TRANS_TIME_CHANGE:
+		printf(" object_detail=time time_operation_id=%u time_operation=%s",
+		       (unsigned int)event->object,
+		       lookup_name(time_operation_names,
+				   sizeof(time_operation_names) /
+				   sizeof(time_operation_names[0]),
+				   (unsigned int)event->object));
+		break;
+	case HDN_TRANS_RESOURCE_LIMIT:
+		print_resource_detail(event->object);
+		break;
+	case HDN_TRANS_USB_ATTACH:
+		printf(" object_detail=usb usb_bus=%u usb_port=%u",
+		       (unsigned int)(event->object >> 32),
+		       (unsigned int)(event->object & 0xffffffff));
+		break;
+	case HDN_TRANS_USB_MONITOR:
+		printf(" object_detail=usb usb_bus=%llu", event->object);
+		break;
+	case HDN_TRANS_SOCKET_CREATE:
+		print_socket_create_detail(event->object);
+		break;
+	case HDN_TRANS_SOCKET_CONNECT:
+	case HDN_TRANS_SOCKET_SERVER:
+		print_socket_endpoint_detail(event->object);
+		break;
+	case HDN_TRANS_CAPABILITY:
+		printf(" object_detail=capability capability_id=%u capability=%s",
+		       (unsigned int)event->object,
+		       lookup_name(capability_names,
+				   sizeof(capability_names) /
+				   sizeof(capability_names[0]),
+				   (unsigned int)event->object));
+		break;
+	default:
+		break;
+	}
+}
+
+static void print_event(const struct hdn_decoded_event *event)
+{
+	printf("sequence=%llu timestamp_ns=%llu pid=%u uid=%u profile=%llu ",
+	       event->sequence, event->timestamp_ns, event->pid, event->uid,
+	       event->profile);
+	printf("event_id=%u event=%s authority_id=%u authority=%s ",
+	       event->event_id,
+	       lookup_name(transition_names,
+			   sizeof(transition_names) / sizeof(transition_names[0]),
+			   event->event_id),
+	       event->authority,
+	       lookup_name(authority_names,
+			   sizeof(authority_names) / sizeof(authority_names[0]),
+			   event->authority));
+	printf("transition_id=%u transition=%s action_id=%u action=%s ",
+	       event->transition,
+	       lookup_name(transition_names,
+			   sizeof(transition_names) / sizeof(transition_names[0]),
+			   event->transition),
+	       event->action,
+	       lookup_name(action_names,
+			   sizeof(action_names) / sizeof(action_names[0]),
+			   event->action));
+	printf("reason_id=%u reason=%s error=%d subject=%llu object=%llu flags=0x%llx flag_names=",
+	       event->reason,
+	       lookup_name(reason_names,
+			   sizeof(reason_names) / sizeof(reason_names[0]),
+			   event->reason),
+	       event->error, event->subject, event->object, event->flags);
+	print_flag_names(event->flags);
+	print_object_detail(event);
+	printf("\n");
+	fflush(stdout);
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--input PATH] [--follow] [--quiet] "
+		"[--expect FIELD=VALUE]...\n"
+		"\n"
+		"Decodes securityfs hardening event records to stable UAPI names.\n"
+		"--follow polls the bounded event ring and prints each sequence once.\n"
+		"Fields for --expect: event, action, authority, transition, reason.\n",
+		prog);
+}
+
+int main(int argc, char **argv)
+{
+	const char *input = HDN_EVENTS_PATH;
+	struct hdn_expectation expectations[HDN_MAX_EXPECTATIONS];
+	unsigned int expectation_count = 0;
+	unsigned long long last_sequence = 0;
+	bool have_sequence = false;
+	bool follow = false;
+	bool quiet = false;
+	bool found = false;
+	char *line = NULL;
+	size_t size = 0;
+	ssize_t len;
+	FILE *file;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		}
+		if (!strcmp(argv[i], "--input")) {
+			if (++i >= argc)
+				goto bad_args;
+			input = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--quiet")) {
+			quiet = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--follow")) {
+			follow = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--expect")) {
+			if (++i >= argc ||
+			    expectation_count >= HDN_MAX_EXPECTATIONS)
+				goto bad_args;
+			if (parse_expectation(argv[i],
+					      &expectations[expectation_count]))
+				goto bad_args;
+			expectation_count++;
+			continue;
+		}
+		goto bad_args;
+	}
+
+	if (follow && expectation_count)
+		goto bad_args;
+	if (follow) {
+		if (signal(SIGTERM, stop_follow) == SIG_ERR ||
+		    signal(SIGINT, stop_follow) == SIG_ERR) {
+			fprintf(stderr,
+				"hdn-event-decode: cannot install signal handler\n");
+			return 2;
+		}
+	}
+
+	do {
+		struct timespec delay = {
+			.tv_sec = 0,
+			.tv_nsec = HDN_FOLLOW_POLL_NS,
+		};
+
+		file = fopen(input, "r");
+		if (!file) {
+			fprintf(stderr, "hdn-event-decode: cannot open %s: %s\n",
+				input, strerror(errno));
+			free(line);
+			return 2;
+		}
+
+		while ((len = getline(&line, &size, file)) >= 0) {
+			struct hdn_decoded_event event;
+
+			(void)len;
+			if (parse_event_line(line, &event)) {
+				free(line);
+				fclose(file);
+				fprintf(stderr,
+					"hdn-event-decode: malformed event line\n");
+				return 2;
+			}
+			if (follow && have_sequence &&
+			    event.sequence <= last_sequence)
+				continue;
+			if (follow) {
+				last_sequence = event.sequence;
+				have_sequence = true;
+			}
+			if (expectation_count &&
+			    event_matches(&event, expectations,
+					  expectation_count))
+				found = true;
+			if (!quiet)
+				print_event(&event);
+		}
+
+		if (ferror(file)) {
+			free(line);
+			fclose(file);
+			return 2;
+		}
+		fclose(file);
+		if (follow && !follow_stop) {
+			while (nanosleep(&delay, &delay) && errno == EINTR &&
+			       !follow_stop)
+				;
+		}
+	} while (follow && !follow_stop);
+
+	free(line);
+
+	if (expectation_count)
+		return found ? 0 : 1;
+	return 0;
+
+bad_args:
+	usage(argv[0]);
+	return 2;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-hardware-facts.c linux-7.0.12-hdn/tools/hardening/hdn-hardware-facts.c
--- linux-7.0.12/tools/hardening/hdn-hardware-facts.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-hardware-facts.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Closed, unprivileged front end to the system's existing hardware brokers. */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+
+static long long monotonic_ms(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts))
+		return -1;
+	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static bool property(bool power, char *buffer, size_t capacity)
+{
+	char *argv[] = { "/usr/bin/busctl", "--system", "--no-pager",
+		"--timeout=2", "get-property",
+		power ? "org.freedesktop.UPower" : "org.freedesktop.NetworkManager",
+		power ? "/org/freedesktop/UPower" : "/org/freedesktop/NetworkManager",
+		power ? "org.freedesktop.UPower" : "org.freedesktop.NetworkManager",
+		power ? "OnBattery" : "Connectivity", NULL };
+	/* Do not accept a caller-selected bus, executable, address or path. */
+	char *env[] = { "LC_ALL=C", "PATH=/usr/bin", NULL };
+	posix_spawn_file_actions_t actions;
+	struct pollfd pfd;
+	int pipes[2], status, ret;
+	size_t used = 0;
+	pid_t child;
+	long long start = monotonic_ms(), remaining;
+	bool ok = false;
+
+	if (start < 0 || pipe2(pipes, O_CLOEXEC))
+		return false;
+	if (posix_spawn_file_actions_init(&actions))
+		goto close_pipes;
+	ret = posix_spawn_file_actions_adddup2(&actions, pipes[1], STDOUT_FILENO);
+	ret |= posix_spawn_file_actions_addopen(&actions, STDIN_FILENO,
+					       "/dev/null", O_RDONLY, 0);
+	ret |= posix_spawn_file_actions_addopen(&actions, STDERR_FILENO,
+					       "/dev/null", O_WRONLY, 0);
+	ret |= posix_spawn_file_actions_addclosefrom_np(&actions, 3);
+	if (!ret)
+		ret = posix_spawn(&child, argv[0], &actions, NULL, argv, env);
+	posix_spawn_file_actions_destroy(&actions);
+	if (ret)
+		goto close_pipes;
+	close(pipes[1]);
+	pfd = (struct pollfd){ .fd = pipes[0], .events = POLLIN };
+	for (;;) {
+		long long now = monotonic_ms();
+		ssize_t n;
+
+		remaining = now < 0 ? 0 : 3000 - (now - start);
+		if (remaining <= 0)
+			break;
+		ret = poll(&pfd, 1, remaining);
+		if (ret < 0 && errno == EINTR)
+			continue;
+		if (ret <= 0 || used == capacity - 1)
+			break;
+		n = read(pipes[0], buffer + used, capacity - 1 - used);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n < 0)
+			break;
+		if (!n) {
+			ok = true;
+			break;
+		}
+		used += n;
+	}
+	close(pipes[0]);
+	if (!ok)
+		kill(child, SIGKILL);
+	for (;;) {
+		long long now;
+
+		ret = waitpid(child, &status, WNOHANG);
+		if (ret == child || (ret < 0 && errno != EINTR))
+			break;
+		now = monotonic_ms();
+		if (now < 0 || now - start >= 3000) {
+			kill(child, SIGKILL);
+			ok = false;
+			while ((ret = waitpid(child, &status, 0)) < 0 && errno == EINTR)
+				;
+			break;
+		}
+		poll(NULL, 0, 10);
+	}
+	buffer[used] = '\0';
+	return ok && ret == child && WIFEXITED(status) && !WEXITSTATUS(status);
+close_pipes:
+	close(pipes[0]);
+	close(pipes[1]);
+	return false;
+}
+
+int main(int argc, char **argv)
+{
+	char buffer[64];
+	const char *value = "unknown";
+	bool power;
+
+	if (argc != 2 || (strcmp(argv[1], "power-source") &&
+			  strcmp(argv[1], "network-state"))) {
+		fprintf(stderr, "usage: %s power-source|network-state\n", argv[0]);
+		return 2;
+	}
+	/* This adapter never gains a service identity on behalf of its caller. */
+	if (getuid() != geteuid() || getgid() != getegid() ||
+	    prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0))
+		return 1;
+	power = !strcmp(argv[1], "power-source");
+	if (property(power, buffer, sizeof(buffer))) {
+		if (power) {
+			if (!strcmp(buffer, "b true\n"))
+				value = "battery";
+			else if (!strcmp(buffer, "b false\n"))
+				value = "external";
+		} else {
+			const char *states[] = { "unknown", "none", "portal", "limited", "full" };
+			for (unsigned int i = 0; i < ARRAY_SIZE(states); i++) {
+				char expected[8];
+				snprintf(expected, sizeof(expected), "u %u\n", i);
+				if (!strcmp(buffer, expected))
+					value = states[i];
+			}
+		}
+	}
+	printf("{\"version\":1,\"fact\":\"%s\",\"value\":\"%s\"}\n", argv[1], value);
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-image-seal.c linux-7.0.12-hdn/tools/hardening/hdn-image-seal.c
--- linux-7.0.12/tools/hardening/hdn-image-seal.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-image-seal.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_IMAGE_SEAL_CONFIG
+#define HDN_IMAGE_SEAL_CONFIG "/etc/hdn/image-seals.conf"
+#endif
+
+#ifndef HDN_ADMIN_BROKER_PATH
+#define HDN_ADMIN_BROKER_PATH "/usr/libexec/hdn-admin-broker"
+#endif
+
+#define HDN_IMAGE_SEAL_MAX_STEPS 64
+
+enum hdn_image_seal_op {
+	HDN_IMAGE_SEAL_POLICY_COMMIT,
+	HDN_IMAGE_SEAL_ROFS_APPLY,
+};
+
+struct hdn_image_seal_step {
+	char *name;
+	enum hdn_image_seal_op op;
+	char *argument;
+};
+
+struct hdn_image_seal_config {
+	struct hdn_image_seal_step steps[HDN_IMAGE_SEAL_MAX_STEPS];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--broker PATH] [--dry-run] SEAL_NAME\n"
+		"\n"
+		"Runs a product-approved image sealing sequence through hdn-admin-broker.\n"
+		"Config lines:\n"
+		"  seal NAME policy-commit SIGNED_POLICY\n"
+		"  seal NAME rofs-apply READONLY_LIST\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr, "hdn-image-seal: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-image-seal: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int add_step(struct hdn_image_seal_config *config, char **tokens,
+		    unsigned int count, unsigned int lineno)
+{
+	struct hdn_image_seal_step *step;
+	enum hdn_image_seal_op op;
+
+	if (count != 4) {
+		fprintf(stderr,
+			"hdn-image-seal: seal line %u needs NAME OP ARGUMENT\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_IMAGE_SEAL_MAX_STEPS) {
+		fprintf(stderr, "hdn-image-seal: too many seal steps\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1])) {
+		fprintf(stderr,
+			"hdn-image-seal: unsafe seal name at line %u: %s\n",
+			lineno, tokens[1]);
+		return -EINVAL;
+	}
+	if (!strcmp(tokens[2], "policy-commit"))
+		op = HDN_IMAGE_SEAL_POLICY_COMMIT;
+	else if (!strcmp(tokens[2], "rofs-apply"))
+		op = HDN_IMAGE_SEAL_ROFS_APPLY;
+	else {
+		fprintf(stderr,
+			"hdn-image-seal: unknown seal operation at line %u: %s\n",
+			lineno, tokens[2]);
+		return -EINVAL;
+	}
+	if (require_safe_absolute(tokens[2], tokens[3]))
+		return -EINVAL;
+
+	step = &config->steps[config->count];
+	step->name = strdup(tokens[1]);
+	step->argument = strdup(tokens[3]);
+	if (!step->name || !step->argument)
+		return -ENOMEM;
+	step->op = op;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_image_seal_config *config, char *line,
+			     unsigned int lineno)
+{
+	char *tokens[4];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-image-seal: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (strcmp(tokens[0], "seal")) {
+		fprintf(stderr,
+			"hdn-image-seal: unknown config key at line %u: %s\n",
+			lineno, tokens[0]);
+		return -EINVAL;
+	}
+
+	return add_step(config, tokens, count, lineno);
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-image-seal: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-image-seal: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-image-seal: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path, struct hdn_image_seal_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_image_seal_config *config)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		free(config->steps[i].name);
+		free(config->steps[i].argument);
+	}
+}
+
+static int run_broker_step(const char *broker, bool dry_run,
+			   const struct hdn_image_seal_step *step)
+{
+	char *const policy_argv[] = {
+		(char *)broker,
+		"policy-commit",
+		step->argument,
+		NULL,
+	};
+	char *const dry_policy_argv[] = {
+		(char *)broker,
+		"--dry-run",
+		"policy-commit",
+		step->argument,
+		NULL,
+	};
+	char *const rofs_argv[] = {
+		(char *)broker,
+		"seal-readonly",
+		"-f",
+		step->argument,
+		NULL,
+	};
+	char *const dry_rofs_argv[] = {
+		(char *)broker,
+		"--dry-run",
+		"seal-readonly",
+		"-f",
+		step->argument,
+		NULL,
+	};
+	char *const *argv;
+	int status;
+	pid_t child;
+
+	if (step->op == HDN_IMAGE_SEAL_POLICY_COMMIT)
+		argv = dry_run ? dry_policy_argv : policy_argv;
+	else
+		argv = dry_run ? dry_rofs_argv : rofs_argv;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-image-seal: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		execv(broker, argv);
+		fprintf(stderr, "hdn-image-seal: exec %s failed: %s\n",
+			broker, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	if (waitpid(child, &status, 0) < 0) {
+		fprintf(stderr, "hdn-image-seal: wait failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_seal(const char *broker,
+		    const struct hdn_image_seal_config *config,
+		    const char *name, bool dry_run)
+{
+	bool found = false;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < config->count; i++) {
+		if (strcmp(config->steps[i].name, name))
+			continue;
+		found = true;
+		ret = run_broker_step(broker, dry_run, &config->steps[i]);
+		if (ret)
+			return ret;
+	}
+
+	if (!found) {
+		fprintf(stderr,
+			"hdn-image-seal: seal is not product-approved: %s\n",
+			name);
+		return 1;
+	}
+
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	const char *config_path = HDN_IMAGE_SEAL_CONFIG;
+	const char *broker_path = HDN_ADMIN_BROKER_PATH;
+	struct hdn_image_seal_config config;
+	const char *seal = NULL;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		}
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc)
+				goto bad_args;
+			config_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--broker")) {
+			if (++i >= argc)
+				goto bad_args;
+			broker_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+			continue;
+		}
+		if (argv[i][0] == '-')
+			goto bad_args;
+		if (seal)
+			goto bad_args;
+		seal = argv[i];
+	}
+
+	if (!seal || !safe_name(seal))
+		goto bad_args;
+	if (require_safe_absolute("config", config_path) ||
+	    require_safe_absolute("broker", broker_path))
+		return 1;
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	ret = run_seal(broker_path, &config, seal, dry_run);
+	free_config(&config);
+	return ret;
+
+bad_args:
+	usage(argv[0]);
+	return 2;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-package-hook.c linux-7.0.12-hdn/tools/hardening/hdn-package-hook.c
--- linux-7.0.12/tools/hardening/hdn-package-hook.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-package-hook.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,432 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_PACKAGE_HOOK_CONFIG
+#define HDN_PACKAGE_HOOK_CONFIG "/etc/hdn/package-hooks.conf"
+#endif
+
+#ifndef HDN_SYSTEM_TRANSACTION_PATH
+#define HDN_SYSTEM_TRANSACTION_PATH "/usr/libexec/hdn-system-transaction"
+#endif
+
+#ifndef HDN_IMAGE_SEAL_PATH
+#define HDN_IMAGE_SEAL_PATH "/usr/libexec/hdn-image-seal"
+#endif
+
+#define HDN_PACKAGE_HOOK_MAX_RULES 64
+
+enum hdn_package_hook_backend {
+	HDN_PACKAGE_HOOK_SYSTEM_TRANSACTION,
+	HDN_PACKAGE_HOOK_IMAGE_SEAL,
+};
+
+struct hdn_package_hook_rule {
+	char *name;
+	enum hdn_package_hook_backend backend;
+	char *argument;
+};
+
+struct hdn_package_hook_config {
+	struct hdn_package_hook_rule rules[HDN_PACKAGE_HOOK_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--system-transaction PATH] [--image-seal PATH] [--dry-run] HOOK\n"
+		"\n"
+		"Runs a product-approved package-manager hook.\n"
+		"Config lines:\n"
+		"  hook NAME system-transaction TRANSACTION\n"
+		"  hook NAME image-seal SEAL\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr, "hdn-package-hook: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-package-hook: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int add_rule(struct hdn_package_hook_config *config, char **tokens,
+		    unsigned int count, unsigned int lineno)
+{
+	struct hdn_package_hook_rule *rule;
+	enum hdn_package_hook_backend backend;
+
+	if (count != 4) {
+		fprintf(stderr,
+			"hdn-package-hook: hook line %u needs NAME BACKEND ARGUMENT\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_PACKAGE_HOOK_MAX_RULES) {
+		fprintf(stderr, "hdn-package-hook: too many hook rules\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1])) {
+		fprintf(stderr,
+			"hdn-package-hook: unsafe hook name at line %u: %s\n",
+			lineno, tokens[1]);
+		return -EINVAL;
+	}
+	if (!safe_name(tokens[3])) {
+		fprintf(stderr,
+			"hdn-package-hook: unsafe backend argument at line %u: %s\n",
+			lineno, tokens[3]);
+		return -EINVAL;
+	}
+
+	if (!strcmp(tokens[2], "system-transaction"))
+		backend = HDN_PACKAGE_HOOK_SYSTEM_TRANSACTION;
+	else if (!strcmp(tokens[2], "image-seal"))
+		backend = HDN_PACKAGE_HOOK_IMAGE_SEAL;
+	else {
+		fprintf(stderr,
+			"hdn-package-hook: unknown hook backend at line %u: %s\n",
+			lineno, tokens[2]);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->argument = strdup(tokens[3]);
+	if (!rule->name || !rule->argument)
+		return -ENOMEM;
+	rule->backend = backend;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_package_hook_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[4];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-package-hook: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (strcmp(tokens[0], "hook")) {
+		fprintf(stderr,
+			"hdn-package-hook: unknown config key at line %u: %s\n",
+			lineno, tokens[0]);
+		return -EINVAL;
+	}
+
+	return add_rule(config, tokens, count, lineno);
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-package-hook: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-package-hook: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-package-hook: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path, struct hdn_package_hook_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_package_hook_config *config)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].argument);
+	}
+}
+
+static const struct hdn_package_hook_rule *
+find_rule(const struct hdn_package_hook_config *config, const char *hook)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, hook))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int run_hook(const struct hdn_package_hook_rule *rule,
+		    const char *system_transaction, const char *image_seal,
+		    bool dry_run)
+{
+	const char *path;
+	const char *argv0;
+	pid_t child;
+	int status;
+
+	if (rule->backend == HDN_PACKAGE_HOOK_SYSTEM_TRANSACTION) {
+		path = system_transaction;
+		argv0 = "hdn-system-transaction";
+	} else {
+		path = image_seal;
+		argv0 = "hdn-image-seal";
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-package-hook: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(path, argv0, "--dry-run", rule->argument, NULL);
+		else
+			execl(path, argv0, rule->argument, NULL);
+		fprintf(stderr, "hdn-package-hook: exec %s failed: %s\n",
+			path, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_package_hook_config config;
+	const struct hdn_package_hook_rule *rule;
+	const char *config_path = HDN_PACKAGE_HOOK_CONFIG;
+	const char *system_transaction = HDN_SYSTEM_TRANSACTION_PATH;
+	const char *image_seal = HDN_IMAGE_SEAL_PATH;
+	const char *transaction;
+	const char *hook = NULL;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--system-transaction")) {
+			if (++i >= argc ||
+			    require_safe_absolute("system transaction helper",
+						  argv[i])) {
+				usage(argv[0]);
+				return 2;
+			}
+			system_transaction = argv[i];
+		} else if (!strcmp(argv[i], "--image-seal")) {
+			if (++i >= argc ||
+			    require_safe_absolute("image seal helper", argv[i])) {
+				usage(argv[0]);
+				return 2;
+			}
+			image_seal = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!hook) {
+			hook = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!hook || !safe_name(hook)) {
+		usage(argv[0]);
+		return 2;
+	}
+	transaction = getenv("HDN_PACKAGE_TRANSACTION");
+	if (!strcmp(hook, "image-seal-default") && transaction &&
+	    !strcmp(transaction, "1"))
+		return 0;
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	rule = find_rule(&config, hook);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-package-hook: hook is not product-approved: %s\n",
+			hook);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_hook(rule, system_transaction, image_seal, dry_run);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-package-worker.c linux-7.0.12-hdn/tools/hardening/hdn-package-worker.c
--- linux-7.0.12/tools/hardening/hdn-package-worker.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-package-worker.c	2026-07-15 14:22:07.961697200 -0500
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_DNF5_PATH
+#define HDN_DNF5_PATH "/usr/bin/dnf5"
+#endif
+
+#ifndef HDN_ROFS_TRANSACTION_PATH
+#define HDN_ROFS_TRANSACTION_PATH "/usr/libexec/hdn-rofs-transaction"
+#endif
+
+#ifndef HDN_PACKAGE_WORKER_PATH
+#define HDN_PACKAGE_WORKER_PATH "/usr/libexec/hdn-package-worker"
+#endif
+
+#ifndef HDN_POLICY_LOAD_PATH
+#define HDN_POLICY_LOAD_PATH "/usr/libexec/hdn-policy-load"
+#endif
+
+#ifndef HDN_SYSTEMCTL_PATH
+#define HDN_SYSTEMCTL_PATH "/usr/bin/systemctl"
+#endif
+
+#ifndef HDN_MOUNTINFO_PATH
+#define HDN_MOUNTINFO_PATH "/proc/self/mountinfo"
+#endif
+
+static const char *const boot_mounts[] = {
+	"/boot",
+	"/boot/efi",
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr, "Usage: %s [update|repair]\n", prog);
+}
+
+static bool mount_option_present(const char *options, const char *wanted)
+{
+	const char *option = options;
+	size_t wanted_len = strlen(wanted);
+
+	while (option && *option) {
+		const char *comma = strchr(option, ',');
+		size_t len = comma ? (size_t)(comma - option) : strlen(option);
+
+		if (len == wanted_len && !memcmp(option, wanted, len))
+			return true;
+		option = comma ? comma + 1 : NULL;
+	}
+
+	return false;
+}
+
+static int decode_mountinfo_path(const char *src, char *dst, size_t dst_size)
+{
+	size_t di = 0;
+
+	while (*src) {
+		unsigned char ch;
+
+		if (di + 1 >= dst_size)
+			return -ENAMETOOLONG;
+		if (src[0] == '\\' && src[1] >= '0' && src[1] <= '7' &&
+		    src[2] >= '0' && src[2] <= '7' &&
+		    src[3] >= '0' && src[3] <= '7') {
+			ch = ((src[1] - '0') << 6) |
+			     ((src[2] - '0') << 3) |
+			     (src[3] - '0');
+			src += 4;
+		} else {
+			ch = *src++;
+		}
+		dst[di++] = ch;
+	}
+
+	dst[di] = '\0';
+	return 0;
+}
+
+static int mount_is_readonly(const char *path, bool *mounted, bool *readonly)
+{
+	char *line = NULL;
+	size_t size = 0;
+	FILE *file;
+	int ret = 0;
+
+	*mounted = false;
+	*readonly = false;
+	file = fopen(HDN_MOUNTINFO_PATH, "r");
+	if (!file) {
+		fprintf(stderr, "hdn-package-worker: cannot open %s: %s\n",
+			HDN_MOUNTINFO_PATH, strerror(errno));
+		return -errno;
+	}
+
+	while (getline(&line, &size, file) >= 0) {
+		char decoded[PATH_MAX];
+		char *fields = line;
+		char *mountpoint = NULL;
+		char *options = NULL;
+		int i;
+
+		for (i = 0; i < 6; i++) {
+			char *field = strsep(&fields, " ");
+
+			if (!field)
+				break;
+			if (i == 4)
+				mountpoint = field;
+			else if (i == 5)
+				options = field;
+		}
+		if (!mountpoint || !options ||
+		    decode_mountinfo_path(mountpoint, decoded, sizeof(decoded)) ||
+		    strcmp(decoded, path))
+			continue;
+
+		/* Retain the final match, which is the visible mount in a stack. */
+		*mounted = true;
+		*readonly = mount_option_present(options, "ro");
+	}
+
+	if (ferror(file)) {
+		fprintf(stderr, "hdn-package-worker: cannot read %s: %s\n",
+			HDN_MOUNTINFO_PATH, strerror(errno));
+		ret = -EIO;
+	}
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static int open_next_boot_mount(unsigned int stage, const char *operation)
+{
+	for (; stage < sizeof(boot_mounts) / sizeof(boot_mounts[0]); stage++) {
+		char next_stage[16];
+		bool mounted;
+		bool readonly;
+		char *const transaction_argv[] = {
+			"hdn-rofs-transaction",
+			(char *)boot_mounts[stage],
+			"--",
+			(char *)HDN_PACKAGE_WORKER_PATH,
+			"--continue",
+			next_stage,
+			(char *)operation,
+			NULL,
+		};
+
+		if (mount_is_readonly(boot_mounts[stage], &mounted, &readonly))
+			return 1;
+		if (!mounted || !readonly)
+			continue;
+
+		snprintf(next_stage, sizeof(next_stage), "%u", stage + 1);
+		execv(HDN_ROFS_TRANSACTION_PATH, transaction_argv);
+		fprintf(stderr, "hdn-package-worker: exec %s failed: %s\n",
+			HDN_ROFS_TRANSACTION_PATH, strerror(errno));
+		return errno == ENOENT ? 127 : 126;
+	}
+
+	return -1;
+}
+
+static int run_command(const char *path, char *const argv[])
+{
+	pid_t child;
+	int status;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-package-worker: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+	if (!child) {
+		execv(path, argv);
+		fprintf(stderr, "hdn-package-worker: exec %s failed: %s\n",
+			path, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+	if (waitpid(child, &status, 0) < 0) {
+		fprintf(stderr, "hdn-package-worker: wait failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+	if (WIFEXITED(status))
+		return WEXITSTATUS(status);
+	if (WIFSIGNALED(status))
+		return 128 + WTERMSIG(status);
+	return 1;
+}
+
+static int quiesce_package_services(void)
+{
+	char *const argv[] = {
+		"systemctl",
+		"stop",
+		"packagekit.service",
+		"dnf5daemon-server.service",
+		NULL,
+	};
+	int ret;
+
+	ret = run_command(HDN_SYSTEMCTL_PATH, argv);
+	if (ret)
+		fprintf(stderr,
+			"hdn-package-worker: cannot quiesce package services\n");
+	return ret;
+}
+
+int main(int argc, char **argv)
+{
+	char *const update_argv[] = {
+		"dnf5",
+		"upgrade",
+		"--refresh",
+		"--assumeyes",
+		NULL,
+	};
+	char *const repair_argv[] = {
+		"dnf5",
+		"distro-sync",
+		"--refresh",
+		"--assumeyes",
+		NULL,
+	};
+	char *const refresh_argv[] = {
+		"hdn-policy-load",
+		"--refresh",
+		NULL,
+	};
+	char *const *dnf_argv;
+	const char *operation;
+	unsigned int stage = 0;
+	int ret;
+
+	if (argc == 1 || (argc == 2 && !strcmp(argv[1], "update"))) {
+		dnf_argv = update_argv;
+		operation = "update";
+	} else if (argc == 2 && !strcmp(argv[1], "repair")) {
+		dnf_argv = repair_argv;
+		operation = "repair";
+	} else if (argc == 4 && !strcmp(argv[1], "--continue") &&
+		   (!strcmp(argv[2], "1") || !strcmp(argv[2], "2")) &&
+		   (!strcmp(argv[3], "update") || !strcmp(argv[3], "repair"))) {
+		stage = (unsigned int)(argv[2][0] - '0');
+		operation = argv[3];
+		dnf_argv = !strcmp(operation, "repair") ? repair_argv : update_argv;
+	} else {
+		usage(argv[0]);
+		return 2;
+	}
+	if (geteuid() != 0) {
+		fprintf(stderr, "hdn-package-worker: must run as root\n");
+		return 1;
+	}
+
+	if (clearenv() || setenv("PATH", "/usr/sbin:/usr/bin", 1) ||
+	    setenv("HOME", "/root", 1) || setenv("LANG", "C.UTF-8", 1) ||
+	    setenv("HDN_PACKAGE_TRANSACTION", "1", 1)) {
+		fprintf(stderr, "hdn-package-worker: environment setup failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	ret = open_next_boot_mount(stage, operation);
+	if (ret >= 0)
+		return ret;
+
+	ret = quiesce_package_services();
+	if (ret)
+		return ret;
+
+	ret = run_command(HDN_DNF5_PATH, (char *const *)dnf_argv);
+	if (!ret)
+		ret = run_command(HDN_POLICY_LOAD_PATH, refresh_argv);
+	if (ret)
+		fprintf(stderr,
+			"hdn-package-worker: package transaction or policy refresh failed\n");
+	if (quiesce_package_services())
+		return 1;
+	return ret;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-policy-daemon.c linux-7.0.12-hdn/tools/hardening/hdn-policy-daemon.c
--- linux-7.0.12/tools/hardening/hdn-policy-daemon.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-policy-daemon.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,518 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_POLICY_DAEMON_CONFIG
+#define HDN_POLICY_DAEMON_CONFIG "/etc/hdn/policy-daemon.conf"
+#endif
+
+#ifndef HDN_POLICY_WORKFLOW_PATH
+#define HDN_POLICY_WORKFLOW_PATH "/usr/libexec/hdn-policy-workflow"
+#endif
+
+#define HDN_POLICY_DAEMON_MAX_WORKFLOWS 128
+
+struct hdn_policy_daemon_config {
+	char *workflow_helper;
+	char *workflows[HDN_POLICY_DAEMON_MAX_WORKFLOWS];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run] COMMAND WORKFLOW\n"
+		"       %s [--config FILE] --stdio\n"
+		"\n"
+		"Runs product-approved policy workflows through hdn-policy-workflow.\n"
+		"Commands: learn, candidate, compile, commit\n"
+		"Stdio requests: COMMAND WORKFLOW, or dry-run commit WORKFLOW\n"
+		"Config lines:\n"
+		"  workflow-helper PATH\n"
+		"  allow-workflow WORKFLOW\n",
+		prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool safe_command(const char *command)
+{
+	return command &&
+	       (!strcmp(command, "learn") || !strcmp(command, "candidate") ||
+		!strcmp(command, "compile") || !strcmp(command, "commit"));
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-policy-daemon: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-policy-daemon: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-policy-daemon: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_workflow_helper(struct hdn_policy_daemon_config *config,
+			       char **tokens, unsigned int count,
+			       unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-policy-daemon: workflow-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("workflow-helper", tokens[1]))
+		return -EINVAL;
+	return replace_string(&config->workflow_helper, tokens[1]);
+}
+
+static int add_allowed_workflow(struct hdn_policy_daemon_config *config,
+				char **tokens, unsigned int count,
+				unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-policy-daemon: allow-workflow line %u needs exactly one workflow\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_POLICY_DAEMON_MAX_WORKFLOWS) {
+		fprintf(stderr, "hdn-policy-daemon: too many workflows\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1])) {
+		fprintf(stderr,
+			"hdn-policy-daemon: unsafe workflow name at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	config->workflows[config->count] = strdup(tokens[1]);
+	if (!config->workflows[config->count])
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_policy_daemon_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[2];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-policy-daemon: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "workflow-helper"))
+		return set_workflow_helper(config, tokens, count, lineno);
+	if (!strcmp(tokens[0], "allow-workflow"))
+		return add_allowed_workflow(config, tokens, count, lineno);
+
+	fprintf(stderr,
+		"hdn-policy-daemon: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-policy-daemon: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-policy-daemon: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-policy-daemon: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_policy_daemon_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->workflow_helper,
+			     HDN_POLICY_WORKFLOW_PATH);
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_policy_daemon_config *config)
+{
+	unsigned int i;
+
+	free(config->workflow_helper);
+	for (i = 0; i < config->count; i++)
+		free(config->workflows[i]);
+}
+
+static bool workflow_allowed(const struct hdn_policy_daemon_config *config,
+			     const char *workflow)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->workflows[i], workflow))
+			return true;
+	}
+
+	return false;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_policy_workflow(const char *helper, const char *command,
+			       const char *workflow, bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-policy-daemon: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(helper, "hdn-policy-workflow", "--dry-run",
+			      command, workflow, NULL);
+		else
+			execl(helper, "hdn-policy-workflow", command,
+			      workflow, NULL);
+		fprintf(stderr, "hdn-policy-daemon: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+static int dispatch_workflow(const struct hdn_policy_daemon_config *config,
+			     const char *command, const char *workflow,
+			     bool dry_run)
+{
+	if (!safe_command(command)) {
+		fprintf(stderr,
+			"hdn-policy-daemon: unsafe policy command: %s\n",
+			command ? command : "(null)");
+		return 1;
+	}
+	if (dry_run && strcmp(command, "commit")) {
+		fprintf(stderr,
+			"hdn-policy-daemon: --dry-run is only valid with commit\n");
+		return 1;
+	}
+	if (!safe_name(workflow)) {
+		fprintf(stderr,
+			"hdn-policy-daemon: unsafe workflow name: %s\n",
+			workflow ? workflow : "(null)");
+		return 1;
+	}
+	if (!workflow_allowed(config, workflow)) {
+		fprintf(stderr,
+			"hdn-policy-daemon: workflow is not product-approved: %s\n",
+			workflow);
+		return 1;
+	}
+
+	return run_policy_workflow(config->workflow_helper, command, workflow,
+				   dry_run) ? 1 : 0;
+}
+
+static int run_stdio(const struct hdn_policy_daemon_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	bool failed = false;
+	ssize_t len;
+
+	puts("HDN_POLICY_DAEMON_READY");
+	fflush(stdout);
+
+	while ((len = getline(&line, &size, stdin)) >= 0) {
+		char *tokens[4];
+		unsigned int count = 0;
+		char *save = NULL;
+		char *word;
+		char *request = trim(line);
+		const char *command = NULL;
+		const char *workflow = NULL;
+		bool dry_run = false;
+		int ret;
+
+		(void)len;
+		if (!request[0])
+			continue;
+
+		for (word = strtok_r(request, " \t", &save); word;
+		     word = strtok_r(NULL, " \t", &save)) {
+			if (count < sizeof(tokens) / sizeof(tokens[0]))
+				tokens[count] = word;
+			count++;
+		}
+
+		if (count == 2) {
+			command = tokens[0];
+			workflow = tokens[1];
+		} else if (count == 3 && !strcmp(tokens[0], "dry-run")) {
+			dry_run = true;
+			command = tokens[1];
+			workflow = tokens[2];
+		}
+
+		if (!command || !workflow || !safe_command(command) ||
+		    !safe_name(workflow)) {
+			printf("HDN_POLICY_DAEMON_RESULT command=(invalid) workflow=(invalid) status=invalid exit=1\n");
+			fflush(stdout);
+			failed = true;
+			continue;
+		}
+
+		ret = dispatch_workflow(config, command, workflow, dry_run);
+		printf("HDN_POLICY_DAEMON_RESULT command=%s workflow=%s status=%s exit=%d\n",
+		       command, workflow, ret ? "failed" : "ok", ret ? 1 : 0);
+		fflush(stdout);
+		if (ret)
+			failed = true;
+	}
+
+	free(line);
+	return ferror(stdin) || failed ? 1 : 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_policy_daemon_config config;
+	const char *config_path = HDN_POLICY_DAEMON_CONFIG;
+	const char *command = NULL;
+	const char *workflow = NULL;
+	bool stdio_mode = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--stdio")) {
+			stdio_mode = true;
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!command) {
+			command = argv[i];
+		} else if (!workflow) {
+			workflow = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (stdio_mode && (command || workflow || dry_run)) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (!stdio_mode && (!command || !workflow)) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (require_safe_absolute("config", config_path))
+		return 1;
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	if (stdio_mode)
+		ret = run_stdio(&config);
+	else
+		ret = dispatch_workflow(&config, command, workflow, dry_run);
+
+	free_config(&config);
+	return ret ? 1 : 0;
+}
