+			close(fd);
+
+		if (expect_allowed)
+			_exit(fd >= 0 ? 0 :
+			      saved_errno == ENOSYS ? KSFT_SKIP : 1);
+		_exit(fd >= 0 ? 1 :
+		      saved_errno == ENOSYS ? KSFT_SKIP :
+		      errno_is_denial(saved_errno) ? 0 : 2);
+	}
+
+	if (waitpid(opener, &status, 0) < 0) {
+		kill(target, SIGKILL);
+		waitpid(target, NULL, 0);
+		return 2;
+	}
+
+	kill(target, SIGKILL);
+	waitpid(target, NULL, 0);
+
+	if (!WIFEXITED(status))
+		return 2;
+	return WEXITSTATUS(status);
+}
