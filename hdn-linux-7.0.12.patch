+		kill(target, SIGKILL);
+		waitpid(target, NULL, 0);
+		return 2;
+	}
+
+	if (!reader) {
+		char fdinfo[1024];
+		char nspid_line[64];
+		char pid_line[64];
+		int fd;
+		int ret;
