+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s->pos, "RAP kexec does not match its closed handoff/return protocol");
+	return -1;
+#undef K_BRANCH
+#undef K_LABEL
+#undef K_EDGE
+#undef K_REF
+#undef K_BYTES
