diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/scripts/gcc-plugins/hdn_alloc_plugin.c linux-7.0.12-hdn/scripts/gcc-plugins/hdn_alloc_plugin.c
--- linux-7.0.12/scripts/gcc-plugins/hdn_alloc_plugin.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/scripts/gcc-plugins/hdn_alloc_plugin.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,356 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "gcc-common.h"
+#undef gimple
+#include <string>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+#include "../../include/linux/hdn_alloc_domains.h"
+
+__visible int plugin_is_GPL_compatible;
+static const char *source_root, *profile;
+static int report_fd = -1;
+static unsigned long records;
+static bool module_unit;
+static unsigned int metadata_records;
+
+static void module_record(unsigned long long identity)
+{
+	if (!module_unit)
+		return;
+	char name[64];
+	snprintf(name, sizeof(name), "__hdn_alloc_record_%u", metadata_records++);
+	tree type = build_array_type_nelts(long_long_unsigned_type_node, 3);
+	tree decl = build_decl(UNKNOWN_LOCATION, VAR_DECL, get_identifier(name), type);
+	vec<constructor_elt, va_gc> *values = NULL;
+	CONSTRUCTOR_APPEND_ELT(values, size_int(0), build_int_cstu(long_long_unsigned_type_node, identity));
+	CONSTRUCTOR_APPEND_ELT(values, size_int(1), build_int_cstu(long_long_unsigned_type_node, HDN_ALLOC_MODULE));
+	CONSTRUCTOR_APPEND_ELT(values, size_int(2), build_int_cstu(long_long_unsigned_type_node, 1));
+	DECL_INITIAL(decl) = build_constructor(type, values);
+	TREE_STATIC(decl) = 1;
+	TREE_READONLY(decl) = 1;
+	TREE_USED(decl) = 1;
+	DECL_PRESERVE_P(decl) = 1;
+	DECL_ARTIFICIAL(decl) = 1;
+	SET_DECL_ALIGN(decl, 64);
+	DECL_USER_ALIGN(decl) = 1;
+	set_decl_section_name(decl, ".hdn.alloc");
+	varpool_add_new_variable(decl);
+}
+
+static void start_unit(void *, void *)
+{
+	/* Even a unit without typed sites declares the metadata ABI. */
+	module_record(0);
+}
+
+static const char *decl_name(tree decl)
+{
+	return decl && DECL_NAME(decl) ? IDENTIFIER_POINTER(DECL_NAME(decl)) : "<anonymous>";
+}
+
+static const char *relative_path(const char *path)
+{
+	if (!path)
+		return "<unknown>";
+	size_t n = strlen(source_root);
+	if (!strncmp(path, source_root, n) && path[n] == '/')
+		return path + n + 1;
+	while (path[0] == '.' && path[1] == '/')
+		path += 2;
+	return path;
+}
+
+static const char *type_name(tree type)
+{
+	tree name = TYPE_NAME(TYPE_MAIN_VARIANT(type));
+	if (!name)
+		return "<anonymous>";
+	return TREE_CODE(name) == IDENTIFIER_NODE ? IDENTIFIER_POINTER(name) : decl_name(name);
+}
+
+static void nominal(std::string &out, tree type)
+{
+	out += type_name(type);
+	tree stub = TYPE_STUB_DECL(type);
+	if (stub && DECL_SOURCE_LOCATION(stub) != UNKNOWN_LOCATION) {
+		expanded_location loc = expand_location(DECL_SOURCE_LOCATION(stub));
+		out += '@';
+		out += relative_path(loc.file);
+		out += ':' + std::to_string(loc.line);
+	}
+}
+
+/* Nominal pointer targets do not recursively expand the entire kernel graph.
+ * By-value layout, field types, signedness, qualifiers and bounds are complete.
+ * Typedef aliases normalize to the same main variant. No runtime address enters
+ * the identity. A nonconstant or oversized by-value graph fails compilation.
+ */
+static bool describe(std::string &out, tree type, unsigned int depth = 0)
+{
+	if (!type || depth > 64 || out.size() > 262144)
+		return false;
+	out += '(' + std::to_string(TREE_CODE(type)) + ',' + std::to_string(TYPE_QUALS(type));
+	type = TYPE_MAIN_VARIANT(type);
+	out += ',' + std::to_string(TYPE_ALIGN(type)) + ',';
+	tree size = TYPE_SIZE(type);
+	if (size && tree_fits_uhwi_p(size))
+		out += std::to_string(tree_to_uhwi(size));
+	else if (size)
+		return false;
+	else
+		out += "incomplete";
+	switch (TREE_CODE(type)) {
+	case RECORD_TYPE:
+	case UNION_TYPE:
+		nominal(out, type);
+		for (tree field = TYPE_FIELDS(type); field; field = DECL_CHAIN(field)) {
+			if (TREE_CODE(field) != FIELD_DECL)
+				continue;
+			out += '[';
+			out += decl_name(field);
+			if (!DECL_FIELD_OFFSET(field) || !tree_fits_uhwi_p(DECL_FIELD_OFFSET(field)) ||
+			    !DECL_FIELD_BIT_OFFSET(field) || !tree_fits_uhwi_p(DECL_FIELD_BIT_OFFSET(field)))
+				return false;
+			out += ':' + std::to_string(tree_to_uhwi(DECL_FIELD_OFFSET(field)));
+			out += ':' + std::to_string(tree_to_uhwi(DECL_FIELD_BIT_OFFSET(field)));
+			if (DECL_SIZE(field) && tree_fits_uhwi_p(DECL_SIZE(field)))
+				out += ':' + std::to_string(tree_to_uhwi(DECL_SIZE(field)));
+			if (!describe(out, TREE_TYPE(field), depth + 1))
+				return false;
+			out += ']';
+		}
+		break;
+	case POINTER_TYPE:
+	case REFERENCE_TYPE: {
+		tree target = TREE_TYPE(type);
+		out += '*' + std::to_string(TYPE_QUALS(target));
+		target = TYPE_MAIN_VARIANT(target);
+		if (TREE_CODE(target) == RECORD_TYPE || TREE_CODE(target) == UNION_TYPE)
+			nominal(out, target);
+		else if (!describe(out, target, depth + 1))
+			return false;
+		break;
+	}
+	case ARRAY_TYPE:
+		if (!describe(out, TREE_TYPE(type), depth + 1))
+			return false;
+		break;
+	case FUNCTION_TYPE:
+		if (!describe(out, TREE_TYPE(type), depth + 1))
+			return false;
+		for (tree arg = TYPE_ARG_TYPES(type); arg; arg = TREE_CHAIN(arg))
+			if (!describe(out, TREE_VALUE(arg), depth + 1))
+				return false;
+		out += TYPE_ARG_TYPES(type) ? ";prototype" : ";unprototyped";
+		break;
+	case INTEGER_TYPE:
+	case ENUMERAL_TYPE:
+	case BOOLEAN_TYPE:
+		out += TYPE_UNSIGNED(type) ? 'u' : 's';
+		out += std::to_string(TYPE_PRECISION(type));
+		if (TREE_CODE(type) == ENUMERAL_TYPE)
+			nominal(out, type);
+		break;
+	case REAL_TYPE:
+	case COMPLEX_TYPE:
+	case VECTOR_TYPE:
+		out += std::to_string(TYPE_PRECISION(type));
+		if (TREE_CODE(type) != REAL_TYPE && !describe(out, TREE_TYPE(type), depth + 1))
+			return false;
+		break;
+	case VOID_TYPE:
+		break;
+	default:
+		return false;
+	}
+	out += ')';
+	return true;
+}
+
+static unsigned int domain_for(tree type)
+{
+	tree stub;
+	expanded_location location;
+	const char *definition;
+
+	if (TREE_CODE(type) != RECORD_TYPE)
+		return HDN_ALLOC_ORDINARY;
+	stub = TYPE_STUB_DECL(type);
+	if (!stub || DECL_SOURCE_LOCATION(stub) == UNKNOWN_LOCATION)
+		return HDN_ALLOC_ORDINARY;
+	location = expand_location(DECL_SOURCE_LOCATION(stub));
+	definition = relative_path(location.file);
+#define HDN_MATCH_DOMAIN(name, domain, source) \
+	if (!strcmp(type_name(type), #name) && !strcmp(definition, source)) \
+		return HDN_ALLOC_##domain;
+	HDN_ALLOC_TYPE_DOMAINS(HDN_MATCH_DOMAIN)
+#undef HDN_MATCH_DOMAIN
+	return HDN_ALLOC_ORDINARY;
+}
+
+static void quoted(FILE *out, const char *value)
+{
+	fputc('"', out);
+	for (const unsigned char *p = (const unsigned char *)value; *p; p++) {
+		if (*p == '"' || *p == '\\')
+			fprintf(out, "\\%c", *p);
+		else if (*p < 32)
+			fprintf(out, "\\u%04x", *p);
+		else
+			fputc(*p, out);
+	}
+	fputc('"', out);
+}
+
+static void emit(const char *kind, location_t loc, const char *callee,
+		 const std::string &canonical, unsigned long long identity, unsigned int domain)
+{
+	char *buffer = NULL;
+	size_t size = 0, done = 0;
+	expanded_location place = expand_location(loc);
+	FILE *out = open_memstream(&buffer, &size);
+	if (!out) {
+		error(G_("cannot allocate HDN allocation report"));
+		return;
+	}
+	fputs("{\"schema_version\":1,\"kind\":", out); quoted(out, kind);
+	fputs(",\"unit\":", out); quoted(out, relative_path(main_input_filename));
+	fputs(",\"profile\":", out); quoted(out, profile);
+	fputs(",\"file\":", out); quoted(out, relative_path(place.file));
+	fprintf(out, ",\"line\":%d,\"column\":%d,\"function\":", place.line, place.column);
+	quoted(out, current_function_decl ? decl_name(current_function_decl) : "<unit>");
+	fputs(",\"callee\":", out); quoted(out, callee);
+	fprintf(out, ",\"identity\":\"%016llx\",\"domain\":%u,\"canonical\":", identity, domain);
+	quoted(out, canonical.c_str());
+	fprintf(out, ",\"records\":%lu,\"errors\":%d}\n", records, errorcount);
+	fclose(out);
+	while (flock(report_fd, LOCK_EX)) {
+		if (errno == EINTR)
+			continue;
+		error(G_("cannot lock HDN allocation report"));
+		free(buffer);
+		return;
+	}
+	while (done < size) {
+		ssize_t n = write(report_fd, buffer + done, size - done);
+		if (n > 0)
+			done += n;
+		else if (n < 0 && errno == EINTR)
+			continue;
+		else {
+			error(G_("cannot write HDN allocation report"));
+			break;
+		}
+	}
+	if (flock(report_fd, LOCK_UN))
+		error(G_("cannot unlock HDN allocation report"));
+	free(buffer);
+	records++;
+}
+
+static bool allocation_callee(const char *callee)
+{
+	return strstr(callee, "kmalloc") || strstr(callee, "kvmalloc") ||
+	       strstr(callee, "krealloc") || strstr(callee, "kvrealloc") ||
+	       strstr(callee, "kmem_cache_alloc") ||
+	       strstr(callee, "kmem_buckets_alloc");
+}
+
+static unsigned int hdn_alloc_execute(void)
+{
+	basic_block block;
+	FOR_EACH_BB_FN(block, cfun) {
+		for (gimple_stmt_iterator gsi = gsi_start_bb(block); !gsi_end_p(gsi); gsi_next(&gsi)) {
+			gimple *stmt = gsi_stmt(gsi);
+			if (!is_gimple_call(stmt) || !gimple_call_fndecl(stmt))
+				continue;
+			const char *callee = decl_name(gimple_call_fndecl(stmt));
+			if (!strcmp(callee, "__hdn_alloc_typed") &&
+			    strcmp(relative_path(main_input_filename), "security/hardening/autoslab_test.c")) {
+				error_at(gimple_location(stmt), G_("HDN allocation runtime entry requires compiler metadata"));
+				continue;
+			}
+			if (strcmp(callee, "__hdn_alloc_marker")) {
+				if (allocation_callee(callee))
+					emit("unclassified-allocation", gimple_location(stmt), callee, "", 0, 0);
+				continue;
+			}
+			if (gimple_call_num_args(stmt) != 5 ||
+			    TREE_CODE(TREE_TYPE(gimple_call_arg(stmt, 4))) != POINTER_TYPE) {
+				error_at(gimple_location(stmt), G_("invalid HDN typed allocation marker"));
+				continue;
+			}
+			tree type = TREE_TYPE(TREE_TYPE(gimple_call_arg(stmt, 4)));
+			std::string canonical = "hdn-allocation-type-v1:";
+			if (!COMPLETE_TYPE_P(type) || !describe(canonical, type)) {
+				error_at(gimple_location(stmt), G_("HDN allocation type is incomplete or not representable"));
+				continue;
+			}
+			/* Identity is a deterministic tier selector, never an authorization secret.
+			 * The report retains the full canonical type for collision checking. */
+			unsigned long long identity = 14695981039346656037ULL;
+			for (unsigned char byte : canonical)
+				identity = (identity ^ byte) * 1099511628211ULL;
+			if (!identity)
+				identity = 1;
+			unsigned int domain = module_unit ? HDN_ALLOC_MODULE : domain_for(TYPE_MAIN_VARIANT(type));
+			module_record(identity);
+			tree fn_type = build_function_type_list(ptr_type_node, size_type_node,
+				unsigned_type_node, integer_type_node, unsigned_type_node,
+				long_long_unsigned_type_node, unsigned_type_node, NULL_TREE);
+			tree fn = build_fn_decl("__hdn_alloc_typed", fn_type);
+			TREE_PUBLIC(fn) = 1;
+			DECL_EXTERNAL(fn) = 1;
+			gcall *replacement = gimple_build_call(fn, 6,
+				gimple_call_arg(stmt, 0), gimple_call_arg(stmt, 1),
+				gimple_call_arg(stmt, 2), gimple_call_arg(stmt, 3),
+				build_int_cstu(long_long_unsigned_type_node, identity),
+				build_int_cstu(unsigned_type_node, domain));
+			gimple_call_set_lhs(replacement, gimple_call_lhs(stmt));
+			gimple_set_location(replacement, gimple_location(stmt));
+			emit("typed-allocation", gimple_location(stmt), callee, canonical, identity, domain);
+			gsi_replace(&gsi, replacement, true);
+		}
+	}
+	return TODO_update_ssa;
+}
+
+#define PASS_NAME hdn_alloc
+#define PROPERTIES_REQUIRED PROP_ssa
+#define NO_GATE
+#include "gcc-generate-gimple-pass.h"
+
+static void finish(void *, void *)
+{
+	emit("unit", UNKNOWN_LOCATION, "", "", 0, 0);
+	close(report_fd);
+}
+
+__visible int plugin_init(struct plugin_name_args *info, struct plugin_gcc_version *version)
+{
+	const char *report = NULL;
+	if (!plugin_default_version_check(version, &gcc_version))
+		return 1;
+	for (int i = 0; i < info->argc; i++) {
+		const char *key = info->argv[i].key, *value = info->argv[i].value;
+		if (!value || !*value)
+			return 1;
+		if (!strcmp(key, "report")) report = value;
+		else if (!strcmp(key, "source-root")) source_root = value;
+		else if (!strcmp(key, "profile")) profile = value;
+		else if (!strcmp(key, "module") && !strcmp(value, "1")) module_unit = true;
+		else return 1;
+	}
+	if (!report || !source_root || !profile)
+		return 1;
+	report_fd = open(report, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC, 0600);
+	if (report_fd < 0)
+		return 1;
+	PASS_INFO(hdn_alloc, "ssa", 1, PASS_POS_INSERT_AFTER);
+	register_callback(info->base_name, PLUGIN_PASS_MANAGER_SETUP, NULL, &hdn_alloc_pass_info);
+	register_callback(info->base_name, PLUGIN_FINISH, finish, NULL);
+	register_callback(info->base_name, PLUGIN_START_UNIT, start_unit, NULL);
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/scripts/gcc-plugins/hdn_latent_entropy_plugin.c linux-7.0.12-hdn/scripts/gcc-plugins/hdn_latent_entropy_plugin.c
--- linux-7.0.12/scripts/gcc-plugins/hdn_latent_entropy_plugin.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/scripts/gcc-plugins/hdn_latent_entropy_plugin.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Closed-site, defined-arithmetic control-flow diversity, with zero credit. */
+#include "gcc-common.h"
+#undef gimple
+
+__visible int plugin_is_GPL_compatible;
+static const char *source_root;
+static bool test_sites;
+
+struct hdn_latent_site {
+	const char *file;
+	const char *function;
+	unsigned int id;
+};
+
+static const struct hdn_latent_site sites[] = {
+	{ "drivers/char/random.c", "random_init", 0 },
+	{ "kernel/fork.c", "copy_process", 1 },
+	{ "drivers/char/random.c", "add_interrupt_randomness", 2 },
+};
+
+static int current_site(void)
+{
+	const char *file = DECL_SOURCE_FILE(current_function_decl);
+	const char *name = IDENTIFIER_POINTER(DECL_NAME(current_function_decl));
+	size_t n = strlen(source_root);
+
+	if (!file)
+		return -1;
+	if (!strncmp(file, source_root, n) && file[n] == '/')
+		file += n + 1;
+	while (file[0] == '.' && file[1] == '/')
+		file += 2;
+	for (unsigned int i = 0; i < ARRAY_SIZE(sites); i++)
+		if (!strcmp(file, sites[i].file) && !strcmp(name, sites[i].function))
+			return sites[i].id;
+	if (test_sites && !strcmp(file, "security/hardening/latent_entropy_test.c") &&
+	    !strcmp(name, "hdn_latent_fixture"))
+		return 3;
+	return -1;
+}
+
+static bool hdn_latent_entropy_gate(void)
+{
+	return current_site() >= 0 && !TREE_THIS_VOLATILE(current_function_decl);
+}
+
+static unsigned int hdn_latent_entropy_execute(void)
+{
+	unsigned int site = current_site();
+	tree state = create_tmp_var(long_unsigned_type_node, "hdn_latent_trace");
+	tree type = build_function_type_list(void_type_node, long_unsigned_type_node,
+					    unsigned_type_node, NULL_TREE);
+	tree collector = build_fn_decl("hdn_latent_mix", type);
+	unsigned HOST_WIDE_INT domain = 0x9e3779b97f4a7c15ULL ^ site;
+	basic_block entry, bb;
+	gimple_stmt_iterator it;
+
+	/* Keep the binary site boundary auditable after interprocedural passes. */
+	DECL_UNINLINABLE(current_function_decl) = 1;
+	DECL_ATTRIBUTES(current_function_decl) = tree_cons(get_identifier("noclone"),
+		NULL_TREE, DECL_ATTRIBUTES(current_function_decl));
+	DECL_EXTERNAL(collector) = 1;
+	TREE_PUBLIC(collector) = 1;
+	TREE_NOTHROW(collector) = 1;
+	/* A dedicated entry block prevents loop backedges from reinitializing. */
+	entry = split_edge(single_succ_edge(ENTRY_BLOCK_PTR_FOR_FN(cfun)));
+	it = gsi_after_labels(entry);
+	gsi_insert_before(&it, gimple_build_assign(state,
+		build_int_cstu(long_unsigned_type_node, domain)), GSI_NEW_STMT);
+
+	FOR_EACH_BB_FN(bb, cfun) {
+		if (bb == entry)
+			continue;
+		it = gsi_after_labels(bb);
+		/* No memory reads, divisions, shifts, or signed overflow. */
+		tree salt = build_int_cstu(long_unsigned_type_node,
+					 domain ^ ((unsigned HOST_WIDE_INT)bb->index * 0x100000001b3ULL));
+		gsi_insert_before(&it, gimple_build_assign(state, PLUS_EXPR, state, salt), GSI_NEW_STMT);
+		for (it = gsi_start_bb(bb); !gsi_end_p(it); gsi_next(&it)) {
+			if (gimple_code(gsi_stmt(it)) == GIMPLE_RETURN) {
+				gcall *call = gimple_build_call(collector, 2, state,
+					build_int_cstu(unsigned_type_node, site));
+
+				gimple_set_location(call, gimple_location(gsi_stmt(it)));
+				gsi_insert_before(&it, call, GSI_SAME_STMT);
+			}
+		}
+	}
+	return 0;
+}
+
+#define PASS_NAME hdn_latent_entropy
+#define PROPERTIES_REQUIRED PROP_cfg
+#include "gcc-generate-gimple-pass.h"
+
+__visible int plugin_init(struct plugin_name_args *info, struct plugin_gcc_version *version)
+{
+	if (!plugin_default_version_check(version, &gcc_version)) {
+		error(G_("incompatible gcc/plugin versions"));
+		return 1;
+	}
+	for (int i = 0; i < info->argc; i++) {
+		if (!strcmp(info->argv[i].key, "source-root") && info->argv[i].value)
+			source_root = info->argv[i].value;
+		else if (!strcmp(info->argv[i].key, "test-sites") && !info->argv[i].value)
+			test_sites = true;
+		else {
+			error(G_("unknown HDN latent-mixing option"));
+			return 1;
+		}
+	}
+	if (!source_root || !*source_root) {
+		error(G_("HDN latent mixing requires source-root"));
+		return 1;
+	}
+	PASS_INFO(hdn_latent_entropy, "cfg", 1, PASS_POS_INSERT_AFTER);
+	register_callback(info->base_name, PLUGIN_PASS_MANAGER_SETUP, NULL, &hdn_latent_entropy_pass_info);
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/scripts/gcc-plugins/hdn_lifetime_plugin.c linux-7.0.12-hdn/scripts/gcc-plugins/hdn_lifetime_plugin.c
--- linux-7.0.12/scripts/gcc-plugins/hdn_lifetime_plugin.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/scripts/gcc-plugins/hdn_lifetime_plugin.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Source lifetime evidence, before optimization removes reads and writes. */
+#include "gcc-common.h"
+#undef gimple
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+__visible int plugin_is_GPL_compatible;
+static const char *source_root, *profile;
+static int report_fd = -1;
+static unsigned long records;
+
+static const char *name(tree decl)
+{
+	return decl && DECL_NAME(decl) ? IDENTIFIER_POINTER(DECL_NAME(decl)) : "<anonymous>";
+}
+
+static const char *json_boolean(bool value)
+{
+	if (value)
+		return "true";
+	return "false";
+}
+
+static const char *relative_file(const char *file)
+{
+	if (!file)
+		return "<unknown>";
+	size_t n = strlen(source_root);
+	if (!strncmp(file, source_root, n) && file[n] == '/')
+		return file + n + 1;
+	while (file[0] == '.' && file[1] == '/')
+		file += 2;
+	return file;
+}
+
+static void quoted(FILE *out, const char *value)
+{
+	fputc('"', out);
+	for (const unsigned char *p = (const unsigned char *)value; *p; p++) {
+		if (*p == '"' || *p == '\\')
+			fprintf(out, "\\%c", *p);
+		else if (*p < 0x20)
+			fprintf(out, "\\u%04x", *p);
+		else
+			fputc(*p, out);
+	}
+	fputc('"', out);
+}
+
+static void field(FILE *out, const char *key, const char *value)
+{
+	fprintf(out, ",\"%s\":", key);
+	quoted(out, value);
+}
+
+static void type_field(FILE *out, tree type)
+{
+	char *buffer = NULL;
+	size_t len = 0;
+	FILE *text = open_memstream(&buffer, &len);
+
+	if (!text) {
+		error(G_("cannot allocate HDN lifetime type record"));
+		return;
+	}
+	print_generic_expr(text, type, TDF_SLIM);
+	if (fclose(text))
+		error(G_("cannot finish HDN lifetime type record"));
+	else
+		field(out, "type", buffer);
+	free(buffer);
+}
+
+static const char *decl_section(tree decl)
+{
+	const char *s = decl ? DECL_SECTION_NAME(decl) : NULL;
+	return s ? s : "<default>";
+}
+
+static bool dispatch_type(tree type, unsigned int depth = 0)
+{
+	if (!type || depth > 32)
+		return false;
+	if (TREE_CODE(type) == POINTER_TYPE)
+		return TREE_CODE(TREE_TYPE(type)) == FUNCTION_TYPE;
+	if (TREE_CODE(type) == ARRAY_TYPE)
+		return dispatch_type(TREE_TYPE(type), depth + 1);
+	if (TREE_CODE(type) == RECORD_TYPE || TREE_CODE(type) == UNION_TYPE)
+		for (tree f = TYPE_FIELDS(type); f; f = DECL_CHAIN(f))
+			if (TREE_CODE(f) == FIELD_DECL && dispatch_type(TREE_TYPE(f), depth + 1))
+				return true;
+	return false;
+}
+
+static void append(char *buffer, size_t len)
+{
+	size_t done = 0;
+	int saved = 0;
+
+	while (flock(report_fd, LOCK_EX))
+		if (errno != EINTR) {
+			error(G_("cannot lock HDN lifetime report: %s"), xstrerror(errno));
+			free(buffer);
+			return;
+		}
+	while (done < len) {
+		ssize_t n = write(report_fd, buffer + done, len - done);
+		if (n > 0)
+			done += n;
+		else if (n < 0 && errno == EINTR)
+			continue;
+		else {
+			saved = n < 0 ? errno : EIO;
+			break;
+		}
+	}
+	if (flock(report_fd, LOCK_UN) && !saved)
+		saved = errno;
+	free(buffer);
+	if (saved)
+		error(G_("cannot write HDN lifetime report: %s"), xstrerror(saved));
+}
+
+static void emit(const char *kind, tree target, tree caller, location_t loc)
+{
+	char *buffer = NULL;
+	size_t len = 0;
+	FILE *out = open_memstream(&buffer, &len);
+
+	if (!out) {
+		error(G_("cannot allocate HDN lifetime record"));
+		return;
+	}
+	fputs("{\"schema_version\":1,\"analyzer_version\":\"2.0.0\"", out);
+	field(out, "kind", kind);
+	field(out, "unit", relative_file(main_input_filename));
+	field(out, "profile", profile);
+	field(out, "file", relative_file(LOCATION_FILE(loc)));
+	fprintf(out, ",\"line\":%d,\"column\":%d", LOCATION_LINE(loc), LOCATION_COLUMN(loc));
+	field(out, "caller", caller ? name(caller) : "<initializer>");
+	field(out, "caller_section", decl_section(caller));
+	if (target) {
+		type_field(out, TREE_TYPE(target));
+		field(out, "symbol", name(target));
+		field(out, "symbol_section", decl_section(target));
+		field(out, "symbol_file", relative_file(DECL_SOURCE_FILE(target)));
+		field(out, "symbol_context", DECL_CONTEXT(target) &&
+		      TREE_CODE(DECL_CONTEXT(target)) == FUNCTION_DECL ? name(DECL_CONTEXT(target)) : "");
+		field(out, "symbol_asm", DECL_ASSEMBLER_NAME_SET_P(target) ?
+		      IDENTIFIER_POINTER(DECL_ASSEMBLER_NAME(target)) : name(target));
+		fprintf(out, ",\"symbol_line\":%d,\"public\":%s,\"readonly\":%s,\"dispatch\":%s",
+			DECL_SOURCE_LINE(target), json_boolean(TREE_PUBLIC(target)),
+			json_boolean(TREE_READONLY(target)),
+			json_boolean(dispatch_type(TREE_TYPE(target))));
+	}
+	if (!strcmp(kind, "unit"))
+		fprintf(out, ",\"records\":%lu,\"compiler_errors\":%d", records, errorcount);
+	fputs("}\n", out);
+	if (fclose(out)) {
+		free(buffer);
+		error(G_("cannot finish HDN lifetime record"));
+		return;
+	}
+	append(buffer, len);
+	records++;
+}
+
+struct walk_context {
+	const char *kind;
+	tree caller;
+	location_t location;
+};
+
+/* Resolve local SSA address copies without pretending an unknown alias is safe. */
+static bool pointer_targets_impl(tree value, struct walk_context *ctx,
+				 auto_vec<tree, 32> &visited, unsigned int depth)
+{
+	if (!value || depth > 32 || visited.length() >= 256)
+		return false;
+	for (unsigned int i = 0; i < visited.length(); i++)
+		if (visited[i] == value)
+			return false;
+	visited.safe_push(value);
+	if (TREE_CODE(value) == ADDR_EXPR) {
+		tree base = get_base_address(TREE_OPERAND(value, 0));
+		if (base && (TREE_CODE(base) == FUNCTION_DECL ||
+		    (TREE_CODE(base) == VAR_DECL && (TREE_STATIC(base) || DECL_EXTERNAL(base))))) {
+			emit(ctx->kind, base, ctx->caller, ctx->location);
+			return true;
+		}
+		/* A local object's address is resolved but is outside static inventory. */
+		return base && TREE_CODE(base) == VAR_DECL;
+	}
+	if (TREE_CODE(value) != SSA_NAME || SSA_NAME_IS_DEFAULT_DEF(value))
+		return false;
+	gimple *def = SSA_NAME_DEF_STMT(value);
+	if (!def)
+		return false;
+	if (is_gimple_assign(def)) {
+		enum tree_code code = gimple_assign_rhs_code(def);
+		if (code == ADDR_EXPR || code == SSA_NAME || code == POINTER_PLUS_EXPR ||
+		    code == NOP_EXPR || code == CONVERT_EXPR)
+			return pointer_targets_impl(gimple_assign_rhs1(def), ctx, visited, depth + 1);
+	} else if (gimple_code(def) == GIMPLE_PHI) {
+		bool resolved = true;
+		for (unsigned int i = 0; i < gimple_phi_num_args(def); i++)
+			resolved &= pointer_targets_impl(gimple_phi_arg_def(def, i), ctx, visited, depth + 1);
+		return resolved;
+	}
+	return false;
+}
+
+static bool pointer_targets(tree value, struct walk_context *ctx)
+{
+	auto_vec<tree, 32> visited;
+	return pointer_targets_impl(value, ctx, visited, 0);
+}
+
+static tree visit(tree *node, int *walk_subtrees, void *data)
+{
+	struct walk_context *ctx = (struct walk_context *)data;
+	tree t = *node;
+
+	if (!t)
+		return NULL_TREE;
+	if (TREE_CODE(t) == MEM_REF || TREE_CODE(t) == TARGET_MEM_REF) {
+		if (!pointer_targets(TREE_OPERAND(t, 0), ctx))
+			emit(!strcmp(ctx->kind, "read") ? "indirect-read" : "indirect-reference",
+			     NULL_TREE, ctx->caller, ctx->location);
+		*walk_subtrees = 0;
+	} else if (TREE_CODE(t) == ADDR_EXPR) {
+		struct walk_context address = {
+			!strcmp(ctx->kind, "initializer-reference") ? "initializer-reference" : "address",
+			ctx->caller, ctx->location
+		};
+		tree value = TREE_OPERAND(t, 0);
+		walk_tree_without_duplicates(&value, visit, &address);
+		*walk_subtrees = 0;
+	} else if (TREE_CODE(t) == VAR_DECL || TREE_CODE(t) == FUNCTION_DECL) {
+		if (TREE_CODE(t) == FUNCTION_DECL || TREE_STATIC(t) || DECL_EXTERNAL(t))
+			emit(ctx->kind, t, ctx->caller, ctx->location);
+		*walk_subtrees = 0; /* Do not recursively visit a declaration's initializer. */
+	} else if (TREE_CODE(t) == SSA_NAME) {
+		if (POINTER_TYPE_P(TREE_TYPE(t)) && !pointer_targets(t, ctx))
+			emit("indirect-reference", NULL_TREE, ctx->caller, ctx->location);
+		*walk_subtrees = 0;
+	} else if (TYPE_P(t)) {
+		*walk_subtrees = 0;
+	}
+	return NULL_TREE;
+}
+
+static void operand(tree value, const char *kind, tree caller, location_t loc)
+{
+	if (!value)
+		return;
+	struct walk_context ctx = { kind, caller, loc };
+	if (!strcmp(kind, "write")) {
+		tree base = get_base_address(value);
+		if (!base || TREE_CODE(base) == SSA_NAME)
+			return;
+		if (TREE_CODE(base) == MEM_REF || TREE_CODE(base) == TARGET_MEM_REF) {
+			if (!pointer_targets(TREE_OPERAND(base, 0), &ctx))
+				emit("indirect-write", NULL_TREE, caller, loc);
+			return;
+		}
+		/* Array indices are reads, not writes to the index variable. */
+		value = base;
+	}
+	walk_tree_without_duplicates(&value, visit, &ctx);
+}
+
+static void declaration(void *gcc_data, void *)
+{
+	tree decl = (tree)gcc_data;
+	if (TREE_CODE(decl) != VAR_DECL || !TREE_STATIC(decl) || DECL_EXTERNAL(decl))
+		return;
+	emit("object", decl, NULL_TREE, DECL_SOURCE_LOCATION(decl));
+	/* Initializer references are distinct from runtime address escapes. */
+	operand(DECL_INITIAL(decl), "initializer-reference", decl, DECL_SOURCE_LOCATION(decl));
+}
+
+static unsigned int hdn_lifetime_execute(void)
+{
+	basic_block bb;
+	tree caller = current_function_decl;
+	emit("function", caller, caller, DECL_SOURCE_LOCATION(caller));
+	FOR_EACH_BB_FN(bb, cfun) {
+		for (gimple_stmt_iterator gsi = gsi_start_bb(bb); !gsi_end_p(gsi); gsi_next(&gsi)) {
+			gimple *stmt = gsi_stmt(gsi);
+			location_t loc = gimple_location(stmt);
+			if (loc == UNKNOWN_LOCATION)
+				loc = DECL_SOURCE_LOCATION(caller);
+			if (is_gimple_assign(stmt)) {
+				tree lhs = gimple_assign_lhs(stmt);
+				operand(lhs, "write", caller, loc);
+				for (unsigned int i = 1; i < gimple_num_ops(stmt); i++)
+					operand(gimple_op(stmt, i), "read", caller, loc);
+			} else if (is_gimple_call(stmt)) {
+				tree callee = gimple_call_fndecl(stmt);
+				emit(callee ? "call" : "indirect-call", callee, caller, loc);
+				for (unsigned int i = 0; i < gimple_call_num_args(stmt); i++)
+					operand(gimple_call_arg(stmt, i), "call-argument", caller, loc);
+				operand(gimple_call_lhs(stmt), "write", caller, loc);
+			} else {
+				if (gimple_code(stmt) == GIMPLE_ASM)
+					emit("assembly", NULL_TREE, caller, loc);
+				for (unsigned int i = 0; i < gimple_num_ops(stmt); i++)
+					operand(gimple_op(stmt, i), "reference", caller, loc);
+			}
+		}
+	}
+	return 0;
+}
+
+#define PASS_NAME hdn_lifetime
+#define PROPERTIES_REQUIRED PROP_ssa
+#define NO_GATE
+#include "gcc-generate-gimple-pass.h"
+
+static void finish(void *, void *)
+{
+	emit("unit", NULL_TREE, NULL_TREE, UNKNOWN_LOCATION);
+	close(report_fd);
+}
+
+__visible int plugin_init(struct plugin_name_args *info, struct plugin_gcc_version *version)
+{
+	const char *report = NULL;
+	if (!plugin_default_version_check(version, &gcc_version))
+		return 1;
+	for (int i = 0; i < info->argc; i++) {
+		const char *key = info->argv[i].key, *value = info->argv[i].value;
+		if (!value || !*value)
+			return 1;
+		if (!strcmp(key, "report"))
+			report = value;
+		else if (!strcmp(key, "source-root"))
+			source_root = value;
+		else if (!strcmp(key, "profile"))
+			profile = value;
+		else
+			return 1;
+	}
+	if (!report || !source_root || !profile) {
+		error(G_("HDN lifetime analysis requires report, source-root and profile"));
+		return 1;
+	}
+	report_fd = open(report, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if (report_fd < 0) {
+		error(G_("cannot open HDN lifetime report: %s"), xstrerror(errno));
+		return 1;
+	}
+	PASS_INFO(hdn_lifetime, "ssa", 1, PASS_POS_INSERT_AFTER);
+	register_callback(info->base_name, PLUGIN_FINISH_DECL, declaration, NULL);
+	register_callback(info->base_name, PLUGIN_PASS_MANAGER_SETUP, NULL, &hdn_lifetime_pass_info);
+	register_callback(info->base_name, PLUGIN_FINISH, finish, NULL);
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/scripts/gcc-plugins/hdn_null_analysis_plugin.c linux-7.0.12-hdn/scripts/gcc-plugins/hdn_null_analysis_plugin.c
--- linux-7.0.12/scripts/gcc-plugins/hdn_null_analysis_plugin.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/scripts/gcc-plugins/hdn_null_analysis_plugin.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,1007 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HDN optimized null-dereference reporting pass.
+ *
+ * This pass never transforms generated code. It runs after the optimizing
+ * GIMPLE passes, combines GCC's statement-sensitive ranges with explicit
+ * dominance checks, and emits one bounded JSON record per finding. Policy
+ * decisions, suppressions, and cross-tool correlation live outside GCC.
+ */
+
+#include "gcc-common.h"
+
+/*
+ * gcc-common.h aliases gimple to a pointer for older in-tree plugins.  GCC's
+ * installed ranger headers are C++ interfaces and must see the native gimple
+ * class name instead.
+ */
+#undef gimple
+#include "gimple-range.h"
+#include "tree-ssa-address.h"
+#include "value-range.h"
+#include "value-query.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+__visible int plugin_is_GPL_compatible;
+
+#define HDN_NULL_SCHEMA_VERSION 1
+#define HDN_NULL_ANALYZER_VERSION "1.0.3"
+#define HDN_NULL_RECORD_MAX 8192
+#define HDN_NULL_PATH_MAX 4096
+#define HDN_NULL_ORIGIN_DEPTH 24
+#define HDN_NULL_GUARD_EDGES_MAX 8
+
+static char report_dir[HDN_NULL_PATH_MAX];
+static char source_root[HDN_NULL_PATH_MAX];
+static char analysis_profile[128] = "unknown";
+static int report_fd = -1;
+static range_query *active_range_query;
+
+struct hdn_guard_set {
+	edge nonnull_edges[HDN_NULL_GUARD_EDGES_MAX];
+	unsigned int count;
+	bool overflow;
+};
+
+static hash_map<tree, hdn_guard_set> *active_guard_cache;
+
+struct hdn_origin {
+	bool explicit_zero;
+	bool parameter;
+	bool nullable_call;
+	bool container_conversion;
+	bool user_influenced;
+	bool root_locked;
+	tree root;
+	const char *callee;
+};
+
+struct hdn_seen {
+	tree pointer;
+	const char *kind;
+	location_t location;
+};
+
+static tree reference_pointer(tree ref);
+static bool reference_has_negative_offset(tree ref);
+static bool already_seen(auto_vec<hdn_seen, 8> *seen, tree pointer,
+			 const char *kind, location_t location);
+static bool seen_before(const auto_vec<hdn_seen, 8> *seen, tree pointer,
+			const char *kind, location_t location);
+
+static struct plugin_info hdn_null_plugin_info = {
+	.version = HDN_NULL_ANALYZER_VERSION,
+	.help = "report-dir=<path>\twrite JSONL findings under path\n"
+		"source-root=<path>\tnormalize source paths relative to path\n"
+		"profile=<name>\trecord the verification profile\n",
+};
+
+static uint64_t fnv1a_update(uint64_t hash, const char *text)
+{
+	const unsigned char *p = (const unsigned char *)text;
+
+	if (!text)
+		return hash;
+	while (*p) {
+		hash ^= *p++;
+		hash *= UINT64_C(1099511628211);
+	}
+	return hash;
+}
+
+static bool copy_option(char *dst, size_t size, const char *value,
+			const char *name)
+{
+	if (!value || !*value) {
+		error(G_("missing value for HDN null-analysis option %qs"), name);
+		return false;
+	}
+	if (strlen(value) >= size) {
+		error(G_("value for HDN null-analysis option %qs is too long"), name);
+		return false;
+	}
+	strcpy(dst, value);
+	return true;
+}
+
+static int mkdir_parents(const char *path)
+{
+	char work[HDN_NULL_PATH_MAX];
+	char *p;
+
+	if (strlen(path) >= sizeof(work))
+		return -ENAMETOOLONG;
+	strcpy(work, path);
+	for (p = work + 1; *p; p++) {
+		if (*p != '/')
+			continue;
+		*p = '\0';
+		if (mkdir(work, 0700) && errno != EEXIST)
+			return -errno;
+		*p = '/';
+	}
+	if (mkdir(work, 0700) && errno != EEXIST)
+		return -errno;
+	return 0;
+}
+
+static bool usable_source_location(location_t loc)
+{
+	const char *file;
+
+	if (loc == UNKNOWN_LOCATION || !LOCATION_LINE(loc))
+		return false;
+	file = LOCATION_FILE(loc);
+	return file && file[0];
+}
+
+static const char *normalized_file(location_t loc)
+{
+	const char *file;
+	size_t root_len;
+
+	if (!usable_source_location(loc))
+		return "<unknown>";
+	file = LOCATION_FILE(loc);
+	root_len = strlen(source_root);
+	if (root_len && !strncmp(file, source_root, root_len) &&
+	    file[root_len] == '/')
+		return file + root_len + 1;
+	while (file[0] == '.' && file[1] == '/')
+		file += 2;
+	return file;
+}
+
+static size_t json_escape(char *dst, size_t cap, const char *src)
+{
+	size_t used = 0;
+
+	if (!src)
+		src = "";
+	while (*src && used + 7 < cap) {
+		unsigned char c = *src++;
+
+		if (c == '"' || c == '\\') {
+			dst[used++] = '\\';
+			dst[used++] = c;
+		} else if (c == '\n') {
+			dst[used++] = '\\';
+			dst[used++] = 'n';
+		} else if (c == '\r') {
+			dst[used++] = '\\';
+			dst[used++] = 'r';
+		} else if (c == '\t') {
+			dst[used++] = '\\';
+			dst[used++] = 't';
+		} else if (c < 0x20) {
+			used += snprintf(dst + used, cap - used, "\\u%04x", c);
+		} else {
+			dst[used++] = c;
+		}
+	}
+	dst[used] = '\0';
+	return used;
+}
+
+static const char *function_name(void)
+{
+	tree name = DECL_NAME(current_function_decl);
+
+	return name ? IDENTIFIER_POINTER(name) : "<anonymous>";
+}
+
+static bool attacker_entry_function(void)
+{
+	tree attrs = DECL_ATTRIBUTES(current_function_decl);
+	const char *name = function_name();
+	static const char * const syscall_prefixes[] = {
+		"__do_sys_", "__se_sys_",
+		"__do_compat_sys_", "__se_compat_sys_",
+	};
+	unsigned int i;
+
+	if (lookup_attribute("hdn_null_attacker_entry", attrs) != NULL_TREE)
+		return true;
+	for (i = 0; i < ARRAY_SIZE(syscall_prefixes); i++)
+		if (!strncmp(name, syscall_prefixes[i],
+			     strlen(syscall_prefixes[i])))
+			return true;
+	return false;
+}
+
+static bool intentional_probe_function(void)
+{
+	return lookup_attribute("hdn_null_probe",
+				DECL_ATTRIBUTES(current_function_decl)) != NULL_TREE;
+}
+
+static void intentional_probe_metadata(const char **owner,
+				       const char **invalidation)
+{
+	tree attr = lookup_attribute("hdn_null_probe",
+				     DECL_ATTRIBUTES(current_function_decl));
+	tree args;
+
+	*owner = "";
+	*invalidation = "";
+	if (!attr)
+		return;
+	args = TREE_VALUE(attr);
+	if (!args || !TREE_CHAIN(args))
+		return;
+	if (TREE_CODE(TREE_VALUE(args)) == STRING_CST)
+		*owner = TREE_STRING_POINTER(TREE_VALUE(args));
+	args = TREE_CHAIN(args);
+	if (TREE_CODE(TREE_VALUE(args)) == STRING_CST)
+		*invalidation = TREE_STRING_POINTER(TREE_VALUE(args));
+}
+
+static bool known_nullable_source(const char *name)
+{
+	static const char * const sources[] = {
+		"alloc", "kmalloc", "kzalloc", "kcalloc", "krealloc",
+		"vmalloc", "vzalloc", "memdup", "strdup", "lookup",
+		"find",
+	};
+	unsigned int i;
+
+	if (!name)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(sources); i++)
+		if (strstr(name, sources[i]))
+			return true;
+	return false;
+}
+
+static bool known_nonnull_return(const char *name)
+{
+	static const char * const functions[] = {
+		"memdup_user", "vmemdup_user", "strndup_user",
+		"memdup_user_nul",
+	};
+	unsigned int i;
+
+	if (!name)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(functions); i++)
+		if (!strcmp(name, functions[i]))
+			return true;
+	return false;
+}
+
+static tree strip_pointer_conversions(tree value)
+{
+	while (value && (CONVERT_EXPR_P(value) ||
+			 TREE_CODE(value) == NON_LVALUE_EXPR ||
+			 TREE_CODE(value) == VIEW_CONVERT_EXPR))
+		value = TREE_OPERAND(value, 0);
+	return value;
+}
+
+static bool constant_is_negative(tree value)
+{
+	return value && TREE_CODE(value) == INTEGER_CST &&
+	       wi::neg_p(wi::to_wide(value), SIGNED);
+}
+
+static void set_origin_root(struct hdn_origin *origin, tree value, bool lock)
+{
+	if (!origin->root)
+		origin->root = value;
+	if (lock)
+		origin->root_locked = true;
+}
+
+static bool origin_already_visited(tree value, auto_vec<tree, 24> *visited)
+{
+	unsigned int i;
+	tree seen;
+
+	FOR_EACH_VEC_ELT(*visited, i, seen) {
+		if (seen == value)
+			return true;
+	}
+	visited->safe_push(value);
+	return false;
+}
+
+static void trace_origin_1(tree value, struct hdn_origin *origin,
+			   unsigned int depth, auto_vec<tree, 24> *visited)
+{
+	gimple *def;
+
+	if (!value || depth > HDN_NULL_ORIGIN_DEPTH)
+		return;
+	value = strip_pointer_conversions(value);
+	if (!value)
+		return;
+
+	if (TREE_CODE(value) == INTEGER_CST) {
+		set_origin_root(origin, value, false);
+		if (integer_zerop(value))
+			origin->explicit_zero = true;
+		return;
+	}
+	if (DECL_P(value)) {
+		set_origin_root(origin, value, false);
+		origin->parameter |= TREE_CODE(value) == PARM_DECL;
+		return;
+	}
+	if (TREE_CODE(value) != SSA_NAME) {
+		tree base = reference_pointer(value);
+
+		if (base && base != value)
+			trace_origin_1(base, origin, depth + 1, visited);
+		return;
+	}
+	if (origin_already_visited(value, visited))
+		return;
+
+	if (SSA_NAME_VAR(value)) {
+		origin->parameter |=
+			TREE_CODE(SSA_NAME_VAR(value)) == PARM_DECL;
+	}
+	if (SSA_NAME_IS_DEFAULT_DEF(value)) {
+		set_origin_root(origin, SSA_NAME_VAR(value) ?
+				SSA_NAME_VAR(value) : value, false);
+		return;
+	}
+
+	def = SSA_NAME_DEF_STMT(value);
+	if (!def)
+		return;
+	if (gimple_code(def) == GIMPLE_PHI) {
+		gphi *phi = as_a<gphi *>(def);
+		unsigned int i;
+
+		set_origin_root(origin, value, true);
+		for (i = 0; i < gimple_phi_num_args(phi); i++)
+			trace_origin_1(gimple_phi_arg_def(phi, i), origin,
+				       depth + 1, visited);
+		return;
+	}
+	if (is_gimple_assign(def)) {
+		tree rhs1 = gimple_assign_rhs1(def);
+		enum tree_code code = gimple_assign_rhs_code(def);
+
+		if (code == POINTER_PLUS_EXPR || code == PLUS_EXPR ||
+		    code == MINUS_EXPR) {
+			tree rhs2 = gimple_assign_rhs2(def);
+
+			if (constant_is_negative(rhs2) ||
+			    (code == MINUS_EXPR && rhs2 &&
+			     TREE_CODE(rhs2) == INTEGER_CST &&
+			     !integer_zerop(rhs2)))
+				origin->container_conversion = true;
+		}
+		trace_origin_1(rhs1, origin, depth + 1, visited);
+		return;
+	}
+	if (is_gimple_call(def)) {
+		tree fndecl = gimple_call_fndecl(def);
+		const char *name = NULL;
+
+		if (!origin->root_locked)
+			set_origin_root(origin, value, false);
+		if (fndecl && DECL_NAME(fndecl))
+			name = IDENTIFIER_POINTER(DECL_NAME(fndecl));
+		origin->callee = name;
+		origin->nullable_call |= known_nullable_source(name);
+	}
+}
+
+static void trace_origin(tree value, struct hdn_origin *origin)
+{
+	auto_vec<tree, 24> visited;
+
+	trace_origin_1(value, origin, 0, &visited);
+}
+
+enum hdn_null_state {
+	HDN_NULL_NONZERO,
+	HDN_NULL_ZERO,
+	HDN_NULL_MAYBE,
+	HDN_NULL_VARYING,
+	HDN_NULL_UNKNOWN,
+};
+
+static enum hdn_null_state pointer_state(tree pointer, gimple *stmt)
+{
+	value_range range(TREE_TYPE(pointer));
+
+	if (!value_range::supports_type_p(TREE_TYPE(pointer)))
+		return HDN_NULL_UNKNOWN;
+	if (!active_range_query->range_of_expr(range, pointer, stmt))
+		return HDN_NULL_UNKNOWN;
+	if (range.undefined_p())
+		return HDN_NULL_NONZERO;
+	if (range.zero_p())
+		return HDN_NULL_ZERO;
+	if (range.nonzero_p())
+		return HDN_NULL_NONZERO;
+	if (range.varying_p())
+		return HDN_NULL_VARYING;
+	return range_includes_zero_p(range) ? HDN_NULL_MAYBE :
+		HDN_NULL_NONZERO;
+}
+
+static bool condition_proves_nonnull(tree value, gimple *stmt)
+{
+	basic_block use_bb = gimple_bb(stmt);
+	struct hdn_guard_set *cached;
+
+	if (!use_bb || TREE_CODE(value) != SSA_NAME || !active_guard_cache)
+		return false;
+	cached = active_guard_cache->get(value);
+	if (!cached) {
+		struct hdn_guard_set found = { };
+		imm_use_iterator iterator;
+		gimple *condition;
+
+		FOR_EACH_IMM_USE_STMT(condition, iterator, value) {
+			basic_block guard_bb;
+		tree lhs;
+		tree rhs;
+		enum tree_code code;
+		edge true_edge;
+		edge false_edge;
+		edge nonnull_edge;
+
+			if (gimple_code(condition) != GIMPLE_COND)
+				continue;
+			guard_bb = gimple_bb(condition);
+			if (!guard_bb)
+				continue;
+		lhs = strip_pointer_conversions(gimple_cond_lhs(condition));
+		rhs = strip_pointer_conversions(gimple_cond_rhs(condition));
+		if (lhs != value && rhs == value) {
+			tree swap = lhs;
+
+			lhs = rhs;
+			rhs = swap;
+		}
+		if (lhs != value || TREE_CODE(rhs) != INTEGER_CST ||
+		    !integer_zerop(rhs))
+			continue;
+		code = gimple_cond_code(condition);
+		if (code != EQ_EXPR && code != NE_EXPR)
+			continue;
+		extract_true_false_edges_from_block(guard_bb, &true_edge,
+					    &false_edge);
+		nonnull_edge = code == NE_EXPR ? true_edge : false_edge;
+			if (!nonnull_edge)
+				continue;
+			if (found.count == HDN_NULL_GUARD_EDGES_MAX) {
+				found.overflow = true;
+				continue;
+			}
+			found.nonnull_edges[found.count++] = nonnull_edge;
+		}
+		active_guard_cache->put(value, found);
+		cached = active_guard_cache->get(value);
+	}
+	for (unsigned int i = 0; i < cached->count; i++)
+		if (dominated_by_p(CDI_DOMINATORS, use_bb,
+				   cached->nonnull_edges[i]->dest))
+			return true;
+	return false;
+}
+
+static bool proven_nonnull_base_1(tree value, gimple *stmt,
+				  unsigned int depth,
+				  auto_vec<tree, 24> *visited,
+				  bool allow_pointer_integer)
+{
+	value_range range;
+	gimple *def;
+	tree type;
+	unsigned int i;
+
+	if (!value || depth > HDN_NULL_ORIGIN_DEPTH)
+		return false;
+	value = strip_pointer_conversions(value);
+	if (!value)
+		return false;
+	type = TREE_TYPE(value);
+	if (!POINTER_TYPE_P(type) &&
+	    !(allow_pointer_integer && INTEGRAL_TYPE_P(type) &&
+	      TYPE_PRECISION(type) >= TYPE_PRECISION(sizetype)))
+		return false;
+	for (i = 0; i < visited->length(); i++)
+		if ((*visited)[i] == value)
+			return true;
+	visited->safe_push(value);
+	if (condition_proves_nonnull(value, stmt))
+		return true;
+	range.set_type(TREE_TYPE(value));
+	if (value_range::supports_type_p(TREE_TYPE(value)) &&
+	    active_range_query->range_of_expr(range, value, stmt) &&
+	    !range.undefined_p() && range.nonzero_p())
+		return true;
+	if (TREE_CODE(value) == INTEGER_CST)
+		return POINTER_TYPE_P(type) && !integer_zerop(value);
+	if (TREE_CODE(value) != SSA_NAME || SSA_NAME_IS_DEFAULT_DEF(value))
+		return false;
+	def = SSA_NAME_DEF_STMT(value);
+	if (!def)
+		return false;
+	if (gimple_code(def) == GIMPLE_PHI) {
+		gphi *phi = as_a<gphi *>(def);
+
+		if (!gimple_phi_num_args(phi))
+			return false;
+		for (i = 0; i < gimple_phi_num_args(phi); i++)
+			if (!proven_nonnull_base_1(gimple_phi_arg_def(phi, i),
+						   stmt, depth + 1, visited,
+						   allow_pointer_integer))
+				return false;
+		return true;
+	}
+	if (is_gimple_assign(def)) {
+		enum tree_code code = gimple_assign_rhs_code(def);
+		tree rhs1 = gimple_assign_rhs1(def);
+		bool next_allow_integer = allow_pointer_integer;
+
+		if (CONVERT_EXPR_CODE_P(code) && rhs1 &&
+		    (INTEGRAL_TYPE_P(type) ||
+		     INTEGRAL_TYPE_P(TREE_TYPE(rhs1))))
+			next_allow_integer = true;
+		if (code == POINTER_PLUS_EXPR || code == PLUS_EXPR ||
+		    code == MINUS_EXPR || CONVERT_EXPR_CODE_P(code))
+			return proven_nonnull_base_1(rhs1, stmt, depth + 1,
+						     visited,
+						     next_allow_integer);
+	}
+	if (is_gimple_call(def)) {
+		tree fndecl = gimple_call_fndecl(def);
+		const char *name = NULL;
+
+		if (fndecl && DECL_NAME(fndecl))
+			name = IDENTIFIER_POINTER(DECL_NAME(fndecl));
+		return known_nonnull_return(name) ||
+		       (fndecl && lookup_attribute("returns_nonnull",
+						 DECL_ATTRIBUTES(fndecl)));
+	}
+	return false;
+}
+
+static bool proven_nonnull_base(tree value, gimple *stmt)
+{
+	auto_vec<tree, 24> visited;
+
+	return proven_nonnull_base_1(value, stmt, 0, &visited, false);
+}
+
+static const char *state_name(enum hdn_null_state state)
+{
+	switch (state) {
+	case HDN_NULL_ZERO:
+		return "zero";
+	case HDN_NULL_MAYBE:
+		return "includes_zero";
+	case HDN_NULL_UNKNOWN:
+		return "unknown";
+	case HDN_NULL_VARYING:
+		return "varying";
+	default:
+		return "nonzero";
+	}
+}
+
+static const char *category_for(enum hdn_null_state state,
+				const struct hdn_origin *origin,
+				location_t loc, bool must_execute)
+{
+	if (intentional_probe_function())
+		return "intentional_probe";
+	if (!usable_source_location(loc))
+		return "compiler_artifact";
+	if (state == HDN_NULL_ZERO && must_execute)
+		return "definite_fault";
+	if (origin->user_influenced ||
+	    (origin->parameter && attacker_entry_function()))
+		return "attacker_influenced_potential";
+	return "invariant_dependent";
+}
+
+static const char *taint_for(const struct hdn_origin *origin)
+{
+	if (origin->user_influenced ||
+	    (origin->parameter && attacker_entry_function()))
+		return "attacker_influenced";
+	if (origin->parameter)
+		return "parameter_unknown";
+	if (origin->nullable_call)
+		return "nullable_return";
+	return "not_observed";
+}
+
+static bool reportable_state(enum hdn_null_state state,
+			     const struct hdn_origin *origin)
+{
+	if (state == HDN_NULL_ZERO || state == HDN_NULL_MAYBE)
+		return true;
+	if (state != HDN_NULL_VARYING && state != HDN_NULL_UNKNOWN)
+		return false;
+	return intentional_probe_function() || origin->explicit_zero ||
+	       origin->nullable_call ||
+	       (origin->parameter && attacker_entry_function());
+}
+
+static void emit_finding(tree pointer, gimple *stmt, tree ref,
+			 const char *kind, auto_vec<hdn_seen, 8> *seen)
+{
+	struct hdn_origin origin = { };
+	enum hdn_null_state state;
+	location_t loc = EXPR_LOCATION(ref);
+	const char *file;
+	const char *function;
+	const char *category;
+	const char *taint;
+	const char *probe_owner;
+	const char *probe_invalidation;
+	basic_block entry_successor;
+	bool must_execute;
+	char esc_profile[sizeof(analysis_profile) * 2];
+	char esc_file[HDN_NULL_PATH_MAX];
+	char esc_function[1024];
+	char esc_callee[1024];
+	char esc_probe_owner[1024];
+	char esc_probe_invalidation[2048];
+	char record[HDN_NULL_RECORD_MAX];
+	char position[64];
+	char id[64];
+	uint64_t hash = UINT64_C(14695981039346656037);
+	int len;
+
+	if (!pointer || !POINTER_TYPE_P(TREE_TYPE(pointer)))
+		return;
+	if (loc == UNKNOWN_LOCATION)
+		loc = gimple_location(stmt);
+	state = pointer_state(pointer, stmt);
+	if (state == HDN_NULL_NONZERO)
+		return;
+	trace_origin(pointer, &origin);
+	origin.container_conversion |= reference_has_negative_offset(ref);
+	if (!reportable_state(state, &origin))
+		return;
+	if (seen_before(seen, origin.root ? origin.root : pointer, kind, loc))
+		return;
+	if (proven_nonnull_base(pointer, stmt))
+		return;
+	if (already_seen(seen, origin.root ? origin.root : pointer, kind, loc))
+		return;
+
+	file = normalized_file(loc);
+	function = function_name();
+	entry_successor = single_succ(ENTRY_BLOCK_PTR_FOR_FN(cfun));
+	must_execute = entry_successor &&
+		dominated_by_p(CDI_POST_DOMINATORS, entry_successor,
+			       gimple_bb(stmt));
+	category = category_for(state, &origin, loc, must_execute);
+	taint = taint_for(&origin);
+	intentional_probe_metadata(&probe_owner, &probe_invalidation);
+	if (origin.container_conversion)
+		kind = "container_conversion";
+
+	hash = fnv1a_update(hash, HDN_NULL_ANALYZER_VERSION);
+	hash = fnv1a_update(hash, "|");
+	hash = fnv1a_update(hash, kind);
+	hash = fnv1a_update(hash, "|");
+	hash = fnv1a_update(hash, function);
+	hash = fnv1a_update(hash, "|");
+	hash = fnv1a_update(hash, file);
+	snprintf(position, sizeof(position), "|%u|%u",
+		 LOCATION_LINE(loc), LOCATION_COLUMN(loc));
+	hash = fnv1a_update(hash, position);
+	snprintf(id, sizeof(id), "HDN-NULL-v1-%016" PRIx64, hash);
+
+	json_escape(esc_profile, sizeof(esc_profile), analysis_profile);
+	json_escape(esc_file, sizeof(esc_file), file);
+	json_escape(esc_function, sizeof(esc_function), function);
+	json_escape(esc_callee, sizeof(esc_callee),
+		    origin.callee ? origin.callee : "");
+	json_escape(esc_probe_owner, sizeof(esc_probe_owner), probe_owner);
+	json_escape(esc_probe_invalidation, sizeof(esc_probe_invalidation),
+		    probe_invalidation);
+	len = snprintf(record, sizeof(record),
+		"{\"schema_version\":%d,\"analyzer_version\":\"%s\","
+		"\"id\":\"%s\",\"tool\":\"gcc-hdn-null\","
+		"\"profile\":\"%s\",\"category\":\"%s\","
+		"\"kind\":\"%s\",\"file\":\"%s\",\"line\":%u,"
+		"\"column\":%u,\"function\":\"%s\",\"reachable\":true,"
+		"\"reachability_evidence\":\"optimized-statement-range-dominance-and-postdominance\","
+		"\"taint\":\"%s\",\"optimization_context\":\"optimized-gimple\","
+		"\"range\":\"%s\",\"path_scope\":\"%s\",\"origin\":\"%s\","
+		"\"probe_owner\":\"%s\",\"probe_invalidation\":\"%s\"}\n",
+		HDN_NULL_SCHEMA_VERSION, HDN_NULL_ANALYZER_VERSION, id,
+		esc_profile, category, kind, esc_file, LOCATION_LINE(loc),
+		LOCATION_COLUMN(loc), esc_function, taint, state_name(state),
+		must_execute ? "must_execute" : "conditional",
+		esc_callee, esc_probe_owner, esc_probe_invalidation);
+	if (len < 0 || (size_t)len >= sizeof(record)) {
+		warning(0, G_("HDN null-analysis record exceeds bounded size"));
+		return;
+	}
+	if (write(report_fd, record, len) != len)
+		warning(0, G_("cannot write HDN null-analysis report: %s"),
+			xstrerror(errno));
+}
+
+static tree reference_pointer(tree ref)
+{
+	if (!ref)
+		return NULL_TREE;
+	switch (TREE_CODE(ref)) {
+	case MEM_REF:
+	case INDIRECT_REF:
+		return TREE_OPERAND(ref, 0);
+	case TARGET_MEM_REF:
+		/*
+		 * TARGET_MEM_REF is a composite address.  In particular, ASan can
+		 * lower an ordinary dereference to a zero base plus a dynamic index.
+		 * Looking at TMR_BASE alone therefore mistakes the addressing-mode
+		 * placeholder for the effective pointer.  Use GCC's canonical helper
+		 * so base, indexes, scale, and offset are all represented.
+		 */
+		return tree_mem_ref_addr(build_pointer_type(TREE_TYPE(ref)), ref);
+	case COMPONENT_REF:
+	case ARRAY_REF:
+	case ARRAY_RANGE_REF:
+	case BIT_FIELD_REF:
+		return reference_pointer(TREE_OPERAND(ref, 0));
+	default:
+		return NULL_TREE;
+	}
+}
+
+static bool reference_has_negative_offset(tree ref)
+{
+	if (!ref)
+		return false;
+	switch (TREE_CODE(ref)) {
+	case MEM_REF:
+		return constant_is_negative(TREE_OPERAND(ref, 1)) ||
+		       reference_has_negative_offset(TREE_OPERAND(ref, 0));
+	case POINTER_PLUS_EXPR:
+	case PLUS_EXPR:
+	case MINUS_EXPR:
+		return constant_is_negative(TREE_OPERAND(ref, 1)) ||
+		       reference_has_negative_offset(TREE_OPERAND(ref, 0));
+	case TARGET_MEM_REF:
+		return constant_is_negative(TMR_OFFSET(ref)) ||
+		       reference_has_negative_offset(TMR_BASE(ref));
+	case COMPONENT_REF:
+	case ARRAY_REF:
+	case ARRAY_RANGE_REF:
+	case BIT_FIELD_REF:
+		return reference_has_negative_offset(TREE_OPERAND(ref, 0));
+	default:
+		return false;
+	}
+}
+
+struct hdn_walk_context {
+	gimple *stmt;
+	auto_vec<hdn_seen, 8> *seen;
+};
+
+static bool already_seen(auto_vec<hdn_seen, 8> *seen, tree pointer,
+			 const char *kind, location_t location)
+{
+	if (seen_before(seen, pointer, kind, location))
+		return true;
+	hdn_seen item = { pointer, kind, location };
+	seen->safe_push(item);
+	return false;
+}
+
+static bool seen_before(const auto_vec<hdn_seen, 8> *seen, tree pointer,
+			const char *kind, location_t location)
+{
+	unsigned int i;
+
+	for (i = 0; i < seen->length(); i++)
+		if ((*seen)[i].pointer == pointer &&
+		    !strcmp((*seen)[i].kind, kind) &&
+		    (*seen)[i].location == location)
+			return true;
+	return false;
+}
+
+static tree walk_reference(tree *tp, int *walk_subtrees, void *data)
+{
+	struct hdn_walk_context *ctx = (struct hdn_walk_context *)data;
+	tree ref = *tp;
+	tree pointer = NULL_TREE;
+	const char *kind = NULL;
+
+	if (!ref)
+		return NULL_TREE;
+	if (TREE_CODE(ref) == ADDR_EXPR) {
+		*walk_subtrees = 0;
+		return NULL_TREE;
+	}
+	if (TREE_CODE(ref) == COMPONENT_REF) {
+		pointer = reference_pointer(ref);
+		kind = "field_offset";
+		*walk_subtrees = 0;
+	} else if (TREE_CODE(ref) == MEM_REF ||
+		   TREE_CODE(ref) == INDIRECT_REF ||
+		   TREE_CODE(ref) == TARGET_MEM_REF) {
+		pointer = reference_pointer(ref);
+		kind = "direct_dereference";
+		*walk_subtrees = 0;
+	}
+	if (pointer)
+		emit_finding(pointer, ctx->stmt, ref, kind, ctx->seen);
+	return NULL_TREE;
+}
+
+static unsigned int hdn_null_analysis_execute(void)
+{
+	basic_block bb;
+	auto_vec<hdn_seen, 8> seen;
+	hash_map<tree, hdn_guard_set> guard_cache(64);
+
+	calculate_dominance_info(CDI_DOMINATORS);
+	calculate_dominance_info(CDI_POST_DOMINATORS);
+	active_range_query = enable_ranger(cfun);
+	active_guard_cache = &guard_cache;
+	FOR_EACH_BB_FN(bb, cfun) {
+		gimple_stmt_iterator gsi;
+
+		for (gsi = gsi_start_bb(bb); !gsi_end_p(gsi); gsi_next(&gsi)) {
+			gimple *stmt = gsi_stmt(gsi);
+			struct hdn_walk_context ctx = { stmt, &seen };
+			unsigned int i;
+
+			for (i = 0; i < gimple_num_ops(stmt); i++) {
+				tree op = gimple_op(stmt, i);
+
+				if (op)
+					walk_tree(&op, walk_reference, &ctx, NULL);
+			}
+			if (is_gimple_call(stmt) && !gimple_call_fndecl(stmt)) {
+				tree fn = gimple_call_fn(stmt);
+
+				if (fn)
+					emit_finding(fn, stmt, fn, "indirect_call",
+						     &seen);
+			}
+		}
+	}
+	disable_ranger(cfun);
+	active_range_query = NULL;
+	active_guard_cache = NULL;
+	free_dominance_info(CDI_POST_DOMINATORS);
+	free_dominance_info(CDI_DOMINATORS);
+	return 0;
+}
+
+#define PASS_NAME hdn_null_analysis
+#define NO_GATE
+#define PROPERTIES_REQUIRED PROP_ssa
+#define TODO_FLAGS_FINISH TODO_dump_func
+#include "gcc-generate-gimple-pass.h"
+
+static tree handle_attacker_attribute(tree *node, tree name, tree,
+				      int, bool *no_add_attrs)
+{
+	if (TREE_CODE(*node) != FUNCTION_DECL) {
+		*no_add_attrs = true;
+		error(G_("%qE attribute applies only to functions"), name);
+	}
+	return NULL_TREE;
+}
+
+static tree handle_probe_attribute(tree *node, tree name, tree args,
+				   int, bool *no_add_attrs)
+{
+	if (TREE_CODE(*node) != FUNCTION_DECL || !args || !TREE_CHAIN(args) ||
+	    TREE_CODE(TREE_VALUE(args)) != STRING_CST ||
+	    TREE_CODE(TREE_VALUE(TREE_CHAIN(args))) != STRING_CST) {
+		*no_add_attrs = true;
+		error(G_("%qE requires a function plus owner and invalidation strings"),
+		      name);
+	}
+	return NULL_TREE;
+}
+
+static struct attribute_spec attacker_attribute = { };
+static struct attribute_spec probe_attribute = { };
+
+static void register_attributes(void *, void *)
+{
+	attacker_attribute.name = "hdn_null_attacker_entry";
+	attacker_attribute.decl_required = true;
+	attacker_attribute.handler = handle_attacker_attribute;
+	register_attribute(&attacker_attribute);
+
+	probe_attribute.name = "hdn_null_probe";
+	probe_attribute.min_length = 2;
+	probe_attribute.max_length = 2;
+	probe_attribute.decl_required = true;
+	probe_attribute.handler = handle_probe_attribute;
+	register_attribute(&probe_attribute);
+}
+
+static void finish_plugin(void *, void *)
+{
+	if (report_fd >= 0)
+		close(report_fd);
+	report_fd = -1;
+}
+
+__visible int plugin_init(struct plugin_name_args *plugin_info,
+			  struct plugin_gcc_version *version)
+{
+	char path[HDN_NULL_PATH_MAX];
+	int directory_error;
+	int i;
+
+	if (!plugin_default_version_check(version, &gcc_version)) {
+		error(G_("incompatible gcc/plugin versions"));
+		return 1;
+	}
+	for (i = 0; i < plugin_info->argc; i++) {
+		const char *key = plugin_info->argv[i].key;
+		const char *value = plugin_info->argv[i].value;
+
+		if (!strcmp(key, "report-dir")) {
+			if (!copy_option(report_dir, sizeof(report_dir), value, key))
+				return 1;
+		} else if (!strcmp(key, "source-root")) {
+			if (!copy_option(source_root, sizeof(source_root), value, key))
+				return 1;
+		} else if (!strcmp(key, "profile")) {
+			if (!copy_option(analysis_profile, sizeof(analysis_profile),
+					 value, key))
+				return 1;
+		} else {
+			error(G_("unknown HDN null-analysis option %qs"), key);
+			return 1;
+		}
+	}
+	if (!report_dir[0]) {
+		error(G_("HDN null-analysis requires report-dir"));
+		return 1;
+	}
+	if (!source_root[0]) {
+		error(G_("HDN null-analysis requires source-root"));
+		return 1;
+	}
+	directory_error = mkdir_parents(report_dir);
+	if (directory_error) {
+		error(G_("cannot create HDN null-analysis report directory %qs: %s"),
+		      report_dir, xstrerror(-directory_error));
+		return 1;
+	}
+	if (snprintf(path, sizeof(path), "%s/gcc.jsonl", report_dir) >=
+	    (int)sizeof(path)) {
+		error(G_("HDN null-analysis report path is too long"));
+		return 1;
+	}
+	report_fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if (report_fd < 0) {
+		error(G_("cannot open HDN null-analysis report %qs: %s"), path,
+		      xstrerror(errno));
+		return 1;
+	}
+
+	PASS_INFO(hdn_null_analysis, "optimized", 1, PASS_POS_INSERT_BEFORE);
+	register_callback(plugin_info->base_name, PLUGIN_INFO, NULL,
+			  &hdn_null_plugin_info);
+	register_callback(plugin_info->base_name, PLUGIN_ATTRIBUTES,
+			  register_attributes, NULL);
+	register_callback(plugin_info->base_name, PLUGIN_PASS_MANAGER_SETUP,
+			  NULL, &hdn_null_analysis_pass_info);
+	register_callback(plugin_info->base_name, PLUGIN_FINISH, finish_plugin,
+			  NULL);
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/scripts/gcc-plugins/hdn_pgtable_plugin.c linux-7.0.12-hdn/scripts/gcc-plugins/hdn_pgtable_plugin.c
--- linux-7.0.12/scripts/gcc-plugins/hdn_pgtable_plugin.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/scripts/gcc-plugins/hdn_pgtable_plugin.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,405 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Inventory page-table writes before optimization erases their source shape. */
+#include "gcc-common.h"
+#undef gimple
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+__visible int plugin_is_GPL_compatible;
+static const char *source_root, *profile;
+static int report_fd = -1;
+static unsigned long findings;
+
+static const char *decl_name(tree decl)
+{
+	return decl && DECL_NAME(decl) ? IDENTIFIER_POINTER(DECL_NAME(decl)) : "<anonymous>";
+}
+
+static const char *relative_file(const char *file)
+{
+	size_t length;
+
+	if (!file)
+		return "<unknown>";
+	length = strlen(source_root);
+	if (!strncmp(file, source_root, length) && file[length] == '/')
+		return file + length + 1;
+	while (file[0] == '.' && file[1] == '/')
+		file += 2;
+	return file;
+}
+
+static void quote(FILE *out, const char *value)
+{
+	fputc('"', out);
+	for (const unsigned char *p = (const unsigned char *)value; *p; p++) {
+		if (*p == '"' || *p == '\\')
+			fprintf(out, "\\%c", *p);
+		else if (*p < 0x20)
+			fprintf(out, "\\u%04x", *p);
+		else
+			fputc(*p, out);
+	}
+	fputc('"', out);
+}
+
+static void field(FILE *out, const char *key, const char *value)
+{
+	fprintf(out, ",\"%s\":", key);
+	quote(out, value ? value : "");
+}
+
+static const char *type_name(tree type)
+{
+	tree name;
+
+	if (!type)
+		return NULL;
+	type = TYPE_MAIN_VARIANT(type);
+	name = TYPE_NAME(type);
+	if (!name)
+		return NULL;
+	if (TREE_CODE(name) == TYPE_DECL)
+		name = DECL_NAME(name);
+	return name && TREE_CODE(name) == IDENTIFIER_NODE ? IDENTIFIER_POINTER(name) : NULL;
+}
+
+static bool page_table_name(const char *name)
+{
+	static const char *const names[] = {
+		"pte_t", "pmd_t", "pud_t", "p4d_t", "pgd_t",
+		"pteval_t", "pmdval_t", "pudval_t", "p4dval_t", "pgdval_t",
+	};
+
+	if (!name)
+		return false;
+	for (unsigned int i = 0; i < ARRAY_SIZE(names); i++)
+		if (!strcmp(name, names[i]))
+			return true;
+	return false;
+}
+
+static bool page_table_type(tree type, unsigned int depth = 0)
+{
+	if (!type || depth > 12)
+		return false;
+	type = TYPE_MAIN_VARIANT(type);
+	if (page_table_name(type_name(type)))
+		return true;
+	if (TREE_CODE(type) == POINTER_TYPE || TREE_CODE(type) == ARRAY_TYPE ||
+	    TREE_CODE(type) == REFERENCE_TYPE)
+		return page_table_type(TREE_TYPE(type), depth + 1);
+	return false;
+}
+
+static bool page_table_field(tree field)
+{
+	const char *name;
+
+	if (!field || TREE_CODE(field) != FIELD_DECL)
+		return false;
+	if (page_table_type(DECL_CONTEXT(field)) || page_table_type(TREE_TYPE(field)))
+		return true;
+	name = decl_name(field);
+	return !strcmp(name, "pte") || !strcmp(name, "pmd") || !strcmp(name, "pud") ||
+	       !strcmp(name, "p4d") || !strcmp(name, "pgd") ||
+	       !strcmp(name, "pte_low") || !strcmp(name, "pte_high") ||
+	       !strcmp(name, "pmd_low") || !strcmp(name, "pmd_high");
+}
+
+static bool page_table_expr_impl(tree value, auto_vec<tree, 32> &visited,
+				 unsigned int depth)
+{
+	if (!value || depth > 32 || visited.length() >= 256)
+		return false;
+	for (unsigned int i = 0; i < visited.length(); i++)
+		if (visited[i] == value)
+			return false;
+	visited.safe_push(value);
+	if (page_table_type(TREE_TYPE(value)))
+		return true;
+	switch (TREE_CODE(value)) {
+	case COMPONENT_REF:
+		return page_table_field(TREE_OPERAND(value, 1)) ||
+		       page_table_expr_impl(TREE_OPERAND(value, 0), visited, depth + 1);
+	case MEM_REF:
+	case TARGET_MEM_REF:
+	case INDIRECT_REF:
+	case ADDR_EXPR:
+	case NOP_EXPR:
+	case CONVERT_EXPR:
+	case VIEW_CONVERT_EXPR:
+	case NON_LVALUE_EXPR:
+		return page_table_expr_impl(TREE_OPERAND(value, 0), visited, depth + 1);
+	case ARRAY_REF:
+	case ARRAY_RANGE_REF:
+		return page_table_expr_impl(TREE_OPERAND(value, 0), visited, depth + 1);
+	case POINTER_PLUS_EXPR:
+		return page_table_expr_impl(TREE_OPERAND(value, 0), visited, depth + 1);
+	case SSA_NAME: {
+		gimple *definition;
+
+		if (SSA_NAME_IS_DEFAULT_DEF(value))
+			return page_table_type(TREE_TYPE(value));
+		definition = SSA_NAME_DEF_STMT(value);
+		if (!definition)
+			return false;
+		if (is_gimple_assign(definition))
+			return page_table_expr_impl(gimple_assign_rhs1(definition), visited, depth + 1);
+		if (gimple_code(definition) == GIMPLE_PHI) {
+			for (unsigned int i = 0; i < gimple_phi_num_args(definition); i++)
+				if (page_table_expr_impl(gimple_phi_arg_def(definition, i), visited,
+							 depth + 1))
+					return true;
+		}
+		return false;
+	}
+	default:
+		return false;
+	}
+}
+
+static bool page_table_expr(tree value)
+{
+	auto_vec<tree, 32> visited;
+
+	return page_table_expr_impl(value, visited, 0);
+}
+
+static bool indirect_store(tree lhs)
+{
+	tree base = lhs ? get_base_address(lhs) : NULL_TREE;
+
+	return base && (TREE_CODE(base) == MEM_REF || TREE_CODE(base) == TARGET_MEM_REF ||
+			TREE_CODE(base) == INDIRECT_REF);
+}
+
+static bool function_page_table_context(tree function)
+{
+	const char *name = decl_name(function);
+
+	if (!strncmp(name, "hdn_pt_", 7) || !strncmp(name, "hdn_stack_mm_", 13) ||
+	    !strncmp(name, "native_set_p", 12) || !strncmp(name, "set_p", 5) ||
+	    !strncmp(name, "ptep_", 5) || !strncmp(name, "pmdp_", 5) ||
+	    !strncmp(name, "pudp_", 5) || !strncmp(name, "p4dp_", 5) ||
+	    !strncmp(name, "pgdp_", 5))
+		return true;
+	if (page_table_type(TREE_TYPE(function)))
+		return true;
+	for (tree argument = DECL_ARGUMENTS(function); argument; argument = DECL_CHAIN(argument))
+		if (page_table_type(TREE_TYPE(argument)))
+			return true;
+	return false;
+}
+
+static bool mutation_name(const char *name)
+{
+	static const char *const prefixes[] = {
+		"set_pte", "set_pmd", "set_pud", "set_p4d", "set_pgd",
+		"native_set_pte", "native_set_pmd", "native_set_pud", "native_set_p4d",
+		"native_set_pgd", "ptep_", "pmdp_", "pudp_", "p4dp_", "pgdp_",
+		"native_ptep_", "native_pmdp_", "native_pudp_", "native_p4dp_",
+		"native_pgdp_", "hdn_pt_",
+	};
+
+	if (!name)
+		return false;
+	for (unsigned int i = 0; i < ARRAY_SIZE(prefixes); i++)
+		if (!strncmp(name, prefixes[i], strlen(prefixes[i])))
+			return true;
+	return false;
+}
+
+static bool bulk_write_name(const char *name)
+{
+	return name && (!strcmp(name, "memcpy") || !strcmp(name, "memmove") ||
+			!strcmp(name, "memset") || !strcmp(name, "__memcpy") ||
+			!strcmp(name, "__memset") || !strcmp(name, "__builtin_memcpy") ||
+			!strcmp(name, "__builtin_memmove") || !strcmp(name, "__builtin_memset") ||
+			!strcmp(name, "clear_page"));
+}
+
+static void type_field(FILE *out, tree value)
+{
+	char *buffer = NULL;
+	size_t length = 0;
+	FILE *type;
+
+	if (!value || !TREE_TYPE(value))
+		return;
+	type = open_memstream(&buffer, &length);
+	if (!type) {
+		error(G_("cannot allocate HDN page-table type record"));
+		return;
+	}
+	print_generic_expr(type, TREE_TYPE(value), TDF_SLIM);
+	if (fclose(type))
+		error(G_("cannot finish HDN page-table type record"));
+	else
+		field(out, "type", buffer);
+	free(buffer);
+}
+
+static void append(char *buffer, size_t length)
+{
+	size_t done = 0;
+	int saved = 0;
+
+	while (flock(report_fd, LOCK_EX))
+		if (errno != EINTR) {
+			error(G_("cannot lock HDN page-table report: %s"), xstrerror(errno));
+			free(buffer);
+			return;
+		}
+	while (done < length) {
+		ssize_t count = write(report_fd, buffer + done, length - done);
+		if (count > 0)
+			done += count;
+		else if (count < 0 && errno == EINTR)
+			continue;
+		else {
+			saved = count < 0 ? errno : EIO;
+			break;
+		}
+	}
+	if (flock(report_fd, LOCK_UN) && !saved)
+		saved = errno;
+	free(buffer);
+	if (saved)
+		error(G_("cannot write HDN page-table report: %s"), xstrerror(saved));
+}
+
+static void emit(const char *kind, tree caller, location_t location, tree value,
+			 const char *operation)
+{
+	char *buffer = NULL;
+	size_t length = 0;
+	FILE *out = open_memstream(&buffer, &length);
+
+	if (!out) {
+		error(G_("cannot allocate HDN page-table record"));
+		return;
+	}
+	fputs("{\"schema_version\":1,\"analyzer_version\":\"1.0.0\"", out);
+	field(out, "kind", kind);
+	field(out, "unit", relative_file(main_input_filename));
+	field(out, "profile", profile);
+	field(out, "file", relative_file(LOCATION_FILE(location)));
+	fprintf(out, ",\"line\":%d,\"column\":%d", LOCATION_LINE(location),
+		LOCATION_COLUMN(location));
+	field(out, "caller", caller ? decl_name(caller) : "<unit>");
+	field(out, "operation", operation);
+	type_field(out, value);
+	if (!strcmp(kind, "unit"))
+		fprintf(out, ",\"findings\":%lu,\"compiler_errors\":%d", findings, errorcount);
+	else
+		fprintf(out, ",\"sequence\":%lu", findings);
+	fputs("}\n", out);
+	if (fclose(out)) {
+		free(buffer);
+		error(G_("cannot finish HDN page-table record"));
+		return;
+	}
+	append(buffer, length);
+	if (strcmp(kind, "unit"))
+		findings++;
+}
+
+static unsigned int hdn_pgtable_execute(void)
+{
+	basic_block block;
+	tree caller = current_function_decl;
+	bool context = function_page_table_context(caller);
+
+	/* First retain functions whose local GIMPLE still carries a page-table type. */
+	FOR_EACH_BB_FN(block, cfun)
+		for (gimple_stmt_iterator iterator = gsi_start_bb(block); !gsi_end_p(iterator);
+		     gsi_next(&iterator)) {
+			gimple *statement = gsi_stmt(iterator);
+			for (unsigned int i = 0; i < gimple_num_ops(statement); i++)
+				context |= page_table_expr(gimple_op(statement, i));
+		}
+
+	FOR_EACH_BB_FN(block, cfun) {
+		for (gimple_stmt_iterator iterator = gsi_start_bb(block); !gsi_end_p(iterator);
+		     gsi_next(&iterator)) {
+			gimple *statement = gsi_stmt(iterator);
+			location_t location = gimple_location(statement);
+
+			if (location == UNKNOWN_LOCATION)
+				location = DECL_SOURCE_LOCATION(caller);
+			if (is_gimple_assign(statement)) {
+				tree lhs = gimple_assign_lhs(statement);
+				if (page_table_expr(lhs))
+					emit("typed-store", caller, location, lhs, "assignment");
+				else if (context && indirect_store(lhs))
+					emit("unresolved-indirect-store", caller, location, lhs,
+					     "assignment");
+			} else if (is_gimple_call(statement)) {
+				tree callee = gimple_call_fndecl(statement);
+				const char *name = callee ? decl_name(callee) : NULL;
+				if (mutation_name(name))
+					emit("mutation-call", caller, location, NULL_TREE, name);
+				if (bulk_write_name(name) && gimple_call_num_args(statement) &&
+				    page_table_expr(gimple_call_arg(statement, 0)))
+					emit("typed-bulk-write", caller, location,
+					     gimple_call_arg(statement, 0), name);
+				if (context && !callee)
+					emit("indirect-call", caller, location, NULL_TREE, "<indirect>");
+			} else if (context && gimple_code(statement) == GIMPLE_ASM) {
+				emit("assembly", caller, location, NULL_TREE, "inline-assembly");
+			}
+		}
+	}
+	return 0;
+}
+
+#define PASS_NAME hdn_pgtable
+#define PROPERTIES_REQUIRED PROP_ssa
+#define NO_GATE
+#include "gcc-generate-gimple-pass.h"
+
+static void finish(void *, void *)
+{
+	emit("unit", NULL_TREE, UNKNOWN_LOCATION, NULL_TREE, "finish");
+	close(report_fd);
+}
+
+__visible int plugin_init(struct plugin_name_args *info, struct plugin_gcc_version *version)
+{
+	const char *report = NULL;
+
+	if (!plugin_default_version_check(version, &gcc_version))
+		return 1;
+	for (int i = 0; i < info->argc; i++) {
+		const char *key = info->argv[i].key;
+		const char *value = info->argv[i].value;
+
+		if (!value || !*value)
+			return 1;
+		if (!strcmp(key, "report"))
+			report = value;
+		else if (!strcmp(key, "source-root"))
+			source_root = value;
+		else if (!strcmp(key, "profile"))
+			profile = value;
+		else
+			return 1;
+	}
+	if (!report || !source_root || !profile) {
+		error(G_("HDN page-table analysis requires report, source-root and profile"));
+		return 1;
+	}
+	report_fd = open(report, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+	if (report_fd < 0) {
+		error(G_("cannot open HDN page-table report: %s"), xstrerror(errno));
+		return 1;
+	}
+	PASS_INFO(hdn_pgtable, "ssa", 1, PASS_POS_INSERT_AFTER);
+	register_callback(info->base_name, PLUGIN_PASS_MANAGER_SETUP, NULL,
+			  &hdn_pgtable_pass_info);
+	register_callback(info->base_name, PLUGIN_FINISH, finish, NULL);
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/scripts/gcc-plugins/hdn_rap_plugin.c linux-7.0.12-hdn/scripts/gcc-plugins/hdn_rap_plugin.c
