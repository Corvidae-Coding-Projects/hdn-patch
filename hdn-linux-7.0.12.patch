+static int support_bundle_run_capture(char *buf, size_t size)
+{
+	int pipefd[2];
+	pid_t child;
+	int status;
+	int ret;
+
+	if (access(HDN_SUPPORT_BUNDLE_EXEC, X_OK))
+		return KSFT_SKIP;
+
+	if (pipe(pipefd))
+		return 2;
+
+	child = fork();
+	if (child < 0) {
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 2;
+	}
+
+	if (!child) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(2);
+		close(pipefd[1]);
+		execl(HDN_SUPPORT_BUNDLE_EXEC, "hdn-support-bundle", NULL);
+		fprintf(stderr, "support bundle exec failed: %s\n",
+			strerror(errno));
+		_exit(2);
+	}
+
+	close(pipefd[1]);
+	ret = event_decoder_read_output(pipefd[0], buf, size);
+	close(pipefd[0]);
+
+	if (waitpid(child, &status, 0) < 0)
+		return 2;
+	if (ret)
+		return 2;
+	if (!WIFEXITED(status))
+		return 2;
+	return WEXITSTATUS(status);
+}
