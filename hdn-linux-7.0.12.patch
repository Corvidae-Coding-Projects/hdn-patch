+static int userns_depth_policy_enforced(void)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0)
+		return 2;
+	if (!child) {
+		execl("/hdn_smoke", "hdn_smoke", "--userns-depth-sentinel",
+		      NULL);
+		fprintf(stderr, "userns-depth sentinel exec failed: %s\n",
+			strerror(errno));
+		_exit(2);
+	}
+
+	return child_exit_result(child);
+}
