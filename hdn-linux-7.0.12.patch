+	    info->sechdrs[section].sh_size % sizeof(*records) ||
+	    info->sechdrs[section].sh_size > SZ_1M ||
+	    !(info->sechdrs[section].sh_flags & SHF_ALLOC) ||
+	    (info->sechdrs[section].sh_flags &
