+
+	child = spawn_proc_sensitive_target();
+	if (child < 0)
+		return 2;
+
+	ret = read_proc_sensitive_file(child, name, needle, expect_denied);
+
+	kill(child, SIGKILL);
+	waitpid(child, NULL, 0);
+	return ret;
+}
