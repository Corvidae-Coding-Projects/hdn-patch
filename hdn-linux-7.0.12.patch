+/* SPDX-License-Identifier: GPL-2.0-only */
+/* The nested-NMI loop has two architectural frames. Both the assembly frame
+ * construction and the runtime's single permitted repeat target are checked. */
+static int verify_rap_nmi(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_kexec_sequence k = { .seq = { .file = file, .func = func } };
+	struct rap_sequence *s = &k.seq;
+	struct instruction *insn;
+	unsigned int i;
+
+#define NMI_BYTES(bytes) do { if (!rap_sequence_bytes(s, bytes, sizeof(bytes) - 1)) goto bad; } while (0)
+#define NMI_BRANCH(op, label) do { if (!rap_kexec_branch(&k, op, label)) goto bad; } while (0)
+#define NMI_LABEL(label) do { if (!rap_kexec_label(&k, label)) goto bad; } while (0)
+	if (strcmp(func->name, "asm_exc_nmi") || is_weak_sym(func) || !func->sec->noinstr ||
+	    !rap_hw_endbr(s) || !rap_hw_fixed_alt(s, "X86_FEATURE_SMAP", "\x0f\x01\xca", 3))
+		goto bad;
+	NMI_BYTES("\xfc\x52\xf6\x44\x24\x10\x03");
+	NMI_BRANCH(0x74, 0);
+	NMI_BYTES("\x0f\x01\xf8");
+	if (!rap_hw_fixed_alt(s, "X86_FEATURE_FENCE_SWAPGS_USER", "\x0f\xae\xe8", 3) ||
+	    !rap_hw_switch_kernel_cr3(s, 2))
+		goto bad;
+	NMI_BYTES("\x48\x89\xe2");
+	if (!rap_thunk_percpu(s, "\x48\x8b\x25", 3, "", 0, "cpu_current_top_of_stack"))
+		goto bad;
+	NMI_BYTES("\xff\x72\x28\xff\x72\x20\xff\x72\x18\xff\x72\x10\xff\x72\x08\x6a\xff");
+	/* PUSH_AND_CLEAR_REGS rdx=(%rdx). */
+	NMI_BYTES("\x57\x56\xff\x32\x51\x50\x41\x50\x41\x51\x41\x52\x41\x53"
+		  "\x53\x55\x41\x54\x41\x55\x41\x56\x41\x57"
+		  "\x31\xf6\x31\xd2\x31\xc9\x45\x31\xc0\x45\x31\xc9\x45\x31\xd2"
+		  "\x45\x31\xdb\x31\xdb\x31\xed\x45\x31\xe4\x45\x31\xed\x45\x31\xf6\x45\x31\xff");
+	rap_sequence_bytes(s, "\x48\x8d\x6c\x24\x01", 5);
+	if (!rap_hw_ibrs(s, true, false) || !rap_hw_untrain(s, false))
+		goto bad;
+	NMI_BYTES("\x48\x89\xe7");
+	if (!rap_entry_call(s, "exc_nmi") ||
+	    !rap_sequence_edge_match(s, "swapgs_restore_regs_and_return_to_usermode", false, false))
+		goto bad;
+	NMI_LABEL(0);
+	if (!rap_sequence_reference(s, "\x48\xc7\xc2", 3, "repeat_nmi", false))
+		goto bad;
+	NMI_BYTES("\x48\x3b\x54\x24\x08");
+	NMI_BRANCH(0x77, 1);
+	if (!rap_sequence_reference(s, "\x48\xc7\xc2", 3, "end_repeat_nmi", false))
+		goto bad;
+	NMI_BYTES("\x48\x3b\x54\x24\x08");
+	NMI_BRANCH(0x77, 3);
+	NMI_LABEL(1);
+	NMI_BYTES("\x83\x7c\x24\xf8\x01");
+	NMI_BRANCH(0x74, 2);
+	NMI_BYTES("\x48\x8d\x54\x24\x30\x48\x39\x54\x24\x20");
+	NMI_BRANCH(0x77, 4);
+	if (!rap_sequence_bytes(s, "\x48\x81\xea\0\x20\0\0", 7) &&
+	    !rap_sequence_bytes(s, "\x48\x81\xea\0\x40\0\0", 7))
+		goto bad;
+	NMI_BYTES("\x48\x39\x54\x24\x20");
+	NMI_BRANCH(0x72, 4);
+	NMI_BYTES("\xf6\x44\x24\x19\x04");
+	NMI_BRANCH(0x74, 4);
+	NMI_LABEL(2);
+	NMI_BYTES("\x48\x83\xec\x08\x48\x8d\x54\x24\xb0\x6a\x18\x52\x9c\x6a\x10");
+	if (!rap_sequence_reference(s, "\x68", 1, "repeat_nmi", false))
+		goto bad;
+	NMI_BYTES("\x48\x83\xc4\x30");
+	NMI_LABEL(3);
+	NMI_BYTES("\x5a\x48\xcf");
+	NMI_LABEL(4);
+	NMI_BYTES("\x48\x8b\x14\x24\x6a\0\x48\x83\xec\x28");
+	for (i = 0; i < 5; i++)
+		NMI_BYTES("\xff\x74\x24\x58");
+	/* DEBUG_ENTRY unmasks NMI using a fixed, immediately following IRET. */
+	if (rap_sequence_bytes(s, "\x6a\0", 2)) {
+		NMI_BYTES("\x54\x48\x83\x04\x24\x08\x9c\x6a\x10");
+		if (!rap_sequence_reference(s, "\x68", 1, "repeat_nmi", false))
+			goto bad;
+		NMI_BYTES("\x48\xcf");
+	}
+	if (!rap_thunk_symbol(file, "repeat_nmi", func->sec, func->offset + s->pos) ||
+	    !rap_thunk_symbol(file, "__hdn_rap_repeat_nmi", func->sec, func->offset + s->pos))
+		goto bad;
+	NMI_BYTES("\x48\xc7\x44\x24\x50\x01\0\0\0\x48\x83\xc4\x50");
+	for (i = 0; i < 5; i++)
+		NMI_BYTES("\xff\x74\x24\xd0");
+	NMI_BYTES("\x48\x83\xec\x28");
+	if (!rap_thunk_symbol(file, "end_repeat_nmi", func->sec, func->offset + s->pos))
+		goto bad;
+	NMI_BYTES("\x6a\xff");
+	if (!rap_sequence_edge_match(s, "paranoid_entry", true, false) ||
+	    !rap_idt_frame_enter(s, 2, 2))
+		goto bad;
+	NMI_BYTES("\x48\x89\xe7");
+	if (!rap_entry_call(s, "exc_nmi") || !rap_idt_frame_exit(s, 2) ||
+	    !rap_hw_ibrs(s, false, true) || !rap_hw_restore_cr3(s, true) ||
+	    !rap_hw_skip(&k, "X86_FEATURE_FSGSBASE", 5))
+		goto bad;
+	NMI_BYTES("\xf3\x48\x0f\xae\xdb");
+	NMI_BRANCH(0xeb, 6);
+	NMI_LABEL(5);
+	NMI_BYTES("\x85\xdb");
+	NMI_BRANCH(0x75, 6);
+	NMI_BYTES("\x0f\x01\xf8");
+	NMI_LABEL(6);
+	if (!rap_entry_pop_regs(s))
+		goto bad;
+	NMI_BYTES("\x48\x83\xc4\x30\xfd\x48\xc7\x44\x24\x28\0\0\0\0\x48\xcf");
+	if (s->pos != func->len || !rap_hw_local_edges(&k))
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt && !insn->rap_thunk_alt)
+			goto bad;
+	func->rap_nmi_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s->pos, "RAP NMI entry differs from its nested-frame protocol");
+	return -1;
+#undef NMI_LABEL
+#undef NMI_BRANCH
+#undef NMI_BYTES
+}
+
+static int validate_rap_nmi_peers(struct objtool_file *file)
+{
+	struct symbol *nmi = find_symbol_by_name(file->elf, "asm_exc_nmi");
+	struct instruction *insn;
+
+	if (!nmi || is_undef_sym(nmi))
+		return 0;
+	if (!nmi->rap_nmi_protocol || nmi->rap_kind != 41)
+		goto bad;
+	if (opts.link) {
+		static const char * const names[] = { "exc_nmi", "hdn_rap_frame_enter", "hdn_rap_frame_exit" };
+		unsigned int i;
+		for (i = 0; i < ARRAY_SIZE(names); i++) {
+			struct symbol *target = find_symbol_by_name(file->elf, names[i]);
+			if (!target || target->rap_kind != (i ? 2 : 1))
+				goto bad;
+		}
+	}
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct section *sec;
+		unsigned long offset;
+
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset) || sec != nmi->sec ||
+		    offset < nmi->offset || offset >= nmi->offset + nmi->len || owner == nmi)
+			continue;
+		if (offset == nmi->offset && insn->type == INSN_CALL && owner && owner->rap_kind == 13 &&
+		    owner->rap_hardware_event && !strcmp(owner->name, "vmx_do_nmi_irqoff"))
+			continue;
+		goto bad;
+	}
+	return 0;
+bad:
+	ERROR("RAP NMI root has an unverified handler or incoming transfer");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-pvh.h linux-7.0.12-hdn/tools/objtool/hdn-pvh.h
--- linux-7.0.12/tools/objtool/hdn-pvh.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-pvh.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,289 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* PVH enters an ELF64 image in 32-bit mode. Only the exact named section is
+ * decoded that way. The physical roots never call runtime C; the virtual root
+ * establishes the statically registered boot stack before its bound C call. */
+static unsigned int rap_pvh_kind(const char *name)
+{
+	if (!strcmp(name, "pvh_start_xen"))
+		return 52;
+	if (!strcmp(name, "hdn_pvh_physical64"))
+		return 53;
+	if (!strcmp(name, "hdn_pvh_virtual64"))
+		return 54;
+	return 0;
+}
+
+/* rva(symbol) is relative to the beginning of the 32-bit root, NOT to the
+ * instruction end. ELF's PC32 addend includes the operand-to-root distance. */
+static bool rap_pvh_rva(struct rap_sequence *s, const char *op, size_t size,
+		const char *name)
+{
+	struct symbol *target = find_symbol_by_name(s->file->elf, name);
+	unsigned long off = s->func->offset + s->pos;
+	struct instruction *insn = find_insn(s->file, s->func->sec, off);
+	struct reloc *reloc;
+	const char *p = s->func->sec->data->d_buf + off;
+	int32_t value;
+
+	if (!target || is_weak_sym(target) || !insn || insn->len != size + 4 ||
+	    s->pos > s->func->len || insn->len > s->func->len - s->pos ||
+	    memcmp(p, op, size) ||
+	    find_reloc_by_dest_range(s->file->elf, s->func->sec, off, size) ||
+	    find_reloc_by_dest_range(s->file->elf, s->func->sec, off + size + 1, 3))
+		return false;
+	reloc = find_reloc_by_dest(s->file->elf, s->func->sec, off + size);
+	if (reloc) {
+		if (reloc_type(reloc) != R_X86_64_PC32 || reloc->sym->sec != target->sec ||
+		    (is_undef_sym(target) && reloc->sym != target) ||
+		    reloc->sym->offset + reloc_addend(reloc) != target->offset + s->pos + size)
+			return false;
+	} else {
+		memcpy(&value, p + size, 4);
+		if (is_undef_sym(target) || target->sec != s->func->sec ||
+		    s->func->offset + value != target->offset)
+			return false;
+	}
+	s->pos += insn->len;
+	return true;
+}
+
+static int verify_rap_pvh(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_kexec_sequence k = { .seq = { .file = file, .func = func } };
+	struct rap_sequence *s = &k.seq;
+	struct instruction *insn;
+
+#define PVH_BYTES(b) do { if (!rap_sequence_bytes(s, b, sizeof(b) - 1)) goto bad; } while (0)
+#define PVH_RVA(b, n) do { if (!rap_pvh_rva(s, b, sizeof(b) - 1, n)) goto bad; } while (0)
+#define PVH_REF(b, n) do { if (!rap_sequence_reference(s, b, sizeof(b) - 1, n, true)) goto bad; } while (0)
+#define PVH_LABEL(n) do { if (!rap_kexec_label(&k, n)) goto bad; } while (0)
+#define PVH_BRANCH(op, n) do { if (!rap_kexec_branch(&k, op, n)) goto bad; } while (0)
+	if (is_weak_sym(func) || !func->sec->init || func->rap_kind != rap_pvh_kind(func->name))
+		goto bad;
+	if (func->rap_kind == 52) {
+		if (strcmp(func->sec->name, ".init.text.hdn_pvh32") || func->offset ||
+		    func->len != sec_size(func->sec))
+			goto bad;
+		PVH_BYTES("\xfc\x8b\x03\x8d\x63\x04\xe8\0\0\0\0\x5d\x89\x03"
+			  "\x83\xed\x0b\xbc\0\0\0\0");
+		PVH_RVA("\x8d\x85", "pvh_gdt");
+		PVH_BYTES("\x01\x40\x02\x0f\x01\x10\xb8\x10\0\0\0\x8e\xd8\x8e\xc0\x8e\xd0");
+		PVH_RVA("\x8d\xbd", "pvh_start_info");
+		PVH_BYTES("\x89\xde");
+		PVH_RVA("\x8b\x8d", "pvh_start_info_sz");
+		PVH_BYTES("\xc1\xe9\x02\xf3\xa5");
+		PVH_RVA("\x8d\xa5", "pvh_early_stack_end");
+		PVH_BYTES("\x0f\x20\xe0\x83\xc8\x20\x0f\x22\xe0"
+			  "\xb9\x80\0\0\xc0\x0f\x32\x0f\xba\xe8\x08\x0f\x30\x89\xeb");
+		PVH_RVA("\x2b\x9d", "xen_elfnote_phys32_entry");
+		PVH_BRANCH(0x74, 0);
+		PVH_RVA("\x89\x9d", "phys_base");
+		PVH_RVA("\x8d\xbd", "pvh_init_top_pgt");
+		PVH_BYTES("\xb9\0\x02\0\0");
+		PVH_LABEL(1);
+		PVH_BYTES("\xf7\x07\x01\0\0\0");
+		PVH_BRANCH(0x74, 2);
+		PVH_BYTES("\x01\x1f");
+		PVH_LABEL(2);
+		PVH_BYTES("\x83\xc7\x08\x49");
+		PVH_BRANCH(0x75, 1);
+		PVH_RVA("\x8d\xbd", "pvh_level3_ident_pgt");
+		PVH_BYTES("\x01\x1f");
+		PVH_RVA("\x8d\xbd", "pvh_level3_kernel_pgt");
+		PVH_BYTES("\x01\x9f\xf0\x0f\0\0\x01\x9f\xf8\x0f\0\0");
+		PVH_RVA("\x8d\xbd", "pvh_level2_kernel_pgt");
+		PVH_BYTES("\xb9\0\x02\0\0");
+		PVH_LABEL(3);
+		PVH_BYTES("\xf7\x07\x01\0\0\0");
+		PVH_BRANCH(0x74, 4);
+		PVH_BYTES("\x01\x1f");
+		PVH_LABEL(4);
+		PVH_BYTES("\x83\xc7\x08\x49");
+		PVH_BRANCH(0x75, 3);
+		PVH_LABEL(0);
+		PVH_RVA("\x8d\x85", "pvh_init_top_pgt");
+		PVH_BYTES("\x0f\x22\xd8\xb8\x01\0\0\x80\x0f\x22\xc0\x6a\x08");
+		PVH_RVA("\x8d\x85", "hdn_pvh_physical64");
+		PVH_BYTES("\x50\xcb");
+	} else if (func->rap_kind == 53) {
+		PVH_REF("\x48\x8d\x05", "hdn_pvh_virtual64");
+		PVH_REF("\x48\x2b\x05", "phys_base");
+		PVH_BYTES("\x48\x05\0\0\0\x80\xff\xe0");
+	} else {
+		PVH_BYTES("\xb9\x01\x01\0\xc0\x31\xc0\x31\xd2\x0f\x30");
+		PVH_REF("\x48\x8d\x25", "__top_init_kernel_stack");
+		PVH_BYTES("\x31\xed");
+		if (!rap_entry_call(s, "xen_prepare_pvh"))
+			goto bad;
+		PVH_REF("\x48\x8d\x35", "pvh_bootparams");
+		PVH_BYTES("\x48\x81\xee\0\0\0\x80");
+		PVH_REF("\x48\x03\x35", "phys_base");
+		PVH_REF("\x48\x8d\x05", "startup_64");
+		PVH_BYTES("\x48\x2d\0\0\0\x80");
+		PVH_REF("\x48\x03\x05", "phys_base");
+		PVH_BYTES("\xff\xe0");
+	}
+	if (s->pos != func->len || !rap_hw_local_edges(&k))
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts)
+			goto bad;
+	func->rap_pvh_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s->pos, "RAP PVH lacks its exact physical/virtual boot protocol");
+	return -1;
+#undef PVH_BYTES
+#undef PVH_RVA
+#undef PVH_REF
+#undef PVH_LABEL
+#undef PVH_BRANCH
+}
+
+static struct symbol *rap_pvh_data(struct objtool_file *file, const char *name, unsigned long size)
+{
+	struct symbol *sym = find_symbol_by_name(file->elf, name);
+
+	if (!sym || is_undef_sym(sym) || is_weak_sym(sym) || sym->len != size ||
+	    !sym->sec->init || is_text_sec(sym->sec) ||
+	    sym->offset > sec_size(sym->sec) || size > sec_size(sym->sec) - sym->offset)
+		return NULL;
+	return sym;
+}
+
+static bool rap_pvh_word(struct objtool_file *file, struct symbol *sym,
+		unsigned long index, uint64_t expected, struct symbol *target)
+{
+	unsigned long off = sym->offset + index * 8;
+	struct reloc *reloc = find_reloc_by_dest(file->elf, sym->sec, off);
+	uint64_t value;
+
+	memcpy(&value, sym->sec->data->d_buf + off, 8);
+	if (find_reloc_by_dest_range(file->elf, sym->sec, off + 1, 7))
+		return false;
+	if (!target)
+		return !reloc && value == expected;
+	return !value && reloc && reloc_type(reloc) == R_X86_64_64 &&
+		reloc->sym->sec == target->sec &&
+		reloc->sym->offset + reloc_addend(reloc) == target->offset + expected;
+}
+
+static bool rap_pvh_notes(struct objtool_file *file, unsigned int large_count)
+{
+	struct symbol *entry = find_symbol_by_name(file->elf, "xen_elfnote_phys32_entry");
+	struct symbol *value = find_symbol_by_name(file->elf, "xen_elfnote_phys32_entry_value");
+	struct symbol *note = find_symbol_by_name(file->elf, "pvh_reloc_note");
+	struct reloc *reloc;
+	uint32_t fields[3];
+
+	if (!entry || is_undef_sym(entry) || is_weak_sym(entry) || !value ||
+	    !note || note->len != 12 || is_undef_sym(note) || is_weak_sym(note) ||
+	    strcmp(entry->sec->name, ".note.Xen") || note->sec != entry->sec ||
+	    entry->offset < 16 || note->offset < 16 ||
+	    entry->offset + 8 > sec_size(entry->sec) || note->offset + 12 > sec_size(note->sec) ||
+	    memcmp(entry->sec->data->d_buf + entry->offset - 16,
+		   "\x04\0\0\0\x08\0\0\0\x12\0\0\0Xen\0", 16) ||
+	    memcmp(note->sec->data->d_buf + note->offset - 16,
+		   "\x04\0\0\0\x0c\0\0\0\x13\0\0\0Xen\0", 16) ||
+	    memcmp(entry->sec->data->d_buf + entry->offset, (char[8]){}, 8) ||
+	    find_reloc_by_dest_range(file->elf, entry->sec, entry->offset - 16, 16) ||
+	    find_reloc_by_dest_range(file->elf, entry->sec, entry->offset + 1, 7) ||
+	    find_reloc_by_dest_range(file->elf, note->sec, note->offset - 16, 28))
+		return false;
+	reloc = find_reloc_by_dest(file->elf, entry->sec, entry->offset);
+	if (!reloc || reloc_type(reloc) != R_X86_64_PC64 || reloc->sym != value || reloc_addend(reloc))
+		return false;
+	memcpy(fields, note->sec->data->d_buf + note->offset, sizeof(fields));
+	return fields[0] >= 0x200000 && !(fields[0] & (fields[0] - 1)) &&
+		!(fields[1] & (fields[0] - 1)) && fields[1] <= fields[2] &&
+		fields[2] == ((uint64_t)large_count << 21) - 1;
+}
+
+static int validate_rap_pvh_peers(struct objtool_file *file)
+{
+	static const char * const names[] = { "pvh_start_xen", "hdn_pvh_physical64", "hdn_pvh_virtual64" };
+	static const char * const tables[] = { "pvh_init_top_pgt", "pvh_level3_ident_pgt",
+		"pvh_level2_ident_pgt", "pvh_level3_kernel_pgt", "pvh_level2_kernel_pgt" };
+	struct symbol *roots[3], *page[5], *gdt, *desc, *stack, *stack_end, *info, *size;
+	struct section *mode32 = find_section_by_name(file->elf, ".init.text.hdn_pvh32");
+	struct instruction *insn;
+	unsigned int i, j, large_count = 0;
+	uint32_t info_size;
+
+	if (!mode32)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(roots); i++) {
+		roots[i] = find_symbol_by_name(file->elf, names[i]);
+		if (!roots[i] || roots[i]->rap_kind != 52 + i || !roots[i]->rap_pvh_protocol)
+			goto bad;
+	}
+	if (roots[0]->sec != mode32 || roots[1]->sec == mode32 || roots[2]->sec == mode32)
+		goto bad;
+	gdt = rap_pvh_data(file, "pvh_gdt", 8);
+	desc = rap_pvh_data(file, "pvh_gdt_start", 24);
+	stack = rap_pvh_data(file, "pvh_early_stack", 0x4000);
+	stack_end = find_symbol_by_name(file->elf, "pvh_early_stack_end");
+	if (!gdt || !desc || desc->sec != gdt->sec || desc->offset != gdt->offset + 8 ||
+	    !rap_pvh_word(file, gdt, 0, 0x80017, NULL) ||
+	    !rap_pvh_word(file, desc, 0, 0, NULL) ||
+	    !rap_pvh_word(file, desc, 1, 0x00af9b000000ffffULL, NULL) ||
+	    !rap_pvh_word(file, desc, 2, 0x00cf93000000ffffULL, NULL) ||
+	    !stack || !stack_end || stack_end->sec != stack->sec ||
+	    stack_end->offset != stack->offset + stack->len || stack->offset % 16)
+		goto bad;
+	for (i = 0; i < ARRAY_SIZE(page); i++) {
+		page[i] = rap_pvh_data(file, tables[i], 4096);
+		if (!page[i] || page[i]->offset % 4096)
+			goto bad;
+	}
+	for (i = 0; i < 512; i++) {
+		if (!rap_pvh_word(file, page[0], i, (i == 0 || i == 273) ? 0x80000063ULL :
+				 i == 511 ? 0x80000067ULL : 0,
+				 (i == 0 || i == 273) ? page[1] : i == 511 ? page[3] : NULL) ||
+		    !rap_pvh_word(file, page[1], i, i == 0 ? 0x80000063ULL : 0, i == 0 ? page[2] : NULL) ||
+		    !rap_pvh_word(file, page[2], i, ((uint64_t)i << 21) | 0x1e3, NULL) ||
+		    !rap_pvh_word(file, page[3], i, i == 510 ? 0x80000063ULL : 0, i == 510 ? page[4] : NULL))
+			goto bad;
+		if (rap_pvh_word(file, page[4], i, ((uint64_t)i << 21) | 0x1e3, NULL)) {
+			if (large_count != i)
+				goto bad;
+			large_count++;
+		} else if (!rap_pvh_word(file, page[4], i, 0, NULL)) {
+			goto bad;
+		}
+	}
+	if ((large_count != 256 && large_count != 512) || !rap_pvh_notes(file, large_count))
+		goto bad;
+	if (opts.link) {
+		struct symbol *prepare = find_symbol_by_name(file->elf, "xen_prepare_pvh");
+		struct symbol *startup = find_symbol_by_name(file->elf, "startup_64");
+		struct symbol *base = find_symbol_by_name(file->elf, "phys_base");
+		info = find_symbol_by_name(file->elf, "pvh_start_info");
+		size = rap_pvh_data(file, "pvh_start_info_sz", 4);
+		if (!prepare || prepare->rap_kind != 1 || !prepare->sec->init ||
+		    !startup || startup->rap_kind != 48 || !startup->rap_startup_protocol ||
+		    !base || base->len != 8 || strcmp(base->sec->name, ".data..ro_after_init") ||
+		    !info || !rap_pvh_data(file, "pvh_start_info", info->len) || !size ||
+		    !rap_pvh_data(file, "pvh_bootparams", 4096) ||
+		    find_reloc_by_dest_range(file->elf, size->sec, size->offset, 4))
+			goto bad;
+		memcpy(&info_size, size->sec->data->d_buf + size->offset, 4);
+		if (!info_size || info_size % 4 || info_size != info->len)
+			goto bad;
+	}
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct section *sec;
+		unsigned long offset;
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset))
+			continue;
+		for (j = 0; j < ARRAY_SIZE(roots); j++)
+			if (sec == roots[j]->sec && offset >= roots[j]->offset &&
+			    offset < roots[j]->offset + roots[j]->len && owner != roots[j])
+				goto bad;
+	}
+	return 0;
+bad:
+	ERROR("RAP PVH has invalid boot tables, stack, peer roots or an unauthorized incoming transfer");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-rewind.h linux-7.0.12-hdn/tools/objtool/hdn-rewind.h
--- linux-7.0.12/tools/objtool/hdn-rewind.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-rewind.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Oops recovery is a one-way stack abandonment, not an exception to the
+ * normal protected return ABI. Its new SP comes only from the closed root. */
+static int verify_rap_rewind(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct symbol *root = find_symbol_by_name(file->elf, "hdn_rap_fatal_rewind");
+	struct symbol *exit = find_symbol_by_name(file->elf, "make_task_dead");
+	struct instruction *insn;
+
+	if (func->rap_kind != 1 || func->rap_returns || is_weak_sym(func) ||
+	    !rap_sequence_bytes(&s, "\x4c\x8d\x1d\x05\0\0\0", 7) ||
+	    !rap_sequence_edge_match(&s, "__hdn_rap_enter", true, false) ||
+	    !rap_sequence_bytes(&s, "\xfa\x41\x89\xfc\x48\x89\xe7\x48\x83\xec\x08", 11) ||
+	    !rap_entry_call(&s, "hdn_rap_fatal_rewind") ||
+	    !rap_sequence_bytes(&s, "\x31\xed\x48\x89\xc4\x44\x89\xe7", 8) ||
+	    !rap_entry_call(&s, "make_task_dead") || s.pos != func->len ||
+	    !root || !exit || (opts.link && (root->rap_kind != 2 || exit->rap_kind != 1)))
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts)
+			goto bad;
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct section *sec;
+		unsigned long offset;
+
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset))
+			continue;
+		if (sec == func->sec && offset >= func->offset && offset < func->offset + func->len) {
+			if (owner && owner->pfunc)
+				owner = owner->pfunc;
+			if (offset != func->offset || insn->type != INSN_CALL || !insn->rap_site ||
+			    !owner || strcmp(owner->name, "oops_end") || owner->rap_kind != 1)
+				goto bad;
+		}
+		if (!is_undef_sym(root) && owner != root && (!owner || owner->pfunc != root) &&
+		    sec == root->sec && offset >= root->offset && offset < root->offset + root->len &&
+		    (owner != func || offset != root->offset || insn->type != INSN_CALL || !insn->rap_site))
+			goto bad;
+	}
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP fatal stack rewind lacks its closed abandonment protocol");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-syscall.h linux-7.0.12-hdn/tools/objtool/hdn-syscall.h
--- linux-7.0.12/tools/objtool/hdn-syscall.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-syscall.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+static bool rap_hw_bhb(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+
+	if (!rap_hw_skip(&k, "X86_FEATURE_CLEAR_BHB_LOOP", 0) ||
+	    !rap_entry_call(&k.seq, "clear_bhb_loop") || !rap_kexec_label(&k, 0) ||
+	    !rap_hw_local_edges(&k))
+		return false;
+	*s = k.seq;
+	return true;
+}
+
+static bool rap_hw_syscall_regs(struct rap_sequence *s)
+{
+	/* PUSH_AND_CLEAR_REGS rax=$-ENOSYS. */
+	return rap_sequence_bytes(s,
+		"\x57\x56\x52\x51\x6a\xda\x41\x50\x41\x51\x41\x52\x41\x53"
+		"\x53\x55\x41\x54\x41\x55\x41\x56\x41\x57"
+		"\x31\xf6\x31\xd2\x31\xc9\x45\x31\xc0\x45\x31\xc9\x45\x31\xd2"
+		"\x45\x31\xdb\x31\xdb\x31\xed\x45\x31\xe4\x45\x31\xed\x45\x31\xf6\x45\x31\xff", 58);
+}
+
+static int verify_rap_syscall(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+
+#define SYSCALL_BYTES(bytes) do { if (!rap_sequence_bytes(&s, bytes, sizeof(bytes) - 1)) goto bad; } while (0)
+#define SYSCALL_LABEL(name) do { if (!rap_thunk_symbol(file, name, func->sec, func->offset + s.pos)) goto bad; } while (0)
+	if (is_weak_sym(func) || !func->sec->noinstr || strcmp(func->name, "entry_SYSCALL_64") || !rap_hw_endbr(&s))
+		goto bad;
+	SYSCALL_BYTES("\x0f\x01\xf8");
+	if (!rap_thunk_percpu_offset(&s, "\x48\x89\x25", 3, "", 0, "cpu_tss_rw", 20) ||
+	    !rap_hw_switch_kernel_cr3(&s, 4) ||
+	    !rap_thunk_percpu(&s, "\x48\x8b\x25", 3, "", 0, "cpu_current_top_of_stack"))
+		goto bad;
+	SYSCALL_LABEL("entry_SYSCALL_64_safe_stack");
+	SYSCALL_BYTES("\x6a\x2b");
+	if (!rap_thunk_percpu_offset(&s, "\xff\x35", 2, "", 0, "cpu_tss_rw", 20))
+		goto bad;
+	SYSCALL_BYTES("\x41\x53\x6a\x33\x51");
+	SYSCALL_LABEL("entry_SYSCALL_64_after_hwframe");
+	SYSCALL_BYTES("\x50");
+	if (!rap_hw_syscall_regs(&s))
+		goto bad;
+	SYSCALL_BYTES("\x48\x89\xe7\x48\x63\xf0");
+	if (!rap_hw_ibrs(&s, true, false) || !rap_hw_untrain(&s, false) || !rap_hw_bhb(&s) ||
+	    !rap_entry_call(&s, "do_syscall_64"))
+		goto bad;
+	SYSCALL_BYTES("\x84\xc0");
+	if (!rap_hw_branch(&s, "swapgs_restore_regs_and_return_to_usermode", 0x74) ||
+	    !rap_hw_ibrs(&s, false, false) || !rap_hw_pop_except_rdi(&s))
+		goto bad;
+	SYSCALL_BYTES("\x48\x89\xe7");
+	if (!rap_thunk_percpu_offset(&s, "\x48\x8b\x25", 3, "", 0, "cpu_tss_rw", 4))
+		goto bad;
+	SYSCALL_BYTES("\xff\x77\x28\xff\x37");
+	if (!rap_hw_stack_erase(&s, true) || !rap_hw_user_cr3_stack(&s))
+		goto bad;
+	SYSCALL_BYTES("\x5f\x5c");
+	SYSCALL_LABEL("entry_SYSRETQ_unsafe_stack");
+	SYSCALL_BYTES("\x0f\x01\xf8");
+	if (!rap_hw_clear_buffers(&s))
+		goto bad;
+	SYSCALL_BYTES("\x48\x0f\x07");
+	SYSCALL_LABEL("entry_SYSRETQ_end");
+	SYSCALL_BYTES("\xcc");
+	if (s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt && !insn->rap_thunk_alt)
+			goto bad;
+	func->rap_syscall_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP syscall root differs from its complete native entry/exit protocol");
+	return -1;
+#undef SYSCALL_LABEL
+#undef SYSCALL_BYTES
+}
+
+static int validate_rap_syscall_peers(struct objtool_file *file)
+{
+	struct symbol *func = find_symbol_by_name(file->elf, "entry_SYSCALL_64");
+	struct instruction *insn;
+
+	if (!func || is_undef_sym(func))
+		return 0;
+	if (func->rap_kind != 42 || !func->rap_syscall_protocol)
+		goto bad;
+	if (opts.link) {
+		struct symbol *call = find_symbol_by_name(file->elf, "do_syscall_64");
+		struct symbol *bhb = find_symbol_by_name(file->elf, "clear_bhb_loop");
+		if (!call || call->rap_kind != 1 || !bhb || bhb->rap_kind != 5)
+			goto bad;
+	}
+	for_each_insn(file, insn) {
+		struct section *sec;
+		unsigned long offset;
+		if (rap_entry_owner(insn) != func && rap_thunk_edge_target(file, insn, &sec, &offset) &&
+		    sec == func->sec && offset >= func->offset && offset < func->offset + func->len)
+			goto bad;
+	}
+	return 0;
+bad:
+	ERROR("RAP syscall root has an unverified handler or an incoming direct transfer");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-thunks.h linux-7.0.12-hdn/tools/objtool/hdn-thunks.h
--- linux-7.0.12/tools/objtool/hdn-thunks.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-thunks.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,607 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The mitigation thunks are not C functions. Their local CALL/RET pairs model
+ * the predictor, and replacing them with RAP calls breaks that protocol. Admit
+ * only these complete instruction sequences, their exact register slots and
+ * alternatives. This does not grant an ordinary indirect-call target.
+ */
+static const char * const rap_thunk_names[] = {
+	"__x86_indirect_thunk_array", "__x86_indirect_call_thunk_array",
+	"__x86_indirect_jump_thunk_array", "__hdn_its_thunk_region",
+	"srso_alias_untrain_ret", "srso_alias_return_thunk", "srso_untrain_ret",
+	"srso_return_thunk", "retbleed_untrain_ret", "entry_untrain_ret",
+	"call_depth_return_thunk", "its_return_thunk", "__x86_return_thunk",
+	"write_ibpb",
+};
+
+static bool rap_thunk_name(const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(rap_thunk_names); i++)
+		if (!strcmp(name, rap_thunk_names[i]))
+			return true;
+	return false;
+}
+
+static bool rap_thunk_symbol(struct objtool_file *file, const char *name,
+		struct section *sec, unsigned long offset)
+{
+	struct symbol *sym = find_symbol_by_name(file->elf, name);
+
+	return sym && !is_weak_sym(sym) && sym->sec == sec && sym->offset == offset;
+}
+
+/* The marker is set only after matching a complete closed instruction span.
+ * It also covers embedded RET instructions which the regular decoder models
+ * through the containing MOVABS/TEST rather than a separate function. */
+static void rap_thunk_mark(struct objtool_file *file, struct symbol *span)
+{
+	struct instruction *insn;
+
+	for_each_insn(file, insn)
+		if (insn->sec == span->sec && insn->offset >= span->offset &&
+		    insn->offset < span->offset + span->len)
+			insn->rap_thunk_safe = true;
+}
+
+static bool rap_thunk_padding(struct rap_sequence *s, unsigned long end, bool traps)
+{
+	while (s->pos < end) {
+		struct instruction *insn = find_insn(s->file, s->func->sec,
+				s->func->offset + s->pos);
+		const char *p = s->func->sec->data->d_buf + s->func->offset + s->pos;
+
+		if (!insn || !insn->len || insn->len > end - s->pos ||
+		    (traps ? (insn->len != 1 || *p != (char)0xcc) : insn->type != INSN_NOP) ||
+		    !rap_sequence_bytes(s, p, insn->len))
+			return false;
+	}
+	return s->pos == end;
+}
+
+/* RIP displacement is followed by an optional immediate. Matching the whole
+ * instruction keeps a valid symbol with a changed shift count from passing. */
+static bool rap_thunk_percpu_offset(struct rap_sequence *s, const char *op, size_t oplen,
+		const char *imm, size_t immlen, const char *name, unsigned long member)
+{
+	struct symbol *target = find_symbol_by_name(s->file->elf, name);
+	unsigned long off = s->func->offset + s->pos;
+	struct instruction *insn = find_insn(s->file, s->func->sec, off);
+	const char *p = s->func->sec->data->d_buf + off;
+	struct reloc *reloc;
+	size_t seg;
+
+	if (!target || is_weak_sym(target) || !insn || s->pos >= s->func->len)
+		return false;
+	seg = (unsigned char)p[0] == 0x65;
+	if (insn->len != seg + oplen + 4 + immlen || insn->len > s->func->len - s->pos ||
+	    memcmp(p + seg, op, oplen) || memcmp(p + seg + oplen + 4, imm, immlen))
+		return false;
+	reloc = find_reloc_by_dest(s->file->elf, s->func->sec, off + seg + oplen);
+	if (!reloc || !arch_pc_relative_reloc(reloc) || arch_reloc_size(reloc) != 4 ||
+	    reloc->sym->sec != target->sec || (is_undef_sym(target) && reloc->sym != target) ||
+	    reloc->sym->offset + arch_insn_adjusted_addend(insn, reloc) != target->offset + member ||
+	    find_reloc_by_dest_range(s->file->elf, s->func->sec, off, seg + oplen) ||
+	    find_reloc_by_dest_range(s->file->elf, s->func->sec, off + seg + oplen + 1,
+				    3 + immlen))
+		return false;
+	/* At final link the addressing mode must agree with the selected per-CPU
+	 * representation; no GS override is valid for a UP ordinary data symbol. */
+	if (!is_undef_sym(target) && !!strstr(target->sec->name, "..percpu") != !!seg)
+		return false;
+	s->pos += insn->len;
+	return true;
+}
+
+static bool rap_thunk_percpu(struct rap_sequence *s, const char *op, size_t oplen,
+		const char *imm, size_t immlen, const char *name)
+{
+	return rap_thunk_percpu_offset(s, op, oplen, imm, immlen, name, 0);
+}
+
+static bool rap_thunk_debug(struct rap_sequence *s, const char *name)
+{
+	struct symbol *target = find_symbol_by_name(s->file->elf, name);
+
+	if (!target)
+		return true;
+	return rap_thunk_percpu(s, "\x48\xff\x05", 3, "", 0, name);
+}
+
+static bool rap_thunk_poline(struct rap_sequence *s, unsigned int reg)
+{
+	unsigned char move[] = { reg < 8 ? 0x48 : 0x4c, 0x89, 0x04 | ((reg & 7) << 3), 0x24 };
+
+	return rap_sequence_bytes(s, "\xe8\x01\0\0\0\xcc", 6) &&
+		rap_sequence_bytes(s, (const char *)move, sizeof(move));
+}
+
+static bool rap_thunk_indirect(struct rap_sequence *s, unsigned int reg)
+{
+	unsigned char jump[] = { 0x41, 0xff, 0xe0 | (reg & 7) };
+
+	return rap_sequence_bytes(s, (const char *)jump + (reg < 8), sizeof(jump) - (reg < 8));
+}
+
+static bool rap_thunk_ret(struct rap_sequence *s)
+{
+	const char *p = s->func->sec->data->d_buf + s->func->offset + s->pos;
+
+	if (s->pos < s->func->len && (unsigned char)*p == 0xc3) {
+		if (!rap_sequence_bytes(s, "\xc3", 1))
+			return false;
+		if (s->pos < s->func->len && (unsigned char)p[1] == 0xcc)
+			return rap_sequence_bytes(s, "\xcc", 1);
+		return true;
+	}
+	return rap_sequence_edge_match(s, "__x86_return_thunk", false, false);
+}
+
+static bool rap_thunk_fill_reg(struct rap_sequence *s, bool full, unsigned int reg)
+{
+	unsigned long loop;
+	const unsigned char *p;
+
+	if (!full)
+		return rap_sequence_bytes(s, "\x90\x90\xe8\x01\0\0\0\xcc"
+					 "\x48\x83\xc4\x08\x0f\xae\xe8", 15);
+	if ((reg != 0 && reg != 12) || !rap_sequence_bytes(s, reg == 0 ?
+		"\x48\xc7\xc0\x10\0\0\0" : "\x49\xc7\xc4\x10\0\0\0", 7))
+		return false;
+	loop = s->pos;
+	if (!rap_sequence_bytes(s, "\xe8\x01\0\0\0\xcc\xe8\x01\0\0\0\xcc"
+				  "\x48\x83\xc4\x10", 16) ||
+	    !rap_sequence_bytes(s, reg == 0 ? "\x48\xff\xc8" : "\x49\xff\xcc", 3) ||
+	    s->pos + 2 > s->func->len)
+		return false;
+	p = s->func->sec->data->d_buf + s->func->offset + s->pos;
+	if (p[0] != 0x75 || s->pos + 2 + (signed char)p[1] != loop ||
+	    !rap_sequence_bytes(s, (const char *)p, 2) ||
+	    !rap_sequence_bytes(s, "\x0f\xae\xe8", 3))
+		return false;
+	if (find_symbol_by_name(s->file->elf, "__x86_call_depth") &&
+	    !rap_thunk_percpu(s, "\x48\xc7\x05", 3, "\xff\xff\xff\xff", 4,
+			      "__x86_call_depth"))
+		return false;
+	return rap_thunk_debug(s, "__x86_ctxsw_count");
+}
+
+static bool rap_thunk_fill(struct rap_sequence *s, bool full)
+{
+	return rap_thunk_fill_reg(s, full, 0);
+}
+
+enum rap_thunk_alt {
+	RAP_ALT_INDIRECT, RAP_ALT_DEPTH, RAP_ALT_UNTRAIN, RAP_ALT_RETURN, RAP_ALT_IBPB,
+	RAP_ALT_SWITCH_RSB
+};
+
+/* Validate the original span separately from all replacement spans. Padding
+ * inserted by GAS is checked too; objtool's synthetic trailing NOP is not part
+ * of the ELF and is deliberately excluded from the replacement extent. */
+static bool rap_thunk_alternative(struct rap_sequence *s, enum rap_thunk_alt type,
+		unsigned int reg)
+{
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	struct alt_group *orig = first ? first->alt_group : NULL;
+	struct alternative *alt;
+	struct symbol span;
+	struct rap_sequence body;
+	unsigned long end;
+	unsigned int mask = 0;
+
+	if (!orig || orig->orig_group || orig->first_insn != first)
+		return false;
+	end = orig->last_insn->offset + orig->last_insn->len - s->func->offset;
+	if (end > s->func->len || end <= s->pos)
+		return false;
+	for (alt = first->alts; alt; alt = alt->next) {
+		struct alt_group *g = alt->insn->alt_group;
+		const char *feature;
+		unsigned int bit;
+
+		if (alt->type != ALT_TYPE_INSTRUCTIONS || !g || g->orig_group != orig ||
+		    g->first_insn != alt->insn || !g->last_insn)
+			return false;
+		feature = arch_cpu_feature_name(g->feature & 0xffff);
+		if (!feature)
+			return false;
+		span = *s->func;
+		span.sec = alt->insn->sec;
+		span.offset = alt->insn->offset;
+		span.len = g->last_insn->offset + g->last_insn->len - span.offset;
+		if (span.len > end - s->pos)
+			return false;
+		body = (struct rap_sequence){ .file = s->file, .func = &span };
+		if (type == RAP_ALT_IBPB || type == RAP_ALT_SWITCH_RSB) {
+			if (!strcmp(feature, type == RAP_ALT_IBPB ? "X86_BUG_IBPB_NO_RET" :
+									 "X86_FEATURE_RSB_CTXSW") && !(g->feature >> 16)) {
+				bit = 1;
+				if (!rap_thunk_fill_reg(&body, true, type == RAP_ALT_IBPB ? 0 : 12)) return false;
+			} else if (!strcmp(feature, "X86_FEATURE_ALWAYS") && (g->feature >> 16) == 1) {
+				bit = 2;
+				if (!rap_thunk_fill(&body, false)) return false;
+			} else {
+				return false;
+			}
+		} else if (type == RAP_ALT_INDIRECT) {
+			if (!strcmp(feature, "X86_FEATURE_RETPOLINE_LFENCE") && !(g->feature >> 16)) {
+				bit = 1;
+				if (!rap_sequence_bytes(&body, "\x0f\xae\xe8", 3) ||
+				    !rap_thunk_indirect(&body, reg) || !rap_sequence_bytes(&body, "\xcc", 1))
+					return false;
+			} else if (!strcmp(feature, "X86_FEATURE_RETPOLINE") && (g->feature >> 16) == 1) {
+				bit = 2;
+				if (!rap_thunk_indirect(&body, reg))
+					return false;
+			} else {
+				return false;
+			}
+		} else {
+			bit = 1;
+			if (g->feature >> 16)
+				return false;
+			if (type == RAP_ALT_DEPTH) {
+				if (strcmp(feature, "X86_FEATURE_CALL_DEPTH") ||
+				    !rap_thunk_percpu(&body, "\x48\xc1\x3d", 3, "\x05", 1, "__x86_call_depth") ||
+				    !rap_thunk_debug(&body, "__x86_call_count"))
+					return false;
+			} else if (type == RAP_ALT_UNTRAIN) {
+				if (strcmp(feature, "X86_FEATURE_SRSO"))
+					return false;
+				if (find_symbol_by_name(s->file->elf, "srso_untrain_ret")) {
+					if (!rap_sequence_edge_match(&body, "srso_untrain_ret", false, false))
+						return false;
+				} else if (!rap_sequence_bytes(&body, "\x0f\x0b", 2)) {
+					return false;
+				}
+			} else if (strcmp(feature, "X86_FEATURE_ALWAYS") ||
+				   !rap_sequence_bytes(&body, "\x0f\x0b", 2)) {
+				return false;
+			}
+		}
+		if ((mask & bit) || body.pos != span.len)
+			return false;
+		mask |= bit;
+		rap_thunk_mark(s->file, &span);
+	}
+	if (mask != (type == RAP_ALT_INDIRECT || type == RAP_ALT_IBPB || type == RAP_ALT_SWITCH_RSB ? 3 : 1))
+		return false;
+	if (type == RAP_ALT_IBPB || type == RAP_ALT_SWITCH_RSB) {
+		const char *p = first->sec->data->d_buf + first->offset;
+		if (!((first->len == 2 && (unsigned char)*p == 0xeb) ||
+		      (first->len == 5 && (unsigned char)*p == 0xe9)) ||
+		    arch_jump_destination(first) != s->func->offset + end ||
+		    !rap_sequence_bytes(s, p, first->len))
+			return false;
+	} else if (type == RAP_ALT_INDIRECT) {
+		if (!rap_thunk_poline(s, reg) || !rap_thunk_ret(s))
+			return false;
+	} else if (type == RAP_ALT_UNTRAIN) {
+		if (find_symbol_by_name(s->file->elf, "retbleed_untrain_ret")) {
+			if (!rap_sequence_edge_match(s, "retbleed_untrain_ret", false, false))
+				return false;
+		} else if (!rap_sequence_bytes(s, "\x0f\x0b", 2)) {
+			return false;
+		}
+	} else if (type == RAP_ALT_RETURN && !rap_sequence_bytes(s, "\xc3", 1)) {
+		return false;
+	}
+	if (!rap_thunk_padding(s, end, false))
+		return false;
+	first->rap_thunk_alt = true;
+	return true;
+}
+
+static bool rap_thunk_array(struct rap_sequence *s, unsigned int variant)
+{
+	static const char * const regs[] = {
+		"rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi",
+		"r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"
+	};
+	static const char * const prefix[] = { "__x86_indirect_thunk_",
+		"__x86_indirect_call_thunk_", "__x86_indirect_jump_thunk_",
+		"__x86_indirect_its_thunk_" };
+	unsigned int reg, stride = variant == 3 ? 64 : 32;
+	char name[64];
+
+	if (s->func->len != 16 * stride ||
+	    (s->func->offset & (stride - 1)) != (variant == 3 ? 29 : 0))
+		return false;
+	for (reg = 0; reg < 16; reg++) {
+		snprintf(name, sizeof(name), "%s%s", prefix[variant], regs[reg]);
+		if (!rap_thunk_symbol(s->file, name, s->func->sec,
+				s->func->offset + s->pos + (variant == 3 ? 3 : 0)))
+			return false;
+		if (variant == 3) {
+			snprintf(name, sizeof(name), "__x86_indirect_paranoid_thunk_%s", regs[reg]);
+			if (!rap_thunk_symbol(s->file, name, s->func->sec, s->func->offset + s->pos + 1) ||
+			    !rap_sequence_bytes(s, "\xd6\x75\xfd", 3) ||
+			    !rap_thunk_indirect(s, reg) || !rap_thunk_padding(s, (reg + 1) * stride, true))
+				return false;
+		} else {
+			if (!variant) {
+				if (!rap_thunk_alternative(s, RAP_ALT_INDIRECT, reg))
+					return false;
+			} else {
+				if ((variant == 1 && !rap_thunk_alternative(s, RAP_ALT_DEPTH, reg)) ||
+				    !rap_thunk_poline(s, reg) || !rap_sequence_bytes(s, "\xc3\xcc", 2))
+					return false;
+			}
+			if (!rap_thunk_padding(s, (reg + 1) * stride, false))
+				return false;
+		}
+	}
+	return true;
+}
+
+static bool rap_thunk_alias_safe(struct objtool_file *file)
+{
+	struct symbol *safe = find_symbol_by_name(file->elf, "srso_alias_safe_ret");
+	struct rap_sequence s = { .file = file, .func = safe };
+
+	if (!safe || is_weak_sym(safe) || !safe->sec->text || safe->len != 7 ||
+	    !rap_sequence_bytes(&s, "\x48\x8d\x64\x24\x08\xc3\xcc", 7))
+		return false;
+	rap_thunk_mark(file, safe);
+	return true;
+}
+
+static bool rap_thunk_peer(struct objtool_file *file, const char *name)
+{
+	struct symbol *sym = find_symbol_by_name(file->elf, name);
+
+	return sym && (is_undef_sym(sym) ? !opts.link :
+			sym->rap_kind == 27 && sym->rap_thunk_protocol);
+}
+
+/* Direct edges have already been recategorized as synthetic returns or
+ * indirect branches by objtool. Recover only their actual PC operand here;
+ * a symbol name alone would miss a relocation redirected into padding. */
+static bool rap_thunk_edge_target(struct objtool_file *file, struct instruction *insn,
+		struct section **sec, unsigned long *offset)
+{
+	const unsigned char *p;
+	unsigned int prefix, width;
+	struct reloc *reloc;
+	s32 displacement;
+
+	if (insn->fake || !insn->len || insn->offset >= sec_size(insn->sec))
+		return false;
+	p = insn->sec->data->d_buf + insn->offset;
+	prefix = p[0] == 0x2e;
+	if (insn->len == prefix + 5 && (p[prefix] == 0xe8 || p[prefix] == 0xe9))
+		width = 4;
+	else if (insn->len == prefix + 2 && (p[prefix] == 0xeb ||
+		 (p[prefix] >= 0x70 && p[prefix] <= 0x7f)))
+		width = 1;
+	else if (insn->len == prefix + 6 && p[prefix] == 0x0f &&
+		 p[prefix + 1] >= 0x80 && p[prefix + 1] <= 0x8f)
+		width = 4;
+	else
+		return false;
+	reloc = find_reloc_by_dest_range(file->elf, insn->sec, insn->offset, insn->len);
+	if (reloc) {
+		if (is_undef_sym(reloc->sym))
+			return false;
+		*sec = reloc->sym->sec;
+		*offset = reloc->sym->offset + arch_insn_adjusted_addend(insn, reloc);
+	} else {
+		if (width == 4)
+			memcpy(&displacement, p + insn->len - 4, 4);
+		else
+			displacement = (signed char)p[insn->len - 1];
+		*sec = insn->sec;
+		*offset = insn->offset + insn->len + displacement;
+	}
+	return true;
+}
+
+static int validate_rap_thunk_peers(struct objtool_file *file)
+{
+	static const struct { const char *from, *to; } peers[] = {
+		{ "srso_return_thunk", "srso_untrain_ret" },
+		{ "srso_alias_return_thunk", "srso_alias_untrain_ret" },
+		{ "__x86_indirect_call_thunk_array", "call_depth_return_thunk" },
+		{ "__x86_indirect_jump_thunk_array", "call_depth_return_thunk" },
+	};
+	struct symbol *sym;
+	struct symbol *safe = find_symbol_by_name(file->elf, "srso_alias_safe_ret");
+	struct section *targets = find_section_by_name(file->elf, ".hdn.rap.targets");
+	struct instruction *insn;
+	unsigned int i;
+
+	for_each_sym(file->elf, sym) {
+		if (is_undef_sym(sym) || !rap_thunk_name(sym->name))
+			continue;
+		if (sym->rap_kind != 27 || !sym->rap_thunk_protocol) {
+			ERROR_FUNC(sym->sec, sym->offset, "mitigation body lacks its unique RAP protocol record");
+			return -1;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(peers); i++) {
+		sym = find_symbol_by_name(file->elf, peers[i].from);
+		if (sym && !is_undef_sym(sym) && !rap_thunk_peer(file, peers[i].to)) {
+			ERROR_FUNC(sym->sec, sym->offset, "RAP mitigation thunk lacks its checked peer body");
+			return -1;
+		}
+	}
+	if (safe && !is_undef_sym(safe)) {
+		unsigned long off;
+		if (!rap_thunk_peer(file, "srso_alias_return_thunk") || !rap_thunk_alias_safe(file)) {
+			ERROR_FUNC(safe->sec, safe->offset, "orphan RAP embedded mitigation return");
+			return -1;
+		}
+		for (off = 0; targets && off < sec_size(targets); off += 16) {
+			struct reloc *reloc = find_reloc_by_dest(file->elf, targets, off);
+			if (reloc && reloc->sym->sec == safe->sec &&
+			    reloc->sym->offset + reloc_addend(reloc) >= safe->offset &&
+			    reloc->sym->offset + reloc_addend(reloc) < safe->offset + safe->len) {
+				ERROR_FUNC(safe->sec, safe->offset, "embedded mitigation return has ordinary target permission");
+				return -1;
+			}
+		}
+	}
+	for_each_insn(file, insn) {
+		struct section *sec;
+		unsigned long offset;
+
+		if (insn->rap_thunk_safe && insn->alts && !insn->rap_thunk_alt) {
+			ERROR_INSN(insn, "unexpected alternative in a RAP mitigation body");
+			return -1;
+		}
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset))
+			continue;
+		if (safe && !is_undef_sym(safe) && safe->sec == sec &&
+		    offset >= safe->offset && offset < safe->offset + safe->len &&
+		    !insn->rap_thunk_safe) {
+			ERROR_INSN(insn, "ordinary code enters an embedded mitigation return");
+			return -1;
+		}
+		for (i = 0; i < ARRAY_SIZE(rap_thunk_names); i++) {
+			unsigned long delta;
+			sym = find_symbol_by_name(file->elf, rap_thunk_names[i]);
+			if (!sym || !sym->rap_thunk_protocol || sym->sec != sec ||
+			    offset < sym->offset || offset >= sym->offset + sym->len)
+				continue;
+			/* Every outgoing edge in a checked mitigation body is exact. */
+			if (insn->rap_thunk_safe)
+				continue;
+			delta = offset - sym->offset;
+			if ((i < 3 && !(delta % 32)) ||
+			    (i == 3 && (delta % 64 == 1 || delta % 64 == 3)) ||
+			    (i > 3 && !delta))
+				continue;
+			ERROR_INSN(insn, "direct edge enters a RAP mitigation body at an unapproved offset");
+			return -1;
+		}
+	}
+	return 0;
+}
+
+/* These leaf services have no C callbacks, data-dependent stack access, or
+ * writes through caller-supplied addresses. Their CALL creates a fresh return
+ * slot and their full body is checked above, including unselected alternatives.
+ * They can therefore run before the asynchronous RAP context is established.
+ * No name-based exemption applies to an arbitrary function or return thunk. */
+static int read_rap_mitigation_calls(struct objtool_file *file)
+{
+	struct instruction *insn;
+
+	for_each_insn(file, insn) {
+		struct symbol *callee = insn->type == INSN_CALL ? insn_call_dest(insn) : NULL;
+		struct symbol span = { .sec = insn->sec, .offset = insn->offset, .len = insn->len };
+		struct rap_sequence s = { .file = file, .func = &span };
+
+		if (!callee || (strcmp(callee->name, "entry_untrain_ret") &&
+		    strcmp(callee->name, "srso_alias_untrain_ret") && strcmp(callee->name, "write_ibpb")))
+			continue;
+		if (!rap_thunk_peer(file, callee->name) ||
+		    !rap_sequence_edge_match(&s, callee->name, true, false) || s.pos != insn->len) {
+			ERROR_INSN(insn, "mitigation call lacks a complete closed leaf protocol");
+			return -1;
+		}
+		insn->rap_leaf_call = true;
+	}
+	return 0;
+}
+
+static int verify_rap_thunk(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+	unsigned int i;
+	const char *name = func->name;
+
+#define MT_BYTES(b) do { if (!rap_sequence_bytes(&s, b, sizeof(b) - 1)) goto bad; } while (0)
+#define MT_EDGE(n, c) do { if (!rap_sequence_edge_match(&s, n, c, false)) goto bad; } while (0)
+	if (is_weak_sym(func) || !rap_thunk_name(name) || !func->sec->text)
+		goto bad;
+	if (!strcmp(name, "__x86_indirect_thunk_array")) {
+		if (!rap_thunk_array(&s, 0)) goto bad;
+	} else if (!strcmp(name, "__x86_indirect_call_thunk_array")) {
+		if (!rap_thunk_array(&s, 1)) goto bad;
+	} else if (!strcmp(name, "__x86_indirect_jump_thunk_array")) {
+		if (!rap_thunk_array(&s, 2)) goto bad;
+	} else if (!strcmp(name, "__hdn_its_thunk_region")) {
+		if (!rap_thunk_array(&s, 3) ||
+		    !rap_thunk_symbol(file, "__x86_indirect_its_thunk_array", func->sec, func->offset + 3))
+			goto bad;
+	} else if (!strcmp(name, "srso_alias_untrain_ret")) {
+		if (func->len == 2) {
+			MT_BYTES("\xc3\xcc");
+		} else {
+			MT_BYTES("\x66\x90\x0f\xae\xe8");
+			MT_EDGE("srso_alias_return_thunk", false);
+			if (!rap_thunk_alias_safe(file)) goto bad;
+		}
+	} else if (!strcmp(name, "srso_alias_return_thunk")) {
+		MT_EDGE("srso_alias_safe_ret", true);
+		MT_BYTES("\x0f\x0b");
+		if (!rap_thunk_alias_safe(file)) goto bad;
+	} else if (!strcmp(name, "srso_untrain_ret")) {
+		if (!rap_thunk_symbol(file, "srso_safe_ret", func->sec, func->offset + 2) ||
+		    ((func->offset + 2) & 63)) goto bad;
+		MT_BYTES("\x48\xb8\x48\x8d\x64\x24\x08\xc3\xcc\xcc\x0f\xae\xe8");
+		MT_EDGE("srso_safe_ret", true);
+		MT_BYTES("\x0f\x0b");
+	} else if (!strcmp(name, "srso_return_thunk")) {
+		MT_EDGE("srso_safe_ret", true);
+		MT_BYTES("\x0f\x0b");
+	} else if (!strcmp(name, "retbleed_untrain_ret")) {
+		if (!rap_thunk_symbol(file, "retbleed_return_thunk", func->sec, func->offset + 1) ||
+		    ((func->offset + 1) & 63)) goto bad;
+		MT_BYTES("\xf6\xc3\xcc\x0f\xae\xe8");
+		MT_EDGE("retbleed_return_thunk", false);
+		MT_BYTES("\xcc");
+	} else if (!strcmp(name, "entry_untrain_ret")) {
+		if (!rap_thunk_alternative(&s, RAP_ALT_UNTRAIN, 0)) goto bad;
+	} else if (!strcmp(name, "call_depth_return_thunk")) {
+		unsigned long target;
+		const unsigned char *p;
+		if (!rap_thunk_debug(&s, "__x86_ret_count") ||
+		    !rap_thunk_percpu(&s, "\x48\xc1\x25", 3, "\x05", 1, "__x86_call_depth")) goto bad;
+		p = func->sec->data->d_buf + func->offset + s.pos;
+		if (s.pos + 2 > func->len || p[0] != 0x74) goto bad;
+		target = s.pos + 2 + (signed char)p[1];
+		if (!rap_sequence_bytes(&s, (const char *)p, 2)) goto bad;
+		MT_BYTES("\xc3\xcc");
+		if (target != s.pos || !rap_thunk_debug(&s, "__x86_stuffs_count")) goto bad;
+		for (i = 0; i < 16; i++) MT_BYTES("\xe8\x01\0\0\0\xcc");
+		MT_BYTES("\x48\x81\xc4\x80\0\0\0");
+		if (!rap_thunk_percpu(&s, "\x48\xc7\x05", 3, "\xff\xff\xff\xff", 4,
+				    "__x86_call_depth")) goto bad;
+		MT_BYTES("\xc3\xcc");
+	} else if (!strcmp(name, "its_return_thunk")) {
+		if ((func->offset & 63) != 32) goto bad;
+		MT_BYTES("\xc3\xcc");
+	} else if (!strcmp(name, "write_ibpb")) {
+		MT_BYTES("\xb9\x49\0\0\0");
+		if (!rap_sequence_reference(&s, "\x8b\x05", 2, "x86_pred_cmd", true)) goto bad;
+		MT_BYTES("\x31\xd2\x0f\x30");
+		if (!rap_thunk_alternative(&s, RAP_ALT_IBPB, 0) || !rap_thunk_ret(&s)) goto bad;
+	} else {
+		insn = find_insn(file, func->sec, func->offset);
+		if (insn && insn->alt_group) {
+			if (!rap_thunk_alternative(&s, RAP_ALT_RETURN, 0)) goto bad;
+		} else {
+			MT_BYTES("\xc3");
+		}
+		MT_BYTES("\xcc");
+	}
+	if (s.pos != func->len)
+		goto bad;
+	/* Nothing may append an unreviewed alternative to a matched instruction. */
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_thunk_alt)
+			goto bad;
+	rap_thunk_mark(file, func);
+	func->rap_thunk_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP mitigation thunk differs from its closed instruction protocol");
+	return -1;
+#undef MT_BYTES
+#undef MT_EDGE
+}
