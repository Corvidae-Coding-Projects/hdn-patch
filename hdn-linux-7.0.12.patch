+	native_load_idt(&desc);
+#else
 	void *handler = NULL;
 
 	if (IS_ENABLED(CONFIG_AMD_MEM_ENCRYPT)) {
@@ -320,4 +332,5 @@
 	}
 
 	__pi_startup_64_load_idt(handler);
+#endif
 }
