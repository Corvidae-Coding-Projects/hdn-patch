+
+	if (!child) {
+		char ch = 'x';
+		int fd;
+
+		fd = tty_controlling_fd();
+		if (fd < 0)
+			_exit(errno == ENOTTY || errno == ENOENT ?
+			      KSFT_SKIP : 2);
+		if (setgid(HDN_TEST_NOBODY) || setuid(HDN_TEST_NOBODY))
+			_exit(2);
+		errno = 0;
+		ret = ioctl(fd, TIOCSTI, &ch);
+		close(fd);
+		if (!ret)
+			_exit(1);
+		_exit(errno_is_denial(errno) || errno == EIO ? 0 : 2);
+	}
+
+	return child_exit_result(child);
+}
