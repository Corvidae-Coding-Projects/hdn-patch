diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/rap_test_module.c linux-7.0.12-hdn/security/hardening/rap_test_module.c
--- linux-7.0.12/security/hardening/rap_test_module.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/rap_test_module.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Signed, post-boot RAP probes. Destructive modes require fresh guests. */
+#include <linux/completion.h>
+#include <linux/hrtimer.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/nmi.h>
+#include <linux/sched.h>
+#include <asm/apic.h>
+#include <asm/irq_vectors.h>
+
+struct rap_test_payload { unsigned long value; };
+typedef long (*rap_long_fn)(long value);
+typedef long (*rap_payload_fn)(struct rap_test_payload *payload);
+
+static unsigned int mode;
+module_param(mode, uint, 0400);
+MODULE_PARM_DESC(mode, "0=positive callback, 1=wrong indirect type, 2=overwrite return, 3=copy return, 4=IRQ/NMI/switch positive");
+
+static struct completion timer_done, thread_done;
+static struct hrtimer timer;
+static unsigned long captured_return;
+static long timer_value, nmi_value, thread_value;
+static bool nmi_pending;
+
+static noinline long rap_good(long value)
+{
+	return value + 17;
+}
+
+static noinline long rap_wrong(struct rap_test_payload *payload)
+{
+	(void)payload;
+	pr_emerg("HDN_RAP_UNEXPECTED_WRONG_TARGET\n");
+	return 0;
+}
+
+static noinline long rap_invoke(rap_long_fn function, long value)
+{
+	return function(value);
+}
+
+static noinline void rap_capture_return(void)
+{
+	captured_return = (unsigned long)__builtin_return_address(0);
+}
+
+static noinline void rap_overwrite_return(void)
+{
+	unsigned long *slot = (unsigned long *)__builtin_frame_address(0) + 1;
+
+	WRITE_ONCE(*slot, 0);
+	barrier();
+}
+
+static noinline void rap_copy_return(void)
+{
+	unsigned long *slot = (unsigned long *)__builtin_frame_address(0) + 1;
+
+	WRITE_ONCE(*slot, READ_ONCE(captured_return));
+	barrier();
+}
+
+static enum hrtimer_restart rap_timer(struct hrtimer *unused)
+{
+	rap_long_fn function = rap_good;
+
+	timer_value = rap_invoke(function, 10);
+	complete(&timer_done);
+	return HRTIMER_NORESTART;
+}
+
+static unsigned int rap_nmi(unsigned int type, struct pt_regs *regs)
+{
+	rap_long_fn function = rap_good;
+
+	if (!READ_ONCE(nmi_pending))
+		return NMI_DONE;
+	nmi_value = rap_invoke(function, 20);
+	WRITE_ONCE(nmi_pending, false);
+	return NMI_HANDLED;
+}
+
+static int rap_thread(void *unused)
+{
+	rap_long_fn function = rap_good;
+
+	schedule_timeout_uninterruptible(1);
+	thread_value = rap_invoke(function, 30);
+	complete(&thread_done);
+	return 0;
+}
+
+static int rap_positive_async(void)
+{
+	struct task_struct *task;
+	unsigned long count;
+	int error;
+
+	init_completion(&timer_done);
+	init_completion(&thread_done);
+	hrtimer_setup(&timer, rap_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	hrtimer_start(&timer, ns_to_ktime(100000), HRTIMER_MODE_REL);
+	if (!wait_for_completion_timeout(&timer_done, HZ))
+		return -ETIMEDOUT;
+	task = kthread_run(rap_thread, NULL, "hdn-rap-probe");
+	if (IS_ERR(task))
+		return PTR_ERR(task);
+	if (!wait_for_completion_timeout(&thread_done, HZ))
+		return -ETIMEDOUT;
+	error = register_nmi_handler(NMI_LOCAL, rap_nmi, NMI_FLAG_FIRST, "hdn-rap-probe");
+	if (error)
+		return error;
+	WRITE_ONCE(nmi_pending, true);
+	__apic_send_IPI_self(NMI_VECTOR);
+	for (count = 0; READ_ONCE(nmi_pending) && count < 10000000; count++)
+		cpu_relax();
+	unregister_nmi_handler(NMI_LOCAL, "hdn-rap-probe");
+	if (READ_ONCE(nmi_pending))
+		return -ETIMEDOUT;
+	return timer_value == 27 && nmi_value == 37 && thread_value == 47 ? 0 : -EUCLEAN;
+}
+
+static int __init rap_test_init(void)
+{
+	rap_long_fn function;
+	long value;
+
+	if (mode > 4)
+		return -EINVAL;
+	pr_info("HDN_RAP_GUEST_READY mode=%u\n", mode);
+	switch (mode) {
+	case 0:
+		function = rap_good;
+		value = rap_invoke(function, 5);
+		if (value != 22)
+			return -EUCLEAN;
+		break;
+	case 1:
+		function = (rap_long_fn)(unsigned long)(rap_payload_fn)rap_wrong;
+		barrier_data(function);
+		(void)rap_invoke(function, 5);
+		return -EUCLEAN;
+	case 2:
+		rap_overwrite_return();
+		return -EUCLEAN;
+	case 3:
+		rap_capture_return();
+		rap_copy_return();
+		return -EUCLEAN;
+	case 4:
+		if (rap_positive_async())
+			return -EUCLEAN;
+		break;
+	}
+	pr_info("HDN_RAP_GUEST_PASS mode=%u\n", mode);
+	return 0;
+}
+
+static void __exit rap_test_exit(void)
+{
+	if (mode == 4)
+		hrtimer_cancel(&timer);
+}
+
+module_init(rap_test_init);
+module_exit(rap_test_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HDN RAP typed-transfer, return and asynchronous-entry probes");
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/respectre_test_module.c linux-7.0.12-hdn/security/hardening/respectre_test_module.c
--- linux-7.0.12/security/hardening/respectre_test_module.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/respectre_test_module.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Signed disposable-guest fixture for RESPECTRE module and semantic coverage. */
+#include <linux/compiler.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+
+struct hdn_respectre_input {
+	size_t length;
+	const u8 *bytes;
+};
+
+static u8 hdn_respectre_table[64];
+static volatile unsigned long hdn_respectre_index;
+static volatile unsigned long hdn_respectre_slot;
+static volatile unsigned long hdn_respectre_alias;
+
+static noinline unsigned long hdn_respectre_bounded(unsigned long index)
+{
+	if (index < ARRAY_SIZE(hdn_respectre_table))
+		return hdn_respectre_table[index];
+	return 0;
+}
+
+static noinline unsigned long
+hdn_respectre_pointer(const struct hdn_respectre_input *input,
+		      unsigned long index)
+{
+	if (index < input->length)
+		return input->bytes[index];
+	return 0;
+}
+
+static noinline unsigned long hdn_respectre_identity(unsigned long value)
+{
+	return value;
+}
+
+static noinline unsigned long
+hdn_respectre_indirect(unsigned long (*target)(unsigned long),
+		       unsigned long value)
+{
+	return target(value);
+}
+
+static noinline unsigned long
+hdn_respectre_store_load(volatile unsigned long *slot,
+			 unsigned long value,
+			 volatile unsigned long *alias)
+{
+	WRITE_ONCE(*slot, value);
+	return READ_ONCE(*alias);
+}
+
+static int __init hdn_respectre_test_init(void)
+{
+	static const u8 bytes[] = { 11, 17, 23, 31 };
+	const struct hdn_respectre_input input = {
+		.length = ARRAY_SIZE(bytes),
+		.bytes = bytes,
+	};
+	unsigned long index;
+
+	for (index = 0; index < ARRAY_SIZE(hdn_respectre_table); index++)
+		hdn_respectre_table[index] = index ^ 0x5a;
+
+	WRITE_ONCE(hdn_respectre_index, 7);
+	index = READ_ONCE(hdn_respectre_index);
+	if (hdn_respectre_bounded(index) != (index ^ 0x5a) ||
+	    hdn_respectre_bounded(ARRAY_SIZE(hdn_respectre_table)) != 0 ||
+	    hdn_respectre_pointer(&input, 2) != 23 ||
+	    hdn_respectre_pointer(&input, input.length) != 0 ||
+	    hdn_respectre_indirect(hdn_respectre_identity, 0x1234) != 0x1234)
+		return -EINVAL;
+
+	WRITE_ONCE(hdn_respectre_alias, 0xa55a);
+	if (hdn_respectre_store_load(&hdn_respectre_slot, 0x55aa,
+				       &hdn_respectre_alias) != 0xa55a ||
+	    READ_ONCE(hdn_respectre_slot) != 0x55aa)
+		return -EINVAL;
+
+	pr_info("HDN_RESPECTRE_PASS module-semantic-v1\n");
+	return 0;
+}
+
+static void __exit hdn_respectre_test_exit(void)
+{
+}
+
+module_init(hdn_respectre_test_init);
+module_exit(hdn_respectre_test_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HDN RESPECTRE signed semantic fixture");
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/seal.c linux-7.0.12-hdn/security/hardening/seal.c
--- linux-7.0.12/security/hardening/seal.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/seal.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,383 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/hardening.h>
+#include <linux/hdn_execmem.h>
+#include <linux/log2.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/nodemask.h>
+#include <linux/rcupdate.h>
+#include <linux/refcount.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/timekeeping.h>
+#include <linux/vmalloc.h>
+#include <linux/workqueue.h>
+#include "seal.h"
+
+enum hdn_seal_state {
+	HDN_SEAL_BUILDING,
+	HDN_SEAL_SEALED,
+	HDN_SEAL_PUBLISHED,
+	HDN_SEAL_RETIRED,
+	HDN_SEAL_FAILED,
+	HDN_SEAL_DISCARDED,
+};
+
+/* Mutable lifetime bookkeeping never shares a granule with the payload. */
+struct hdn_seal {
+	const struct hdn_seal_type *type;
+	void *data;
+	size_t size;
+	struct task_struct *builder;
+	struct mutex mutex;
+	refcount_t refs;
+	enum hdn_seal_state state;
+	struct rcu_head rcu;
+	struct work_struct destroy_work;
+};
+
+static atomic64_t hdn_seal_allocations;
+static atomic64_t hdn_seal_live_objects;
+static atomic64_t hdn_seal_live_pages;
+static atomic64_t hdn_seal_live_payload_bytes;
+static atomic64_t hdn_seal_live_granule_bytes;
+static atomic64_t hdn_seal_operations;
+static atomic64_t hdn_seal_publications;
+static atomic64_t hdn_seal_replacements;
+static atomic64_t hdn_seal_retirements;
+static atomic64_t hdn_seal_discards;
+static atomic64_t hdn_seal_rejections;
+static atomic64_t hdn_seal_allocation_failures;
+static atomic64_t hdn_seal_replacement_total_ns;
+static atomic64_t hdn_seal_replacement_max_ns;
+
+static bool hdn_seal_known_type(const struct hdn_seal_type *type)
+{
+#ifdef CONFIG_SECURITY_HARDENING_KERNSEAL_TEST
+	if (type == &hdn_test_seal_type)
+		return true;
+#endif
+	return type == &hdn_policy_seal_type || type == &hdn_mitigation_seal_type;
+}
+
+static bool hdn_seal_valid_type(const struct hdn_seal_type *type)
+{
+	if (!hdn_seal_known_type(type) || !type->id || !type->minimum_size ||
+	    type->minimum_size > type->maximum_size || !type->alignment ||
+	    !is_power_of_2(type->alignment) || !type->validate || !type->handle)
+		return false;
+	if (type->readers != HDN_SEAL_READER_IMMORTAL &&
+	    type->readers != HDN_SEAL_READER_RCU_REFCOUNT)
+		return false;
+	return type->replacement == HDN_SEAL_REPLACE_NONE ||
+	       (type->replacement == HDN_SEAL_REPLACE_COPY_RCU &&
+		type->readers == HDN_SEAL_READER_RCU_REFCOUNT);
+}
+
+static int hdn_seal_error(const struct hdn_seal_type *type, int error)
+{
+	/* Closed class IDs, never payload contents or an address. */
+	atomic64_inc(&hdn_seal_rejections);
+	hdn_report_kernel_seal(hdn_seal_known_type(type) ? type->id : 0, error);
+	return error;
+}
+
+static void hdn_seal_update_max(atomic64_t *maximum, u64 value)
+{
+	s64 old = atomic64_read(maximum);
+
+	while (old < value && !atomic64_try_cmpxchg(maximum, &old, value))
+		;
+}
+
+static void hdn_seal_destroy_work(struct work_struct *work)
+{
+	struct hdn_seal *object = container_of(work, struct hdn_seal, destroy_work);
+
+	if (WARN_ON_ONCE(!hdn_execmem_free(object->data)))
+		return; /* Never fall back to freeing storage with uncertain ownership. */
+	atomic64_dec(&hdn_seal_live_objects);
+	atomic64_sub(PFN_UP(object->size), &hdn_seal_live_pages);
+	atomic64_sub(object->size, &hdn_seal_live_payload_bytes);
+	atomic64_sub(PAGE_ALIGN(object->size), &hdn_seal_live_granule_bytes);
+	kfree(object);
+}
+
+void hdn_seal_put(struct hdn_seal *object)
+{
+	if (!refcount_dec_and_test(&object->refs))
+		return;
+	if (WARN_ON_ONCE(READ_ONCE(object->state) != HDN_SEAL_RETIRED &&
+			 READ_ONCE(object->state) != HDN_SEAL_DISCARDED))
+		return; /* Misuse must not reclaim a still-published payload. */
+	queue_work(system_unbound_wq, &object->destroy_work);
+}
+
+struct hdn_seal *hdn_seal_create(const struct hdn_seal_type *type, size_t size, int node)
+{
+	struct hdn_seal *object;
+	int error;
+
+	if (!hdn_seal_valid_type(type) || size < type->minimum_size ||
+	    size > type->maximum_size || size > ((size_t)INT_MAX << PAGE_SHIFT))
+		return ERR_PTR(hdn_seal_error(type, -EINVAL));
+	if (node != NUMA_NO_NODE &&
+	    (node < 0 || node >= MAX_NUMNODES || !node_online(node)))
+		return ERR_PTR(hdn_seal_error(type, -EINVAL));
+	object = kmalloc_node_typed(struct hdn_seal, sizeof(*object),
+				    GFP_KERNEL | __GFP_ZERO, node);
+	if (!object) {
+		atomic64_inc(&hdn_seal_allocation_failures);
+		return ERR_PTR(hdn_seal_error(type, -ENOMEM));
+	}
+	object->data = __vmalloc_node_range(PAGE_ALIGN(size), PAGE_SIZE,
+					    VMALLOC_START, VMALLOC_END, GFP_KERNEL | __GFP_ZERO,
+					    PAGE_KERNEL, VM_FLUSH_RESET_PERMS, node,
+					    __builtin_return_address(0));
+	if (!object->data) {
+		kfree(object);
+		atomic64_inc(&hdn_seal_allocation_failures);
+		return ERR_PTR(hdn_seal_error(type, -ENOMEM));
+	}
+	if (WARN_ON_ONCE(!IS_ALIGNED((unsigned long)object->data, type->alignment))) {
+		vfree(object->data);
+		kfree(object);
+		return ERR_PTR(hdn_seal_error(type, -EFAULT));
+	}
+	error = hdn_execmem_claim_data(object->data);
+	if (error) {
+		vfree(object->data);
+		kfree(object);
+		atomic64_inc(&hdn_seal_allocation_failures);
+		return ERR_PTR(hdn_seal_error(type, error));
+	}
+	object->type = type;
+	object->size = size;
+	object->builder = current;
+	get_task_struct(current);
+	mutex_init(&object->mutex);
+	refcount_set(&object->refs, 1);
+	INIT_WORK(&object->destroy_work, hdn_seal_destroy_work);
+	atomic64_inc(&hdn_seal_allocations);
+	atomic64_inc(&hdn_seal_live_objects);
+	atomic64_add(PFN_UP(size), &hdn_seal_live_pages);
+	atomic64_add(size, &hdn_seal_live_payload_bytes);
+	atomic64_add(PAGE_ALIGN(size), &hdn_seal_live_granule_bytes);
+	return object;
+}
+
+void *hdn_seal_write(struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	void *data = NULL;
+
+	if (!object) {
+		hdn_seal_error(type, -EINVAL);
+		return NULL;
+	}
+	mutex_lock(&object->mutex);
+	if (object->type == type && object->state == HDN_SEAL_BUILDING &&
+	    object->builder == current)
+		data = object->data;
+	mutex_unlock(&object->mutex);
+	if (!data)
+		hdn_seal_error(type, -EPERM);
+	return data;
+}
+
+const void *hdn_seal_read(const struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	enum hdn_seal_state state;
+
+	if (!object) {
+		hdn_seal_error(type, -EINVAL);
+		return NULL;
+	}
+	state = smp_load_acquire(&object->state);
+
+	if (object->type != type || (state != HDN_SEAL_SEALED &&
+	    state != HDN_SEAL_PUBLISHED && state != HDN_SEAL_RETIRED)) {
+		hdn_seal_error(type, -EPERM);
+		return NULL;
+	}
+	return object->data;
+}
+
+int hdn_seal_finish(struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	struct task_struct *builder = NULL;
+	int error = -EPERM;
+
+	if (!object)
+		return hdn_seal_error(type, -EINVAL);
+	mutex_lock(&object->mutex);
+	if (object->type != type || object->state != HDN_SEAL_BUILDING ||
+	    object->builder != current)
+		goto out;
+	error = type->validate(object->data, object->size);
+	if (error)
+		goto out;
+	error = hdn_execmem_seal_data(object->data);
+	/* A failed permission change cannot return the object to its builder. */
+	smp_store_release(&object->state, error ? HDN_SEAL_FAILED : HDN_SEAL_SEALED);
+	builder = object->builder;
+	object->builder = NULL;
+out:
+	mutex_unlock(&object->mutex);
+	if (builder)
+		put_task_struct(builder);
+	if (error)
+		return hdn_seal_error(type, error);
+	atomic64_inc(&hdn_seal_operations);
+	hdn_report_kernel_seal(type->id, 0);
+	return 0;
+}
+
+int hdn_seal_publish(struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	int error = -EPERM;
+
+	if (!object)
+		return hdn_seal_error(type, -EINVAL);
+	mutex_lock(&object->mutex);
+	if (object->type == type && object->state == HDN_SEAL_SEALED) {
+		smp_store_release(&object->state, HDN_SEAL_PUBLISHED);
+		error = 0;
+	}
+	mutex_unlock(&object->mutex);
+	if (error)
+		return hdn_seal_error(type, error);
+	atomic64_inc(&hdn_seal_publications);
+	return 0;
+}
+
+int hdn_seal_replace(struct hdn_seal *object, const struct hdn_seal_type *type,
+		     hdn_seal_publish_fn publish, void *context)
+{
+	const void *old_data;
+	struct hdn_seal *old;
+	u64 started;
+	u64 elapsed;
+	int error;
+
+	if (!object || !publish || !hdn_seal_valid_type(type) ||
+	    type->replacement != HDN_SEAL_REPLACE_COPY_RCU)
+		return hdn_seal_error(type, -EINVAL);
+
+	started = ktime_get_mono_fast_ns();
+	error = hdn_seal_publish(object, type);
+	if (error)
+		return error;
+
+	/* The callback owns the consumer lock and returns only the instance that
+	 * lost its final publication slot. The descriptor recovers its opaque
+	 * handle without accepting an arbitrary address registration. */
+	old_data = publish(context, object->data);
+	if (old_data) {
+		old = type->handle(old_data);
+		if (!old || old == object || old->type != type || old->data != old_data) {
+			/* Publication is irreversible. Keep every uncertain object live
+			 * rather than reporting failure and letting the caller free @object. */
+			hdn_seal_error(type, -EUCLEAN);
+			goto published;
+		}
+		error = hdn_seal_retire(old, type);
+		if (error)
+			goto published; /* Same fail-safe leak after publication. */
+		atomic64_inc(&hdn_seal_replacements);
+	}
+
+published:
+	elapsed = ktime_get_mono_fast_ns() - started;
+	atomic64_add(elapsed, &hdn_seal_replacement_total_ns);
+	hdn_seal_update_max(&hdn_seal_replacement_max_ns, elapsed);
+	return 0;
+}
+
+bool hdn_seal_get(struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	if (!object || object->type != type ||
+	    type->readers != HDN_SEAL_READER_RCU_REFCOUNT) {
+		hdn_seal_error(type, -EPERM);
+		return false;
+	}
+	if (smp_load_acquire(&object->state) != HDN_SEAL_PUBLISHED)
+		return false;
+	return refcount_inc_not_zero(&object->refs);
+}
+
+static void hdn_seal_rcu_put(struct rcu_head *rcu)
+{
+	struct hdn_seal *object = container_of(rcu, struct hdn_seal, rcu);
+
+	hdn_seal_put(object);
+}
+
+int hdn_seal_retire(struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	int error = -EPERM;
+
+	if (!object)
+		return hdn_seal_error(type, -EINVAL);
+	mutex_lock(&object->mutex);
+	if (object->type == type && object->state == HDN_SEAL_PUBLISHED &&
+	    type->readers == HDN_SEAL_READER_RCU_REFCOUNT) {
+		smp_store_release(&object->state, HDN_SEAL_RETIRED);
+		error = 0;
+	}
+	mutex_unlock(&object->mutex);
+	if (error)
+		return hdn_seal_error(type, error);
+	atomic64_inc(&hdn_seal_retirements);
+	/* Publication was already removed under the consumer's serialization. */
+	call_rcu(&object->rcu, hdn_seal_rcu_put);
+	return 0;
+}
+
+int hdn_seal_destroy(struct hdn_seal *object, const struct hdn_seal_type *type)
+{
+	struct task_struct *builder;
+	int error = 0;
+
+	if (!object)
+		return hdn_seal_error(type, -EINVAL);
+	mutex_lock(&object->mutex);
+	if (object->type != type || object->state == HDN_SEAL_PUBLISHED ||
+	    object->state == HDN_SEAL_RETIRED ||
+	    object->state == HDN_SEAL_DISCARDED ||
+	    (object->builder && object->builder != current)) {
+		error = -EPERM;
+		goto out;
+	}
+	smp_store_release(&object->state, HDN_SEAL_DISCARDED);
+	builder = object->builder;
+	object->builder = NULL;
+	mutex_unlock(&object->mutex);
+	if (builder)
+		put_task_struct(builder);
+	atomic64_inc(&hdn_seal_discards);
+	hdn_seal_put(object);
+	return 0;
+out:
+	mutex_unlock(&object->mutex);
+	return hdn_seal_error(type, error);
+}
+
+void hdn_seal_get_stats(struct hdn_seal_stats *stats)
+{
+	*stats = (struct hdn_seal_stats) {
+		.allocations = atomic64_read(&hdn_seal_allocations),
+		.live_objects = atomic64_read(&hdn_seal_live_objects),
+		.live_pages = atomic64_read(&hdn_seal_live_pages),
+		.live_payload_bytes = atomic64_read(&hdn_seal_live_payload_bytes),
+		.live_granule_bytes = atomic64_read(&hdn_seal_live_granule_bytes),
+		.seal_operations = atomic64_read(&hdn_seal_operations),
+		.publications = atomic64_read(&hdn_seal_publications),
+		.replacements = atomic64_read(&hdn_seal_replacements),
+		.retirements = atomic64_read(&hdn_seal_retirements),
+		.discards = atomic64_read(&hdn_seal_discards),
+		.rejections = atomic64_read(&hdn_seal_rejections),
+		.allocation_failures = atomic64_read(&hdn_seal_allocation_failures),
+		.replacement_total_ns = atomic64_read(&hdn_seal_replacement_total_ns),
+		.replacement_max_ns = atomic64_read(&hdn_seal_replacement_max_ns),
+	};
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/seal.h linux-7.0.12-hdn/security/hardening/seal.h
--- linux-7.0.12/security/hardening/seal.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/seal.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _HDN_SEAL_H
+#define _HDN_SEAL_H
+
+#include <linux/err.h>
+#include <linux/types.h>
+
+struct hdn_seal;
+
+enum hdn_seal_reader_discipline {
+	HDN_SEAL_READER_IMMORTAL,
+	HDN_SEAL_READER_RCU_REFCOUNT,
+};
+
+enum hdn_seal_replacement {
+	HDN_SEAL_REPLACE_NONE,
+	HDN_SEAL_REPLACE_COPY_RCU,
+};
+
+struct hdn_seal_type {
+	u32 id;
+	size_t minimum_size;
+	size_t maximum_size;
+	size_t alignment;
+	enum hdn_seal_reader_discipline readers;
+	enum hdn_seal_replacement replacement;
+	int (*validate)(const void *data, size_t size);
+	struct hdn_seal *(*handle)(const void *data);
+};
+
+struct hdn_seal_stats {
+	u64 allocations;
+	u64 live_objects;
+	u64 live_pages;
+	u64 live_payload_bytes;
+	u64 live_granule_bytes;
+	u64 seal_operations;
+	u64 publications;
+	u64 replacements;
+	u64 retirements;
+	u64 discards;
+	u64 rejections;
+	u64 allocation_failures;
+	u64 replacement_total_ns;
+	u64 replacement_max_ns;
+};
+
+/* Called under the consumer's publication serialization. It must atomically
+ * publish @next and return the complete payload evicted from all publication
+ * slots, or NULL when no object became unreachable. */
+typedef const void *(*hdn_seal_publish_fn)(void *context, const void *next);
+
+/* Closed set of in-tree types; descriptors and payloads are never exported. */
+extern const struct hdn_seal_type hdn_policy_seal_type;
+extern const struct hdn_seal_type hdn_mitigation_seal_type;
+#ifdef CONFIG_SECURITY_HARDENING_KERNSEAL_TEST
+extern const struct hdn_seal_type hdn_test_seal_type;
+#endif
+
+#ifdef CONFIG_SECURITY_HARDENING_KERNSEAL
+struct hdn_seal *hdn_seal_create(const struct hdn_seal_type *type, size_t size, int node);
+/* The constructing task owns the sole unpublished reference. A successful
+ * publish transfers that reference to publication. Replace performs publish,
+ * the consumer's atomic pointer update, and retirement as one typed operation.
+ * A direct retire requires all published pointers to have been removed under
+ * consumer serialization. Read requires the publication reference, an
+ * acquired reference, or the RCU read lock that protects publication. */
+void *hdn_seal_write(struct hdn_seal *object, const struct hdn_seal_type *type);
+const void *hdn_seal_read(const struct hdn_seal *object, const struct hdn_seal_type *type);
+int hdn_seal_finish(struct hdn_seal *object, const struct hdn_seal_type *type);
+int hdn_seal_publish(struct hdn_seal *object, const struct hdn_seal_type *type);
+int hdn_seal_replace(struct hdn_seal *object, const struct hdn_seal_type *type,
+		hdn_seal_publish_fn publish, void *context);
+int hdn_seal_destroy(struct hdn_seal *object, const struct hdn_seal_type *type);
+int hdn_seal_retire(struct hdn_seal *object, const struct hdn_seal_type *type);
+/* get requires a live reference or the RCU read lock protecting publication. */
+bool __must_check hdn_seal_get(struct hdn_seal *object, const struct hdn_seal_type *type);
+void hdn_seal_put(struct hdn_seal *object);
+void hdn_seal_get_stats(struct hdn_seal_stats *stats);
+#else
+static inline struct hdn_seal *hdn_seal_create(const struct hdn_seal_type *type,
+		size_t size, int node) { return ERR_PTR(-EOPNOTSUPP); }
+static inline void *hdn_seal_write(struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return NULL; }
+static inline int hdn_seal_finish(struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return -EOPNOTSUPP; }
+static inline int hdn_seal_publish(struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return -EOPNOTSUPP; }
+static inline int hdn_seal_replace(struct hdn_seal *object,
+		const struct hdn_seal_type *type, hdn_seal_publish_fn publish,
+		void *context) { return -EOPNOTSUPP; }
+static inline int hdn_seal_destroy(struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return -EOPNOTSUPP; }
+static inline int hdn_seal_retire(struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return -EOPNOTSUPP; }
+static inline const void *hdn_seal_read(const struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return NULL; }
+static inline bool hdn_seal_get(struct hdn_seal *object,
+		const struct hdn_seal_type *type) { return false; }
+static inline void hdn_seal_put(struct hdn_seal *object) { }
+static inline void hdn_seal_get_stats(struct hdn_seal_stats *stats)
+{
+	*stats = (struct hdn_seal_stats){};
+}
+#endif
+#endif
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/seal_test.c linux-7.0.12-hdn/security/hardening/seal_test.c
--- linux-7.0.12/security/hardening/seal_test.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/seal_test.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,406 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/hdn_execmem.h>
+#include <linux/highmem.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/nodemask.h>
+#include <linux/rcupdate.h>
+#include <linux/sched/task.h>
+#include <linux/set_memory.h>
+#include <linux/timekeeping.h>
+#include <linux/uaccess.h>
+#include <linux/vmalloc.h>
+#include "seal.h"
+
+#define HDN_SEAL_TEST_MAGIC 0x51ea10b1ec7ULL
+
+struct hdn_seal_test_payload {
+	struct hdn_seal *seal;
+	u64 magic;
+	u64 values[];
+};
+
+static int hdn_test_seal_validate(const void *data, size_t size)
+{
+	const struct hdn_seal_test_payload *payload = data;
+
+	return size == PAGE_SIZE && payload->seal &&
+	       payload->magic == HDN_SEAL_TEST_MAGIC ? 0 : -EINVAL;
+}
+
+static struct hdn_seal *hdn_test_seal_handle(const void *data)
+{
+	return ((const struct hdn_seal_test_payload *)data)->seal;
+}
+
+const struct hdn_seal_type hdn_test_seal_type = {
+	.id = 255,
+	.minimum_size = PAGE_SIZE,
+	.maximum_size = PAGE_SIZE,
+	.alignment = __alignof__(struct hdn_seal_test_payload),
+	.readers = HDN_SEAL_READER_RCU_REFCOUNT,
+	.replacement = HDN_SEAL_REPLACE_COPY_RCU,
+	.validate = hdn_test_seal_validate,
+	.handle = hdn_test_seal_handle,
+};
+
+struct hdn_seal_test_resource {
+	struct hdn_seal *object;
+	bool published;
+};
+
+static void hdn_seal_test_cleanup(void *data)
+{
+	struct hdn_seal_test_resource *resource = data;
+
+	if (!resource->object)
+		return;
+	if (resource->published)
+		hdn_seal_retire(resource->object, &hdn_test_seal_type);
+	else
+		hdn_seal_destroy(resource->object, &hdn_test_seal_type);
+}
+
+static struct hdn_seal_test_resource *hdn_seal_test_create_node(struct kunit *test, int node)
+{
+	struct hdn_seal_test_resource *resource;
+
+	resource = kunit_kzalloc(test, sizeof(*resource), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, resource);
+	resource->object = hdn_seal_create(&hdn_test_seal_type, PAGE_SIZE, node);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, resource->object);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, hdn_seal_test_cleanup, resource), 0);
+	return resource;
+}
+
+static struct hdn_seal_test_resource *hdn_seal_test_create(struct kunit *test)
+{
+	return hdn_seal_test_create_node(test, NUMA_NO_NODE);
+}
+
+static struct hdn_seal_test_payload *hdn_seal_test_write(
+		struct hdn_seal_test_resource *resource)
+{
+	struct hdn_seal_test_payload *payload;
+
+	payload = hdn_seal_write(resource->object, &hdn_test_seal_type);
+	if (payload)
+		payload->seal = resource->object;
+	return payload;
+}
+
+static void hdn_seal_lifecycle_test(struct kunit *test)
+{
+	struct hdn_seal_test_resource *resource = hdn_seal_test_create(test);
+	struct hdn_seal *object = resource->object;
+	struct hdn_seal_test_payload *data = hdn_seal_test_write(resource);
+	const struct hdn_seal_test_payload *read;
+
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	KUNIT_EXPECT_EQ(test, hdn_seal_publish(object, &hdn_test_seal_type), -EPERM);
+	KUNIT_EXPECT_EQ(test, hdn_seal_finish(object, &hdn_test_seal_type), -EINVAL);
+	KUNIT_EXPECT_PTR_EQ(test, hdn_seal_write(object, &hdn_policy_seal_type), NULL);
+	data->magic = HDN_SEAL_TEST_MAGIC;
+	KUNIT_ASSERT_EQ(test, hdn_seal_finish(object, &hdn_test_seal_type), 0);
+	KUNIT_EXPECT_EQ(test, hdn_seal_finish(object, &hdn_test_seal_type), -EPERM);
+	KUNIT_EXPECT_PTR_EQ(test, hdn_seal_write(object, &hdn_test_seal_type), NULL);
+	KUNIT_EXPECT_PTR_EQ(test, hdn_seal_read(object, &hdn_policy_seal_type), NULL);
+	read = hdn_seal_read(object, &hdn_test_seal_type);
+	KUNIT_ASSERT_NOT_NULL(test, read);
+	KUNIT_EXPECT_EQ(test, read->magic, HDN_SEAL_TEST_MAGIC);
+	KUNIT_ASSERT_EQ(test, hdn_seal_publish(object, &hdn_test_seal_type), 0);
+	resource->published = true;
+	KUNIT_EXPECT_EQ(test, hdn_seal_destroy(object, &hdn_test_seal_type), -EPERM);
+	KUNIT_EXPECT_EQ(test, hdn_seal_publish(object, &hdn_test_seal_type), -EPERM);
+	KUNIT_ASSERT_TRUE(test, hdn_seal_get(object, &hdn_test_seal_type));
+	read = hdn_seal_read(object, &hdn_test_seal_type);
+	KUNIT_ASSERT_NOT_NULL(test, read);
+	KUNIT_EXPECT_EQ(test, read->magic, HDN_SEAL_TEST_MAGIC);
+	hdn_seal_put(object);
+}
+
+static void hdn_seal_alias_test(struct kunit *test)
+{
+	struct hdn_seal_test_resource *resource = hdn_seal_test_create(test);
+	struct hdn_seal *object = resource->object;
+	struct hdn_seal_test_payload *data = hdn_seal_test_write(resource);
+	struct page *page;
+	void *alias;
+	u64 replacement = 0;
+	u64 value;
+
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	page = vmalloc_to_page(data);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	data->magic = HDN_SEAL_TEST_MAGIC;
+	KUNIT_ASSERT_EQ(test, hdn_seal_finish(object, &hdn_test_seal_type), 0);
+	KUNIT_EXPECT_LT(test, copy_to_kernel_nofault(&data->magic, &replacement,
+						      sizeof(replacement)), 0);
+	KUNIT_EXPECT_EQ(test, hdn_execmem_claim_data(data), -EBUSY);
+	KUNIT_EXPECT_EQ(test, set_memory_rw((unsigned long)data, 1), -EPERM);
+	KUNIT_EXPECT_EQ(test, set_memory_x((unsigned long)data, 1), -EPERM);
+	KUNIT_EXPECT_EQ(test, set_memory_rox((unsigned long)data, 1), -EPERM);
+	KUNIT_EXPECT_LT(test, copy_from_kernel_nofault(&value, page_address(page), sizeof(value)), 0);
+	alias = vmap(&page, 1, VM_MAP, PAGE_KERNEL);
+	KUNIT_EXPECT_PTR_EQ(test, alias, NULL);
+	if (alias)
+		vunmap(alias);
+	alias = vmap(&page, 1, VM_MAP, PAGE_KERNEL_RO);
+	KUNIT_EXPECT_PTR_EQ(test, alias, NULL);
+	if (alias)
+		vunmap(alias);
+	KUNIT_EXPECT_FALSE(test, hdn_execmem_text_page(page));
+	KUNIT_EXPECT_EQ(test, data->magic, HDN_SEAL_TEST_MAGIC);
+}
+
+struct hdn_seal_reader {
+	const struct hdn_seal_test_payload __rcu *published;
+	struct completion acquired;
+	struct completion release;
+	bool got_reference;
+	bool intact;
+};
+
+static int hdn_seal_retained_reader(void *arg)
+{
+	struct hdn_seal_reader *reader = arg;
+	struct hdn_seal *object;
+	const struct hdn_seal_test_payload *published;
+	const struct hdn_seal_test_payload *data;
+	unsigned int i;
+
+	rcu_read_lock();
+	published = rcu_dereference(reader->published);
+	object = published ? published->seal : NULL;
+	reader->got_reference = object && hdn_seal_get(object, &hdn_test_seal_type);
+	rcu_read_unlock();
+	complete(&reader->acquired);
+	wait_for_completion(&reader->release);
+	if (!reader->got_reference)
+		return 0;
+	/* The writer has replaced publication and completed a full grace period.
+	 * Only our explicit reference now keeps the old immutable payload alive. */
+	data = hdn_seal_read(object, &hdn_test_seal_type);
+	reader->intact = data && data->magic == HDN_SEAL_TEST_MAGIC;
+	for (i = 0; reader->intact &&
+	     i < (PAGE_SIZE - sizeof(*data)) / sizeof(data->values[0]); i++)
+		reader->intact = data->values[i] == (0x123456789abcdef0ULL ^ i);
+	hdn_seal_put(object);
+	return 0;
+}
+
+static const void *hdn_seal_test_replace_publish(void *context, const void *next)
+{
+	struct hdn_seal_reader *reader = context;
+
+	return rcu_replace_pointer(reader->published, next, true);
+}
+
+static void hdn_seal_replacement_test(struct kunit *test)
+{
+	struct hdn_seal_test_resource *old = hdn_seal_test_create(test);
+	struct hdn_seal_test_resource *next = hdn_seal_test_create(test);
+	struct hdn_seal_reader reader = {};
+	struct task_struct *task;
+	struct hdn_seal_test_payload *data;
+	struct hdn_seal_test_payload *next_data;
+	unsigned int i;
+	int error;
+
+	data = hdn_seal_test_write(old);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	data->magic = HDN_SEAL_TEST_MAGIC;
+	for (i = 0; i < (PAGE_SIZE - sizeof(*data)) / sizeof(data->values[0]); i++)
+		data->values[i] = 0x123456789abcdef0ULL ^ i;
+	KUNIT_ASSERT_EQ(test, hdn_seal_finish(old->object, &hdn_test_seal_type), 0);
+	KUNIT_ASSERT_EQ(test, hdn_seal_publish(old->object, &hdn_test_seal_type), 0);
+	old->published = true;
+	next_data = hdn_seal_test_write(next);
+	KUNIT_ASSERT_NOT_NULL(test, next_data);
+	next_data->magic = HDN_SEAL_TEST_MAGIC;
+	for (i = 0; i < (PAGE_SIZE - sizeof(*next_data)) /
+	     sizeof(next_data->values[0]); i++)
+		next_data->values[i] = 0xfedcba9876543210ULL ^ i;
+	KUNIT_ASSERT_EQ(test, hdn_seal_finish(next->object, &hdn_test_seal_type), 0);
+	init_completion(&reader.acquired);
+	init_completion(&reader.release);
+	rcu_assign_pointer(reader.published, data);
+	task = kthread_run(hdn_seal_retained_reader, &reader, "hdn-seal-reader");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, task);
+	get_task_struct(task);
+	/* From this point every exit wakes and joins the reader before unwinding. */
+	if (!wait_for_completion_timeout(&reader.acquired, 5 * HZ)) {
+		KUNIT_FAIL(test, "retained reader did not start");
+		goto join;
+	}
+	KUNIT_EXPECT_TRUE(test, reader.got_reference);
+	error = hdn_seal_replace(next->object, &hdn_test_seal_type,
+				 hdn_seal_test_replace_publish, &reader);
+	KUNIT_EXPECT_EQ(test, error, 0);
+	if (!error) {
+		old->object = NULL; /* retirement owns the publication reference */
+		old->published = false;
+		next->published = true;
+	}
+	rcu_barrier();
+	KUNIT_EXPECT_PTR_EQ(test, hdn_seal_write(next->object, &hdn_test_seal_type), NULL);
+join:
+	RCU_INIT_POINTER(reader.published, NULL);
+	complete(&reader.release);
+	kthread_stop(task);
+	put_task_struct(task);
+	KUNIT_EXPECT_TRUE(test, reader.intact);
+}
+
+static void hdn_seal_numa_test(struct kunit *test)
+{
+	int node;
+
+	for_each_online_node(node) {
+		struct hdn_seal_test_resource *resource = hdn_seal_test_create_node(test, node);
+		struct hdn_seal_test_payload *data = hdn_seal_test_write(resource);
+		const struct hdn_seal_test_payload *read;
+
+		KUNIT_ASSERT_NOT_NULL(test, data);
+		data->magic = HDN_SEAL_TEST_MAGIC;
+		KUNIT_ASSERT_EQ(test, hdn_seal_finish(resource->object, &hdn_test_seal_type), 0);
+		read = hdn_seal_read(resource->object, &hdn_test_seal_type);
+		KUNIT_ASSERT_NOT_NULL(test, read);
+		KUNIT_EXPECT_EQ(test, read->magic, HDN_SEAL_TEST_MAGIC);
+		KUNIT_ASSERT_EQ(test, hdn_seal_destroy(resource->object, &hdn_test_seal_type), 0);
+		resource->object = NULL;
+	}
+	KUNIT_EXPECT_EQ(test, PTR_ERR(hdn_seal_create(&hdn_test_seal_type, PAGE_SIZE, MAX_NUMNODES)), -EINVAL);
+}
+
+struct hdn_seal_builder_attack {
+	struct hdn_seal *object;
+	struct completion done;
+	bool write_rejected;
+	int finish_error;
+	int destroy_error;
+};
+
+static int hdn_seal_wrong_builder(void *arg)
+{
+	struct hdn_seal_builder_attack *attack = arg;
+
+	attack->write_rejected =
+		!hdn_seal_write(attack->object, &hdn_test_seal_type);
+	attack->finish_error = hdn_seal_finish(attack->object,
+					       &hdn_test_seal_type);
+	attack->destroy_error = hdn_seal_destroy(attack->object,
+						 &hdn_test_seal_type);
+	complete(&attack->done);
+	return 0;
+}
+
+static void hdn_seal_builder_test(struct kunit *test)
+{
+	struct hdn_seal_test_resource *resource = hdn_seal_test_create(test);
+	struct hdn_seal_builder_attack attack = {
+		.object = resource->object,
+	};
+	struct hdn_seal_test_payload *payload;
+	struct task_struct *task;
+
+	init_completion(&attack.done);
+	task = kthread_run(hdn_seal_wrong_builder, &attack,
+			   "hdn-seal-wrong-builder");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, task);
+	get_task_struct(task);
+	if (!wait_for_completion_timeout(&attack.done, 5 * HZ))
+		KUNIT_FAIL(test, "wrong-builder probe did not finish");
+	kthread_stop(task);
+	put_task_struct(task);
+	KUNIT_EXPECT_TRUE(test, attack.write_rejected);
+	KUNIT_EXPECT_EQ(test, attack.finish_error, -EPERM);
+	KUNIT_EXPECT_EQ(test, attack.destroy_error, -EPERM);
+
+	payload = hdn_seal_test_write(resource);
+	KUNIT_ASSERT_NOT_NULL(test, payload);
+	payload->magic = HDN_SEAL_TEST_MAGIC;
+	KUNIT_ASSERT_EQ(test, hdn_seal_finish(resource->object,
+					      &hdn_test_seal_type), 0);
+}
+
+static void hdn_seal_validation_cleanup_test(struct kunit *test)
+{
+	struct hdn_seal_test_resource *resource = hdn_seal_test_create(test);
+	struct hdn_seal_test_payload *payload = hdn_seal_test_write(resource);
+
+	KUNIT_ASSERT_NOT_NULL(test, payload);
+	KUNIT_EXPECT_EQ(test, hdn_seal_finish(resource->object,
+					      &hdn_test_seal_type), -EINVAL);
+	KUNIT_ASSERT_EQ(test, hdn_seal_destroy(resource->object,
+					       &hdn_test_seal_type), 0);
+	resource->object = NULL;
+}
+
+static void hdn_seal_metrics_test(struct kunit *test)
+{
+	struct hdn_seal_stats before;
+	struct hdn_seal_stats after;
+	struct hdn_seal_test_resource *resource;
+	struct hdn_seal_test_payload *payload;
+	const struct hdn_seal_test_payload *read;
+	u64 seal_started;
+	u64 seal_ns;
+	u64 read_started;
+	u64 read_ns;
+	u64 sink = 0;
+	unsigned int i;
+
+	hdn_seal_get_stats(&before);
+	resource = hdn_seal_test_create(test);
+	payload = hdn_seal_test_write(resource);
+	KUNIT_ASSERT_NOT_NULL(test, payload);
+	payload->magic = HDN_SEAL_TEST_MAGIC;
+	seal_started = ktime_get_mono_fast_ns();
+	KUNIT_ASSERT_EQ(test, hdn_seal_finish(resource->object,
+					      &hdn_test_seal_type), 0);
+	seal_ns = ktime_get_mono_fast_ns() - seal_started;
+	KUNIT_ASSERT_EQ(test, hdn_seal_publish(resource->object,
+					       &hdn_test_seal_type), 0);
+	resource->published = true;
+
+	read_started = ktime_get_mono_fast_ns();
+	for (i = 0; i < 10000; i++) {
+		read = hdn_seal_read(resource->object, &hdn_test_seal_type);
+		KUNIT_ASSERT_NOT_NULL(test, read);
+		sink ^= READ_ONCE(read->magic);
+		barrier();
+	}
+	read_ns = ktime_get_mono_fast_ns() - read_started;
+	hdn_seal_get_stats(&after);
+
+	KUNIT_EXPECT_EQ(test, sink, 0ULL);
+	kunit_info(test,
+		   "metrics class=test objects=%llu pages=%llu payload_bytes=%llu granule_bytes=%llu fragmentation_bytes=%llu seal_ns=%llu read_ops=10000 read_total_ns=%llu",
+		   after.live_objects - before.live_objects,
+		   after.live_pages - before.live_pages,
+		   after.live_payload_bytes - before.live_payload_bytes,
+		   after.live_granule_bytes - before.live_granule_bytes,
+		   (after.live_granule_bytes - before.live_granule_bytes) -
+		   (after.live_payload_bytes - before.live_payload_bytes),
+		   seal_ns, read_ns);
+}
+
+static struct kunit_case hdn_seal_cases[] = {
+	KUNIT_CASE(hdn_seal_lifecycle_test),
+	KUNIT_CASE(hdn_seal_alias_test),
+	KUNIT_CASE(hdn_seal_replacement_test),
