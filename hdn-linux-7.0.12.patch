+static int object_prepare_blkdev_node(const char *path, dev_t dev)
+{
+	struct stat st;
+
+	if (!lstat(path, &st)) {
+		if (S_ISBLK(st.st_mode) && st.st_rdev == dev)
+			return chmod(path, 0666) ? 2 : 0;
+		if (unlink(path))
+			return 2;
+	} else if (errno != ENOENT) {
+		return 2;
+	}
+
+	if (mknod(path, S_IFBLK | 0666, dev))
+		return 2;
+
+	return chmod(path, 0666) ? 2 : 0;
+}
