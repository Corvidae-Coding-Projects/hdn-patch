+static bool proc_timer_list_symbol_line(const char *line)
+{
+	static const char * const prefixes[] = {
+		" set_next_event:",
+		" shutdown:",
+		" periodic:",
+		" oneshot:",
+		" oneshot stopped:",
+		" resume:",
+		" event_handler:",
+	};
+	size_t i;
+
+	if (line[0] == ' ' && line[1] == '#' &&
+	    line[2] >= '0' && line[2] <= '9')
+		return true;
+
+	for (i = 0; i < ARRAY_SIZE(prefixes); i++) {
+		if (!strncmp(line, prefixes[i], strlen(prefixes[i])))
+			return true;
+	}
+
+	return false;
+}
