+	errno = 0;
+	wd = inotify_add_watch(fd, path, IN_ALL_EVENTS);
+	saved_errno = errno;
+
+	if (wd >= 0) {
+		inotify_rm_watch(fd, wd);
+		close(fd);
+		return expect_denied ? 1 : 0;
+	}
+
+	close(fd);
+	if (expect_denied)
+		return errno_is_denial(saved_errno) ? 0 : 2;
+	return 2;
+}
