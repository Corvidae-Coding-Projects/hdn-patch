diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/mm/hdn_pgtable.c linux-7.0.12-hdn/arch/x86/mm/hdn_pgtable.c
