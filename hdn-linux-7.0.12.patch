+	*server_fd = -1;
+	ret = unix_sockaddr_path(path, &addr, &addrlen);
+	if (ret)
+		return ret;
+
+	unlink(path);
+	fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return -errno;
+
+	if (bind(fd, (struct sockaddr *)&addr, addrlen)) {
+		ret = -errno;
+		close(fd);
+		unlink(path);
+		return ret;
+	}
+	if (start_listening && listen(fd, 4)) {
+		ret = -errno;
+		close(fd);
+		unlink(path);
+		return ret;
+	}
+
+	*server_fd = fd;
+	return 0;
+}
