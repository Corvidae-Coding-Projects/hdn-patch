+				size_t count, loff_t *ppos)
+{
+	int ret;
+
+	if (*ppos != 0)
+		return -ESPIPE;
+
+	ret = hdn_commit_policy();
+	if (ret)
+		return ret;
+
+	*ppos += count;
+	return count;
+}
+
