+			       strerror(errno));
+		return errno == ENOENT ? KSFT_SKIP : 2;
+	}
+
+	len = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (len <= 0) {
+		ksft_print_msg("%s read failed\n", HDN_PROC_SELF_IPADDR);
+		return 2;
+	}
+
+	if (strcmp(buf, expected)) {
+		ksft_print_msg("%s expected %s got %s", HDN_PROC_SELF_IPADDR,
+			       expected, buf);
+		return 1;
+	}
+
+	return 0;
+}
