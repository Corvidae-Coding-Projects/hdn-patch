+			ret);
+		cleanup_product_rofs_mount(HDN_PRODUCT_ROFS_BROKER_DIR);
+		return ret;
+	}
+
+	errno = 0;
+	fd = open(HDN_PRODUCT_ROFS_BROKER_SENTINEL,
+		  O_WRONLY | O_APPEND | O_CLOEXEC);
