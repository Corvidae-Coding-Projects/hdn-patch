+static pid_t spawn_proc_sensitive_target(void)
+{
+	char *const argv[] = {
+		"hdn_smoke",
+		"--proc-sensitive-target",
+		(char *)HDN_PROC_SENSITIVE_ARG,
+		NULL,
+	};
+	char *const envp[] = {
+		(char *)HDN_PROC_SENSITIVE_ENV,
+		NULL,
+	};
+	int sync_pipe[2];
+	char ready;
+	pid_t child;
+
+	if (pipe(sync_pipe))
+		return -1;
+
+	child = fork();
+	if (child < 0) {
+		close(sync_pipe[0]);
+		close(sync_pipe[1]);
+		return -1;
+	}
+
+	if (!child) {
+		close(sync_pipe[0]);
+		if (dup2(sync_pipe[1], 3) < 0)
+			_exit(2);
+		if (sync_pipe[1] != 3)
+			close(sync_pipe[1]);
+		execve("/proc/self/exe", argv, envp);
+		_exit(2);
+	}
+
+	close(sync_pipe[1]);
+	if (read(sync_pipe[0], &ready, sizeof(ready)) != sizeof(ready)) {
+		close(sync_pipe[0]);
+		kill(child, SIGKILL);
+		waitpid(child, NULL, 0);
+		return -1;
+	}
+	close(sync_pipe[0]);
+
+	return child;
+}
