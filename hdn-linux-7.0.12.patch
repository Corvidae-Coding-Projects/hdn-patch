diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/autoslab_test.c linux-7.0.12-hdn/security/hardening/autoslab_test.c
--- linux-7.0.12/security/hardening/autoslab_test.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/autoslab_test.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Built in deliberately: a module may never request a built-in domain. */
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/hdn_alloc.h>
+#include <linux/mmzone.h>
+#include <linux/rcupdate.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include "../../mm/slab.h"
+
+#define HDN_TEST_ID_A 0x4155544f534c4142ULL
+#define HDN_TEST_ID_B 0x534c414249534f4cULL
+#define HDN_TEST_ID_FAIL 0x4641494c534c4142ULL
+
+struct autoslab_rcu_object {
+	struct rcu_head rcu;
+	struct completion *done;
+	struct kmem_cache *cache;
+	u64 payload;
+};
+
+static unsigned int allocation_domain(const void *pointer)
+{
+	struct page *page;
+	struct slab *slab;
+
+	if (is_vmalloc_addr(pointer))
+		return find_vm_area(pointer)->hdn_alloc_domain;
+	page = virt_to_page(pointer);
+	slab = page_slab(page);
+	return slab ? slab->slab_cache->hdn_alloc_domain : page_private(page);
+}
+
+static void autoslab_rcu_free(struct rcu_head *head)
+{
+	struct autoslab_rcu_object *object =
+		container_of(head, struct autoslab_rcu_object, rcu);
+	struct completion *done = object->done;
+
+	kmem_cache_free(object->cache, object);
+	complete(done);
+}
+
+static void domains_and_resize(struct kunit *test)
+{
+	struct hdn_alloc_stats before, after;
+	void *a, *b, *grown;
+	unsigned int i;
+
+	hdn_alloc_get_stats(&before);
+	for (i = 0; i < 32; i++) {
+		a = __hdn_alloc_typed(128, GFP_KERNEL_ACCOUNT | __GFP_ZERO,
+				      NUMA_NO_NODE, 0, HDN_TEST_ID_A, HDN_ALLOC_IPC_QUEUE);
+		b = __hdn_alloc_typed(128, GFP_KERNEL_ACCOUNT, NUMA_NO_NODE,
+				      0, HDN_TEST_ID_B, HDN_ALLOC_SHM);
+		if (!a || !b) {
+			kfree(a);
+			kfree(b);
+			KUNIT_FAIL(test, "domain allocation failed");
+			return;
+		}
+		KUNIT_EXPECT_EQ(test, allocation_domain(a), (unsigned int)HDN_ALLOC_IPC_QUEUE);
+		KUNIT_EXPECT_EQ(test, allocation_domain(b), (unsigned int)HDN_ALLOC_SHM);
+		KUNIT_EXPECT_TRUE(test, IS_ALIGNED((unsigned long)a, 128));
+		KUNIT_EXPECT_PTR_NE(test, virt_to_slab(a)->slab_cache, virt_to_slab(b)->slab_cache);
+		KUNIT_EXPECT_PTR_EQ(test, memchr_inv(a, 0, 128), NULL);
+		memset(a, 0x5a, 128);
+		grown = kvrealloc(a, 2 * KMALLOC_MAX_CACHE_SIZE, GFP_KERNEL_ACCOUNT);
+		if (!grown) {
+			kfree(a);
+			kfree(b);
+			KUNIT_FAIL(test, "domain growth failed");
+			return;
+		}
+		KUNIT_EXPECT_EQ(test, allocation_domain(grown), (unsigned int)HDN_ALLOC_IPC_QUEUE);
+		KUNIT_EXPECT_PTR_EQ(test, memchr_inv(grown, 0x5a, 128), NULL);
+		kvfree(grown);
+		kfree(b);
+	}
+	hdn_alloc_get_stats(&after);
+	KUNIT_EXPECT_GE(test, after.typed - before.typed, 64ULL);
+	KUNIT_EXPECT_GE(test, after.successful - before.successful, 64ULL);
+	KUNIT_EXPECT_GE(test, after.mandatory - before.mandatory, 64ULL);
+}
+
+static void planes_nodes_and_failure(struct kunit *test)
+{
+	struct hdn_alloc_stats before, after;
+	void *normal, *accounted, *reclaimable, *node_object;
+	struct kmem_cache *normal_cache, *accounted_cache, *reclaim_cache;
+	u64 test_attempts, test_failures;
+	int node = first_memory_node;
+
+	normal = __hdn_alloc_typed(256, GFP_KERNEL, NUMA_NO_NODE, 0,
+				   HDN_TEST_ID_A, HDN_ALLOC_IPC_QUEUE);
+	accounted = __hdn_alloc_typed(256, GFP_KERNEL_ACCOUNT, NUMA_NO_NODE, 0,
+				      HDN_TEST_ID_A, HDN_ALLOC_IPC_QUEUE);
+	reclaimable = __hdn_alloc_typed(256, GFP_KERNEL | __GFP_RECLAIMABLE,
+					NUMA_NO_NODE, 0, HDN_TEST_ID_A,
+					HDN_ALLOC_IPC_QUEUE);
+	if (!normal || !accounted || !reclaimable) {
+		kfree(normal);
+		kfree(accounted);
+		kfree(reclaimable);
+		KUNIT_FAIL(test, "allocation-plane setup failed");
+		return;
+	}
+	normal_cache = virt_to_slab(normal)->slab_cache;
+	accounted_cache = virt_to_slab(accounted)->slab_cache;
+	reclaim_cache = virt_to_slab(reclaimable)->slab_cache;
+	KUNIT_EXPECT_EQ(test, normal_cache->hdn_alloc_domain,
+			(unsigned int)HDN_ALLOC_IPC_QUEUE);
+	KUNIT_EXPECT_TRUE(test, reclaim_cache->flags & SLAB_RECLAIM_ACCOUNT);
+	if (IS_ENABLED(CONFIG_MEMCG)) {
+		KUNIT_EXPECT_TRUE(test, accounted_cache->flags & SLAB_ACCOUNT);
+		KUNIT_EXPECT_PTR_NE(test, normal_cache, accounted_cache);
+	}
+	KUNIT_EXPECT_PTR_NE(test, normal_cache, reclaim_cache);
+	kfree(normal);
+	kfree(accounted);
+	kfree(reclaimable);
+
+	node_object = __hdn_alloc_typed(256, GFP_KERNEL | __GFP_THISNODE, node, 0,
+					HDN_TEST_ID_A, HDN_ALLOC_IPC_QUEUE);
+	if (!node_object) {
+		KUNIT_FAIL(test, "node-local allocation failed");
+		return;
+	}
+	KUNIT_EXPECT_EQ(test, page_to_nid(virt_to_page(node_object)), node);
+	kfree(node_object);
+
+	hdn_alloc_get_stats(&before);
+	KUNIT_ASSERT_EQ(test, hdn_alloc_test_fail(HDN_TEST_ID_FAIL), 0);
+	normal = __hdn_alloc_typed(64, GFP_KERNEL | __GFP_NOWARN, NUMA_NO_NODE, 0,
+				   HDN_TEST_ID_FAIL, HDN_ALLOC_IPC_QUEUE);
+	hdn_alloc_test_clear(&test_attempts, &test_failures);
+	KUNIT_EXPECT_PTR_EQ(test, normal, NULL);
+	KUNIT_EXPECT_EQ(test, test_attempts, 1ULL);
+	KUNIT_EXPECT_EQ(test, test_failures, 1ULL);
+	hdn_alloc_get_stats(&after);
+	KUNIT_EXPECT_GE(test, after.typed - before.typed, 1ULL);
+	KUNIT_EXPECT_GE(test, after.failed - before.failed, 1ULL);
+}
+
+static void bulk_rcu_and_shrink(struct kunit *test)
+{
+	struct kmem_cache *first, *second;
+	struct autoslab_rcu_object *delayed;
+	DECLARE_COMPLETION_ONSTACK(done);
+	void *objects[256];
+	unsigned int count;
+
+	first = kmem_cache_create("hdn-autoslab-bulk-a",
+				  sizeof(struct autoslab_rcu_object), 0,
+				  SLAB_ACCOUNT | SLAB_HDN_DOMAIN, NULL);
+	if (!first) {
+		KUNIT_FAIL(test, "first bulk cache creation failed");
+		return;
+	}
+	second = kmem_cache_create("hdn-autoslab-bulk-b",
+				   sizeof(struct autoslab_rcu_object), 0,
+				   SLAB_ACCOUNT | SLAB_HDN_DOMAIN, NULL);
+	if (!second) {
+		kmem_cache_destroy(first);
+		KUNIT_FAIL(test, "second bulk cache creation failed");
+		return;
+	}
+	hdn_cache_domain(first, HDN_ALLOC_JITTER_META);
+	hdn_cache_domain(second, HDN_ALLOC_JITTER_TEST);
+	KUNIT_ASSERT_PTR_NE(test, first, second);
+
+	count = kmem_cache_alloc_bulk(first, GFP_KERNEL_ACCOUNT,
+				      ARRAY_SIZE(objects), objects);
+	if (count != ARRAY_SIZE(objects)) {
+		kmem_cache_free_bulk(first, count, objects);
+		kmem_cache_destroy(first);
+		kmem_cache_destroy(second);
+		KUNIT_FAIL(test, "bulk allocation returned a partial batch");
+		return;
+	}
+	for (unsigned int i = 0; i < count; i++) {
+		KUNIT_EXPECT_PTR_EQ(test, virt_to_slab(objects[i])->slab_cache, first);
+		KUNIT_EXPECT_EQ(test, allocation_domain(objects[i]),
+				(unsigned int)HDN_ALLOC_JITTER_META);
+	}
+	delayed = objects[--count];
+	delayed->done = &done;
+	delayed->cache = first;
+	delayed->payload = HDN_TEST_ID_A;
+	call_rcu(&delayed->rcu, autoslab_rcu_free);
+	kmem_cache_free_bulk(first, count, objects);
+	wait_for_completion(&done);
+	rcu_barrier();
+	KUNIT_EXPECT_EQ(test, kmem_cache_shrink(first), 0);
+	KUNIT_EXPECT_EQ(test, kmem_cache_shrink(second), 0);
+	kmem_cache_destroy(first);
+	kmem_cache_destroy(second);
+}
+
+static struct kunit_case autoslab_cases[] = {
+	KUNIT_CASE(domains_and_resize),
+	KUNIT_CASE(planes_nodes_and_failure),
+	KUNIT_CASE(bulk_rcu_and_shrink),
+	{}
+};
+static struct kunit_suite autoslab_suite = {
+	.name = "hdn-autoslab", .test_cases = autoslab_cases,
+};
+kunit_test_suite(autoslab_suite);
+MODULE_LICENSE("GPL");
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/autoslab_test_module.c linux-7.0.12-hdn/security/hardening/autoslab_test_module.c
--- linux-7.0.12/security/hardening/autoslab_test_module.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/autoslab_test_module.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/hdn_alloc.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include "../../mm/slab.h"
+
+#define HDN_AUTOSLAB_MODULE_ID 0x4d4f44554c45534cULL
+
+struct autoslab_module_object {
+	u64 marker;
+	unsigned int length;
+	u8 payload[];
+};
+
+static int __init autoslab_module_init(void)
+{
+	void *(*runtime_alloc)(size_t, gfp_t, int, unsigned int, u64,
+			      unsigned int) = __hdn_alloc_typed;
+	struct autoslab_module_object *typed;
+	void *requested;
+	unsigned int typed_domain, requested_domain;
+
+	typed = kzalloc_flex(*typed, payload, 64);
+	requested = runtime_alloc(struct_size(typed, payload, 64), GFP_KERNEL,
+				  NUMA_NO_NODE, 0, HDN_AUTOSLAB_MODULE_ID,
+				  HDN_ALLOC_CRED);
+	if (!typed || !requested)
+		goto fail;
+	typed_domain = virt_to_slab(typed)->slab_cache->hdn_alloc_domain;
+	requested_domain = virt_to_slab(requested)->slab_cache->hdn_alloc_domain;
+	if (typed_domain != HDN_ALLOC_MODULE || requested_domain != HDN_ALLOC_MODULE ||
+	    memchr_inv(typed, 0, struct_size(typed, payload, 64)))
+		goto fail;
+	pr_info("HDN_AUTOSLAB_MODULE_PASS typed_domain=%u requested_domain=%u\n",
+		typed_domain, requested_domain);
+	kfree(requested);
+	kfree(typed);
+	return 0;
+fail:
+	pr_err("HDN_AUTOSLAB_MODULE_FAIL\n");
+	kfree(requested);
+	kfree(typed);
+	return -EINVAL;
+}
+
+static void __exit autoslab_module_exit(void)
+{
+	pr_info("HDN_AUTOSLAB_MODULE_UNLOAD\n");
+}
+
+module_init(autoslab_module_init);
+module_exit(autoslab_module_exit);
+MODULE_DESCRIPTION("HDN AUTOSLAB module-domain fixture");
+MODULE_LICENSE("GPL");
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/bpf_execmem_test.c linux-7.0.12-hdn/security/hardening/bpf_execmem_test.c
--- linux-7.0.12/security/hardening/bpf_execmem_test.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/bpf_execmem_test.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fresh-guest-only BPF executable-memory permission and stale-address probes. */
+#include <linux/execmem.h>
+#include <linux/hdn_execmem.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/set_memory.h>
+#include <linux/vmalloc.h>
+
+typedef int (*hdn_bpf_test_fn_t)(void);
+
+int hdn_bpf_execmem_test_run(unsigned int mode);
+
+static int hdn_bpf_execmem_placement(void)
+{
+	void *images[64] = {};
+	u64 buckets = 0;
+	unsigned int allocated = 0, count, n;
+	int error = 0;
+
+	for (n = 0; n < ARRAY_SIZE(images); n++) {
+		int bucket;
+
+		images[n] = execmem_alloc_rw(EXECMEM_BPF, PAGE_SIZE);
+		if (!images[n] || !execmem_bpf_contains(images[n], PAGE_SIZE) ||
+		    !IS_ALIGNED((unsigned long)images[n], PAGE_SIZE)) {
+			error = -ENOMEM;
+			break;
+		}
+		allocated++;
+		bucket = execmem_bpf_test_bucket(images[n]);
+		if (bucket < 0) {
+			error = bucket;
+			break;
+		}
+		buckets |= 1ULL << bucket;
+	}
+	count = hweight64(buckets);
+	pr_info("HDN_BPF_PLACEMENT base=%016llx buckets=%016llx unique=%u\n",
+		(unsigned long long)execmem_bpf_test_base_token(),
+		(unsigned long long)buckets, count);
+	while (allocated)
+		execmem_free(images[--allocated]);
+	if (error)
+		return error;
+	return count < 2 ? -ERANGE : 0;
+}
+
+int hdn_bpf_execmem_test_run(unsigned int mode)
+{
+	static const u8 return_zero[] = { 0x31, 0xc0, 0xc3 };
+	hdn_bpf_test_fn_t function;
+	struct page *page;
+	void *alias, *image;
+	int error;
+
+	if (mode > 5)
+		return -EINVAL;
+	if (mode == 5) {
+		pr_info("HDN_BPF_EXECMEM_PROBE_READY mode=%u\n", mode);
+		return hdn_bpf_execmem_placement();
+	}
+	image = execmem_alloc_rw(EXECMEM_BPF, PAGE_SIZE);
+	if (!image || !execmem_bpf_contains(image, PAGE_SIZE))
+		return -ENOMEM;
+	error = hdn_execmem_bpf_copy(image, return_zero, sizeof(return_zero));
+	if (error != 1)
+		goto fail;
+	function = image;
+	pr_info("HDN_BPF_EXECMEM_PROBE_READY mode=%u\n", mode);
+	if (mode == 1)
+		return function();
+	error = hdn_execmem_bpf_finalize(image);
+	if (error)
+		goto fail;
+	if (mode == 2) {
+		WRITE_ONCE(*(u8 *)image, 0xcc);
+		return -EUCLEAN;
+	}
+	if (mode == 3) {
+		execmem_free(image);
+		return function();
+	}
+	if (function()) {
+		error = -EIO;
+		goto fail;
+	}
+	page = vmalloc_to_page(image);
+	if (!page) {
+		error = -EFAULT;
+		goto fail;
+	}
+	alias = vmap(&page, 1, VM_MAP, PAGE_KERNEL);
+	if (alias) {
+		vunmap(alias);
+		error = -EACCES;
+		goto fail;
+	}
+	if (mode == 4 && set_memory_rw((unsigned long)image, 1) != -EACCES) {
+		error = -EACCES;
+		goto fail;
+	}
+	execmem_free(image);
+	return 0;
+fail:
+	execmem_free(image);
+	return error;
+}
+EXPORT_SYMBOL_GPL(hdn_bpf_execmem_test_run);
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/bpf_execmem_test_module.c linux-7.0.12-hdn/security/hardening/bpf_execmem_test_module.c
