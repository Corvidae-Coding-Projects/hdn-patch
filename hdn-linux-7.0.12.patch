+static off_t self_pagemap_offset(void)
+{
+	long page_size = sysconf(_SC_PAGESIZE);
+	uintptr_t addr = (uintptr_t)&page_size;
+
+	if (page_size <= 0)
+		page_size = 4096;
+
+	return (off_t)((addr / (uintptr_t)page_size) * sizeof(uint64_t));
+}
