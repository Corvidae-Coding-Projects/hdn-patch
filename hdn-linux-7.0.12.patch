+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/workqueue.h>
+#include <linux/kprobes.h>
+#include <asm/irqflags.h>
+#include <asm/bug.h>
+#include <asm/cpu_entry_area.h>
