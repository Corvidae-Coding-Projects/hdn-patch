+	X(msg_queue, IPC_QUEUE, "ipc/msg.c") \
+	X(msg_msgseg, IPC_SEGMENT, "ipc/msgutil.c") \
+	X(sem_array, SEM_ARRAY, "ipc/sem.c") \
+	X(sem_undo, SEM_UNDO, "ipc/sem.c") \
+	X(sem_undo_list, UNDO_LIST, "ipc/sem.c") \
+	X(shmid_kernel, SHM, "ipc/shm.c") \
