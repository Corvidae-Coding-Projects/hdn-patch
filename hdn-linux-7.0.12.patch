diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-compat.h linux-7.0.12-hdn/tools/objtool/hdn-compat.h
--- linux-7.0.12/tools/objtool/hdn-compat.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-compat.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Compat hardware entries keep the IA32 ABI, including the shared SYSRETL
+ * exit. Only SYSENTER may join that interior continuation. */
+static bool rap_compat_user_cr3(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (!rap_hw_alt_is(p, "X86_FEATURE_PTI"))
+		return true;
+	if (!rap_hw_skip(&k, "X86_FEATURE_PTI", 0) ||
+	    !rap_sequence_bytes(p, "\x41\x0f\x20\xd8", 4) ||
+	    !rap_hw_skip(&k, "X86_FEATURE_PCID", 3) ||
+	    !rap_sequence_bytes(p, "\x4d\x89\xc1\x49\x81\xe0\xff\x07\0\0", 10) ||
+	    !rap_thunk_percpu_offset(p, "\x4c\x0f\xa3\x05", 4, "", 0, "cpu_tlbstate", 22) ||
+	    !rap_kexec_branch(&k, 0x73, 1) ||
+	    !rap_thunk_percpu_offset(p, "\x4c\x0f\xb3\x05", 4, "", 0, "cpu_tlbstate", 22) ||
+	    !rap_sequence_bytes(p, "\x4d\x89\xc8", 3) || !rap_kexec_branch(&k, 0xeb, 2) ||
+	    !rap_kexec_label(&k, 1) || !rap_sequence_bytes(p, "\x4d\x89\xc8\x49\x0f\xba\xe8\x3f", 8) ||
+	    !rap_kexec_label(&k, 2) || !rap_sequence_bytes(p, "\x49\x81\xc8\0\x08\0\0", 7) ||
+	    !rap_kexec_label(&k, 3) || !rap_sequence_bytes(p, "\x49\x81\xc8\0\x10\0\0\x41\x0f\x22\xd8", 11) ||
+	    !rap_kexec_label(&k, 0) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_compat_regs(struct rap_sequence *s)
+{
+	/* SYSCALL uses RBP for arg2; save it in pt_regs.cx. SYSENTER instead
+	 * uses the ordinary register helper, which saves RCX in this slot. */
+	return rap_sequence_bytes(s,
+		"\x57\x56\x52\x55\x6a\xda\x41\x50\x41\x51\x41\x52\x41\x53"
+		"\x53\x55\x41\x54\x41\x55\x41\x56\x41\x57"
+		"\x31\xf6\x31\xd2\x31\xc9\x45\x31\xc0\x45\x31\xc9\x45\x31\xd2"
+		"\x45\x31\xdb\x31\xdb\x31\xed\x45\x31\xe4\x45\x31\xed\x45\x31\xf6\x45\x31\xff", 58);
+}
+
+static int verify_rap_compat(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_kexec_sequence k = { .seq = { .file = file, .func = func } };
+	struct rap_sequence *s = &k.seq;
+	struct instruction *insn;
+	bool sysenter = func->rap_kind == 44;
+
+#define COMPAT_BYTES(bytes) do { if (!rap_sequence_bytes(s, bytes, sizeof(bytes) - 1)) goto bad; } while (0)
+#define COMPAT_LABEL(name) do { if (!rap_thunk_symbol(file, name, func->sec, func->offset + s->pos)) goto bad; } while (0)
+	if (is_weak_sym(func) || !func->sec->noinstr ||
+	    strcmp(func->name, sysenter ? "entry_SYSENTER_compat" : "entry_SYSCALL_compat") || !rap_hw_endbr(s))
+		goto bad;
+	COMPAT_BYTES("\x0f\x01\xf8");
+	if (sysenter) {
+		COMPAT_BYTES("\x50");
+		if (!rap_hw_switch_kernel_cr3(s, 0))
+			goto bad;
+		COMPAT_BYTES("\x58");
+	} else {
+		COMPAT_BYTES("\x41\x89\xe0");
+		if (!rap_hw_switch_kernel_cr3(s, 4))
+			goto bad;
+	}
+	if (!rap_thunk_percpu(s, "\x48\x8b\x25", 3, "", 0, "cpu_current_top_of_stack"))
+		goto bad;
+	if (sysenter) {
+		COMPAT_BYTES("\x6a\x2b\x6a\0\x9c\x6a\x23\x6a\0");
+		COMPAT_LABEL("entry_SYSENTER_compat_after_hwframe");
+	} else {
+		COMPAT_LABEL("entry_SYSCALL_compat_safe_stack");
+		COMPAT_BYTES("\x6a\x2b\x41\x50\x41\x53\x6a\x23\x51");
+		COMPAT_LABEL("entry_SYSCALL_compat_after_hwframe");
+	}
+	COMPAT_BYTES("\x89\xc0\x50");
+	if (!(sysenter ? rap_hw_syscall_regs(s) : rap_compat_regs(s)))
+		goto bad;
+	if (sysenter) {
+		COMPAT_BYTES("\xfc\xf7\x84\x24\x90\0\0\0\0\x41\x04\0");
+		if (!rap_kexec_branch(&k, 0x75, 0) || !rap_kexec_label(&k, 1))
+			goto bad;
+	}
+	if (!rap_hw_ibrs(s, true, false) || !rap_hw_untrain(s, false) || !rap_hw_bhb(s))
+		goto bad;
+	COMPAT_BYTES("\x48\x89\xe7");
+	if (!rap_entry_call(s, sysenter ? "do_SYSENTER_32" : "do_fast_syscall_32"))
+		goto bad;
+	if (sysenter) {
+		if (!rap_sequence_edge_match(s, "__hdn_rap_sysret32", false, false) || !rap_kexec_label(&k, 0))
+			goto bad;
+		COMPAT_BYTES("\x6a\x02\x9d");
+		if (!rap_kexec_branch(&k, 0xeb, 1) || !rap_hw_local_edges(&k))
+			goto bad;
+		COMPAT_LABEL("__end_entry_SYSENTER_compat");
+	} else {
+		COMPAT_LABEL("__hdn_rap_sysret32");
+		COMPAT_BYTES("\x84\xc0");
+		if (!rap_hw_branch(s, "swapgs_restore_regs_and_return_to_usermode", 0x74) ||
+		    !rap_hw_stack_erase(s, false) || !rap_hw_ibrs(s, false, false))
+			goto bad;
+		COMPAT_BYTES("\x48\x8b\x5c\x24\x28\x48\x8b\x6c\x24\x20"
+			"\x4c\x8b\x9c\x24\x90\0\0\0\x48\x8b\x8c\x24\x80\0\0\0"
+			"\x48\x83\xc4\x50\x58\x5a\x5a\x5e\x5f\x48\x8b\x64\x24\x20");
+		COMPAT_LABEL("entry_SYSRETL_compat_unsafe_stack");
+		if (!rap_compat_user_cr3(s))
+			goto bad;
+		COMPAT_BYTES("\x45\x31\xc0\x45\x31\xc9\x45\x31\xd2\x0f\x01\xf8");
+		if (!rap_hw_clear_buffers(s))
+			goto bad;
+		COMPAT_BYTES("\x0f\x07");
+		COMPAT_LABEL("entry_SYSRETL_compat_end");
+		COMPAT_BYTES("\xcc");
+	}
+	if (s->pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt && !insn->rap_thunk_alt)
+			goto bad;
+	func->rap_compat_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s->pos, "RAP compat syscall differs from its complete entry/exit protocol");
+	return -1;
+#undef COMPAT_LABEL
+#undef COMPAT_BYTES
+}
+
+static int verify_rap_int80(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+
+	if (is_weak_sym(func) || func->rap_kind != 1 || func->rap_returns != 1 ||
+	    !func->sec->noinstr ||
+	    !rap_sequence_bytes(&s, "\x4c\x8d\x1d\x05\0\0\0", 7) ||
+	    !rap_sequence_edge_match(&s, "__hdn_rap_enter", true, false) ||
+	    !rap_hw_bhb(&s) || !rap_entry_call(&s, "do_int80_emulation") ||
+	    !rap_sequence_edge(&s, "__hdn_rap_return", false) || s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt)
+			goto bad;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP int80 bridge lacks its typed entry and protected return");
+	return -1;
+}
+
+static int validate_rap_compat_peers(struct objtool_file *file)
+{
+	struct symbol *enter = find_symbol_by_name(file->elf, "entry_SYSENTER_compat");
+	struct symbol *call = find_symbol_by_name(file->elf, "entry_SYSCALL_compat");
+	struct symbol *resume = find_symbol_by_name(file->elf, "__hdn_rap_sysret32");
+	struct symbol *bridge = find_symbol_by_name(file->elf, "int80_emulation");
+	struct instruction *insn;
+	unsigned int i;
+	static const char * const handlers[] = { "do_SYSENTER_32", "do_fast_syscall_32", "do_int80_emulation", "clear_bhb_loop" };
+
+	if ((!enter || is_undef_sym(enter)) && (!call || is_undef_sym(call)))
+		return 0;
+	if (!enter || !call || is_undef_sym(enter) || is_undef_sym(call) ||
+	    enter->rap_kind != 44 || call->rap_kind != 45 ||
+	    !enter->rap_compat_protocol || !call->rap_compat_protocol ||
+	    !resume || resume->sec != call->sec || !bridge || is_undef_sym(bridge) ||
+	    verify_rap_int80(file, bridge))
+		goto bad;
+	if (opts.link)
+		for (i = 0; i < ARRAY_SIZE(handlers); i++) {
+			struct symbol *handler = find_symbol_by_name(file->elf, handlers[i]);
+			if (!handler || handler->rap_kind != (i == 3 ? 5 : 1))
+				goto bad;
+		}
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct section *sec;
+		unsigned long offset;
+
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset))
+			continue;
+		if (owner != enter && sec == enter->sec && offset >= enter->offset &&
+		    offset < enter->offset + enter->len)
+			goto bad;
+		if (owner != call && sec == call->sec && offset >= call->offset &&
+		    offset < call->offset + call->len &&
+		    !(owner == enter && offset == resume->offset && insn->type == INSN_JUMP_UNCONDITIONAL))
+			goto bad;
+		if (owner != bridge && sec == bridge->sec && offset >= bridge->offset &&
+		    offset < bridge->offset + bridge->len &&
+		    !(owner && owner->rap_kind == 33 && !strcmp(owner->name, "asm_int80_emulation") &&
+		      offset == bridge->offset && insn->type == INSN_CALL && insn->rap_site))
+			goto bad;
+	}
+	return 0;
+bad:
+	ERROR("RAP compat entry has an unverified handler or an unauthorized incoming transfer");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-crypto.h linux-7.0.12-hdn/tools/objtool/hdn-crypto.h
--- linux-7.0.12/tools/objtool/hdn-crypto.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-crypto.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Closed assembly-only crypto ABIs. The normal RAP verifier still checks
+ * every transfer; these lists never exempt a body from that verification. */
+static bool rap_regs_name(const char *name)
+{
+	static const char * const names[] = {
+		"__aria_aesni_avx2_crypt_32way",
+		"__aria_aesni_avx2_ctr_gen_keystream_32way",
+		"__aria_aesni_avx2_gfni_crypt_32way",
+		"__aria_aesni_avx_crypt_16way",
+		"__aria_aesni_avx_ctr_gen_keystream_16way",
+		"__aria_aesni_avx_gfni_crypt_16way",
+		"__aria_gfni_avx512_crypt_64way",
+		"__aria_gfni_avx512_ctr_gen_keystream_64way",
+		"__camellia_dec_blk16",
+		"__camellia_dec_blk32",
+		"__camellia_enc_blk16",
+		"__camellia_enc_blk32",
+		"__cast5_dec_blk16",
+		"__cast5_enc_blk16",
+		"__cast6_dec_blk8",
+		"__cast6_enc_blk8",
+		"__poly1305_block",
+		"__poly1305_init_avx",
+		"__serpent_dec_blk16",
+		"__serpent_dec_blk8_avx",
+		"__serpent_enc_blk16",
+		"__serpent_enc_blk8_avx",
+		"__sm4_crypt_blk16",
+		"__sm4_crypt_blk8",
+		"__twofish_dec_blk8",
+		"__twofish_enc_blk8",
+		"arch_bpf_timed_may_goto",
+		"hdn_hv_vtl_gate",
+		"chacha_permute",
+		"roundsm16_x0_x1_x2_x3_x4_x5_x6_x7_y0_y1_y2_y3_y4_y5_y6_y7_cd",
+		"roundsm16_x4_x5_x6_x7_x0_x1_x2_x3_y4_y5_y6_y7_y0_y1_y2_y3_ab",
+		"roundsm32_x0_x1_x2_x3_x4_x5_x6_x7_y0_y1_y2_y3_y4_y5_y6_y7_cd",
+		"roundsm32_x4_x5_x6_x7_x0_x1_x2_x3_y4_y5_y6_y7_y0_y1_y2_y3_ab",
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (!strcmp(name, names[i]))
+			return true;
+	return false;
+}
+
+static bool rap_crypto_private_name(const char *name)
+{
+	static const char * const names[] = {
+		"__clmul_gf128mul_ble",
+		"_aesni_dec1",
+		"_aesni_dec4",
+		"_aesni_enc1",
+		"_aesni_enc4",
+		"_aesni_inc",
+		"_aesni_inc_init",
+		"_key_expansion_192a",
+		"_key_expansion_192b",
+		"_key_expansion_256a",
+		"_key_expansion_256b",
+	};
+	unsigned int i;
+
+	if (rap_regs_name(name) && strcmp(name, "hdn_hv_vtl_gate"))
+		return true;
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (!strcmp(name, names[i]))
+			return true;
+	return false;
+}
+
+static bool rap_regs_insn(struct objtool_file *file, struct instruction *insn,
+			  struct symbol *owner, const char *bytes, size_t len)
+{
+	return insn && rap_insn_owner(insn) == owner && !insn->alts &&
+		insn->len == len &&
+		!find_reloc_by_dest_range(file->elf, insn->sec, insn->offset, len) &&
+		!memcmp(insn->sec->data->d_buf + insn->offset, bytes, len);
+}
+
+/* Match both ends of HDN_REGS_CALL and the callee's data transports. The two
+ * words above the authenticated return slot must never become C arguments or
+ * a different private convention. The sole global helper is also called by
+ * the BPF JIT, whose sealed-image admission checks the same paired bytes. */
+static int verify_rap_regs(struct objtool_file *file, struct symbol *func)
+{
+	struct instruction *insn, *a, *b, *binding;
+	bool vtl = !strcmp(func->name, "hdn_hv_vtl_gate");
+
+	if ((func->bind != STB_LOCAL && strcmp(func->name, "arch_bpf_timed_may_goto") && !vtl) ||
+	    func->rap_kind != (vtl ? 20 : 5))
+		goto bad;
+	rap_for_each_insn(file, func, insn) {
+		if (insn->rap_entry) {
+			a = next_insn_same_sec(file, insn);
+			b = a ? next_insn_same_sec(file, a) : NULL;
+			if (!rap_regs_insn(file, a, func, "\x4c\x8b\x54\x24\x08", 5) ||
+			    !rap_regs_insn(file, b, func, "\x4c\x8b\x5c\x24\x10", 5) ||
+			    a->offset != insn->offset + insn->len || b->offset != a->offset + a->len)
+				goto bad;
+		}
+		if (insn->rap_return) {
+			b = prev_insn_same_sec(file, insn);
+			a = b ? prev_insn_same_sec(file, b) : NULL;
+			if (!rap_regs_insn(file, a, func, "\x4c\x89\x54\x24\x08", 5) ||
+			    !rap_regs_insn(file, b, func, "\x4c\x89\x5c\x24\x10", 5) ||
+			    b->offset != a->offset + a->len || insn->offset != b->offset + b->len)
+				goto bad;
+		}
+	}
+	for_each_insn(file, insn) {
+		struct symbol *caller = rap_insn_owner(insn);
+
+		if (insn->jump_dest && rap_insn_owner(insn->jump_dest) == func && caller != func)
+			goto bad;
+		if (insn->type != INSN_CALL || insn_call_dest(insn) != func)
+			continue;
+		binding = prev_insn_same_sec(file, insn);
+		b = binding ? prev_insn_same_sec(file, binding) : NULL;
+		a = b ? prev_insn_same_sec(file, b) : NULL;
+		if (!caller || !insn->rap_site || insn->alts || !binding ||
+		    !binding->rap_binding || binding->alts ||
+		    !rap_regs_insn(file, a, caller, "\x41\x53", 2) ||
+		    !rap_regs_insn(file, b, caller, "\x41\x52", 2) ||
+		    b->offset != a->offset + a->len || binding->offset != b->offset + b->len)
+			goto bad;
+		a = next_insn_same_sec(file, insn);
+		b = a ? next_insn_same_sec(file, a) : NULL;
+		if (!rap_regs_insn(file, a, caller, "\x41\x5a", 2) ||
+		    !rap_regs_insn(file, b, caller, "\x41\x5b", 2) ||
+		    a->offset != insn->offset + insn->len || b->offset != a->offset + a->len)
+			goto bad;
+	}
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset, "RAP assembly register ABI has an unpaired argument/result transport");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-efi.h linux-7.0.12-hdn/tools/objtool/hdn-efi.h
--- linux-7.0.12/tools/objtool/hdn-efi.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-efi.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Native EFI is a closed foreign ABI: match every instruction and relocation,
+ * including the only unchecked (firmware) CALL and the protected return path. */
+/* The return stub is deliberately data, mapped executable only in efi_mm.
+ * Validate its complete mixed 64/32-bit encoding without decoding 32-bit
+ * instructions with objtool's ordinary 64-bit text decoder. */
+static bool rap_efi_trampoline(struct objtool_file *file)
+{
+	struct symbol *blob = find_symbol_by_name(file->elf, "__efi64_thunk_ret_tramp");
+	struct symbol *compat = find_symbol_by_name(file->elf, "__hdn_efi32_return");
+	struct symbol *target = find_symbol_by_name(file->elf, "__hdn_efi_return");
+	struct reloc *reloc;
+	const char *bytes;
+
+	if (!blob || !compat || !target || is_weak_sym(blob) || is_weak_sym(compat) ||
+	    is_weak_sym(target) || blob->len != 17 || blob->offset % 4096 ||
+	    blob->offset + blob->len > sec_size(blob->sec) ||
+	    !(blob->sec->sh.sh_flags & SHF_ALLOC) || (blob->sec->sh.sh_flags & SHF_WRITE) ||
+	    compat->sec != blob->sec || compat->offset != blob->offset + 13)
+		return false;
+	bytes = blob->sec->data->d_buf + blob->offset;
+	if (memcmp(bytes, "\x49\xbb", 2) ||
+	    memcmp(bytes + 10, "\x41\xff\xe3\x6a\x10\x55\xcb", 7))
+		return false;
+	reloc = find_reloc_by_dest(file->elf, blob->sec, blob->offset + 2);
+	return reloc && reloc_type(reloc) == R_X86_64_64 && arch_reloc_size(reloc) == 8 &&
+		reloc->sym->sec == target->sec &&
+		(!is_undef_sym(target) || reloc->sym == target) &&
+		reloc->sym->offset + reloc_addend(reloc) == target->offset &&
+		!find_reloc_by_dest_range(file->elf, blob->sec, blob->offset, 2) &&
+		!find_reloc_by_dest_range(file->elf, blob->sec, blob->offset + 3, 14);
+}
+
+static int verify_rap_efi(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn, *first = find_insn(file, func->sec, func->offset);
+
+#define EFI_BYTES(bytes) do { \
+	if (!rap_sequence_bytes(&s, bytes, sizeof(bytes) - 1)) goto bad; \
+} while (0)
+#define EFI_REF(bytes, name) do { \
+	if (!rap_sequence_reference(&s, bytes, sizeof(bytes) - 1, name, true)) goto bad; \
+} while (0)
+#define EFI_EDGE(name, call, bound) do { \
+	if (!rap_sequence_edge_match(&s, name, call, bound)) goto bad; \
+} while (0)
+	if (is_weak_sym(func) || strcmp(func->name,
+		func->rap_kind == 14 ? "__hdn_efi_call" :
+		func->rap_kind == 15 ? "__hdn_efi_return" :
+		func->rap_kind == 16 ? "__hdn_efi_fault_return" : "__hdn_efi64_thunk"))
+		goto bad;
+	if (first && first->type == INSN_ENDBR)
+		EFI_BYTES("\xf3\x0f\x1e\xfa");
+	if (func->rap_kind == 16) {
+		EFI_BYTES("\x48\xb8\x15\0\0\0\0\0\0\x80");
+		EFI_EDGE("__hdn_efi_return", false, false);
+	} else if (func->rap_kind == 14 || func->rap_kind == 17) {
+	EFI_BYTES("\x4c\x8d\x1d\x05\0\0\0");
+	EFI_EDGE("__hdn_rap_enter", true, false);
+	EFI_BYTES("\x9c\xfa\x53\x55\x41\x54\x41\x55\x41\x56\x41\x57"
+		  "\x48\x83\xec\x40\x48\x89\x14\x24\x48\x89\x4c\x24\x08"
+		  "\x4c\x89\x44\x24\x10\x4c\x89\x4c\x24\x18"
+		  "\x48\x8b\x84\x24\x80\0\0\0\x48\x89\x44\x24\x20"
+		  "\x48\x8b\x84\x24\x88\0\0\0\x48\x89\x44\x24\x28"
+		  "\x48\x8b\x84\x24\x90\0\0\0\x48\x89\x44\x24\x30"
+		  "\x48\x8b\x84\x24\x98\0\0\0\x48\x89\x44\x24\x38"
+		  "\x48\x89\xe2");
+	if (func->rap_kind == 17)
+		EFI_BYTES("\xb9\x01\0\0\0");
+	else
+		EFI_BYTES("\x31\xc9");
+	EFI_BYTES("\x4c\x8d\x15\x05\0\0\0");
+	EFI_EDGE("hdn_efi_enter", true, true);
+	if (func->rap_kind == 17) {
+		EFI_BYTES("\x49\x89\xc2");
+		EFI_REF("\x48\x8b\x25", "efi_mixed_mode_stack_pa");
+		EFI_BYTES("\x48\x83\xec\x24\x48\xc7\xc0\0\0\0\x80");
+		EFI_REF("\x48\x2b\x05", "phys_base");
+		EFI_REF("\x48\x8d\x2d", "__efi64_thunk_ret_tramp");
+		EFI_REF("\x48\x8d\x1d", "__hdn_efi32_return");
+		EFI_BYTES("\x48\x29\xc5\x48\x29\xc3\x89\x1c\x24"
+			  "\x41\x8b\x12\x89\x54\x24\x04"
+			  "\x41\x8b\x52\x08\x89\x54\x24\x08"
+			  "\x41\x8b\x52\x10\x89\x54\x24\x0c"
+			  "\x41\x8b\x52\x18\x89\x54\x24\x10"
+			  "\x41\x8b\x52\x20\x89\x54\x24\x14"
+			  "\x41\x8b\x52\x28\x89\x54\x24\x18"
+			  "\x41\x8b\x52\x30\x89\x54\x24\x1c"
+			  "\x41\x8b\x52\x38\x89\x54\x24\x20"
+			  "\x6a\x08\x41\xff\xb2\x80\0\0\0\x48\xcb");
+		if (!rap_efi_trampoline(file))
+			goto bad;
+	} else {
+	EFI_BYTES("\x49\x89\xc3\x48\x83\xe4\xf0\x48\x83\xec\x30"
+		  "\x49\x8b\x43\x20\x48\x89\x44\x24\x20"
+		  "\x49\x8b\x43\x28\x48\x89\x44\x24\x28"
+		  "\x49\x8b\x0b\x49\x8b\x53\x08\x4d\x8b\x43\x10\x4d\x8b\x4b\x18"
+		  "\x41\xff\x73\x70\x9d\x4d\x8b\x9b\x80\0\0\0");
+	if (s.pos < func->len &&
+	    *((unsigned char *)func->sec->data->d_buf + func->offset + s.pos) == 0x2e)
+		EFI_REF("\x2e\xe8", "__x86_indirect_thunk_r11");
+	else
+		EFI_BYTES("\x41\xff\xd3");
+	EFI_EDGE("__hdn_efi_return", false, false);
+	}
+	} else {
+	EFI_BYTES("\xfa\xfc\x49\x89\xc0");
+	EFI_REF("\x4c\x8d\x1d", "hdn_efi_state");
+	EFI_BYTES("\x49\x8b\x83\x88\0\0\0\x48\x89\xc2\x48\xc1\xea\x20"
+		  "\xb9\x01\x01\0\xc0\x0f\x30\x49\x8b\x63\x78\x41\x50"
+		  "\x41\xff\x73\x70\x4d\x8b\x7b\x40\x4d\x8b\x73\x48"
+		  "\x4d\x8b\x6b\x50\x4d\x8b\x63\x58\x49\x8b\x6b\x60\x49\x8b\x5b\x68"
+		  "\x4c\x8d\x15\x05\0\0\0");
+	EFI_EDGE("hdn_efi_finish", true, true);
+	EFI_BYTES("\x9d\x58");
+	EFI_EDGE("__hdn_rap_return", false, false);
+	}
+	if (s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts)
+			goto bad;
+	for_each_insn(file, insn)
+		if (rap_insn_owner(insn) != func && insn->jump_dest && insn->jump_dest->sec == func->sec &&
+		    insn->jump_dest->offset > func->offset && insn->jump_dest->offset < func->offset + func->len)
+			goto bad;
+	func->rap_efi_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP EFI call does not match its protected foreign-ABI protocol");
+	return -1;
+#undef EFI_BYTES
+#undef EFI_REF
+#undef EFI_EDGE
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-entry-macros.h linux-7.0.12-hdn/tools/objtool/hdn-entry-macros.h
--- linux-7.0.12/tools/objtool/hdn-entry-macros.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-entry-macros.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,374 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Exact native entry-macro descriptions, shared by the IRQ/NMI/syscall roots. */
+static bool rap_hw_local_edges(struct rap_kexec_sequence *k)
+{
+	unsigned int i;
+
+	for (i = 0; i < k->count; i++) {
+		struct section *sec;
+		unsigned long offset;
+		if (!k->defined[k->branches[i].label] ||
+		    !rap_thunk_edge_target(k->seq.file, k->branches[i].insn, &sec, &offset) ||
+		    sec != k->seq.func->sec || offset != k->labels[k->branches[i].label])
+			return false;
+	}
+	return true;
+}
+
+static bool rap_hw_alt_is(struct rap_sequence *s, const char *feature)
+{
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	struct alternative *alt;
+
+	for (alt = first ? first->alts : NULL; alt; alt = alt->next) {
+		struct alt_group *g = alt->insn->alt_group;
+		const char *name = g ? arch_cpu_feature_name(g->feature & 0xffff) : NULL;
+
+		if (name && !strcmp(name, feature))
+			return true;
+	}
+	return false;
+}
+
+/* ALTERNATIVE "jmp local_label", "", feature. The empty replacement is
+ * represented by objtool's synthetic NOP, not bytes in the input object. */
+static bool rap_hw_skip(struct rap_kexec_sequence *k, const char *feature, unsigned int label)
+{
+	struct rap_sequence *s = &k->seq;
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	struct alt_group *orig = first ? first->alt_group : NULL, *g;
+	struct alternative *alt;
+	unsigned long end;
+	const char *name;
+
+	if (!orig || orig->orig_group || orig->first_insn != first || !orig->last_insn ||
+	    !(alt = first->alts) || alt->next || alt->type != ALT_TYPE_INSTRUCTIONS ||
+	    !(g = alt->insn->alt_group) || g->orig_group != orig ||
+	    g->first_insn != alt->insn || g->last_insn || g->nop != alt->insn || !g->nop->fake ||
+	    g->feature >> 16 || !(name = arch_cpu_feature_name(g->feature)) || strcmp(name, feature))
+		return false;
+	end = orig->last_insn->offset + orig->last_insn->len - s->func->offset;
+	if (end > s->func->len || end <= s->pos || g->nop->len != end - s->pos ||
+	    !rap_kexec_branch(k, 0xeb, label) || !rap_thunk_padding(s, end, false))
+		return false;
+	first->rap_hw_alt = true;
+	return true;
+}
+
+static bool rap_hw_untrain_alts(struct rap_sequence *s, bool leaves, bool from_call)
+{
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	struct alt_group *orig = first ? first->alt_group : NULL;
+	struct alternative *alt;
+	unsigned long end;
+	unsigned int seen = 0;
+
+	if (!orig || orig->orig_group || orig->first_insn != first || !orig->last_insn)
+		return false;
+	end = orig->last_insn->offset + orig->last_insn->len - s->func->offset;
+	if (end > s->func->len || end <= s->pos)
+		return false;
+	for (alt = first->alts; alt; alt = alt->next) {
+		struct alt_group *g = alt->insn->alt_group;
+		struct symbol span = *s->func;
+		struct rap_sequence body = { .file = s->file, .func = &span };
+		const char *feature;
+		unsigned int bit;
+
+		if (alt->type != ALT_TYPE_INSTRUCTIONS || !g || g->orig_group != orig ||
+		    g->first_insn != alt->insn || g->feature >> 16 ||
+		    !(feature = arch_cpu_feature_name(g->feature)))
+			return false;
+		span.sec = alt->insn->sec;
+		span.offset = alt->insn->offset;
+		span.len = g->last_insn ? g->last_insn->offset + g->last_insn->len - span.offset : 0;
+		if (span.len > end - s->pos || (!span.len && (g->nop != alt->insn || !g->nop->fake)))
+			return false;
+		if (leaves) {
+			if (!strcmp(feature, "X86_FEATURE_UNRET")) {
+				bit = 1;
+				if (!rap_sequence_edge_match(&body, "entry_untrain_ret", true, false)) return false;
+			} else if (!strcmp(feature, "X86_FEATURE_SRSO_ALIAS")) {
+				bit = 2;
+				if (!rap_sequence_edge_match(&body, "srso_alias_untrain_ret", true, false)) return false;
+			} else return false;
+		} else if (!strcmp(feature, "X86_FEATURE_ENTRY_IBPB")) {
+			bit = 1;
+			if (!rap_sequence_edge_match(&body, "write_ibpb", true, false)) return false;
+		} else if (!strcmp(feature, "X86_FEATURE_CALL_DEPTH")) {
+			bit = 2;
+			if (find_symbol_by_name(s->file->elf, "__x86_call_depth")) {
+				if (!rap_sequence_bytes(&body, from_call ? "\xb0\xfc\x48\xc1\xe0\x38" :
+						"\x31\xc0\x48\x0f\xba\xe8\x3f", from_call ? 6 : 7) ||
+				    !rap_thunk_percpu(&body, "\x48\x89\x05", 3, "", 0, "__x86_call_depth") ||
+				    (from_call && !rap_thunk_debug(&body, "__x86_call_count")))
+					return false;
+			}
+		} else return false;
+		if ((seen & bit) || body.pos != span.len)
+			return false;
+		seen |= bit;
+		rap_hw_mark(s->file, &span);
+	}
+	if (seen != 3 || !rap_thunk_padding(s, end, false))
+		return false;
+	first->rap_hw_alt = true;
+	return true;
+}
+
+static bool rap_hw_untrain(struct rap_sequence *s, bool from_call)
+{
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+
+	if (first && !first->alts)
+		rap_sequence_bytes(s, "\x90", 1); /* VALIDATE_UNRET_END */
+	if (rap_hw_alt_is(s, "X86_FEATURE_UNRET") && !rap_hw_untrain_alts(s, true, from_call))
+		return false;
+	if (rap_hw_alt_is(s, "X86_FEATURE_ENTRY_IBPB") && !rap_hw_untrain_alts(s, false, from_call))
+		return false;
+	return true;
+}
+
+static bool rap_hw_ibrs(struct rap_sequence *s, bool enter, bool save)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (!rap_hw_alt_is(s, "X86_FEATURE_KERNEL_IBRS"))
+		return true;
+	if (!rap_hw_skip(&k, "X86_FEATURE_KERNEL_IBRS", 0) ||
+	    !rap_sequence_bytes(p, "\xb9\x48\0\0\0", 5))
+		return false;
+	if (enter && save) {
+		if (!rap_sequence_bytes(p, "\x0f\x32\x48\xc1\xe2\x20\x48\x09\xd0\x49\x89\xc7"
+					  "\xa9\x01\0\0\0", 17) ||
+		    !rap_kexec_branch(&k, 0x74, 1) || !rap_sequence_bytes(p, "\x0f\xae\xe8", 3) ||
+		    !rap_kexec_branch(&k, 0xeb, 0) || !rap_kexec_label(&k, 1))
+			return false;
+	}
+	if (!enter && save) {
+		if (!rap_sequence_bytes(p, "\x4c\x89\xfa", 3))
+			return false;
+	} else {
+		if (!rap_thunk_percpu(p, "\x48\x8b\x15", 3, "", 0, "x86_spec_ctrl_current") ||
+		    (!enter && !rap_sequence_bytes(p, "\x83\xe2\xfe", 3)))
+			return false;
+	}
+	if (!rap_sequence_bytes(p, "\x89\xd0\x48\xc1\xea\x20\x0f\x30", 8) ||
+	    !rap_kexec_label(&k, 0) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_save_regs(struct rap_sequence *s)
+{
+	/* PUSH_AND_CLEAR_REGS save_ret=1; the sole return slot remains on top. */
+	return rap_sequence_bytes(s, "\x56\x48\x8b\x74\x24\x08\x48\x89\x7c\x24\x08"
+		"\x52\x51\x50\x41\x50\x41\x51\x41\x52\x41\x53\x53\x55\x41\x54"
+		"\x41\x55\x41\x56\x41\x57\x56", 33) &&
+		rap_sequence_bytes(s,
+		"\x31\xf6\x31\xd2\x31\xc9\x45\x31\xc0\x45\x31\xc9\x45\x31\xd2"
+		"\x45\x31\xdb\x31\xdb\x31\xed\x45\x31\xe4\x45\x31\xed"
+		"\x45\x31\xf6\x45\x31\xff", 34);
+}
+
+/* RAX-only form used by the IDT preamble, optionally preserving CR3 in R14. */
+static bool rap_hw_kernel_cr3(struct rap_sequence *s, bool save)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (save && !rap_sequence_bytes(p, "\x41\x0f\x20\xde", 4))
+		return false;
+	if (!rap_hw_alt_is(p, "X86_FEATURE_PTI")) {
+		*s = *p;
+		return true;
+	}
+	if (!rap_hw_skip(&k, "X86_FEATURE_PTI", 0) || !rap_sequence_bytes(p, "\x0f\x20\xd8", 3))
+		return false;
+	if (save && (!rap_sequence_bytes(p, "\x49\x89\xc6\x48\x0f\xba\xe0\x0c", 8) ||
+		     !rap_kexec_branch(&k, 0x73, 0)))
+		return false;
+	if (!rap_hw_fixed_alt(p, "X86_FEATURE_PCID", "\x48\x0f\xba\xe8\x3f", 5) ||
+	    !rap_sequence_bytes(p, "\x48\x25\xff\xe7\xff\xff\x0f\x22\xd8", 9) ||
+	    !rap_kexec_label(&k, 0) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_depth(struct rap_sequence *s)
+{
+	return !rap_hw_alt_is(s, "X86_FEATURE_CALL_DEPTH") ||
+		rap_thunk_alternative(s, RAP_ALT_DEPTH, 0);
+}
+
+static bool rap_hw_restore_cr3(struct rap_sequence *s, bool scratch_r15)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (rap_sequence_bytes(p, "\x41\x0f\x22\xde", 4)) {
+		if (opts.link && !find_symbol_by_name(s->file->elf, "hdn_stack_mm_ready"))
+			return false;
+		*s = *p;
+		return true;
+	}
+	if (opts.link && find_symbol_by_name(s->file->elf, "hdn_stack_mm_ready"))
+		return false;
+	if (!rap_hw_alt_is(p, "X86_FEATURE_PTI"))
+		return true;
+	if (!rap_hw_skip(&k, "X86_FEATURE_PTI", 0) ||
+	    !rap_sequence_bytes(p, "\x49\x0f\xba\xe6\x0c", 5) ||
+	    !rap_kexec_branch(&k, 0x73, 0) || !rap_hw_skip(&k, "X86_FEATURE_PCID", 1) ||
+	    !rap_sequence_bytes(p, scratch_r15 ? "\x4d\x89\xf7\x49\x81\xe7\xff\x07\0\0" :
+					       "\x4c\x89\xf0\x48\x25\xff\x07\0\0", scratch_r15 ? 10 : 9) ||
+	    !rap_thunk_percpu_offset(p, scratch_r15 ? "\x4c\x0f\xb3\x3d" : "\x48\x0f\xb3\x05",
+				    4, "", 0, "cpu_tlbstate", 22) ||
+	    !rap_kexec_branch(&k, 0x72, 1) || !rap_sequence_bytes(p, "\x49\x0f\xba\xee\x3f", 5) ||
+	    !rap_kexec_label(&k, 1) || !rap_sequence_bytes(p, "\x41\x0f\x22\xde", 4) ||
+	    !rap_kexec_label(&k, 0) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_single_alt(struct rap_sequence *s, const char *feature,
+		struct symbol *span, unsigned long *end, struct instruction **original)
+{
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	struct alt_group *orig = first ? first->alt_group : NULL, *g;
+	struct alternative *alt;
+	const char *name;
+
+	if (!orig || orig->orig_group || orig->first_insn != first || !orig->last_insn ||
+	    !(alt = first->alts) || alt->next || alt->type != ALT_TYPE_INSTRUCTIONS ||
+	    !(g = alt->insn->alt_group) || g->orig_group != orig ||
+	    g->first_insn != alt->insn || !g->last_insn || g->feature >> 16 ||
+	    !(name = arch_cpu_feature_name(g->feature)) || strcmp(name, feature))
+		return false;
+	*span = *s->func;
+	span->sec = alt->insn->sec;
+	span->offset = alt->insn->offset;
+	span->len = g->last_insn->offset + g->last_insn->len - span->offset;
+	*end = orig->last_insn->offset + orig->last_insn->len - s->func->offset;
+	*original = first;
+	return *end > s->pos && *end <= s->func->len && span->len <= *end - s->pos;
+}
+
+static bool rap_hw_take_alt(struct rap_kexec_sequence *k, const char *feature, unsigned int label)
+{
+	struct rap_sequence *s = &k->seq;
+	struct instruction *first, *jump;
+	struct symbol span;
+	struct reloc *reloc;
+	const unsigned char *p;
+	unsigned long end;
+
+	if (label >= ARRAY_SIZE(k->labels) || k->count == ARRAY_SIZE(k->branches) ||
+	    !rap_hw_single_alt(s, feature, &span, &end, &first))
+		return false;
+	jump = first->alts->insn;
+	p = span.sec->data->d_buf + span.offset;
+	if (jump->len != span.len || !((span.len == 2 && *p == 0xeb) || (span.len == 5 && *p == 0xe9)))
+		return false;
+	reloc = find_reloc_by_dest_range(s->file->elf, span.sec, span.offset, span.len);
+	if (reloc && (span.len != 5 || !arch_pc_relative_reloc(reloc) || arch_reloc_size(reloc) != 4 ||
+		      reloc_offset(reloc) != span.offset + 1 ||
+		      find_reloc_by_dest_range(s->file->elf, span.sec, span.offset + 2, 3)))
+		return false;
+	if (!rap_thunk_padding(s, end, false))
+		return false;
+	k->branches[k->count].insn = jump;
+	k->branches[k->count++].label = label;
+	first->rap_hw_alt = true;
+	rap_hw_mark(s->file, &span);
+	return true;
+}
+
+static bool rap_hw_clear_buffers(struct rap_sequence *s)
+{
+	struct symbol span;
+	struct instruction *first;
+	struct rap_sequence body = { .file = s->file, .func = &span };
+	unsigned long end;
+
+	if (!rap_hw_single_alt(s, "X86_FEATURE_CLEAR_CPU_BUF", &span, &end, &first) ||
+	    !rap_sequence_reference(&body, "\x0f\x00\x2d", 3, "x86_verw_sel", true) ||
+	    body.pos != span.len || !rap_thunk_padding(s, end, false))
+		return false;
+	first->rap_hw_alt = true;
+	rap_hw_mark(s->file, &span);
+	return true;
+}
+
+static bool rap_hw_switch_kernel_cr3(struct rap_sequence *s, unsigned int reg)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+	unsigned char read[] = { 0x0f, 0x20, 0xd8 + reg };
+	unsigned char write[] = { 0x0f, 0x22, 0xd8 + reg };
+	unsigned char bts[] = { 0x48, 0x0f, 0xba, 0xe8 + reg, 0x3f };
+	unsigned char mask[] = { 0x48, 0x81, 0xe0 + reg, 0xff, 0xe7, 0xff, 0xff };
+
+	if (reg != 0 && reg != 2 && reg != 4 && reg != 7)
+		return false;
+	if (!rap_hw_alt_is(p, "X86_FEATURE_PTI"))
+		return true;
+	if (!rap_hw_skip(&k, "X86_FEATURE_PTI", 0) ||
+	    !rap_sequence_bytes(p, (const char *)read, sizeof(read)) ||
+	    !rap_hw_fixed_alt(p, "X86_FEATURE_PCID", (const char *)bts, sizeof(bts)) ||
+	    !(reg ? rap_sequence_bytes(p, (const char *)mask, sizeof(mask)) :
+		    rap_sequence_bytes(p, "\x48\x25\xff\xe7\xff\xff", 6)) ||
+	    !rap_sequence_bytes(p, (const char *)write, sizeof(write)) ||
+	    !rap_kexec_label(&k, 0) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_user_cr3(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (!rap_sequence_bytes(p, "\x0f\x20\xdf", 3) || !rap_hw_skip(&k, "X86_FEATURE_PCID", 3) ||
+	    !rap_sequence_bytes(p, "\x48\x89\xf8\x48\x81\xe7\xff\x07\0\0", 10) ||
+	    !rap_thunk_percpu_offset(p, "\x48\x0f\xa3\x3d", 4, "", 0, "cpu_tlbstate", 22) ||
+	    !rap_kexec_branch(&k, 0x73, 1) ||
+	    !rap_thunk_percpu_offset(p, "\x48\x0f\xb3\x3d", 4, "", 0, "cpu_tlbstate", 22) ||
+	    !rap_sequence_bytes(p, "\x48\x89\xc7", 3) || !rap_kexec_branch(&k, 0xeb, 2) ||
+	    !rap_kexec_label(&k, 1) || !rap_sequence_bytes(p, "\x48\x89\xc7\x48\x0f\xba\xef\x3f", 8) ||
+	    !rap_kexec_label(&k, 2) || !rap_sequence_bytes(p, "\x48\x81\xcf\0\x08\0\0", 7) ||
+	    !rap_kexec_label(&k, 3) || !rap_sequence_bytes(p, "\x48\x81\xcf\0\x10\0\0\x0f\x22\xdf", 10) ||
+	    !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_user_cr3_stack(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (!rap_hw_alt_is(s, "X86_FEATURE_PTI"))
+		return true;
+	if (!rap_hw_skip(&k, "X86_FEATURE_PTI", 0) || !rap_sequence_bytes(p, "\x50", 1) ||
+	    !rap_hw_user_cr3(p) || !rap_sequence_bytes(p, "\x58", 1) ||
+	    !rap_kexec_label(&k, 0) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_stack_erase(struct rap_sequence *s, bool save)
+{
+	bool enabled = !!find_symbol_by_name(s->file->elf, "stackleak_erase");
+
+	if (!enabled)
+		return true;
+	return (!save || rap_entry_push_regs(s)) && rap_entry_call(s, "stackleak_erase") &&
+		(!save || rap_entry_pop_regs(s));
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-entry-return.h linux-7.0.12-hdn/tools/objtool/hdn-entry-return.h
--- linux-7.0.12/tools/objtool/hdn-entry-return.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-entry-return.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+static bool rap_hw_pop_except_rdi(struct rap_sequence *s)
+{
+	return rap_sequence_bytes(s, "\x41\x5f\x41\x5e\x41\x5d\x41\x5c\x5d\x5b\x41\x5b\x41\x5a"
+				    "\x41\x59\x41\x58\x58\x59\x5a\x5e", 22);
+}
+
+static bool rap_hw_espfix(struct rap_sequence *s)
+{
+	unsigned int i;
+	const unsigned int words[] = { 1, 2, 3, 5, 4 };
+
+	if (!rap_sequence_bytes(s, "\x57\x0f\x01\xf8", 4) || !rap_hw_switch_kernel_cr3(s, 7) ||
+	    !rap_thunk_percpu(s, "\x48\x8b\x3d", 3, "", 0, "espfix_waddr") ||
+	    !rap_sequence_bytes(s, "\x48\x89\x07", 3))
+		return false;
+	for (i = 0; i < ARRAY_SIZE(words); i++) {
+		unsigned char read[] = { 0x48, 0x8b, 0x44, 0x24, words[i] * 8 };
+		unsigned char write[] = { 0x48, 0x89, 0x47, words[i] * 8 };
+		if (!rap_sequence_bytes(s, (const char *)read, sizeof(read)) ||
+		    !rap_sequence_bytes(s, (const char *)write, sizeof(write)))
+			return false;
+	}
+	return rap_sequence_bytes(s, "\x25\0\0\xff\xff", 5) &&
+		rap_thunk_percpu(s, "\x48\x0b\x05", 3, "", 0, "espfix_stack") &&
+		rap_hw_user_cr3_stack(s) && rap_sequence_bytes(s, "\x0f\x01\xf8\x5f\x48\x89\xc4\x58", 8) &&
+		rap_hw_clear_buffers(s) && rap_sequence_edge_match(s, "native_irq_return_iret", false, false);
+}
+
+static int verify_rap_interrupt_return(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_kexec_sequence k = { .seq = { .file = file, .func = func } };
+	struct rap_sequence *s = &k.seq;
+	struct instruction *insn;
+	bool pti, espfix;
+
+	if (is_weak_sym(func) || !func->sec->noinstr || strcmp(func->name, "common_interrupt_return") ||
+	    !rap_thunk_symbol(file, "swapgs_restore_regs_and_return_to_usermode", func->sec, func->offset) ||
+	    !rap_hw_ibrs(s, false, false))
+		goto bad;
+	pti = rap_hw_alt_is(s, "X86_FEATURE_PTI");
+	if ((pti && !rap_hw_take_alt(&k, "X86_FEATURE_PTI", 1)) || !rap_hw_stack_erase(s, false) ||
+	    !rap_entry_pop_regs(s) || !rap_sequence_bytes(s, "\x48\x83\xc4\x08", 4) ||
+	    !rap_kexec_label(&k, 0) || !rap_sequence_bytes(s, "\x0f\x01\xf8", 3) ||
+	    !rap_hw_clear_buffers(s) || !rap_sequence_bytes(s, "\xf6\x44\x24\x08\x03", 5) ||
+	    !rap_kexec_branch(&k, 0x75, 3) || !rap_sequence_bytes(s, "\x0f\x0b", 2))
+		goto bad;
+	if (pti) {
+		if (!rap_kexec_label(&k, 1) || !rap_hw_pop_except_rdi(s) ||
+		    !rap_sequence_bytes(s, "\x48\x89\xe7", 3) ||
+		    !rap_thunk_percpu_offset(s, "\x48\x8b\x25", 3, "", 0, "cpu_tss_rw", 4) ||
+		    !rap_sequence_bytes(s, "\xff\x77\x30\xff\x77\x28\xff\x77\x20"
+					  "\xff\x77\x18\xff\x77\x10\xff\x37", 17) ||
+		    !rap_hw_stack_erase(s, true) || !rap_sequence_bytes(s, "\x50", 1) ||
+		    !rap_hw_user_cr3(s) || !rap_sequence_bytes(s, "\x58\x5f", 2) ||
+		    !rap_kexec_branch(&k, 0xeb, 0))
+			goto bad;
+	}
+	if (!rap_thunk_symbol(file, "restore_regs_and_return_to_kernel", func->sec, func->offset + s->pos))
+		goto bad;
+	if (rap_sequence_bytes(s, "\xf6\x84\x24\x88\0\0\0\x03", 8)) {
+		if (!rap_kexec_branch(&k, 0x74, 2) || !rap_sequence_bytes(s, "\x0f\x0b", 2) ||
+		    !rap_kexec_label(&k, 2))
+			goto bad;
+	}
+	if (!rap_entry_pop_regs(s) || !rap_sequence_bytes(s, "\x48\x83\xc4\x08", 4) ||
+	    !rap_kexec_label(&k, 3))
+		goto bad;
+	espfix = rap_sequence_bytes(s, "\xf6\x44\x24\x20\x04", 5);
+	if ((espfix && !rap_kexec_branch(&k, 0x75, 4)) ||
+	    !rap_thunk_symbol(file, "native_irq_return_iret", func->sec, func->offset + s->pos) ||
+	    !rap_sequence_bytes(s, "\x48\xcf", 2) ||
+	    (espfix && (!rap_kexec_label(&k, 4) || !rap_hw_espfix(s))) ||
+	    s->pos != func->len || !rap_hw_local_edges(&k))
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt)
+			goto bad;
+	func->rap_interrupt_return_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s->pos, "RAP interrupt return differs from its complete native exit protocol");
+	return -1;
+}
+
+static int verify_rap_syscall32_ignore(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+
+	if (is_weak_sym(func) || !func->sec->noinstr || strcmp(func->name, "entry_SYSCALL32_ignore") ||
+	    !rap_hw_endbr(&s) || !rap_sequence_bytes(&s, "\xb8\xda\xff\xff\xff", 5) ||
+	    !rap_hw_clear_buffers(&s) || !rap_sequence_bytes(&s, "\x0f\x07", 2) || s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt)
+			goto bad;
+	func->rap_interrupt_return_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP ignored compat syscall has an invalid fixed exit");
+	return -1;
+}
+
+static int validate_rap_interrupt_return_peers(struct objtool_file *file)
+{
+	struct symbol *func = find_symbol_by_name(file->elf, "common_interrupt_return");
+	struct symbol *ignore = find_symbol_by_name(file->elf, "entry_SYSCALL32_ignore");
+	struct symbol *kernel = find_symbol_by_name(file->elf, "restore_regs_and_return_to_kernel");
+	struct instruction *insn;
+
+	if ((!func || is_undef_sym(func)) && (!ignore || is_undef_sym(ignore)))
+		return 0;
+	if ((func && !is_undef_sym(func) && (func->rap_kind != 40 || !func->rap_interrupt_return_protocol)) ||
+	    (ignore && !is_undef_sym(ignore) && (ignore->rap_kind != 43 || !ignore->rap_interrupt_return_protocol)))
+		goto bad;
+	if (opts.link) {
+		struct symbol *erase = find_symbol_by_name(file->elf, "stackleak_erase");
+		struct symbol *verw = find_symbol_by_name(file->elf, "x86_verw_sel");
+		if ((erase && erase->rap_kind != 1) || !verw || !verw->sec->text || verw->len < 2 ||
+		    memcmp(verw->sec->data->d_buf + verw->offset, "\x18\0", 2))
+			goto bad;
+	}
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct section *sec;
+		unsigned long offset;
+
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset))
+			continue;
+		if (ignore && !is_undef_sym(ignore) && sec == ignore->sec &&
+		    offset >= ignore->offset && offset < ignore->offset + ignore->len)
+			goto bad;
+		if (!func || is_undef_sym(func) || sec != func->sec || offset < func->offset ||
+		    offset >= func->offset + func->len || owner == func)
+			continue;
+		if (!owner || (insn->type != INSN_JUMP_UNCONDITIONAL && insn->type != INSN_JUMP_CONDITIONAL))
+			goto bad;
+		if (offset == func->offset && (owner->rap_kind == 31 || owner->rap_kind == 36 ||
+		    owner->rap_kind == 41 || owner->rap_kind == 42 || owner->rap_kind == 45))
+			continue;
+		if (kernel && offset == kernel->offset &&
+		    (owner->rap_kind == 36 || owner->rap_kind == 39 || owner->rap_kind == 47))
+			continue;
+		goto bad;
+	}
+	return 0;
+bad:
+	ERROR("RAP interrupt exit has an unverified caller or an unauthorized interior entry");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-entry-roots.h linux-7.0.12-hdn/tools/objtool/hdn-entry-roots.h
--- linux-7.0.12/tools/objtool/hdn-entry-roots.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-entry-roots.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,206 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Pre-C IDT helpers have a hardware frame and a fresh assembly CALL slot.
+ * They are not general C functions. Only error_entry captures that slot,
+ * exactly at the boundary before its first protected C call. */
+static unsigned int rap_entry_root_kind(const char *name)
+{
+	if (!strcmp(name, "error_entry")) return 37;
+	if (!strcmp(name, "paranoid_entry")) return 38;
+	if (!strcmp(name, "paranoid_exit")) return 39;
+	return 0;
+}
+
+static bool rap_hw_capture(struct rap_sequence *s)
+{
+	struct instruction *call;
+
+	if (!rap_sequence_bytes(s, "\x4c\x8b\x14\x24\x4c\x8d\x1d\x05\0\0\0", 11))
+		return false;
+	call = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	return call && call->rap_root && call->rap_entry &&
+		rap_sequence_edge_match(s, "__hdn_rap_enter", true, false);
+}
+
+static bool rap_hw_user_entry(struct rap_sequence *s)
+{
+	return rap_sequence_bytes(s, "\x0f\x01\xf8", 3) &&
+		rap_hw_fixed_alt(s, "X86_FEATURE_FENCE_SWAPGS_USER", "\x0f\xae\xe8", 3) &&
+		rap_hw_kernel_cr3(s, false) && rap_hw_ibrs(s, true, false) &&
+		rap_hw_untrain(s, true) && rap_hw_capture(s) &&
+		rap_sequence_bytes(s, "\x48\x8d\x7c\x24\x08", 5);
+}
+
+static bool rap_hw_error_entry(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+	struct instruction *insn;
+
+	if (!rap_hw_save_regs(p))
+		return false;
+	rap_sequence_bytes(p, "\x48\x8d\x6c\x24\x09", 5);
+	if (!rap_sequence_bytes(p, "\xf6\x84\x24\x90\0\0\0\x03", 8) ||
+	    !rap_kexec_branch(&k, 0x74, 0) || !rap_hw_user_entry(p) ||
+	    !rap_entry_call(p, "sync_regs") || !rap_sequence_edge_match(p, "__hdn_rap_return", false, false) ||
+	    !rap_kexec_label(&k, 0) ||
+	    !rap_sequence_reference(p, "\x48\x8d\x0d", 3, "native_irq_return_iret", true) ||
+	    !rap_sequence_bytes(p, "\x48\x39\x8c\x24\x88\0\0\0", 8) ||
+	    !rap_kexec_branch(&k, 0x74, 2) || !rap_sequence_bytes(p, "\x89\xc8", 2) ||
+	    !rap_sequence_bytes(p, "\x48\x39\x84\x24\x88\0\0\0", 8) ||
+	    !rap_kexec_branch(&k, 0x74, 1) ||
+	    !rap_sequence_reference(p, "\x48\x81\xbc\x24\x88\0\0\0", 8, "__hdn_rap_gs_change", false) ||
+	    !rap_kexec_branch(&k, 0x75, 3) || !rap_sequence_bytes(p, "\x0f\x01\xf8", 3) ||
+	    !rap_kexec_label(&k, 3) ||
+	    !rap_hw_fixed_alt(p, "X86_FEATURE_FENCE_SWAPGS_KERNEL", "\x0f\xae\xe8", 3) ||
+	    !rap_hw_depth(p) || !rap_sequence_bytes(p, "\x48\x8d\x44\x24\x08", 5))
+		return false;
+	insn = find_insn(p->file, p->func->sec, p->func->offset + p->pos);
+	if (insn && !insn->alts)
+		rap_sequence_bytes(p, "\x90", 1);
+	if (!rap_thunk_ret(p) || !rap_kexec_label(&k, 1) ||
+	    !rap_sequence_bytes(p, "\x48\x89\x8c\x24\x88\0\0\0", 8) ||
+	    !rap_kexec_label(&k, 2) || !rap_hw_user_entry(p) ||
+	    !rap_entry_call(p, "fixup_bad_iret") || !rap_sequence_bytes(p, "\x48\x89\xc7", 3) ||
+	    !rap_entry_call(p, "sync_regs") || !rap_sequence_edge_match(p, "__hdn_rap_return", false, false) ||
+	    !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_paranoid_entry(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (!rap_hw_save_regs(p))
+		return false;
+	rap_sequence_bytes(p, "\x48\x8d\x6c\x24\x09", 5);
+	if (!rap_hw_kernel_cr3(p, true) || !rap_hw_skip(&k, "X86_FEATURE_FSGSBASE", 0) ||
+	    !rap_sequence_bytes(p, "\xf3\x48\x0f\xae\xcb", 5))
+		return false;
+	if (rap_sequence_bytes(p, "\x48\xc7\xc0\x7b\0\0\0", 7)) {
+		if (!rap_sequence_bytes(p, "\x48\x0f\x03\xc0\x48\x25\xff\x0f\0\0", 10) ||
+		    !rap_sequence_reference(p, "\x48\x8b\x04\xc5", 4, "__per_cpu_offset", false))
+			return false;
+	} else if (!rap_sequence_reference(p, "\x48\x8b\x05", 3, "pcpu_unit_offsets", true)) {
+		return false;
+	}
+	if (!rap_sequence_bytes(p, "\xf3\x48\x0f\xae\xd8", 5) ||
+	    !rap_kexec_branch(&k, 0xeb, 1) || !rap_kexec_label(&k, 0) ||
+	    !rap_sequence_bytes(p, "\xbb\x01\0\0\0\xb9\x01\x01\0\xc0\x0f\x32\x85\xd2", 14) ||
+	    !rap_kexec_branch(&k, 0x78, 2) || !rap_sequence_bytes(p, "\x31\xdb\x0f\x01\xf8", 5) ||
+	    !rap_kexec_label(&k, 2) ||
+	    !rap_hw_fixed_alt(p, "X86_FEATURE_FENCE_SWAPGS_KERNEL", "\x0f\xae\xe8", 3) ||
+	    !rap_kexec_label(&k, 1) || !rap_hw_ibrs(p, true, true) ||
+	    !rap_hw_untrain(p, true) || !rap_thunk_ret(p) || !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static bool rap_hw_paranoid_exit(struct rap_sequence *s)
+{
+	struct rap_kexec_sequence k = { .seq = *s };
+	struct rap_sequence *p = &k.seq;
+
+	if (!rap_idt_frame_exit(p, 1) || !rap_hw_ibrs(p, false, true) ||
+	    !rap_hw_restore_cr3(p, false) || !rap_hw_skip(&k, "X86_FEATURE_FSGSBASE", 0) ||
+	    !rap_sequence_bytes(p, "\xf3\x48\x0f\xae\xdb", 5) ||
+	    !rap_sequence_edge_match(p, "restore_regs_and_return_to_kernel", false, false) ||
+	    !rap_kexec_label(&k, 0) || !rap_sequence_bytes(p, "\x85\xdb", 2) ||
+	    !rap_hw_branch(p, "restore_regs_and_return_to_kernel", 0x75) ||
+	    !rap_sequence_bytes(p, "\x0f\x01\xf8", 3) ||
+	    !rap_sequence_edge_match(p, "restore_regs_and_return_to_kernel", false, false) ||
+	    !rap_hw_local_edges(&k))
+		return false;
+	*s = *p;
+	return true;
+}
+
+static int verify_rap_entry_root(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+
+	if (is_weak_sym(func) || !func->sec->noinstr || func->rap_kind != rap_entry_root_kind(func->name))
+		goto bad;
+	if (func->rap_kind == 37 ? !rap_hw_error_entry(&s) :
+	    func->rap_kind == 38 ? !rap_hw_paranoid_entry(&s) : !rap_hw_paranoid_exit(&s))
+		goto bad;
+	if (s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_hw_alt && !insn->rap_thunk_alt)
+			goto bad;
+	func->rap_entry_root_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP pre-C entry/exit helper differs from its closed frame protocol");
+	return -1;
+}
+
+static int validate_rap_entry_root_peers(struct objtool_file *file)
+{
+	struct instruction *insn;
+	struct symbol *func;
+	bool present = false;
+
+	for_each_sym(file->elf, func) {
+		if (!rap_entry_root_kind(func->name) || is_undef_sym(func))
+			continue;
+		present = true;
+		if (func->rap_kind != rap_entry_root_kind(func->name) || !func->rap_entry_root_protocol)
+			goto bad;
+	}
+	if (opts.link && present) {
+		static const struct { const char *name; unsigned int kind; } peers[] = {
+			{ "sync_regs", 1 }, { "fixup_bad_iret", 1 },
+			{ "__hdn_rap_enter", 4 }, { "__hdn_rap_return", 4 },
+			{ "hdn_rap_frame_exit", 2 }, { "asm_load_gs_index", 1 },
+		};
+		struct symbol *change = find_symbol_by_name(file->elf, "__hdn_rap_gs_change");
+		struct symbol *load = find_symbol_by_name(file->elf, "asm_load_gs_index");
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(peers); i++) {
+			struct symbol *peer = find_symbol_by_name(file->elf, peers[i].name);
+			if (!peer || peer->rap_kind != peers[i].kind)
+				goto bad;
+		}
+		if (!change || !load || change->sec != load->sec || change->offset < load->offset ||
+		    change->offset - load->offset + 2 > load->len ||
+		    memcmp(change->sec->data->d_buf + change->offset, "\x8e\xef", 2))
+			goto bad;
+	}
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct instruction *dest;
+		struct section *sec;
+		unsigned long offset;
+
+		if (!rap_thunk_edge_target(file, insn, &sec, &offset))
+			continue;
+		dest = find_insn(file, sec, offset);
+		func = dest ? rap_insn_owner(dest) : NULL;
+		if (!func || !func->rap_entry_root_protocol || owner == func)
+			continue;
+		if (offset != func->offset || !owner)
+			goto bad;
+		if (func->rap_kind == 37 && insn->type == INSN_CALL && owner->rap_idt_protocol &&
+		    (owner->rap_kind == 33 || owner->rap_kind == 34))
+			continue;
+		if (func->rap_kind == 38 && insn->type == INSN_CALL &&
+		    ((owner->rap_kind == 34 && owner->rap_idt_protocol) ||
+		     (!strcmp(owner->name, "asm_exc_nmi") && owner->rap_kind == 41)))
+			continue;
+		if (func->rap_kind == 39 && insn->type == INSN_JUMP_UNCONDITIONAL &&
+		    owner->rap_kind == 34 && owner->rap_idt_protocol)
+			continue;
+		goto bad;
+	}
+	return 0;
+bad:
+	ERROR("RAP pre-C entry helper has an unverified caller or an interior entry");
+	return -1;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/objtool/hdn-entry.h linux-7.0.12-hdn/tools/objtool/hdn-entry.h
--- linux-7.0.12/tools/objtool/hdn-entry.h	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/objtool/hdn-entry.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,457 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Hardware roots have no ordinary incoming C return slot. Describe their
+ * whole instruction protocol instead of treating that fact as an exemption. */
+static bool rap_fred_name(const char *name)
+{
+	return !strcmp(name, "asm_fred_entrypoint_user") ||
+		!strcmp(name, "asm_fred_entrypoint_kernel");
+}
+
+static struct symbol *rap_entry_owner(struct instruction *insn)
+{
+	if (insn->alt_group && insn->alt_group->orig_group)
+		insn = insn->alt_group->orig_group->first_insn;
+	return rap_insn_owner(insn);
+}
+
+static bool rap_entry_push_regs(struct rap_sequence *s)
+{
+	return rap_sequence_bytes(s,
+		"\x57\x56\x52\x51\x50\x41\x50\x41\x51\x41\x52\x41\x53"
+		"\x53\x55\x41\x54\x41\x55\x41\x56\x41\x57", 23) &&
+		rap_sequence_bytes(s,
+		"\x31\xf6\x31\xd2\x31\xc9\x45\x31\xc0\x45\x31\xc9\x45\x31\xd2"
+		"\x45\x31\xdb\x31\xdb\x31\xed\x45\x31\xe4\x45\x31\xed"
+		"\x45\x31\xf6\x45\x31\xff", 34);
+}
+
+static bool rap_entry_pop_regs(struct rap_sequence *s)
+{
+	return rap_sequence_bytes(s,
+		"\x41\x5f\x41\x5e\x41\x5d\x41\x5c\x5d\x5b\x41\x5b\x41\x5a"
+		"\x41\x59\x41\x58\x58\x59\x5a\x5e\x5f", 23);
+}
+
+static bool rap_entry_call(struct rap_sequence *s, const char *name)
+{
+	return rap_sequence_bytes(s, "\x4c\x8d\x15\x05\0\0\0", 7) &&
+		rap_sequence_edge(s, name, true);
+}
+
+static int verify_rap_fred(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+	struct symbol *user = find_symbol_by_name(file->elf, "asm_fred_entrypoint_user");
+	struct symbol *kernel = find_symbol_by_name(file->elf, "asm_fred_entrypoint_kernel");
+	struct symbol *exit = find_symbol_by_name(file->elf, "asm_fred_exit_user");
+	unsigned long exit_offset;
+	bool from_user = !strcmp(func->name, "asm_fred_entrypoint_user");
+	bool private_stack = false;
+
+	if (!rap_fred_name(func->name) || is_weak_sym(func) || !func->sec->noinstr ||
+	    !user || !kernel || user->sec != kernel->sec || (user->offset & 4095) ||
+	    kernel->offset != user->offset + 256 || user->len > 256 ||
+	    !rap_entry_push_regs(&s) || !rap_sequence_bytes(&s, "\x48\x89\xe7", 3))
+		goto bad;
+	if (from_user) {
+		if (!rap_entry_call(&s, "fred_entry_from_user"))
+			goto bad;
+	} else {
+		if (!rap_sequence_bytes(&s, "\x48\x89\xe7\xbe\x03\0\0\0\x41\xb9\0\x01\0\0"
+					"\x31\xd2\x31\xc9\x45\x31\xc0", 21) ||
+		    !rap_entry_call(&s, "hdn_rap_frame_enter") ||
+		    !rap_sequence_bytes(&s, "\x48\x89\xe7", 3) ||
+		    !rap_entry_call(&s, "fred_entry_from_kernel") ||
+		    !rap_sequence_bytes(&s, "\x48\x89\xe7\xbe\x03\0\0\0", 8) ||
+		    !rap_entry_call(&s, "hdn_rap_frame_exit"))
+			goto bad;
+		/* PRIVATE_STACKS consumes only the authenticated saved CR3. */
+		private_stack = s.pos < func->len &&
+			*(unsigned char *)(func->sec->data->d_buf + func->offset + s.pos) == 0x48;
+		if (private_stack && !rap_sequence_bytes(&s, "\x48\x8b\x10\x0f\x22\xda", 6))
+			goto bad;
+		if (opts.link && !!find_symbol_by_name(file->elf, "hdn_stack_mm_ready") != private_stack)
+			goto bad;
+	}
+	exit_offset = func->offset + s.pos;
+	if (from_user && (!exit || exit->sec != func->sec || exit->offset != exit_offset))
+		goto bad;
+	if (!rap_entry_pop_regs(&s) ||
+	    !rap_sequence_bytes(&s, from_user ? "\xf3\x0f\x01\xca" : "\xf2\x0f\x01\xca", 4) ||
+	    s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts)
+			goto bad;
+	/* Only the fork return adapter may join the already-prepared user exit.
+	 * There are no direct callers of either hardware entry point. */
+	for_each_insn(file, insn) {
+		struct symbol *owner = rap_entry_owner(insn);
+		struct instruction *dest = insn->jump_dest;
+		struct symbol *callee = insn->type == INSN_CALL ? insn_call_dest(insn) : NULL;
+
+		if (callee == func)
+			goto bad;
+		if (!dest || dest->sec != func->sec || dest->offset < func->offset ||
+		    dest->offset >= func->offset + func->len || owner == func)
+			continue;
+		if (!from_user || dest->offset != exit_offset ||
+		    insn->type != INSN_JUMP_UNCONDITIONAL || !owner ||
+		    strcmp(owner->name, "ret_from_fork_asm") || owner->rap_kind != 31)
+			goto bad;
+	}
+	func->rap_fred_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP FRED root does not match its complete frame protocol");
+	return -1;
+}
+
+/* CPU build requirements vary with the selected x86 baseline. Their values
+ * cannot authorize memory access or a control transfer. Require the paired
+ * AND/XOR masks to agree, and derive the SSE subset from that same mask. */
+static bool rap_cpu_mask(struct rap_sequence *s, unsigned char modrm, uint32_t *value)
+{
+	unsigned long offset = s->func->offset + s->pos;
+	struct instruction *insn = find_insn(s->file, s->func->sec, offset);
+	const unsigned char *p = s->func->sec->data->d_buf + offset;
+
+	if (!insn || s->pos >= s->func->len || insn->len > s->func->len - s->pos ||
+	    !((insn->len == 6 && p[0] == 0x81) || (insn->len == 3 && p[0] == 0x83)) ||
+	    p[1] != modrm || find_reloc_by_dest_range(s->file->elf, s->func->sec, offset, insn->len))
+		return false;
+	if (insn->len == 6)
+		memcpy(value, p + 2, sizeof(*value));
+	else
+		*value = (int8_t)p[2];
+	s->pos += insn->len;
+	return true;
+}
+
+static int verify_rap_cpu(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_kexec_sequence k = { .seq = { .file = file, .func = func } };
+	struct rap_sequence *s = &k.seq;
+	struct instruction *insn;
+	uint32_t mask0, mask1, mask, sse;
+	unsigned int i;
+
+#define CPU_BYTES(bytes) do { if (!rap_sequence_bytes(s, bytes, sizeof(bytes) - 1)) goto bad; } while (0)
+#define CPU_BRANCH(op, n) do { if (!rap_kexec_branch(&k, op, n)) goto bad; } while (0)
+#define CPU_LABEL(n) do { if (!rap_kexec_label(&k, n)) goto bad; } while (0)
+	if (strcmp(func->name, "verify_cpu") || is_weak_sym(func))
+		goto bad;
+	CPU_BYTES("\x9c\x6a\0\x9d\xb8\0\0\0\0\x0f\xa2\x83\xf8\x01");
+	CPU_BRANCH(0x72, 5);
+	CPU_BYTES("\x66\x31\xff\x81\xfb\x41\x75\x74\x68");
+	CPU_BRANCH(0x75, 0);
+	CPU_BYTES("\x81\xfa\x65\x6e\x74\x69");
+	CPU_BRANCH(0x75, 0);
+	CPU_BYTES("\x81\xf9\x63\x41\x4d\x44");
+	CPU_BRANCH(0x75, 0);
+	CPU_BYTES("\x66\xbf\x01\0");
+	CPU_BRANCH(0xeb, 2);
+	CPU_LABEL(0);
+	CPU_BYTES("\x81\xfb\x47\x65\x6e\x75");
+	CPU_BRANCH(0x75, 2);
+	CPU_BYTES("\x81\xfa\x69\x6e\x65\x49");
+	CPU_BRANCH(0x75, 2);
+	CPU_BYTES("\x81\xf9\x6e\x74\x65\x6c");
+	CPU_BRANCH(0x75, 2);
+	CPU_BYTES("\xb8\x01\0\0\0\x0f\xa2\x89\xc1\x25\0\x0f\xf0\x0f\xc1\xe8\x08\x83\xf8\x06");
+	CPU_BRANCH(0x77, 1);
+	CPU_BRANCH(0x72, 2);
+	CPU_BYTES("\x81\xe1\xf0\0\x0f\0\xc1\xe9\x04\x83\xf9\x0d");
+	CPU_BRANCH(0x72, 2);
+	CPU_LABEL(1);
+	CPU_BYTES("\xb9\xa0\x01\0\0\x0f\x32\x0f\xba\xf2\x02");
+	CPU_BRANCH(0x73, 2);
+	CPU_BYTES("\x0f\x30");
+	CPU_LABEL(2);
+	CPU_BYTES("\xb8\x01\0\0\0\x0f\xa2");
+	if (!rap_cpu_mask(s, 0xe2, &mask0) || !rap_cpu_mask(s, 0xf2, &mask) || mask != mask0)
+		goto bad;
+	CPU_BRANCH(0x75, 5);
+	CPU_BYTES("\xb8\0\0\0\x80\x0f\xa2\x3d\x01\0\0\x80");
+	CPU_BRANCH(0x72, 5);
+	CPU_BYTES("\xb8\x01\0\0\x80\x0f\xa2");
+	if (!rap_cpu_mask(s, 0xe2, &mask1) || !rap_cpu_mask(s, 0xf2, &mask) || mask != mask1)
+		goto bad;
+	CPU_BRANCH(0x75, 5);
+	CPU_LABEL(3);
+	CPU_BYTES("\xb8\x01\0\0\0\x0f\xa2");
+	if (!rap_cpu_mask(s, 0xe2, &sse) || !rap_cpu_mask(s, 0xfa, &mask) ||
+	    mask != sse || sse != (mask0 & 0x06000000U))
+		goto bad;
+	CPU_BRANCH(0x74, 6);
+	CPU_BYTES("\x66\x85\xff");
+	CPU_BRANCH(0x74, 5);
+	CPU_BYTES("\xb9\x15\0\x01\xc0\x0f\x32\x0f\xba\xf0\x0f\x0f\x30\x66\x31\xff");
+	CPU_BRANCH(0xeb, 3);
+	CPU_LABEL(5);
+	CPU_BYTES("\x9d\xb8\x01\0\0\0");
+	if (!rap_thunk_ret(s))
+		goto bad;
+	CPU_LABEL(6);
+	CPU_BYTES("\x9d\x31\xc0");
+	if (!rap_thunk_ret(s) || s->pos != func->len)
+		goto bad;
+	for (i = 0; i < k.count; i++)
+		if (!k.defined[k.branches[i].label] ||
+		    arch_jump_destination(k.branches[i].insn) != k.labels[k.branches[i].label])
+			goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts)
+			goto bad;
+	for_each_insn(file, insn) {
+		struct instruction *dest = insn->jump_dest;
+		struct symbol *owner = rap_entry_owner(insn);
+		struct symbol *callee = insn->type == INSN_CALL ? insn_call_dest(insn) : NULL;
+
+		if (owner == func)
+			continue;
+		if (callee == func) {
+			if (!owner || (strcmp(owner->name, "startup_64") &&
+				       strcmp(owner->name, "secondary_startup_64")))
+				goto bad;
+		} else if (dest && dest->sec == func->sec && dest->offset >= func->offset &&
+			   dest->offset < func->offset + func->len) {
+			goto bad;
+		}
+	}
+	func->rap_cpu_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s->pos, "RAP CPU bootstrap leaf does not match its closed protocol");
+	return -1;
+#undef CPU_LABEL
+#undef CPU_BRANCH
+#undef CPU_BYTES
+}
+
+static bool rap_fork_exit(struct rap_sequence *s)
+{
+	struct instruction *first = find_insn(s->file, s->func->sec, s->func->offset + s->pos);
+	struct alt_group *orig = first ? first->alt_group : NULL;
+	struct alternative *alt;
+	struct symbol span;
+	struct rap_sequence replacement;
+	unsigned long end;
+	const char *feature;
+
+	if (!orig)
+		return rap_sequence_edge_match(s, "swapgs_restore_regs_and_return_to_usermode", false, false);
+	if (orig->orig_group || orig->first_insn != first || !orig->last_insn ||
+	    !(alt = first->alts) || alt->next || alt->type != ALT_TYPE_INSTRUCTIONS ||
+	    !alt->insn->alt_group || alt->insn->alt_group->orig_group != orig ||
+	    alt->insn->alt_group->first_insn != alt->insn || !alt->insn->alt_group->last_insn ||
+	    !(feature = arch_cpu_feature_name(alt->insn->alt_group->feature)) ||
+	    strcmp(feature, "X86_FEATURE_FRED"))
+		return false;
+	span = *s->func;
+	span.sec = alt->insn->sec;
+	span.offset = alt->insn->offset;
+	span.len = alt->insn->alt_group->last_insn->offset +
+		alt->insn->alt_group->last_insn->len - span.offset;
+	replacement = (struct rap_sequence){ .file = s->file, .func = &span };
+	if (!rap_sequence_edge_match(&replacement, "asm_fred_exit_user", false, false) ||
+	    replacement.pos != span.len)
+		return false;
+	end = orig->last_insn->offset + orig->last_insn->len - s->func->offset;
+	if (!rap_sequence_edge_match(s, "swapgs_restore_regs_and_return_to_usermode", false, false) ||
+	    !rap_thunk_padding(s, end, false))
+		return false;
+	rap_thunk_mark(s->file, &span);
+	first->rap_thunk_alt = true;
+	return true;
+}
+
+static int verify_rap_switch(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn;
+	bool fork = func->rap_kind == 31;
+	bool private_stack = false, canary = false;
+
+#define SWITCH_BYTES(bytes) do { if (!rap_sequence_bytes(&s, bytes, sizeof(bytes) - 1)) goto bad; } while (0)
+#define SWITCH_CALL(name) do { if (!rap_entry_call(&s, name)) goto bad; } while (0)
+	if (is_weak_sym(func) || strcmp(func->name, fork ? "ret_from_fork_asm" : "__switch_to_asm"))
+		goto bad;
+	if (fork) {
+		insn = find_insn(file, func->sec, func->offset);
+		if (insn && insn->alts && !rap_thunk_alternative(&s, RAP_ALT_DEPTH, 0))
+			goto bad;
+		SWITCH_BYTES("\x48\x89\xc7\x48\x89\xe6\x48\x89\xda\x4c\x89\xe1");
+		SWITCH_CALL("ret_from_fork");
+		if (!rap_fork_exit(&s))
+			goto bad;
+	} else {
+		SWITCH_BYTES("\x55\x53\x41\x54\x41\x55\x41\x56\x41\x57"
+			     "\x49\x89\xfc\x49\x89\xf5\x48\x89\xe2\x4c\x89\xd1\x48\x83\xec\x08");
+		SWITCH_CALL("hdn_rap_switch");
+		SWITCH_BYTES("\x48\x83\xc4\x08\x4c\x89\xe7\x4c\x89\xee");
+		insn = find_insn(file, func->sec, func->offset + s.pos);
+		if (insn && insn->len == 3 && !memcmp(func->sec->data->d_buf + insn->offset,
+						    "\x48\x8b\x20", 3)) {
+			SWITCH_BYTES("\x48\x8b\x20");
+		} else {
+			private_stack = true;
+			SWITCH_BYTES("\x4c\x8b\x58\x40\x48\x8b\x10");
+			if (!rap_thunk_symbol(file, "__hdn_stack_switch_cr3", func->sec, func->offset + s.pos))
+				goto bad;
+			SWITCH_BYTES("\x41\x0f\x22\xdb\x48\x89\xd4");
+			if (!rap_thunk_symbol(file, "__hdn_stack_switch_rsp", func->sec, func->offset + s.pos))
+				goto bad;
+			SWITCH_BYTES("\x49\x89\xc4\x49\x89\xfd\x49\x89\xf6\x48\x83\xec\x08");
+			SWITCH_CALL("hdn_stack_mm_finish");
+			SWITCH_BYTES("\x48\x83\xc4\x08\x4c\x89\xe0\x4c\x89\xef\x4c\x89\xf6");
+		}
+		insn = find_insn(file, func->sec, func->offset + s.pos);
+		if (insn && insn->len == 4 && !memcmp(func->sec->data->d_buf + insn->offset,
+						    "\x48\x8b\x58\x48", 4)) {
+			canary = true;
+			SWITCH_BYTES("\x48\x8b\x58\x48");
+			if (!rap_thunk_percpu(&s, "\x48\x89\x1d", 3, "", 0, "__stack_chk_guard"))
+				goto bad;
+		}
+		if (opts.link &&
+		    (!!find_symbol_by_name(file->elf, "hdn_stack_mm_ready") != private_stack ||
+		     !!find_symbol_by_name(file->elf, "__stack_chk_guard") != canary))
+			goto bad;
+		if (!rap_thunk_alternative(&s, RAP_ALT_SWITCH_RSB, 12))
+			goto bad;
+		SWITCH_BYTES("\x4c\x8b\x78\x08\x4c\x8b\x70\x10\x4c\x8b\x68\x18"
+			     "\x4c\x8b\x60\x20\x48\x8b\x58\x28\x48\x8b\x68\x30"
+			     "\x4c\x8b\x50\x38\x48\x83\xc4\x30");
+		if (!rap_sequence_edge_match(&s, "__switch_to", false, false))
+			goto bad;
+	}
+	if (s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts && !insn->rap_thunk_alt)
+			goto bad;
+	for_each_insn(file, insn) {
+		struct instruction *dest = insn->jump_dest;
+		struct symbol *callee = insn->type == INSN_CALL ? insn_call_dest(insn) : NULL;
+
+		if (rap_entry_owner(insn) == func)
+			continue;
+		if ((callee == func && (fork || !insn->rap_site)) ||
+		    (dest && dest->sec == func->sec && dest->offset >= func->offset &&
+		     dest->offset < func->offset + func->len))
+			goto bad;
+	}
+	func->rap_switch_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP task switch/fork lacks its checked snapshot protocol");
+	return -1;
+#undef SWITCH_CALL
+#undef SWITCH_BYTES
+}
+
+static int verify_rap_s3(struct objtool_file *file, struct symbol *func)
+{
+	struct rap_sequence s = { .file = file, .func = func };
+	struct instruction *insn, *first = find_insn(file, func->sec, func->offset);
+	struct symbol *resume = find_symbol_by_name(file->elf, "__hdn_s3_resume");
+	struct symbol *suspend = find_symbol_by_name(file->elf, "do_suspend_lowlevel");
+	struct symbol *wakeup = find_symbol_by_name(file->elf, "wakeup_long64");
+	bool frame = false;
+
+#define S3_BYTES(bytes) do { if (!rap_sequence_bytes(&s, bytes, sizeof(bytes) - 1)) goto bad; } while (0)
+#define S3_CALL(name) do { if (!rap_entry_call(&s, name)) goto bad; } while (0)
+#define S3_REF(bytes, name) do { if (!rap_sequence_reference(&s, bytes, sizeof(bytes) - 1, name, false)) goto bad; } while (0)
+	if (is_weak_sym(func) || !resume || !suspend || !wakeup ||
+	    suspend->rap_kind != 1 || wakeup->rap_kind != 32 ||
+	    resume->sec != suspend->sec || resume->offset <= suspend->offset ||
+	    resume->offset >= suspend->offset + suspend->len)
+		goto bad;
+	if (func == wakeup) {
+		if (!rap_sequence_edge_match(&s, "__hdn_s3_resume", false, false))
+			goto bad;
+	} else if (func == suspend) {
+		if (first && first->type == INSN_ENDBR)
+			S3_BYTES("\xf3\x0f\x1e\xfa");
+		S3_BYTES("\x4c\x8d\x1d\x05\0\0\0");
+		if (!rap_sequence_edge_match(&s, "__hdn_rap_enter", true, false))
+			goto bad;
+		if (s.pos < func->len &&
+		    *(unsigned char *)(func->sec->data->d_buf + func->offset + s.pos) == 0x55) {
+			S3_BYTES("\x55\x48\x89\xe5");
+			frame = true;
+		}
+		S3_BYTES("\x48\x83\xec\x08\x31\xc0");
+		S3_CALL("save_processor_state");
+		S3_REF("\x48\xc7\xc0", "saved_context");
+		S3_BYTES("\x48\x89\xa0\x98\0\0\0\x48\x89\x68\x20\x48\x89\x70\x68"
+			 "\x48\x89\x78\x70\x48\x89\x58\x28\x48\x89\x48\x58\x48\x89\x50\x60"
+			 "\x4c\x89\x40\x48\x4c\x89\x48\x40\x4c\x89\x50\x38\x4c\x89\x58\x30"
+			 "\x4c\x89\x60\x18\x4c\x89\x68\x10\x4c\x89\x70\x08\x4c\x89\x38"
+			 "\x9c\x8f\x80\x90\0\0\0\x48\x89\xe6\xbf\x01\0\0\0");
+		S3_CALL("hdn_rap_resume_save");
+		S3_BYTES("\x48\x83\xc4\x08\xbf\x03\0\0\0\x31\xc0");
+		S3_CALL("x86_acpi_enter_sleep_state");
+		if (!rap_sequence_edge_match(&s, "__hdn_s3_resume", false, false) ||
+		    (resume->offset & 3) || !rap_thunk_padding(&s, resume->offset - func->offset, false))
+			goto bad;
+		S3_REF("\x48\xc7\xc0", "hdn_rap_resume_state");
+		S3_BYTES("\x0f\x01\x90\x0a\x01\0\0\x0f\x01\x98\x16\x01\0\0\xbf\x01\0\0\0");
+		S3_CALL("hdn_rap_resume_restore");
+		S3_BYTES("\x48\x8b\x98\xe0\0\0\0\x0f\x22\xe3"
+			 "\x48\x8b\x98\xd8\0\0\0\x0f\x22\xdb"
+			 "\x48\x8b\x98\xd0\0\0\0\x0f\x22\xd3"
+			 "\x48\x8b\x98\xc8\0\0\0\x0f\x22\xc3"
+			 "\xff\xb0\x90\0\0\0\x9d\x48\x8b\xa0\x98\0\0\0"
+			 "\x48\x8b\x68\x20\x48\x8b\x70\x68\x48\x8b\x78\x70"
+			 "\x48\x8b\x58\x28\x48\x8b\x48\x58\x48\x8b\x50\x60"
+			 "\x4c\x8b\x40\x48\x4c\x8b\x48\x40\x4c\x8b\x50\x38\x4c\x8b\x58\x30"
+			 "\x4c\x8b\x60\x18\x4c\x8b\x68\x10\x4c\x8b\x70\x08\x4c\x8b\x38");
+		if (s.pos < func->len &&
+		    *(unsigned char *)(func->sec->data->d_buf + func->offset + s.pos) == 0x48) {
+			S3_BYTES("\x48\x89\xe7");
+			S3_CALL("kasan_unpoison_task_stack_below");
+		}
+		S3_BYTES("\x31\xc0\x48\x83\xc4\x08");
+		if (frame)
+			S3_BYTES("\x5d");
+		S3_CALL("restore_processor_state");
+		if (!rap_sequence_edge_match(&s, "__hdn_rap_return", false, false))
+			goto bad;
+	} else {
+		goto bad;
+	}
+	if (s.pos != func->len)
+		goto bad;
+	rap_for_each_insn(file, func, insn)
+		if (insn->alts)
+			goto bad;
+	for_each_insn(file, insn) {
+		struct instruction *dest = insn->jump_dest;
+		struct symbol *owner = rap_entry_owner(insn);
+		struct symbol *callee = insn->type == INSN_CALL ? insn_call_dest(insn) : NULL;
+
+		if (func == wakeup && callee == func)
+			goto bad;
+		if (!dest || dest->sec != func->sec || dest->offset < func->offset ||
+		    dest->offset >= func->offset + func->len || owner == func)
+			continue;
+		if (func == suspend) {
+			if (owner != wakeup || dest->offset != resume->offset)
+				goto bad;
+		} else if (!owner || strcmp(owner->name, "common_startup_64") || owner->rap_kind != 50 ||
+			   dest->offset != func->offset) {
+			goto bad;
+		}
+	}
+	func->rap_s3_protocol = true;
+	return 0;
+bad:
+	ERROR_FUNC(func->sec, func->offset + s.pos, "RAP S3 transition does not match its fixed checkpoint protocol");
+	return -1;
+#undef S3_REF
+#undef S3_CALL
+#undef S3_BYTES
+}
