+
+struct cred;
+struct file;
+enum hdn_jitter_class {
+	HDN_JITTER_NONE,
+	HDN_JITTER_CRED,
+	HDN_JITTER_FILE,
+	HDN_JITTER_BACKING_FILE,
+#ifdef CONFIG_SECURITY_HARDENING_SLAB_JITTER_TEST
+	HDN_JITTER_TEST,
+#endif
