+++ linux-7.0.12-hdn/tools/hardening/hdn-audit.service	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,43 @@
+[Unit]
+Description=Persist decoded HDN security events to the journal
+Documentation=man:journalctl(1)
+After=hdn-policy-load.service systemd-journald.service
+Requires=hdn-policy-load.service
+ConditionPathExists=/sys/kernel/security/hardening/events
+
+[Service]
+Type=simple
+ExecStart=/usr/libexec/hdn-event-decode --follow
+Restart=on-failure
+RestartSec=1s
+StandardOutput=journal
+StandardError=journal
+SyslogIdentifier=hdn-audit
+UMask=0077
+NoNewPrivileges=yes
+ProtectSystem=strict
+ProtectHome=yes
+PrivateTmp=yes
+PrivateDevices=yes
+PrivateNetwork=yes
+ProtectProc=invisible
+ProcSubset=pid
+ProtectKernelTunables=yes
+ProtectKernelModules=yes
+ProtectKernelLogs=yes
+ProtectControlGroups=yes
+ProtectClock=yes
+ProtectHostname=yes
+RestrictAddressFamilies=AF_UNIX
+CapabilityBoundingSet=
+RestrictSUIDSGID=yes
+RestrictNamespaces=yes
+RestrictRealtime=yes
+LockPersonality=yes
+MemoryDenyWriteExecute=yes
+SystemCallArchitectures=native
+SystemCallFilter=@system-service
+SystemCallErrorNumber=EPERM
+
+[Install]
+WantedBy=multi-user.target
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-auth-prompt.c linux-7.0.12-hdn/tools/hardening/hdn-auth-prompt.c
--- linux-7.0.12/tools/hardening/hdn-auth-prompt.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-auth-prompt.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#define HDN_AUTH_PROMPT_MAX_METADATA 8192
+#define HDN_AUTH_PROMPT_MAX_TEXT 512
+
+struct hdn_prompt_metadata {
+	char *action;
+	char *title;
+	char *message;
+	char *consequence;
+	char *risk;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--test-approve|--test-deny] ACTION\n"
+		"\n"
+		"Reads HDN prompt metadata on stdin, shows a desktop approval prompt,\n"
+		"and exits 0 only when the user approves.\n",
+		prog);
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool safe_text(const char *text)
+{
+	const unsigned char *p;
+	size_t len;
+
+	if (!text || !text[0])
+		return false;
+
+	len = strlen(text);
+	if (len > HDN_AUTH_PROMPT_MAX_TEXT)
+		return false;
+
+	for (p = (const unsigned char *)text; *p; p++) {
+		if (*p >= 0x20 && *p <= 0x7e)
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static int read_metadata(char **metadata)
+{
+	char *buf;
+	size_t done = 0;
+
+	buf = calloc(HDN_AUTH_PROMPT_MAX_METADATA + 1, 1);
+	if (!buf)
+		return -ENOMEM;
+
+	for (;;) {
+		ssize_t len;
+
+		len = read(STDIN_FILENO, buf + done,
+			   HDN_AUTH_PROMPT_MAX_METADATA - done);
+		if (len < 0) {
+			if (errno == EINTR)
+				continue;
+			free(buf);
+			return -errno;
+		}
+		if (!len)
+			break;
+		done += (size_t)len;
+		if (done == HDN_AUTH_PROMPT_MAX_METADATA) {
+			free(buf);
+			return -E2BIG;
+		}
+	}
+
+	if (!done) {
+		free(buf);
+		return -EINVAL;
+	}
+
+	buf[done] = '\0';
+	*metadata = buf;
+	return 0;
+}
+
+static int set_field(char **slot, char *value, bool action)
+{
+	if (*slot)
+		return -EINVAL;
+	if (action) {
+		if (!safe_name(value))
+			return -EINVAL;
+	} else if (!safe_text(value)) {
+		return -EINVAL;
+	}
+
+	*slot = value;
+	return 0;
+}
+
+static int parse_metadata(char *blob, struct hdn_prompt_metadata *metadata)
+{
+	char *save = NULL;
+	char *line;
+	bool magic = false;
+
+	memset(metadata, 0, sizeof(*metadata));
+
+	for (line = strtok_r(blob, "\n", &save); line;
+	     line = strtok_r(NULL, "\n", &save)) {
+		size_t len = strlen(line);
+
+		if (len && line[len - 1] == '\r')
+			line[--len] = '\0';
+		if (!len)
+			continue;
+		if (!strcmp(line, "HDN_PROMPT_METADATA_V1")) {
+			magic = true;
+			continue;
+		}
+		if (!strncmp(line, "action=", 7)) {
+			if (set_field(&metadata->action, line + 7, true))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "title=", 6)) {
+			if (set_field(&metadata->title, line + 6, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "message=", 8)) {
+			if (set_field(&metadata->message, line + 8, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "consequence=", 12)) {
+			if (set_field(&metadata->consequence, line + 12, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "risk=", 5)) {
+			if (set_field(&metadata->risk, line + 5, false))
+				return -EINVAL;
+			continue;
+		}
+
+		return -EINVAL;
+	}
+
+	if (!magic || !metadata->action || !metadata->title ||
+	    !metadata->message || !metadata->consequence)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_prompt_tool(const char *path, char *const argv[])
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-auth-prompt: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		execv(path, argv);
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child) ? 1 : 0;
+}
+
+static bool desktop_session_available(void)
+{
+	const char *display = getenv("DISPLAY");
+	const char *wayland = getenv("WAYLAND_DISPLAY");
+
+	return (display && display[0]) || (wayland && wayland[0]);
+}
+
+static int show_graphical_prompt(const struct hdn_prompt_metadata *metadata)
+{
+	char body[2048];
+
+	if (!desktop_session_available()) {
+		fprintf(stderr,
+			"hdn-auth-prompt: no graphical session available; denying request\n");
+		return 1;
+	}
+
+	if (metadata->risk) {
+		snprintf(body, sizeof(body), "%s\n\n%s\n\nRisk: %s",
+			 metadata->message, metadata->consequence,
+			 metadata->risk);
+	} else {
+		snprintf(body, sizeof(body), "%s\n\n%s",
+			 metadata->message, metadata->consequence);
+	}
+
+	if (!access("/usr/bin/zenity", X_OK)) {
+		char *const argv[] = {
+			"zenity", "--question", "--title", metadata->title,
+			"--width", "480", "--ok-label", "Allow",
+			"--cancel-label", "Cancel", "--text", body, NULL
+		};
+
+		return run_prompt_tool("/usr/bin/zenity", argv);
+	}
+
+	if (!access("/usr/bin/kdialog", X_OK)) {
+		char *const argv[] = {
+			"kdialog", "--title", metadata->title,
+			"--yes-label", "Allow", "--no-label", "Cancel",
+			"--yesno", body, NULL
+		};
+
+		return run_prompt_tool("/usr/bin/kdialog", argv);
+	}
+
+	if (!access("/usr/bin/xmessage", X_OK)) {
+		char *const argv[] = {
+			"xmessage", "-center", "-title", metadata->title,
+			"-buttons", "Allow:0,Cancel:1", body, NULL
+		};
+
+		return run_prompt_tool("/usr/bin/xmessage", argv);
+	}
+
+	fprintf(stderr,
+		"hdn-auth-prompt: no supported graphical prompt helper found\n");
+	return 1;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_prompt_metadata metadata;
+	const char *action = NULL;
+	bool test_approve = false;
+	bool test_deny = false;
+	char *blob = NULL;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--help") || !strcmp(argv[i], "-h")) {
+			usage(argv[0]);
+			return 0;
+		}
+		if (!strcmp(argv[i], "--test-approve")) {
+			test_approve = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--test-deny")) {
+			test_deny = true;
+			continue;
+		}
+		if (!action) {
+			action = argv[i];
+			continue;
+		}
+		usage(argv[0]);
+		return 2;
+	}
+
+	if (!action || !safe_name(action) || (test_approve && test_deny)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = read_metadata(&blob);
+	if (ret) {
+		fprintf(stderr, "hdn-auth-prompt: invalid prompt metadata\n");
+		return 1;
+	}
+
+	ret = parse_metadata(blob, &metadata);
+	if (ret || strcmp(metadata.action, action)) {
+		fprintf(stderr, "hdn-auth-prompt: rejected prompt metadata\n");
+		free(blob);
+		return 1;
+	}
+
+	if (test_approve) {
+		free(blob);
+		return 0;
+	}
+	if (test_deny) {
+		free(blob);
+		return 1;
+	}
+
+	ret = show_graphical_prompt(&metadata);
+	free(blob);
+	return ret;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-compat linux-7.0.12-hdn/tools/hardening/hdn-compat
--- linux-7.0.12/tools/hardening/hdn-compat	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-compat	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,445 @@
+#!/usr/bin/python3 -I
+# SPDX-License-Identifier: GPL-2.0-only
+"""Offline, pinned-publisher compatibility compiler. Never loads or signs policy."""
+import argparse
+import contextlib
+import fcntl
+import hashlib
+import json
+import os
+import re
+import stat
+import subprocess
+import sys
+
+VERSION = 1
+LIMIT = 1024 * 1024
+ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C", "OPENSSL_CONF": "/dev/null"}
+INTENTS = {"jit-private": 1 << 4, "fixed-private-code": 1 << 2}
+
+
+class Rejected(Exception):
+    def __init__(self, category, message):
+        self.category, self.message = category, message
+
+
+def require(condition, category="invalid-metadata", message="Invalid application metadata"):
+    if not condition:
+        raise Rejected(category, message)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def pairs(entries):
+    result = {}
+    for key, value in entries:
+        require(key not in result, message="Duplicate metadata field")
+        result[key] = value
+    return result
+
+
+def decode(data):
+    require(len(data) <= LIMIT)
+    return json.loads(data.decode("utf-8", "strict"), object_pairs_hook=pairs,
+                      parse_constant=lambda _: require(False))
+
+
+def fields(value, names):
+    require(type(value) is dict and set(value) == set(names.split()))
+
+
+def integer(value, maximum=(1 << 64) - 2):
+    require(type(value) is int and 0 < value <= maximum)
+    return value
+
+
+def digest(value):
+    require(type(value) is str and re.fullmatch(r"[0-9a-f]{64}", value))
+    return value
+
+
+def package(value):
+    fields(value, "name version release")
+    for part in value.values():
+        require(type(part) is str and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~:-]{0,127}", part))
+
+
+def pathname(value):
+    require(type(value) is str and value.startswith("/") and len(value.encode()) < 256)
+    require(all(re.fullmatch(r"[A-Za-z0-9_+.@-]+", part) and part not in (".", "..")
+                for part in value.split("/")[1:]))
+    return value
+
+
+def intents(value):
+    require(type(value) is list and 0 < len(value) <= len(INTENTS))
+    require(all(type(v) is str for v in value) and len(set(value)) == len(value))
+    require(all(v in INTENTS for v in value), "unsupported-request",
+            "This application needs an updated build; its requested exception is unsupported")
+    return sum(INTENTS[v] for v in value)
+
+
+def snapshot(path, maximum=LIMIT):
+    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        before = os.fstat(fd)
+        require(stat.S_ISREG(before.st_mode) and 0 < before.st_size <= maximum)
+        data = bytearray()
+        while len(data) <= maximum:
+            chunk = os.read(fd, min(65536, maximum + 1 - len(data)))
+            if not chunk:
+                break
+            data.extend(chunk)
+        after = os.fstat(fd)
+        require(len(data) == before.st_size and
+                (before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
+                (after.st_size, after.st_mtime_ns, after.st_ctime_ns),
+                "changed-input", "Application metadata changed during verification")
+        return bytes(data)
+    finally:
+        os.close(fd)
+
+
+@contextlib.contextmanager
+def memfile(data=None):
+    fd = os.memfd_create("hdn-compat", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
+    try:
+        if data is not None:
+            with os.fdopen(os.dup(fd), "wb") as stream:
+                stream.write(data)
+            os.lseek(fd, 0, os.SEEK_SET)
+            fcntl.fcntl(fd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW |
+                        fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL)
+        yield fd
+    finally:
+        os.close(fd)
+
+
+def fdpath(fd):
+    return f"/proc/self/fd/{fd}"
+
+
+def run(argv, fds=(), data=None):
+    result = subprocess.run(argv, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            pass_fds=fds, close_fds=True, env=ENV, timeout=30, check=False)
+    require(result.returncode == 0, "verification-failed",
+            "Application approval could not be verified; obtain a current signed package")
+    require(len(result.stdout) <= LIMIT and len(result.stderr) <= LIMIT)
+    return result.stdout
+
+
+def certificate(data):
+    # One explicitly pinned public certificate; no ambient CA or embedded signer.
+    require(re.fullmatch(rb"\s*-----BEGIN CERTIFICATE-----\r?\n[A-Za-z0-9+/=\r\n]+"
+                         rb"-----END CERTIFICATE-----\s*", data), "invalid-certificate")
+    return run(["/usr/bin/openssl", "x509", "-inform", "PEM", "-outform", "DER"], data=data)
+
+
+def der_items(data):
+    """Bounded definite-length DER framing, not a cryptographic implementation."""
+    result, cursor = [], 0
+    while cursor < len(data):
+        require(cursor + 2 <= len(data), "invalid-signature")
+        tag, length = data[cursor:cursor + 2]
+        cursor += 2
+        require(tag & 31 != 31, "invalid-signature")
+        if length & 128:
+            width = length & 127
+            require(1 <= width <= 4 and cursor + width <= len(data) and data[cursor] != 0,
+                    "invalid-signature")
+            length = int.from_bytes(data[cursor:cursor + width], "big")
+            cursor += width
+            require(length >= 128, "invalid-signature")
+        require(cursor + length <= len(data), "invalid-signature")
+        result.append((tag, data[cursor:cursor + length]))
+        cursor += length
+    return result
+
+
+def cms_digest_contract(signature):
+    # RFC 5652 sections 5.1 and 5.3. Only detached SignedData with one signer
+    # and a modern content digest is accepted; OpenSSL validates all signatures.
+    def sequence(data):
+        values = der_items(data)
+        require(len(values) == 1 and values[0][0] == 0x30, "invalid-signature")
+        return der_items(values[0][1])
+
+    def algorithm(value):
+        require(value[0] == 0x30, "invalid-signature")
+        parts = der_items(value[1])
+        require(len(parts) in (1, 2) and parts[0][0] == 6, "invalid-signature")
+        require(len(parts) == 1 or parts[1] == (5, b""), "invalid-signature")
+        allowed = {bytes.fromhex("608648016503040201"), bytes.fromhex("608648016503040202"),
+                   bytes.fromhex("608648016503040203")}
+        require(parts[0][1] in allowed, "unsupported-signature-digest")
+        return parts[0][1]
+
+    content = sequence(signature)
+    require(len(content) == 2 and content[0] == (6, bytes.fromhex("2a864886f70d010702"))
+            and content[1][0] == 0xa0, "invalid-signature")
+    signed = sequence(content[1][1])
+    require(4 <= len(signed) <= 6 and signed[0][0] == 2 and signed[1][0] == 0x31
+            and signed[2][0] == 0x30 and signed[-1][0] == 0x31, "invalid-signature")
+    require(der_items(signed[2][1]) == [(6, bytes.fromhex("2a864886f70d010701"))],
+            "attached-signature-not-supported")
+    digests = der_items(signed[1][1])
+    require(len(digests) == 1, "invalid-signature")
+    digest_oid = algorithm(digests[0])
+    signer = sequence(signed[-1][1])
+    require(len(signer) >= 5 and signer[0][0] == 2 and algorithm(signer[2]) == digest_oid,
+            "invalid-signature")
+
+
+def verify(data, signature, cert):
+    cms_digest_contract(signature)
+    pinned = certificate(cert)
+    with memfile(data) as content, memfile(signature) as sig, memfile(cert) as pem, memfile() as signer:
+        verified = run(["/usr/bin/openssl", "cms", "-verify", "-verify_retcode", "-binary",
+                        "-inform", "DER", "-in", fdpath(sig), "-content", fdpath(content),
+                        "-nointern", "-certfile", fdpath(pem), "-noverify", "-signer", fdpath(signer)],
+                       (content, sig, pem, signer))
+        require(verified == data, "signature-content-mismatch")
+        os.lseek(signer, 0, os.SEEK_SET)
+        signed_by = os.read(signer, 65537)
+        require(len(signed_by) <= 65536 and certificate(signed_by) == pinned, "wrong-publisher")
+    return sha(pinned)
+
+
+class Policy:
+    def __init__(self, data, abi):
+        self.abi, self.header = abi, abi["header"]
+        self.data = bytearray(data)
+        require(len(data) >= self.header["size"] and len(data) <= abi["max_policy"])
+        for field, expected in (("magic", abi["magic"]), ("abi_version", abi["abi"]),
+                                ("header_size", self.header["size"])):
+            require(self.get(data, self.header, field) == expected, "incompatible-policy")
+        self.records, self.offsets = {}, {}
+        cursor = self.header["size"]
+        for name in ("profile", "subject_rule", "object_rule", "exec_rule", "module_rule",
+                     "firmware_rule", "resource_rule"):
+            layout = abi["records"][name]
+            size, count = self.h(name + "_size"), self.h(name + "_count")
+            require(size == layout["size"] and count <= layout["maximum"], "incompatible-policy")
+            require(cursor + size * count <= len(data), "invalid-policy")
+            self.offsets[name] = cursor
+            self.records[name] = [data[cursor + i * size:cursor + (i + 1) * size] for i in range(count)]
+            cursor += size * count
+        require(cursor == len(data), "invalid-policy", "Expected an unsigned compiled base policy")
+
+    def get(self, data, layout, field):
+        offset, size = layout["fields"][field]
+        return int.from_bytes(data[offset:offset + size], self.abi["byteorder"])
+
+    def set(self, data, layout, field, value):
+        offset, size = layout["fields"][field]
+        encoded = value if isinstance(value, bytes) else value.to_bytes(size, self.abi["byteorder"])
+        require(len(encoded) <= size)
+        data[offset:offset + size] = encoded.ljust(size, b"\0")
+
+    def h(self, field):
+        return self.get(self.data, self.header, field)
+
+    def record(self, name, record, field):
+        return self.get(record, self.abi["records"][name], field)
+
+    def binding(self, approval, executable):
+        target, parent = integer(approval["profile_id"]), integer(approval["parent_profile_id"])
+        found = [r for r in self.records["profile"] if self.record("profile", r, "profile_id") == target]
+        require(len(found) == 1 and sha(found[0]) == digest(approval["profile_sha256"]), "profile-mismatch")
+        require(any(self.record("profile", r, "profile_id") == parent for r in self.records["profile"]),
+                "profile-mismatch")
+        require(target != parent and target not in (self.h("default_profile_id"), self.h("privileged_profile_id")))
+        for record in self.records["profile"]:
+            if self.record("profile", record, "profile_id") in (self.h("default_profile_id"), self.h("privileged_profile_id")):
+                require(self.record("profile", record, "memory_flags") == 0, "ambient-memory-grant")
+        flags = self.record("profile", found[0], "flags")
+        memory = self.record("profile", found[0], "memory_flags")
+        require(not flags & self.abi["inherit_flag"] and memory == intents(executable["intents"])
+                and not memory & ~self.abi["memory_mask"], "unsupported-request")
+        require(not any(self.record("subject_rule", r, "profile_id") == target
+                        for r in self.records["subject_rule"]), "ambient-profile")
+        require(not any(self.record("object_rule", r, "profile_id") == target
+                        for r in self.records["object_rule"]), "unsupported-object-policy")
+        # Dedicated preapproved profiles have no preexisting exec selector.
+        # Reject wildcard inheritance, which could copy this grant without its lease.
+        for rule in self.records["exec_rule"]:
+            require(self.record("exec_rule", rule, "target_profile_id") != target, "ambient-profile")
+            require(self.record("exec_rule", rule, "flags") & (1 << 3), "unsupported-base-selector")
+            path_offset, path_size = self.abi["records"]["exec_rule"]["fields"]["file_path"]
+            existing_path = rule[path_offset:path_offset + path_size].split(b"\0", 1)[0].decode("utf-8", "strict")
+            require(existing_path != executable["path"], "ambiguous-executable-binding")
+            if self.record("exec_rule", rule, "flags") & (1 << 5):
+                require(self.record("exec_rule", rule, "parent_profile_id") not in (0, target), "ambient-profile")
+        layout = self.abi["records"]["exec_rule"]
+        rule = bytearray(layout["size"])
+        values = {"target_profile_id": target, "parent_profile_id": parent,
+                  "flags": self.abi["lease_flags"], "verity_digest_size": 32,
+                  "verity_digest_algorithm": 1,
+                  "verity_digest": bytes.fromhex(executable["verity"]["digest"]),
+                  "file_path": executable["path"].encode() + b"\0"}
+        for key, value in values.items():
+            self.set(rule, layout, key, value)
+        return rule
+
+    def finish(self, rules):
+        count = self.h("exec_rule_count") + len(rules)
+        require(count <= self.abi["records"]["exec_rule"]["maximum"])
+        # Prepend exact approved selectors so earlier generic rules cannot shadow them.
+        cursor = self.offsets["exec_rule"]
+        self.data[cursor:cursor] = b"".join(rules)
+        self.set(self.data, self.header, "exec_rule_count", count)
+        require(len(self.data) <= self.abi["max_policy"])
+        return bytes(self.data)
+
+
+def open_image(rootfd, path):
+    directory = os.dup(rootfd)
+    try:
+        parts = pathname(path).split("/")[1:]
+        for part in parts[:-1]:
+            child = os.open(part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory)
+            os.close(directory)
+            directory = child
+        return os.open(parts[-1], os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+    finally:
+        os.close(directory)
+
+
+def image_identity(fd, executable, abi):
+    info = os.fstat(fd)
+    require(stat.S_ISREG(info.st_mode) and info.st_mode & 0o111 and info.st_size <= 1024**3,
+            "unsupported-image")
+    head = os.pread(fd, 64, 0)
+    machine = {"x86_64": 62, "aarch64": 183, "riscv64": 243}.get(os.uname().machine)
+    require(len(head) == 64 and head[:6] == b"\x7fELF\x02\x01" and
+            int.from_bytes(head[18:20], "little") == machine and
+            int.from_bytes(head[16:18], "little") in (2, 3), "unsupported-image",
+            "Use a native executable package; scripts and foreign binaries need separate approval")
+    measured = bytearray(68)
+    measured[2:4] = (64).to_bytes(2, abi["byteorder"])
+    fcntl.ioctl(fd, abi["measure_verity"], measured, True)
+    require(int.from_bytes(measured[:2], abi["byteorder"]) == 1 and
+            int.from_bytes(measured[2:4], abi["byteorder"]) == 32 and
+            measured[4:36].hex() == executable["verity"]["digest"], "image-mismatch")
+    hasher = hashlib.sha256()
+    offset = 0
+    while chunk := os.pread(fd, 65536, offset):
+        hasher.update(chunk)
+        offset += len(chunk)
+    require(offset == info.st_size and hasher.hexdigest() == executable["sha256"], "image-mismatch")
+    return info.st_dev, info.st_ino
+
+
+def write_new(path, data):
+    # Never overwrite a previous output or follow a link. A failed write leaves
+    # an unsigned incomplete file, which must be discarded by the build owner.
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    with os.fdopen(fd, "wb") as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def compile_policy(args):
+    manifest_bytes = snapshot(args.manifest)
+    approvals_bytes = snapshot(args.approvals)
+    publisher = verify(manifest_bytes, snapshot(args.manifest_signature, 131072),
+                       snapshot(args.publisher_cert, 65536))
+    authority = verify(approvals_bytes, snapshot(args.approvals_signature, 131072),
+                       snapshot(args.authority_cert, 65536))
+    require(publisher != authority, "non-independent-approval",
+            "Application approval must come from an independent distribution authority")
+    manifest, approvals = decode(manifest_bytes), decode(approvals_bytes)
+    fields(manifest, "schema kind package policy_generation executables")
+    fields(approvals, "schema kind package policy_generation publisher_sha256 base_policy_sha256 bindings")
+    require(type(manifest["schema"]) is int and manifest["schema"] == VERSION and
+            type(approvals["schema"]) is int and approvals["schema"] == VERSION, "unsupported-schema")
+    require(manifest["kind"] == "hdn.compat.package" and approvals["kind"] == "hdn.compat.approvals")
+    package(manifest["package"])
+    package(approvals["package"])
+    require(manifest["package"] == approvals["package"] and
+            publisher == digest(approvals["publisher_sha256"]), "wrong-publisher")
+    generation = integer(manifest["policy_generation"])
+    require(generation == integer(approvals["policy_generation"]), "stale-approval")
+    base = snapshot(args.base_policy)
+    require(sha(base) == digest(approvals["base_policy_sha256"]), "stale-approval")
+    abi = decode(run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "hdn-compat-abi")]))
+    require(abi["schema"] == VERSION and abi["byteorder"] == sys.byteorder, "incompatible-tools")
+    policy = Policy(base, abi)
+    require(policy.h("generation") == generation and
+            policy.h("expected_generation") != (1 << 64) - 1, "stale-approval")
+    executables, bindings = manifest["executables"], approvals["bindings"]
+    require(type(executables) is list and 0 < len(executables) <= 128 and type(bindings) is list
+            and len(bindings) == len(executables))
+    approved = {}
+    for binding in bindings:
+        fields(binding, "path profile_id parent_profile_id profile_sha256 intents")
+        path = pathname(binding["path"])
+        require(path not in approved)
+        intents(binding["intents"])
+        approved[path] = binding
+    rootfd = os.open(args.image_root, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    rules, identities, seen = [], [], set()
+    try:
+        for executable in executables:
+            fields(executable, "path sha256 verity intents")
+            path = pathname(executable["path"])
+            require(path not in seen and path in approved)
+            seen.add(path)
+            digest(executable["sha256"])
+            fields(executable["verity"], "algorithm digest")
+            require(executable["verity"]["algorithm"] == "sha256", "unsupported-digest")
+            digest(executable["verity"]["digest"])
+            require(intents(executable["intents"]) == intents(approved[path]["intents"]), "unapproved-intent")
+            fd = open_image(rootfd, path)
+            try:
+                identity = image_identity(fd, executable, abi)
+            finally:
+                os.close(fd)
+            identities.append((path, identity))
+            rules.append(policy.binding(approved[path], executable))
+        for path, identity in identities:
+            fd = open_image(rootfd, path)
+            try:
+                info = os.fstat(fd)
+                require((info.st_dev, info.st_ino) == identity, "changed-input")
+            finally:
+                os.close(fd)
+    finally:
+        os.close(rootfd)
+    output = policy.finish(rules)
+    report = {"schema": VERSION, "compiler_version": VERSION, "status": "ready-for-signing",
+              "package": manifest["package"], "policy_generation": generation,
+              "manifest_sha256": sha(manifest_bytes), "approvals_sha256": sha(approvals_bytes),
+              "publisher_sha256": publisher, "authority_sha256": authority,
+              "base_policy_sha256": sha(base), "output_policy_sha256": sha(output),
+              "executables": sorted(seen), "runtime_applied": False}
+    write_new(args.output, output)
+    print(json.dumps(report, sort_keys=True))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--version", action="version", version=f"hdn-compat {VERSION}; intent schema {VERSION}")
+    sub = parser.add_subparsers(dest="command", required=True)
+    command = sub.add_parser("compile")
+    for name in ("manifest", "manifest-signature", "publisher-cert", "approvals", "approvals-signature",
+                 "authority-cert", "base-policy", "image-root", "output"):
+        command.add_argument("--" + name, required=True)
+    args = parser.parse_args()
+    try:
+        compile_policy(args)
+        return 0
+    except Rejected as error:
+        category, message = error.category, error.message
+    except (OSError, ValueError, OverflowError, KeyError, TypeError, RecursionError, subprocess.SubprocessError):
+        category, message = "verification-failed", "Application approval could not be verified; obtain a current signed package"
+    print(json.dumps({"schema": VERSION, "status": "rejected", "category": category,
+                      "message": message, "runtime_applied": False}), file=sys.stderr)
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-compat-abi.c linux-7.0.12-hdn/tools/hardening/hdn-compat-abi.c
--- linux-7.0.12/tools/hardening/hdn-compat-abi.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-compat-abi.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Describe the native policy ABI to the offline compiler; no authority or I/O. */
+#include <stddef.h>
+#include <stdio.h>
+#include <linux/hardening.h>
+#include <linux/fsverity.h>
+
+#define FIELD(type, member) \
+	printf("\"" #member "\":[%zu,%zu],", offsetof(struct type, member), \
+	       sizeof(((struct type *)0)->member))
+#define RECORD(name, type, maximum) \
+	printf("\"" name "\":{\"size\":%zu,\"maximum\":%u,\"fields\":{", \
+	       sizeof(struct type), maximum)
+#define END_RECORD() printf("\"_end\":[0,0]}}")
+
+int main(void)
+{
+	const unsigned int endian = 1;
+
+	printf("{\"schema\":1,\"byteorder\":\"%s\",\"abi\":%u,\"magic\":%u,"
+	       "\"max_policy\":%u,\"path_size\":%u,\"measure_verity\":%lu,"
+	       "\"lease_flags\":%llu,\"memory_mask\":%llu,\"inherit_flag\":%llu,"
+	       "\"header\":{\"size\":%zu,\"fields\":{",
+	       *(const unsigned char *)&endian ? "little" : "big",
+	       HDN_POLICY_ABI_VERSION, HDN_POLICY_MAGIC, HDN_MAX_POLICY_SIZE,
+	       HDN_POLICY_PATH_LEN, (unsigned long)FS_IOC_MEASURE_VERITY,
+	       (unsigned long long)(HDN_EXEC_RESOLVE_FILE_PATH | HDN_EXEC_MATCH_VERITY_DIGEST | HDN_EXEC_COMPAT_LEASE),
+	       (unsigned long long)(HDN_MEM_ALLOW_FIXED_ANON_EXEC | HDN_MEM_ALLOW_JIT_EXEC_AFTER_WRITE),
+	       (unsigned long long)HDN_PROFILE_INHERIT_UNMATCHED_EXEC,
+	       sizeof(struct hdn_policy_header));
+#define H(member) FIELD(hdn_policy_header, member)
+	H(magic); H(abi_version); H(header_size); H(profile_size); H(profile_count);
+	H(flags); H(subject_rule_size); H(subject_rule_count); H(object_rule_size);
+	H(object_rule_count); H(exec_rule_size); H(exec_rule_count); H(module_rule_size);
+	H(module_rule_count); H(firmware_rule_size); H(firmware_rule_count);
+	H(resource_rule_size); H(resource_rule_count); H(generation);
+	H(expected_generation); H(default_profile_id); H(privileged_profile_id);
+	END_RECORD();
+	printf(",\"records\":{");
+	RECORD("profile", hdn_profile_record, HDN_MAX_PROFILES);
+	FIELD(hdn_profile_record, profile_id); FIELD(hdn_profile_record, memory_flags);
+	FIELD(hdn_profile_record, flags); END_RECORD(); printf(",");
+	RECORD("subject_rule", hdn_subject_rule_record, HDN_MAX_SUBJECT_RULES);
+	FIELD(hdn_subject_rule_record, profile_id); END_RECORD(); printf(",");
+	RECORD("object_rule", hdn_object_rule_record, HDN_MAX_OBJECT_RULES);
+	FIELD(hdn_object_rule_record, profile_id);
+	END_RECORD(); printf(",");
+	RECORD("exec_rule", hdn_exec_rule_record, HDN_MAX_EXEC_RULES);
+#define E(member) FIELD(hdn_exec_rule_record, member)
+	E(target_profile_id); E(parent_profile_id); E(flags); E(verity_digest_size);
+	E(verity_digest_algorithm); E(verity_digest); E(file_path);
+	END_RECORD(); printf(",");
+	RECORD("module_rule", hdn_module_rule_record, HDN_MAX_MODULE_RULES);
+	END_RECORD(); printf(",");
+	RECORD("firmware_rule", hdn_firmware_rule_record, HDN_MAX_FIRMWARE_RULES);
+	END_RECORD(); printf(",");
+	RECORD("resource_rule", hdn_resource_rule_record, HDN_MAX_RESOURCE_RULES);
+	END_RECORD(); puts("}}");
+	return ferror(stdout) ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-control-center.c linux-7.0.12-hdn/tools/hardening/hdn-control-center.c
--- linux-7.0.12/tools/hardening/hdn-control-center.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-control-center.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,458 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_STATUS_HELPER_PATH
+#define HDN_STATUS_HELPER_PATH "/usr/libexec/hdn-status"
+#endif
+
+#ifndef HDN_DESKTOP_DAEMON_PATH
+#define HDN_DESKTOP_DAEMON_PATH "/usr/libexec/hdn-desktop-daemon"
+#endif
+
+#ifndef HDN_POLICY_DAEMON_PATH
+#define HDN_POLICY_DAEMON_PATH "/usr/libexec/hdn-policy-daemon"
+#endif
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--status-helper PATH] [--desktop-daemon PATH] [--policy-daemon PATH] status [HDN_STATUS_ARGS...]\n"
+		"       %s [--desktop-daemon PATH] [--dry-run] action DESKTOP_ACTION\n"
+		"       %s [--policy-daemon PATH] [--dry-run] policy COMMAND WORKFLOW\n"
+		"       %s [--status-helper PATH] [--desktop-daemon PATH] [--policy-daemon PATH] --stdio\n"
+		"\n"
+		"Policy commands: learn, candidate, compile, commit (--dry-run only for commit)\n"
+		"Stdio requests: status, action DESKTOP_ACTION, dry-run action DESKTOP_ACTION, policy COMMAND WORKFLOW, or dry-run policy commit WORKFLOW\n"
+		"Stable product-facing entry point for desktop shells and settings panels.\n",
+		prog, prog, prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-control-center: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-control-center: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-control-center: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int run_status(const char *status_helper, int argc, char **argv)
+{
+	char **status_argv;
+	int err;
+	int i;
+
+	status_argv = calloc((size_t)argc + 2, sizeof(*status_argv));
+	if (!status_argv)
+		return 1;
+
+	status_argv[0] = "hdn-status";
+	for (i = 0; i < argc; i++)
+		status_argv[i + 1] = argv[i];
+	status_argv[argc + 1] = NULL;
+
+	execv(status_helper, status_argv);
+	err = errno;
+	fprintf(stderr, "hdn-control-center: exec %s failed: %s\n",
+		status_helper, strerror(err));
+	free(status_argv);
+	return err == ENOENT ? 127 : 126;
+}
+
+static int run_action(const char *desktop_daemon, const char *action,
+		      bool dry_run)
+{
+	int err;
+
+	if (!safe_name(action)) {
+		fprintf(stderr,
+			"hdn-control-center: unsafe desktop action: %s\n",
+			action ? action : "(null)");
+		return 1;
+	}
+
+	if (dry_run)
+		execl(desktop_daemon, "hdn-desktop-daemon", "--dry-run",
+		      action, NULL);
+	else
+		execl(desktop_daemon, "hdn-desktop-daemon", action, NULL);
+	err = errno;
+	fprintf(stderr, "hdn-control-center: exec %s failed: %s\n",
+		desktop_daemon, strerror(err));
+	return err == ENOENT ? 127 : 126;
+}
+
+static bool safe_policy_command(const char *command)
+{
+	return command &&
+	       (!strcmp(command, "learn") || !strcmp(command, "candidate") ||
+		!strcmp(command, "compile") || !strcmp(command, "commit"));
+}
+
+static int run_policy(const char *policy_daemon, const char *command,
+		      const char *workflow, bool dry_run)
+{
+	int err;
+
+	if (!safe_policy_command(command)) {
+		fprintf(stderr,
+			"hdn-control-center: unsafe policy command: %s\n",
+			command ? command : "(null)");
+		return 1;
+	}
+	if (dry_run && strcmp(command, "commit")) {
+		fprintf(stderr,
+			"hdn-control-center: --dry-run is only valid with policy commit\n");
+		return 1;
+	}
+	if (!safe_name(workflow)) {
+		fprintf(stderr,
+			"hdn-control-center: unsafe workflow name: %s\n",
+			workflow ? workflow : "(null)");
+		return 1;
+	}
+
+	if (dry_run)
+		execl(policy_daemon, "hdn-policy-daemon", "--dry-run",
+		      command, workflow, NULL);
+	else
+		execl(policy_daemon, "hdn-policy-daemon", command, workflow,
+		      NULL);
+	err = errno;
+	fprintf(stderr, "hdn-control-center: exec %s failed: %s\n",
+		policy_daemon, strerror(err));
+	return err == ENOENT ? 127 : 126;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_status_child(const char *status_helper)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-control-center: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child)
+		_exit(run_status(status_helper, 0, NULL));
+
+	return child_status_result(child);
+}
+
+static int run_action_child(const char *desktop_daemon, const char *action,
+			    bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-control-center: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child)
+		_exit(run_action(desktop_daemon, action, dry_run));
+
+	return child_status_result(child);
+}
+
+static int run_policy_child(const char *policy_daemon, const char *command,
+			    const char *workflow, bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-control-center: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child)
+		_exit(run_policy(policy_daemon, command, workflow, dry_run));
+
+	return child_status_result(child);
+}
+
+static int run_stdio(const char *status_helper, const char *desktop_daemon,
+		     const char *policy_daemon)
+{
+	char *line = NULL;
+	size_t size = 0;
+	bool failed = false;
+	ssize_t len;
+
+	puts("HDN_CONTROL_CENTER_READY");
+	fflush(stdout);
+
+	while ((len = getline(&line, &size, stdin)) >= 0) {
+		char *tokens[5];
+		unsigned int count = 0;
+		char *save = NULL;
+		char *word;
+		char *request = trim(line);
+		const char *kind = NULL;
+		const char *action = NULL;
+		const char *command = NULL;
+		const char *workflow = NULL;
+		bool dry_run = false;
+		int ret = 1;
+
+		(void)len;
+		if (!request[0])
+			continue;
+
+		for (word = strtok_r(request, " \t", &save); word;
+		     word = strtok_r(NULL, " \t", &save)) {
+			if (count < sizeof(tokens) / sizeof(tokens[0]))
+				tokens[count] = word;
+			count++;
+		}
+
+		if (count == 1 && !strcmp(tokens[0], "status")) {
+			kind = "status";
+			ret = run_status_child(status_helper);
+		} else if (count == 2 && !strcmp(tokens[0], "action")) {
+			kind = "action";
+			action = tokens[1];
+			ret = run_action_child(desktop_daemon, action, false);
+		} else if (count == 3 && !strcmp(tokens[0], "dry-run") &&
+			   !strcmp(tokens[1], "action")) {
+			kind = "action";
+			dry_run = true;
+			action = tokens[2];
+			ret = run_action_child(desktop_daemon, action, true);
+		} else if (count == 3 && !strcmp(tokens[0], "policy")) {
+			kind = "policy";
+			command = tokens[1];
+			workflow = tokens[2];
+			ret = run_policy_child(policy_daemon, command, workflow,
+					       false);
+		} else if (count == 4 && !strcmp(tokens[0], "dry-run") &&
+			   !strcmp(tokens[1], "policy")) {
+			kind = "policy";
+			dry_run = true;
+			command = tokens[2];
+			workflow = tokens[3];
+			ret = run_policy_child(policy_daemon, command, workflow,
+					       true);
+		}
+
+		if (!kind) {
+			printf("HDN_CONTROL_CENTER_RESULT request=(invalid) status=invalid exit=1\n");
+			fflush(stdout);
+			failed = true;
+			continue;
+		}
+
+		if (!strcmp(kind, "action"))
+			printf("HDN_CONTROL_CENTER_RESULT request=action action=%s dry_run=%u status=%s exit=%d\n",
+			       safe_name(action) ? action : "(invalid)",
+			       dry_run ? 1 : 0, ret ? "failed" : "ok",
+			       ret ? 1 : 0);
+		else if (!strcmp(kind, "policy"))
+			printf("HDN_CONTROL_CENTER_RESULT request=policy command=%s workflow=%s dry_run=%u status=%s exit=%d\n",
+			       safe_policy_command(command) ? command : "(invalid)",
+			       safe_name(workflow) ? workflow : "(invalid)",
+			       dry_run ? 1 : 0, ret ? "failed" : "ok",
+			       ret ? 1 : 0);
+		else
+			printf("HDN_CONTROL_CENTER_RESULT request=status status=%s exit=%d\n",
+			       ret ? "failed" : "ok", ret ? 1 : 0);
+		fflush(stdout);
+		if (ret)
+			failed = true;
+	}
+
+	free(line);
+	return ferror(stdin) || failed ? 1 : 0;
+}
+
+int main(int argc, char **argv)
+{
+	const char *status_helper = HDN_STATUS_HELPER_PATH;
+	const char *desktop_daemon = HDN_DESKTOP_DAEMON_PATH;
+	const char *policy_daemon = HDN_POLICY_DAEMON_PATH;
+	const char *command = NULL;
+	int command_index = 0;
+	bool dry_run = false;
+	bool stdio_mode = false;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--status-helper")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			status_helper = argv[i];
+		} else if (!strcmp(argv[i], "--desktop-daemon")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			desktop_daemon = argv[i];
+		} else if (!strcmp(argv[i], "--policy-daemon")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			policy_daemon = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "--stdio")) {
+			stdio_mode = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else {
+			command = argv[i];
+			command_index = i + 1;
+			break;
+		}
+	}
+
+	if (stdio_mode && (command || dry_run)) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (!stdio_mode && !command) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (require_safe_absolute("status-helper", status_helper) ||
+	    require_safe_absolute("desktop-daemon", desktop_daemon) ||
+	    require_safe_absolute("policy-daemon", policy_daemon))
+		return 1;
+
+	if (stdio_mode)
+		return run_stdio(status_helper, desktop_daemon, policy_daemon);
+
+	if (!strcmp(command, "status")) {
+		if (dry_run) {
+			usage(argv[0]);
+			return 2;
+		}
+		return run_status(status_helper, argc - command_index,
+				  &argv[command_index]);
+	}
+
+	if (!strcmp(command, "action")) {
+		if (command_index + 1 != argc) {
+			usage(argv[0]);
+			return 2;
+		}
+		return run_action(desktop_daemon, argv[command_index],
+				  dry_run);
+	}
+
+	if (!strcmp(command, "policy")) {
+		if (command_index + 2 != argc) {
+			usage(argv[0]);
+			return 2;
+		}
+		return run_policy(policy_daemon, argv[command_index],
+				  argv[command_index + 1], dry_run);
+	}
+
+	usage(argv[0]);
+	return 2;
+}
