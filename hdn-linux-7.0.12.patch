diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/org.hdn.system.policy linux-7.0.12-hdn/tools/hardening/org.hdn.system.policy
