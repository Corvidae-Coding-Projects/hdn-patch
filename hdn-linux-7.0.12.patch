+static int read_whole_file(const char *path, unsigned char **buf,
+			   size_t *size)
+{
+	const size_t max_size = 2 * 1024 * 1024;
+	struct stat st;
+	unsigned char *data;
+	bool stream;
+	size_t capacity;
+	size_t offset = 0;
+	int fd;
+	int ret = 0;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	if (fstat(fd, &st)) {
+		ret = -errno;
+		goto out_close;
+	}
+	if (st.st_size > (off_t)max_size) {
+		ret = -EINVAL;
+		goto out_close;
+	}
+
+	stream = st.st_size == 0;
+	capacity = st.st_size > 0 ? (size_t)st.st_size : 4096;
+	data = malloc(capacity);
+	if (!data) {
+		ret = -ENOMEM;
+		goto out_close;
+	}
+
+	for (;;) {
+		ssize_t len;
+
+		if (offset == capacity) {
+			unsigned char *grown;
+			size_t new_capacity;
+
+			if (capacity == max_size) {
+				ret = -EFBIG;
+				goto out_free;
+			}
+			new_capacity = capacity > max_size / 2 ? max_size :
+							       capacity * 2;
+			grown = realloc(data, new_capacity);
+			if (!grown) {
+				ret = -ENOMEM;
+				goto out_free;
+			}
+			data = grown;
+			capacity = new_capacity;
+		}
+
+		len = read(fd, data + offset, capacity - offset);
+		if (len < 0) {
+			ret = -errno;
+			goto out_free;
+		}
+		if (!len && !stream && offset != (size_t)st.st_size) {
+			ret = -EIO;
+			goto out_free;
+		}
+		if (!len)
+			break;
+		offset += len;
+		if (!stream && offset == (size_t)st.st_size)
+			break;
+	}
+	if (!offset) {
+		ret = -EINVAL;
+		goto out_free;
+	}
+
+	*buf = data;
+	*size = offset;
+	goto out_close;
+
+out_free:
+	free(data);
+out_close:
+	close(fd);
+	return ret;
+}
+
+static int write_blob_file(const char *path, const unsigned char *buf,
+			   size_t size)
+{
+	int fd;
+	ssize_t len;
+	int ret = 0;
+
+	fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+
+	len = write(fd, buf, size);
+	if (len < 0)
+		ret = -errno;
+	else if ((size_t)len != size)
+		ret = -EIO;
+
+	close(fd);
+	return ret;
+}
+
+static int write_text_file(const char *path, const char *text)
+{
+	return write_blob_file(path, (const unsigned char *)text, strlen(text));
+}
