+			      "--config", config_path, "--dry-run", NULL);
+		else if (config_path)
+			execl(HDN_SUPPORT_BUNDLE_EXEC, "hdn-support-bundle",
+			      "--config", config_path, NULL);
+		else if (dry_run)
+			execl(HDN_SUPPORT_BUNDLE_EXEC, "hdn-support-bundle",
+			      "--dry-run", NULL);
+		else
+			execl(HDN_SUPPORT_BUNDLE_EXEC, "hdn-support-bundle",
+			      NULL);
+		fprintf(stderr, "support bundle exec failed: %s\n",
+			strerror(errno));
+		_exit(2);
+	}
+
+	return child_exit_result(child);
