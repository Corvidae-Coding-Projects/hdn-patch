+	{ "KEXEC_LOAD", HDN_AUTH_KEXEC_LOAD },
+	{ "FIRMWARE_LOAD", HDN_AUTH_FIRMWARE_LOAD },
+	{ "IO_URING_RESTRICTED_OP", HDN_AUTH_IO_URING_RESTRICTED_OP },
+	{ "KERNEL_LOG_READ", HDN_AUTH_KERNEL_LOG_READ },
+	{ "KERNEL_LOG_WRITE", HDN_AUTH_KERNEL_LOG_WRITE },
+	{ "RAW_IO", HDN_AUTH_RAW_IO },
+	{ "MOUNT_ADMIN", HDN_AUTH_MOUNT_ADMIN },
+	{ "POLICY_ADMIN", HDN_AUTH_POLICY_ADMIN },
+	{ "NAMESPACE_ADMIN", HDN_AUTH_NAMESPACE_ADMIN },
+	{ "CRED_CHANGE", HDN_AUTH_CRED_CHANGE },
+	{ "CHROOT_ADMIN", HDN_AUTH_CHROOT_ADMIN },
+	{ "TRUSTED_EXEC_BYPASS", HDN_AUTH_TRUSTED_EXEC_BYPASS },
+	{ "IPC_ADMIN", HDN_AUTH_IPC_ADMIN },
+	{ "TTY_INJECT", HDN_AUTH_TTY_INJECT },
+	{ "TTY_ACCESS", HDN_AUTH_TTY_ACCESS },
+	{ "FUSE_MOUNT", HDN_AUTH_FUSE_MOUNT },
+	{ "ROFS_RELAX", HDN_AUTH_ROFS_RELAX },
+	{ "USB_ATTACH", HDN_AUTH_USB_ATTACH },
+	{ "USB_MONITOR", HDN_AUTH_USB_MONITOR },
+	{ "SOCKET_CREATE", HDN_AUTH_SOCKET_CREATE },
+	{ "SOCKET_CONNECT", HDN_AUTH_SOCKET_CONNECT },
+	{ "SOCKET_SERVER", HDN_AUTH_SOCKET_SERVER },
+	{ "PROC_TASK_VIEW", HDN_AUTH_PROC_TASK_VIEW },
+	{ "TIME_ADMIN", HDN_AUTH_TIME_ADMIN },
+	{ "RESOURCE_ADMIN", HDN_AUTH_RESOURCE_ADMIN },
+	{ "BLOCK_DEVICE_ACCESS", HDN_AUTH_BLOCK_DEVICE_ACCESS },
+	{ "BLOCK_DEVICE_ADMIN", HDN_AUTH_BLOCK_DEVICE_ADMIN },
+	{ "SIGNAL", HDN_AUTH_SIGNAL },
+	{ "PROCESS_MEMORY", HDN_AUTH_PROCESS_MEMORY },
+	{ "MEMORY_MIGRATE", HDN_AUTH_MEMORY_MIGRATE },
+	{ "PROCESS_FD", HDN_AUTH_PROCESS_FD },
+};
+
+static const struct name_value memory_flag_names[] = {
+	{ "ALLOW_WX", HDN_MEM_ALLOW_WX },
+	{ "ALLOW_EXEC_AFTER_WRITE", HDN_MEM_ALLOW_EXEC_AFTER_WRITE },
+	{ "ALLOW_FIXED_ANON_EXEC", HDN_MEM_ALLOW_FIXED_ANON_EXEC },
+	{ "ALLOW_READ_IMPLIES_EXEC", HDN_MEM_ALLOW_READ_IMPLIES_EXEC },
+	{ "ALLOW_JIT_EXEC_AFTER_WRITE", HDN_MEM_ALLOW_JIT_EXEC_AFTER_WRITE },
+	{ "ALLOW_EXEC_STACK_ELF", HDN_MEM_ALLOW_EXEC_STACK_ELF },
+	{ "ALLOW_TEXTREL_MPROTECT", HDN_MEM_ALLOW_TEXTREL_MPROTECT },
+	{ "ALLOW_RELRO_WRITE", HDN_MEM_ALLOW_RELRO_WRITE },
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s BASE.policy LEARN.frag OUTPUT.policy\n"
+		"\n"
+		"Appends reviewed hdn-policy-learn allow/mem suggestions to a\n"
+		"candidate policy file without rewriting the base policy.\n",
+		prog);
+}
+
+static void normalize_token(const char *input, char *output, size_t size)
+{
+	size_t i;
+
+	for (i = 0; i + 1 < size && input[i]; i++) {
+		unsigned char c = input[i];
+
+		output[i] = c == '-' ? '_' : (char)toupper(c);
+	}
+	output[i] = '\0';
+
+	if (!strncmp(output, "HDN_AUTH_", 9))
+		memmove(output, output + 9, strlen(output + 9) + 1);
+	else if (!strncmp(output, "AUTH_", 5))
+		memmove(output, output + 5, strlen(output + 5) + 1);
+	else if (!strncmp(output, "HDN_MEM_", 8))
+		memmove(output, output + 8, strlen(output + 8) + 1);
+	else if (!strncmp(output, "MEM_", 4))
+		memmove(output, output + 4, strlen(output + 4) + 1);
+}
+
+static int parse_u64(const char *text, uint64_t *value)
+{
+	char *end;
+	unsigned long long parsed;
+
+	errno = 0;
+	parsed = strtoull(text, &end, 0);
+	if (errno || end == text || *end)
+		return -EINVAL;
+
+	*value = parsed;
+	return 0;
+}
+
+static int lookup_name(const struct name_value *names, size_t count,
+		       const char *text, uint64_t *value)
+{
+	char normalized[64];
+	size_t i;
+
+	normalize_token(text, normalized, sizeof(normalized));
+	for (i = 0; i < count; i++) {
+		if (!strcmp(normalized, names[i].name)) {
+			*value = names[i].value;
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+static const char *value_name(const struct name_value *names, size_t count,
+			      uint64_t value)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		if (names[i].value == value)
+			return names[i].name;
+	}
+
+	return "UNKNOWN";
+}
+
+static struct hdn_merge_profile *
+find_profile(struct hdn_merge_profile *profiles, uint64_t id)
+{
+	size_t i;
+
+	for (i = 0; i < HDN_MAX_PROFILES; i++) {
+		if (profiles[i].present && profiles[i].id == id)
+			return &profiles[i];
+	}
+
+	return NULL;
+}
+
+static int add_profile(struct hdn_merge_profile *profiles, uint64_t id)
+{
+	size_t i;
+
+	if (!id)
+		return -EINVAL;
+	if (find_profile(profiles, id))
+		return 0;
+
+	for (i = 0; i < HDN_MAX_PROFILES; i++) {
+		if (!profiles[i].present) {
+			profiles[i].present = true;
+			profiles[i].id = id;
+			return 0;
+		}
+	}
+
+	return -ENOSPC;
+}
+
+static int parse_profile_line(struct hdn_merge_profile *profiles, char *save,
+			      unsigned int line_number)
+{
+	char *id_text;
+	uint64_t id;
+	int ret;
+
+	id_text = strtok_r(NULL, " \t\r\n", &save);
+	if (!id_text) {
+		fprintf(stderr, "%u: profile needs an ID\n", line_number);
+		return -EINVAL;
+	}
+
+	ret = parse_u64(id_text, &id);
+	if (ret) {
+		fprintf(stderr, "%u: invalid profile ID '%s'\n",
+			line_number, id_text);
+		return ret;
+	}
+
+	ret = add_profile(profiles, id);
+	if (ret)
+		fprintf(stderr, "%u: could not add profile %llu: %s\n",
+			line_number, (unsigned long long)id, strerror(-ret));
+	return ret;
+}
+
+static int add_authority_mask(uint64_t authority, uint64_t *mask,
+			      uint64_t *mask_hi)
+{
+	if (!authority || authority >= HDN_AUTH__MAX ||
+	    authority >= HDN_AUTHORITY_MAX_BITS)
+		return -EINVAL;
+
+	if (HDN_AUTHORITY_WORD(authority) == 0)
+		*mask |= HDN_AUTHORITY_MASK(authority);
+	else if (HDN_AUTHORITY_WORD(authority) == 1)
+		*mask_hi |= HDN_AUTHORITY_MASK(authority);
+	else
+		return -EINVAL;
+
+	return 0;
+}
+
+static bool authority_mask_contains(uint64_t mask, uint64_t mask_hi,
+				    uint64_t authority)
+{
+	if (authority >= HDN_AUTH__MAX || authority >= HDN_AUTHORITY_MAX_BITS)
+		return false;
+	if (HDN_AUTHORITY_WORD(authority) == 0)
+		return mask & HDN_AUTHORITY_MASK(authority);
+	if (HDN_AUTHORITY_WORD(authority) == 1)
+		return mask_hi & HDN_AUTHORITY_MASK(authority);
+	return false;
+}
+
+static int parse_mask_tokens(const struct name_value *names, size_t name_count,
+			     char *save, uint64_t *id, uint64_t *mask,
+			     uint64_t *mask_hi, unsigned int line_number)
+{
+	char *id_text;
+	char *name;
+	int ret;
+
+	*mask = 0;
+	if (mask_hi)
+		*mask_hi = 0;
+	id_text = strtok_r(NULL, " \t\r\n", &save);
+	if (!id_text) {
+		fprintf(stderr, "%u: suggestion needs profile ID\n",
+			line_number);
+		return -EINVAL;
+	}
+
+	ret = parse_u64(id_text, id);
+	if (ret) {
+		fprintf(stderr, "%u: invalid profile ID '%s'\n",
+			line_number, id_text);
+		return ret;
+	}
+
+	name = strtok_r(NULL, " \t\r\n", &save);
+	if (!name) {
+		fprintf(stderr, "%u: suggestion needs at least one token\n",
+			line_number);
+		return -EINVAL;
+	}
+
+	while (name) {
+		uint64_t value;
+
+		ret = lookup_name(names, name_count, name, &value);
+		if (ret) {
+			fprintf(stderr, "%u: unknown token '%s'\n",
+				line_number, name);
+			return ret;
+		}
+		if (names == authority_names) {
+			ret = add_authority_mask(value, mask, mask_hi);
+			if (ret)
+				return ret;
+		} else {
+			*mask |= value;
+		}
+		name = strtok_r(NULL, " \t\r\n", &save);
+	}
+
+	return 0;
+}
+
+static int parse_base_line(struct hdn_merge_profile *profiles, char *line,
+			   unsigned int line_number)
+{
+	struct hdn_merge_profile *profile;
+	char *comment;
+	char *command;
+	char *save = NULL;
+	uint64_t id;
+	uint64_t mask;
+	uint64_t mask_hi = 0;
+	int ret;
+
+	comment = strchr(line, '#');
+	if (comment)
+		*comment = '\0';
+
+	command = strtok_r(line, " \t\r\n", &save);
+	if (!command)
+		return 0;
+
+	if (!strcmp(command, "profile"))
+		return parse_profile_line(profiles, save, line_number);
+	if (strcmp(command, "allow") && strcmp(command, "mem"))
+		return 0;
+
+	if (!strcmp(command, "allow"))
+		ret = parse_mask_tokens(authority_names,
+					ARRAY_SIZE(authority_names), save, &id,
+					&mask, &mask_hi, line_number);
+	else
+		ret = parse_mask_tokens(memory_flag_names,
+					ARRAY_SIZE(memory_flag_names), save, &id,
+					&mask, NULL, line_number);
+	if (ret)
+		return ret;
+
+	profile = find_profile(profiles, id);
+	if (!profile) {
+		fprintf(stderr, "%u: unknown profile %llu\n", line_number,
+			(unsigned long long)id);
+		return -ENOENT;
+	}
+
+	if (!strcmp(command, "allow")) {
+		profile->authority_allow |= mask;
+		profile->authority_allow_hi |= mask_hi;
+	} else {
+		profile->memory_flags |= mask;
+	}
+	return 0;
+}
+
+static int parse_base_policy(const char *path,
+			     struct hdn_merge_profile *profiles)
+{
+	char line[4096];
+	unsigned int line_number = 0;
+	FILE *file;
+	int ret = 0;
+
+	file = fopen(path, "r");
+	if (!file) {
+		fprintf(stderr, "hdn-policy-merge: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	while (fgets(line, sizeof(line), file)) {
+		line_number++;
+		ret = parse_base_line(profiles, line, line_number);
+		if (ret)
+			break;
+	}
+
+	if (ferror(file) && !ret)
+		ret = -EIO;
+	fclose(file);
+	return ret;
+}
+
+static int parse_suggestion_line(struct hdn_merge_profile *profiles, char *line,
+				 unsigned int line_number)
+{
+	struct hdn_merge_profile *profile;
+	char *comment;
+	char *command;
+	char *save = NULL;
+	uint64_t id;
+	uint64_t mask;
+	uint64_t mask_hi = 0;
+	int ret;
+
+	comment = strchr(line, '#');
+	if (comment)
+		*comment = '\0';
+
+	command = strtok_r(line, " \t\r\n", &save);
+	if (!command)
+		return 0;
+
+	if (strcmp(command, "allow") && strcmp(command, "mem")) {
+		fprintf(stderr, "%u: unsupported merge command '%s'\n",
+			line_number, command);
+		return -EINVAL;
+	}
+
+	if (!strcmp(command, "allow"))
+		ret = parse_mask_tokens(authority_names,
+					ARRAY_SIZE(authority_names), save, &id,
+					&mask, &mask_hi, line_number);
+	else
+		ret = parse_mask_tokens(memory_flag_names,
+					ARRAY_SIZE(memory_flag_names), save, &id,
+					&mask, NULL, line_number);
+	if (ret)
+		return ret;
+
+	profile = find_profile(profiles, id);
+	if (!profile) {
+		fprintf(stderr, "%u: suggestion references unknown profile %llu\n",
+			line_number, (unsigned long long)id);
+		return -ENOENT;
+	}
+
+	if (!strcmp(command, "allow")) {
+		mask &= ~profile->authority_allow;
+		mask_hi &= ~profile->authority_allow_hi;
+		profile->suggested_authority_allow |= mask;
+		profile->suggested_authority_allow_hi |= mask_hi;
+		profile->authority_allow |= mask;
+		profile->authority_allow_hi |= mask_hi;
+	} else {
+		mask &= ~profile->memory_flags;
+		profile->suggested_memory_flags |= mask;
+		profile->memory_flags |= mask;
+	}
+
+	return 0;
+}
+
+static int parse_suggestions(const char *path,
+			     struct hdn_merge_profile *profiles)
+{
+	char line[4096];
+	unsigned int line_number = 0;
+	FILE *file;
+	int ret = 0;
+
+	file = fopen(path, "r");
+	if (!file) {
+		fprintf(stderr, "hdn-policy-merge: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	while (fgets(line, sizeof(line), file)) {
+		line_number++;
+		ret = parse_suggestion_line(profiles, line, line_number);
+		if (ret)
+			break;
+	}
+
+	if (ferror(file) && !ret)
+		ret = -EIO;
+	fclose(file);
+	return ret;
+}
+
+static bool profile_has_suggestions(const struct hdn_merge_profile *profile)
+{
+	return profile->suggested_authority_allow ||
+	       profile->suggested_authority_allow_hi ||
+	       profile->suggested_memory_flags;
+}
+
+static unsigned int write_authority_line(FILE *out,
+					 const struct hdn_merge_profile *profile)
+{
+	unsigned int authority;
+	unsigned int count = 0;
+
+	if (!profile->suggested_authority_allow &&
+	    !profile->suggested_authority_allow_hi)
+		return 0;
+
+	fprintf(out, "allow %llu", (unsigned long long)profile->id);
+	for (authority = 1; authority < HDN_AUTH__MAX; authority++) {
+		if (authority_mask_contains(
+			    profile->suggested_authority_allow,
+			    profile->suggested_authority_allow_hi,
+			    authority)) {
+			fprintf(out, " %s",
+				value_name(authority_names,
+					   ARRAY_SIZE(authority_names),
+					   authority));
+			count++;
+		}
+	}
+	fprintf(out, "\n");
+	return count;
+}
+
+static unsigned int write_memory_line(FILE *out,
+				      const struct hdn_merge_profile *profile)
+{
+	unsigned int count = 0;
+	size_t i;
+
+	if (!profile->suggested_memory_flags)
+		return 0;
+
+	fprintf(out, "mem %llu", (unsigned long long)profile->id);
+	for (i = 0; i < ARRAY_SIZE(memory_flag_names); i++) {
+		if (profile->suggested_memory_flags & memory_flag_names[i].value) {
+			fprintf(out, " %s", memory_flag_names[i].name);
+			count++;
+		}
+	}
+	fprintf(out, "\n");
+	return count;
+}
+
+static int copy_base_policy(FILE *out, const char *path)
+{
+	char buf[4096];
+	size_t len;
+	int last = '\n';
+	FILE *in;
+
+	in = fopen(path, "r");
+	if (!in) {
+		fprintf(stderr, "hdn-policy-merge: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	while ((len = fread(buf, 1, sizeof(buf), in)) > 0) {
+		if (fwrite(buf, 1, len, out) != len) {
+			fclose(in);
+			return -EIO;
+		}
+		last = (unsigned char)buf[len - 1];
+		if (len < sizeof(buf))
+			break;
+	}
+
+	if (ferror(in)) {
+		fclose(in);
+		return -EIO;
+	}
+	fclose(in);
+
+	if (last != '\n')
+		fputc('\n', out);
+	return 0;
+}
+
+static int write_merged_policy(const char *base, const char *learn,
+			       const char *output,
+			       const struct hdn_merge_profile *profiles)
+{
+	unsigned int count = 0;
+	FILE *out;
+	size_t i;
+	int ret;
+
+	out = fopen(output, "w");
+	if (!out) {
+		fprintf(stderr, "hdn-policy-merge: cannot open %s: %s\n",
+			output, strerror(errno));
+		return -errno;
+	}
+
+	ret = copy_base_policy(out, base);
+	if (ret)
+		goto out_close;
+
+	fprintf(out, "\n# HDN_POLICY_MERGE_V1\n");
+	fprintf(out, "# source %s\n", learn);
+	fprintf(out, "# Review, compile, sign, and commit this candidate policy.\n");
+
+	for (i = 0; i < HDN_MAX_PROFILES; i++) {
+		if (!profiles[i].present || !profile_has_suggestions(&profiles[i]))
+			continue;
+		count += write_authority_line(out, &profiles[i]);
+		count += write_memory_line(out, &profiles[i]);
+	}
+	if (!count)
+		fprintf(out, "# no new allow/mem suggestions\n");
+
+out_close:
+	if (fclose(out) && !ret)
+		ret = -EIO;
+	return ret;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_merge_profile profiles[HDN_MAX_PROFILES] = {};
+	const char *base;
+	const char *learn;
+	const char *output;
+	int ret;
+
+	if (argc != 4 || !strcmp(argv[1], "--help")) {
+		usage(argv[0]);
+		return argc == 2 && !strcmp(argv[1], "--help") ? 0 : 2;
+	}
+
+	base = argv[1];
+	learn = argv[2];
+	output = argv[3];
+	if (!strcmp(base, output) || !strcmp(learn, output)) {
+		fprintf(stderr,
+			"hdn-policy-merge: output must not replace input files\n");
+		return 2;
+	}
+
+	ret = parse_base_policy(base, profiles);
+	if (ret)
+		return 2;
+	ret = parse_suggestions(learn, profiles);
+	if (ret)
+		return 2;
+	ret = write_merged_policy(base, learn, output, profiles);
+	if (ret)
+		return 2;
+
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-policy-workflow.c linux-7.0.12-hdn/tools/hardening/hdn-policy-workflow.c
--- linux-7.0.12/tools/hardening/hdn-policy-workflow.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-policy-workflow.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,674 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_POLICY_WORKFLOW_CONFIG
+#define HDN_POLICY_WORKFLOW_CONFIG "/etc/hdn/policy-workflows.conf"
+#endif
+
+#ifndef HDN_POLICY_LEARN_PATH
+#define HDN_POLICY_LEARN_PATH "/usr/libexec/hdn-policy-learn"
+#endif
+
+#ifndef HDN_POLICY_MERGE_PATH
+#define HDN_POLICY_MERGE_PATH "/usr/libexec/hdn-policy-merge"
+#endif
+
+#ifndef HDN_POLICY_COMPILER_PATH
+#define HDN_POLICY_COMPILER_PATH "/usr/libexec/hdn-policy"
+#endif
+
+#ifndef HDN_ADMIN_BROKER_PATH
+#define HDN_ADMIN_BROKER_PATH "/usr/libexec/hdn-admin-broker"
+#endif
+
+#define HDN_POLICY_WORKFLOW_MAX_RULES 64
+
+struct hdn_policy_workflow_rule {
+	char *name;
+	char *base_policy;
+	char *event_log;
+	char *suggestions;
+	char *candidate;
+	char *binary_policy;
+	char *signed_policy;
+};
+
+struct hdn_policy_workflow_config {
+	char *learn_helper;
+	char *merge_helper;
+	char *compiler_helper;
+	char *admin_broker;
+	struct hdn_policy_workflow_rule rules[HDN_POLICY_WORKFLOW_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--learn-helper PATH] [--merge-helper PATH] [--compiler-helper PATH] [--admin-broker PATH] learn WORKFLOW\n"
+		"       %s [--config FILE] [--learn-helper PATH] [--merge-helper PATH] [--compiler-helper PATH] [--admin-broker PATH] candidate WORKFLOW\n"
+		"       %s [--config FILE] [--learn-helper PATH] [--merge-helper PATH] [--compiler-helper PATH] [--admin-broker PATH] compile WORKFLOW\n"
+		"       %s [--config FILE] [--learn-helper PATH] [--merge-helper PATH] [--compiler-helper PATH] [--admin-broker PATH] [--dry-run] commit WORKFLOW\n"
+		"\n"
+		"Runs named policy learning, candidate-generation, compile, and brokered commit workflows.\n"
+		"Config lines:\n"
+		"  learn-helper PATH\n"
+		"  merge-helper PATH\n"
+		"  compiler-helper PATH\n"
+		"  admin-broker PATH\n"
+		"  workflow NAME BASE_POLICY EVENT_LOG SUGGESTIONS CANDIDATE_POLICY [BINARY_POLICY [SIGNED_POLICY]]\n",
+		prog, prog, prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-policy-workflow: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-policy-workflow: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-policy-workflow: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_helper(char **slot, const char *what, char **tokens,
+		      unsigned int count, unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-policy-workflow: %s line %u needs exactly one path\n",
+			what, lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute(what, tokens[1]))
+		return -EINVAL;
+	return replace_string(slot, tokens[1]);
+}
+
+static int add_workflow(struct hdn_policy_workflow_config *config,
+			char **tokens, unsigned int count, unsigned int lineno)
+{
+	struct hdn_policy_workflow_rule *rule;
+
+	if (count != 6 && count != 7 && count != 8) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow line %u needs NAME BASE EVENTS SUGGESTIONS CANDIDATE [BINARY [SIGNED]]\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_POLICY_WORKFLOW_MAX_RULES) {
+		fprintf(stderr,
+			"hdn-policy-workflow: too many workflow rules\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1])) {
+		fprintf(stderr,
+			"hdn-policy-workflow: unsafe workflow name at line %u: %s\n",
+			lineno, tokens[1]);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("base policy", tokens[2]) ||
+	    require_safe_absolute("event log", tokens[3]) ||
+	    require_safe_absolute("suggestions", tokens[4]) ||
+	    require_safe_absolute("candidate policy", tokens[5]))
+		return -EINVAL;
+	if (count == 7 && require_safe_absolute("binary policy", tokens[6]))
+		return -EINVAL;
+	if (count == 8 &&
+	    (require_safe_absolute("binary policy", tokens[6]) ||
+	     require_safe_absolute("signed policy", tokens[7])))
+		return -EINVAL;
+	if (!strcmp(tokens[2], tokens[3]) || !strcmp(tokens[2], tokens[4]) ||
+	    !strcmp(tokens[2], tokens[5]) || !strcmp(tokens[3], tokens[4]) ||
+	    !strcmp(tokens[3], tokens[5]) || !strcmp(tokens[4], tokens[5])) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow line %u reuses input/output paths\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (count >= 7 &&
+	    (!strcmp(tokens[6], tokens[2]) || !strcmp(tokens[6], tokens[3]) ||
+	     !strcmp(tokens[6], tokens[4]) || !strcmp(tokens[6], tokens[5]))) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow line %u reuses binary output path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (count == 8 &&
+	    (!strcmp(tokens[7], tokens[2]) || !strcmp(tokens[7], tokens[3]) ||
+	     !strcmp(tokens[7], tokens[4]) || !strcmp(tokens[7], tokens[5]) ||
+	     !strcmp(tokens[7], tokens[6]))) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow line %u reuses signed policy path\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->base_policy = strdup(tokens[2]);
+	rule->event_log = strdup(tokens[3]);
+	rule->suggestions = strdup(tokens[4]);
+	rule->candidate = strdup(tokens[5]);
+	if (count >= 7)
+		rule->binary_policy = strdup(tokens[6]);
+	if (count == 8)
+		rule->signed_policy = strdup(tokens[7]);
+	if (!rule->name || !rule->base_policy || !rule->event_log ||
+	    !rule->suggestions || !rule->candidate ||
+	    (count >= 7 && !rule->binary_policy) ||
+	    (count == 8 && !rule->signed_policy))
+		return -ENOMEM;
+
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_policy_workflow_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[8];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-policy-workflow: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "learn-helper"))
+		return set_helper(&config->learn_helper, "learn-helper",
+				  tokens, count, lineno);
+	if (!strcmp(tokens[0], "merge-helper"))
+		return set_helper(&config->merge_helper, "merge-helper",
+				  tokens, count, lineno);
+	if (!strcmp(tokens[0], "compiler-helper"))
+		return set_helper(&config->compiler_helper, "compiler-helper",
+				  tokens, count, lineno);
+	if (!strcmp(tokens[0], "admin-broker"))
+		return set_helper(&config->admin_broker, "admin-broker",
+				  tokens, count, lineno);
+	if (!strcmp(tokens[0], "workflow"))
+		return add_workflow(config, tokens, count, lineno);
+
+	fprintf(stderr,
+		"hdn-policy-workflow: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-policy-workflow: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-policy-workflow: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-policy-workflow: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_policy_workflow_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->learn_helper, HDN_POLICY_LEARN_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->merge_helper, HDN_POLICY_MERGE_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->compiler_helper, HDN_POLICY_COMPILER_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->admin_broker, HDN_ADMIN_BROKER_PATH);
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_policy_workflow_config *config)
+{
+	unsigned int i;
+
+	free(config->learn_helper);
+	free(config->merge_helper);
+	free(config->compiler_helper);
+	free(config->admin_broker);
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].base_policy);
+		free(config->rules[i].event_log);
+		free(config->rules[i].suggestions);
+		free(config->rules[i].candidate);
+		free(config->rules[i].binary_policy);
+		free(config->rules[i].signed_policy);
+	}
+}
+
+static const struct hdn_policy_workflow_rule *
+find_workflow(const struct hdn_policy_workflow_config *config,
+	      const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, name))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int wait_for_child(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 2;
+	if (!WIFEXITED(status))
+		return 2;
+	return WEXITSTATUS(status);
+}
+
+static int run_learn(const char *learn_helper,
+		     const struct hdn_policy_workflow_rule *rule)
+{
+	pid_t child;
+	int fd;
+
+	fd = open(rule->suggestions,
+		  O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-policy-workflow: cannot open %s: %s\n",
+			rule->suggestions, strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		close(fd);
+		return 2;
+	}
+
+	if (!child) {
+		if (dup2(fd, STDOUT_FILENO) < 0)
+			_exit(2);
+		close(fd);
+		execl(learn_helper, "hdn-policy-learn", "--input",
+		      rule->event_log, NULL);
+		fprintf(stderr, "hdn-policy-workflow: exec %s failed: %s\n",
+			learn_helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(fd);
+	return wait_for_child(child);
+}
+
+static int run_candidate(const char *merge_helper,
+			 const struct hdn_policy_workflow_rule *rule)
+{
+	execl(merge_helper, "hdn-policy-merge", rule->base_policy,
+	      rule->suggestions, rule->candidate, NULL);
+	fprintf(stderr, "hdn-policy-workflow: exec %s failed: %s\n",
+		merge_helper, strerror(errno));
+	return errno == ENOENT ? 127 : 126;
+}
+
+static int run_compile(const char *compiler_helper,
+		       const struct hdn_policy_workflow_rule *rule)
+{
+	if (!rule->binary_policy) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow has no binary policy output\n");
+		return 1;
+	}
+
+	execl(compiler_helper, "hdn-policy", rule->candidate,
+	      rule->binary_policy, NULL);
+	fprintf(stderr, "hdn-policy-workflow: exec %s failed: %s\n",
+		compiler_helper, strerror(errno));
+	return errno == ENOENT ? 127 : 126;
+}
+
+static int run_commit(const char *admin_broker, bool dry_run,
+		      const struct hdn_policy_workflow_rule *rule)
+{
+	if (!rule->signed_policy) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow has no signed policy input\n");
+		return 1;
+	}
+
+	if (dry_run)
+		execl(admin_broker, "hdn-admin-broker", "--dry-run",
+		      "policy-commit", rule->signed_policy, NULL);
+	else
+		execl(admin_broker, "hdn-admin-broker", "policy-commit",
+		      rule->signed_policy, NULL);
+	fprintf(stderr, "hdn-policy-workflow: exec %s failed: %s\n",
+		admin_broker, strerror(errno));
+	return errno == ENOENT ? 127 : 126;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_policy_workflow_config config;
+	const struct hdn_policy_workflow_rule *rule;
+	const char *config_path = HDN_POLICY_WORKFLOW_CONFIG;
+	const char *learn_helper_override = NULL;
+	const char *merge_helper_override = NULL;
+	const char *compiler_helper_override = NULL;
+	const char *admin_broker_override = NULL;
+	const char *command = NULL;
+	const char *workflow = NULL;
+	bool dry_run = false;
+	int i;
+	int ret;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--learn-helper")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			learn_helper_override = argv[i];
+		} else if (!strcmp(argv[i], "--merge-helper")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			merge_helper_override = argv[i];
+		} else if (!strcmp(argv[i], "--compiler-helper")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			compiler_helper_override = argv[i];
+		} else if (!strcmp(argv[i], "--admin-broker")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			admin_broker_override = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else {
+			command = argv[i];
+			if (++i < argc)
+				workflow = argv[i];
+			break;
+		}
+	}
+
+	if (!command || !workflow || i + 1 != argc ||
+	    (strcmp(command, "learn") && strcmp(command, "candidate") &&
+	     strcmp(command, "compile") && strcmp(command, "commit"))) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (dry_run && strcmp(command, "commit")) {
+		fprintf(stderr,
+			"hdn-policy-workflow: --dry-run is only valid with commit\n");
+		return 2;
+	}
+
+	if (!safe_name(workflow)) {
+		fprintf(stderr,
+			"hdn-policy-workflow: unsafe workflow name: %s\n",
+			workflow);
+		return 1;
+	}
+	if (require_safe_absolute("config", config_path))
+		return 1;
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	if (learn_helper_override) {
+		if (require_safe_absolute("learn-helper", learn_helper_override)) {
+			free_config(&config);
+			return 1;
+		}
+		ret = replace_string(&config.learn_helper, learn_helper_override);
+		if (ret) {
+			free_config(&config);
+			return 2;
+		}
+	}
+	if (compiler_helper_override) {
+		if (require_safe_absolute("compiler-helper",
+					  compiler_helper_override)) {
+			free_config(&config);
+			return 1;
+		}
+		ret = replace_string(&config.compiler_helper,
+				     compiler_helper_override);
+		if (ret) {
+			free_config(&config);
+			return 2;
+		}
+	}
+	if (admin_broker_override) {
+		if (require_safe_absolute("admin-broker",
+					  admin_broker_override)) {
+			free_config(&config);
+			return 1;
+		}
+		ret = replace_string(&config.admin_broker, admin_broker_override);
+		if (ret) {
+			free_config(&config);
+			return 2;
+		}
+	}
+	if (merge_helper_override) {
+		if (require_safe_absolute("merge-helper", merge_helper_override)) {
+			free_config(&config);
+			return 1;
+		}
+		ret = replace_string(&config.merge_helper, merge_helper_override);
+		if (ret) {
+			free_config(&config);
+			return 2;
+		}
+	}
+
+	rule = find_workflow(&config, workflow);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-policy-workflow: workflow not approved: %s\n",
+			workflow);
+		free_config(&config);
+		return 1;
+	}
+
+	if (!strcmp(command, "learn"))
+		ret = run_learn(config.learn_helper, rule);
+	else if (!strcmp(command, "candidate"))
+		ret = run_candidate(config.merge_helper, rule);
+	else if (!strcmp(command, "compile"))
+		ret = run_compile(config.compiler_helper, rule);
+	else
+		ret = run_commit(config.admin_broker, dry_run, rule);
+
+	free_config(&config);
+	return ret;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-policy.c linux-7.0.12-hdn/tools/hardening/hdn-policy.c
--- linux-7.0.12/tools/hardening/hdn-policy.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-policy.c	2026-07-15 15:05:14.989871342 -0500
@@ -0,0 +1,2615 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <ctype.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+#ifndef __user
+#define __user
+#endif
+#include <linux/capability.h>
+#include <linux/fsverity.h>
+#include <linux/hardening.h>
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+#define HDN_VERITY_DIGEST_MAX \
+	sizeof(((struct hdn_exec_rule_record *)0)->verity_digest)
+#define HDN_ROLE_NAME_LEN 64
+#define HDN_MAX_ROLES 128
+#define HDN_MAX_ROLE_USES 512
+#define HDN_MAX_ROLE_INCLUDES 512
+
+struct hdn_profile_builder {
+	struct hdn_profile_record record;
+	bool present;
+};
+
+struct hdn_role_builder {
+	uint64_t authority_allow;
+	uint64_t authority_allow_hi;
+	uint64_t authority_audit;
+	uint64_t authority_audit_hi;
+	uint64_t memory_flags;
+	uint64_t flags;
+	uint64_t capability_deny;
+	uint64_t capability_audit;
+	char name[HDN_ROLE_NAME_LEN];
+	bool present;
+	unsigned int visit_state;
+};
+
+struct hdn_role_use {
+	uint64_t profile_id;
+	unsigned int line;
+	char role_name[HDN_ROLE_NAME_LEN];
+};
+
+struct hdn_role_include {
+	unsigned int line;
+	char role_name[HDN_ROLE_NAME_LEN];
+	char parent_name[HDN_ROLE_NAME_LEN];
+};
+
+struct hdn_policy_builder {
+	uint32_t required_capabilities;
+	struct hdn_profile_builder profiles[HDN_MAX_PROFILES];
+	struct hdn_role_builder roles[HDN_MAX_ROLES];
+	struct hdn_role_use role_uses[HDN_MAX_ROLE_USES];
+	struct hdn_role_include role_includes[HDN_MAX_ROLE_INCLUDES];
+	struct hdn_subject_rule_record subject_rules[HDN_MAX_SUBJECT_RULES];
+	struct hdn_object_rule_record object_rules[HDN_MAX_OBJECT_RULES];
+	struct hdn_exec_rule_record exec_rules[HDN_MAX_EXEC_RULES];
+	struct hdn_module_rule_record module_rules[HDN_MAX_MODULE_RULES];
+	struct hdn_firmware_rule_record firmware_rules[HDN_MAX_FIRMWARE_RULES];
+	struct hdn_resource_rule_record resource_rules[HDN_MAX_RESOURCE_RULES];
+	uint32_t role_use_count;
+	uint32_t role_include_count;
+	uint32_t subject_rule_count;
+	uint32_t object_rule_count;
+	uint32_t exec_rule_count;
+	uint32_t module_rule_count;
+	uint32_t firmware_rule_count;
+	uint32_t resource_rule_count;
+};
+
+struct name_value {
+	const char *name;
+	uint64_t value;
+};
+
+static const struct name_value invariant_names[] = {
+#define HDN_CAP_NAME(symbol, name) { #name, HDN_CAP_REQUIRED(HDN_CAP_##symbol) },
+	HDN_CAPABILITY_LIST(HDN_CAP_NAME)
+#undef HDN_CAP_NAME
+};
+
+static const struct name_value authority_names[] = {
+	{ "EXEC", HDN_AUTH_EXEC },
+	{ "MMAP", HDN_AUTH_MMAP },
+	{ "MPROTECT", HDN_AUTH_MPROTECT },
+	{ "BPF_LOAD", HDN_AUTH_BPF_LOAD },
+	{ "PERF_OPEN", HDN_AUTH_PERF_OPEN },
