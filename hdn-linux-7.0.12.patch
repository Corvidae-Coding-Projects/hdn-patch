+static int parse_module_options(struct hdn_module_rule_record *rule,
+				char *name, char **save, unsigned int line)
+{
+	int ret;
+
+	while (name) {
+		if (!strcmp(name, "signed")) {
+			if (rule->flags & HDN_MODULE_MATCH_TRUSTED_SIGNATURE) {
+				fprintf(stderr,
+					"%u: duplicate module signed option\n", line);
+				return -EEXIST;
+			}
+			rule->flags |= HDN_MODULE_MATCH_TRUSTED_SIGNATURE;
+		} else if (!strcmp(name, "verity")) {
+			char *algorithm = strtok_r(NULL, " \t\r\n", save);
+			char *digest = strtok_r(NULL, " \t\r\n", save);
+
+			if (!algorithm || !digest) {
+				fprintf(stderr,
+					"%u: module verity needs algorithm and hex digest\n",
+					line);
+				return -EINVAL;
+			}
+			ret = set_module_verity(rule, algorithm, digest);
+			if (ret) {
+				fprintf(stderr,
+					"%u: invalid module verity digest\n",
+					line);
+				return ret;
+			}
+		} else {
+			fprintf(stderr, "%u: unknown module option '%s'\n",
+				line, name);
+			return -EINVAL;
+		}
+
+		name = strtok_r(NULL, " \t\r\n", save);
+	}
+
+	return 0;
+}
+
+static int parse_module_command(struct hdn_policy_builder *builder, char *save,
+				unsigned int line)
+{
+	struct hdn_module_rule_record *rule;
+	char *profile_text;
+	char *mode;
+	char *name;
+	uint64_t profile_id;
+	int ret;
+
+	if (builder->module_rule_count >= HDN_MAX_MODULE_RULES)
+		return -ENOSPC;
+
+	profile_text = strtok_r(NULL, " \t\r\n", &save);
+	mode = strtok_r(NULL, " \t\r\n", &save);
+	if (!profile_text || !mode) {
+		fprintf(stderr, "%u: module needs profile ID and match mode\n",
+			line);
+		return -EINVAL;
+	}
+
+	ret = parse_u64(profile_text, &profile_id);
+	if (ret)
+		return ret;
+	if (!find_profile(builder->profiles, profile_id)) {
+		fprintf(stderr, "%u: unknown module profile %llu\n",
+			line, (unsigned long long)profile_id);
+		return -ENOENT;
+	}
+
+	rule = &builder->module_rules[builder->module_rule_count];
+	memset(rule, 0, sizeof(*rule));
+	rule->profile_id = profile_id;
+
+	if (!strcmp(mode, "path")) {
+		name = strtok_r(NULL, " \t\r\n", &save);
+		if (!name)
+			return -EINVAL;
+		ret = set_module_path(rule, name);
+		if (ret) {
+			fprintf(stderr, "%u: invalid module path '%s': %s\n",
+				line, name, strerror(-ret));
+			return ret;
+		}
+		name = strtok_r(NULL, " \t\r\n", &save);
+	} else if (!strcmp(mode, "inode")) {
+		ret = parse_module_identity_tokens(rule, &save, line);
+		if (ret)
+			return ret;
+		name = strtok_r(NULL, " \t\r\n", &save);
+	} else if (!strcmp(mode, "verity")) {
+		char *algorithm = strtok_r(NULL, " \t\r\n", &save);
+		char *digest = strtok_r(NULL, " \t\r\n", &save);
+
+		if (!algorithm || !digest) {
+			fprintf(stderr,
+				"%u: module verity needs algorithm and hex digest\n",
+				line);
+			return -EINVAL;
+		}
+		ret = set_module_verity(rule, algorithm, digest);
+		if (ret) {
+			fprintf(stderr, "%u: invalid module verity digest\n",
+				line);
+			return ret;
+		}
+		name = strtok_r(NULL, " \t\r\n", &save);
+	} else if (!strcmp(mode, "signed")) {
+		rule->flags |= HDN_MODULE_MATCH_TRUSTED_SIGNATURE;
+		name = strtok_r(NULL, " \t\r\n", &save);
+	} else {
+		fprintf(stderr, "%u: unknown module match mode '%s'\n",
+			line, mode);
+		return -EINVAL;
+	}
+
+	ret = parse_module_options(rule, name, &save, line);
+	if (ret)
+		return ret;
+
+	builder->module_rule_count++;
+	return 0;
+}
+
+static int parse_firmware_command(struct hdn_policy_builder *builder,
+				  char *save, unsigned int line)
+{
+	struct hdn_firmware_rule_record *rule;
+	char *profile_text;
+	char *mode;
+	char *name;
+	uint64_t profile_id;
+	int ret;
+
+	if (builder->firmware_rule_count >= HDN_MAX_FIRMWARE_RULES)
+		return -ENOSPC;
+
+	profile_text = strtok_r(NULL, " \t\r\n", &save);
+	mode = strtok_r(NULL, " \t\r\n", &save);
+	name = strtok_r(NULL, " \t\r\n", &save);
+	if (!profile_text || !mode ||
+	    (strcmp(mode, "name") && strcmp(mode, "any")) ||
+	    (!strcmp(mode, "name") && !name) ||
+	    (!strcmp(mode, "any") && name)) {
+		fprintf(stderr,
+			"%u: firmware needs profile ID and name <firmware> or any\n",
+			line);
+		return -EINVAL;
+	}
+	if (name && strtok_r(NULL, " \t\r\n", &save)) {
+		fprintf(stderr, "%u: firmware name may not contain spaces\n",
+			line);
+		return -EINVAL;
+	}
+	if (name && strlen(name) >= HDN_FIRMWARE_NAME_LEN) {
+		fprintf(stderr, "%u: firmware name is too long\n", line);
+		return -ENAMETOOLONG;
+	}
+
+	ret = parse_u64(profile_text, &profile_id);
+	if (ret)
+		return ret;
+	if (!find_profile(builder->profiles, profile_id)) {
+		fprintf(stderr, "%u: unknown firmware profile %llu\n",
+			line, (unsigned long long)profile_id);
+		return -ENOENT;
+	}
+
+	rule = &builder->firmware_rules[builder->firmware_rule_count];
+	memset(rule, 0, sizeof(*rule));
+	rule->profile_id = profile_id;
+	if (!strcmp(mode, "any"))
+		rule->flags = HDN_FIRMWARE_MATCH_ANY;
+	else
+		snprintf(rule->name, sizeof(rule->name), "%s", name);
+	builder->firmware_rule_count++;
+	return 0;
+}
+
+static int parse_id_command(uint64_t *value, char *save, unsigned int line,
+			    const char *command)
+{
+	char *id_text = strtok_r(NULL, " \t\r\n", &save);
+	int ret;
+
+	if (!id_text) {
+		fprintf(stderr, "%u: %s needs profile ID\n", line, command);
+		return -EINVAL;
+	}
+
+	ret = parse_u64(id_text, value);
+	if (ret)
+		fprintf(stderr, "%u: invalid %s ID '%s'\n", line, command,
+			id_text);
+
+	return ret;
+}
+
+static int parse_subject_command(struct hdn_policy_builder *builder,
+				 char *save, unsigned int line)
+{
+	struct hdn_subject_rule_record *rule;
+	char *kind;
+	char *id_text;
+	char *profile_text;
+	uint64_t id;
+	uint64_t profile_id;
+	int ret;
+
+	if (builder->subject_rule_count >= HDN_MAX_SUBJECT_RULES) {
+		fprintf(stderr, "%u: too many subject rules\n", line);
+		return -E2BIG;
+	}
+
+	kind = strtok_r(NULL, " \t\r\n", &save);
+	id_text = strtok_r(NULL, " \t\r\n", &save);
+	profile_text = strtok_r(NULL, " \t\r\n", &save);
+	if (!kind || !id_text || !profile_text ||
+	    strtok_r(NULL, " \t\r\n", &save)) {
+		fprintf(stderr,
+			"%u: subject needs uid|gid ID PROFILE\n", line);
+		return -EINVAL;
+	}
+
+	ret = parse_u64(id_text, &id);
+	if (ret || id > UINT32_MAX) {
+		fprintf(stderr, "%u: invalid subject ID '%s'\n", line,
+			id_text);
+		return -EINVAL;
+	}
+
+	ret = parse_u64(profile_text, &profile_id);
+	if (ret) {
+		fprintf(stderr, "%u: invalid subject profile '%s'\n", line,
+			profile_text);
+		return -EINVAL;
+	}
+	if (!find_profile(builder->profiles, profile_id)) {
+		fprintf(stderr, "%u: unknown subject profile %llu\n", line,
+			(unsigned long long)profile_id);
+		return -EINVAL;
+	}
+
+	rule = &builder->subject_rules[builder->subject_rule_count];
+	memset(rule, 0, sizeof(*rule));
+	rule->profile_id = profile_id;
+	rule->id = (uint32_t)id;
+	if (!strcmp(kind, "uid"))
+		rule->flags = HDN_SUBJECT_MATCH_UID;
+	else if (!strcmp(kind, "gid"))
+		rule->flags = HDN_SUBJECT_MATCH_GID;
+	else {
+		fprintf(stderr, "%u: unknown subject kind '%s'\n", line,
+			kind);
+		return -EINVAL;
+	}
+
+	builder->subject_rule_count++;
+	return 0;
+}
+
+static int parse_line(struct hdn_policy_builder *builder,
+		      uint64_t *generation, uint64_t *default_profile,
+		      uint64_t *privileged_profile,
+		      uint64_t *expected_generation, char *line,
+		      unsigned int line_number)
+{
+	char *comment;
+	char *command;
+	char *save = NULL;
+
+	comment = strchr(line, '#');
+	if (comment)
+		*comment = '\0';
+
+	command = strtok_r(line, " \t\r\n", &save);
+	if (!command)
+		return 0;
+
+	if (!strcmp(command, "require-capability")) {
+		char *name = strtok_r(NULL, " \t\r\n", &save);
+
+		if (name && !strtok_r(NULL, " \t\r\n", &save)) {
+			for (size_t i = 0; i < ARRAY_SIZE(invariant_names); i++) {
+				if (!strcmp(name, invariant_names[i].name)) {
+					if (builder->required_capabilities &
+					    invariant_names[i].value) {
+						fprintf(stderr,
+							"%u: duplicate required capability: %s\n",
+							line_number, name);
+						return -EINVAL;
+					}
+					builder->required_capabilities |= invariant_names[i].value;
+					return 0;
+				}
+			}
+		}
+		fprintf(stderr, "%u: require-capability needs one known invariant\n", line_number);
+		return -EINVAL;
+	}
+	if (!strcmp(command, "generation"))
+		return parse_id_command(generation, save, line_number,
+					command);
+	if (!strcmp(command, "base"))
+		return parse_id_command(expected_generation, save, line_number,
+					command);
+	if (!strcmp(command, "default"))
+		return parse_id_command(default_profile, save, line_number,
+					command);
+	if (!strcmp(command, "privileged"))
+		return parse_id_command(privileged_profile, save, line_number,
+					command);
+	if (!strcmp(command, "profile"))
+		return parse_profile_command(builder->profiles, save,
+					     line_number);
+	if (!strcmp(command, "role"))
+		return parse_role_command(builder, save, line_number);
+	if (!strcmp(command, "use-role") || !strcmp(command, "profile-role"))
+		return parse_role_use_command(builder, save, line_number);
+	if (!strcmp(command, "allow"))
+		return parse_mask_command(builder->profiles, save, line_number,
+					  false);
+	if (!strcmp(command, "audit"))
+		return parse_mask_command(builder->profiles, save, line_number,
+					  true);
+	if (!strcmp(command, "capability-deny") ||
+	    !strcmp(command, "cap-deny"))
+		return parse_capability_command(builder->profiles, save, line_number,
+						false);
+	if (!strcmp(command, "capability-audit") ||
+	    !strcmp(command, "cap-audit"))
+		return parse_capability_command(builder->profiles, save, line_number,
+						true);
+	if (!strcmp(command, "mem"))
+		return parse_mem_command(builder->profiles, save, line_number);
+	if (!strcmp(command, "response"))
+		return parse_profile_flag_command(builder->profiles, save,
+						  line_number, command);
+	if (!strcmp(command, "feature"))
+		return parse_profile_flag_command(builder->profiles, save,
+						  line_number, command);
+	if (!strcmp(command, "umask") || !strcmp(command, "profile-umask"))
+		return parse_umask_command(builder->profiles, save,
+					   line_number);
+	if (!strcmp(command, "userns-max"))
+		return parse_userns_max_command(builder->profiles, save,
+						line_number);
+	if (!strcmp(command, "resource") || !strcmp(command, "rlimit"))
+		return parse_resource_command(builder, save, line_number);
+	if (!strcmp(command, "subject"))
+		return parse_subject_command(builder, save, line_number);
+	if (!strcmp(command, "object"))
+		return parse_object_command(builder, save, line_number);
+	if (!strcmp(command, "exec"))
+		return parse_exec_command(builder, save, line_number);
+	if (!strcmp(command, "module"))
+		return parse_module_command(builder, save, line_number);
+	if (!strcmp(command, "firmware"))
+		return parse_firmware_command(builder, save, line_number);
+
+	fprintf(stderr, "%u: unknown command '%s'\n", line_number, command);
+	return -EINVAL;
+}
+
+static int read_policy(const char *path, struct hdn_policy_builder *builder,
+		       uint64_t *generation, uint64_t *default_profile,
+		       uint64_t *privileged_profile,
+		       uint64_t *expected_generation)
+{
+	char line[4096];
+	unsigned int line_number = 0;
+	FILE *file;
+	int ret = 0;
+
+	file = fopen(path, "r");
+	if (!file) {
+		perror(path);
+		return -errno;
+	}
+
+	while (fgets(line, sizeof(line), file)) {
+		line_number++;
+		ret = parse_line(builder, generation, default_profile,
+				 privileged_profile, expected_generation, line,
+				 line_number);
+		if (ret)
+			break;
+	}
+
+	if (ferror(file) && !ret) {
+		perror(path);
+		ret = -EIO;
+	}
+
+	fclose(file);
+	return ret;
+}
+
+static void merge_role(struct hdn_role_builder *role,
+		       const struct hdn_role_builder *parent)
+{
+	role->authority_allow |= parent->authority_allow;
+	role->authority_allow_hi |= parent->authority_allow_hi;
+	role->authority_audit |= parent->authority_audit;
+	role->authority_audit_hi |= parent->authority_audit_hi;
+	role->memory_flags |= parent->memory_flags;
+	role->flags |= parent->flags;
+	role->capability_deny |= parent->capability_deny;
+	role->capability_audit |= parent->capability_audit;
+}
+
+static int expand_role(struct hdn_policy_builder *builder, size_t index)
+{
+	struct hdn_role_builder *role = &builder->roles[index];
+	uint32_t i;
+	int ret;
+	int parent_index;
+
+	if (role->visit_state == 2)
+		return 0;
+	if (role->visit_state == 1) {
+		fprintf(stderr, "role include cycle involving '%s'\n",
+			role->name);
+		return -EINVAL;
+	}
+
+	role->visit_state = 1;
+	for (i = 0; i < builder->role_include_count; i++) {
+		const struct hdn_role_include *include =
+			&builder->role_includes[i];
+
+		if (strcmp(include->role_name, role->name))
+			continue;
+
+		parent_index = find_role_index(builder->roles,
+					       include->parent_name);
+		if (parent_index < 0) {
+			fprintf(stderr, "%u: unknown included role '%s'\n",
+				include->line, include->parent_name);
+			return -ENOENT;
+		}
+
+		ret = expand_role(builder, (size_t)parent_index);
+		if (ret)
+			return ret;
+		merge_role(role, &builder->roles[parent_index]);
+	}
+	role->visit_state = 2;
+
+	return 0;
+}
+
+static int expand_roles(struct hdn_policy_builder *builder)
+{
+	size_t i;
+	int ret;
+
+	for (i = 0; i < HDN_MAX_ROLES; i++)
+		builder->roles[i].visit_state = 0;
+
+	for (i = 0; i < HDN_MAX_ROLES; i++) {
+		if (!builder->roles[i].present)
+			continue;
+		ret = expand_role(builder, i);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int apply_role_uses(struct hdn_policy_builder *builder)
+{
+	uint32_t i;
+
+	for (i = 0; i < builder->role_use_count; i++) {
+		const struct hdn_role_use *role_use = &builder->role_uses[i];
+		struct hdn_profile_builder *profile;
+		struct hdn_role_builder *role;
+
+		profile = find_profile(builder->profiles, role_use->profile_id);
+		if (!profile) {
+			fprintf(stderr, "%u: unknown use-role profile %llu\n",
+				role_use->line,
+				(unsigned long long)role_use->profile_id);
+			return -ENOENT;
+		}
+
+		role = find_role(builder->roles, role_use->role_name);
+		if (!role) {
+			fprintf(stderr, "%u: unknown role '%s'\n",
+				role_use->line, role_use->role_name);
+			return -ENOENT;
+		}
+
+		profile->record.authority_allow |= role->authority_allow;
+		profile->record.authority_allow_hi |= role->authority_allow_hi;
+		profile->record.authority_audit |= role->authority_audit;
+		profile->record.authority_audit_hi |= role->authority_audit_hi;
+		profile->record.memory_flags |= role->memory_flags;
+		profile->record.flags |= role->flags;
+		profile->record.capability_deny |= role->capability_deny;
+		profile->record.capability_audit |= role->capability_audit;
+	}
+
+	return 0;
+}
+
+static int build_records(const struct hdn_profile_builder *profiles,
+			 struct hdn_profile_record *records, uint32_t *count)
+{
+	size_t i;
+
+	*count = 0;
+	for (i = 0; i < HDN_MAX_PROFILES; i++) {
+		if (!profiles[i].present)
+			continue;
+		records[*count] = profiles[i].record;
+		(*count)++;
+	}
+
+	return *count ? 0 : -EINVAL;
+}
+
+static int write_policy(const char *path,
+			const struct hdn_profile_record *records,
+			uint32_t count,
+			const struct hdn_subject_rule_record *subject_rules,
+			uint32_t subject_rule_count,
+			const struct hdn_object_rule_record *object_rules,
+			uint32_t object_rule_count,
+			const struct hdn_exec_rule_record *exec_rules,
+			uint32_t exec_rule_count,
+			const struct hdn_module_rule_record *module_rules,
+			uint32_t module_rule_count,
+			const struct hdn_firmware_rule_record *firmware_rules,
+			uint32_t firmware_rule_count,
+			const struct hdn_resource_rule_record *resource_rules,
+			uint32_t resource_rule_count, uint64_t generation,
+			uint64_t expected_generation,
+			uint64_t default_profile, uint64_t privileged_profile,
+			uint32_t required_capabilities)
+{
+	struct hdn_policy_header header = {
+		.magic = HDN_POLICY_MAGIC,
+		.abi_version = HDN_POLICY_ABI_VERSION,
+		.header_size = sizeof(header),
+		.profile_size = sizeof(records[0]),
+		.profile_count = count,
+		.flags = required_capabilities,
+		.subject_rule_size = sizeof(subject_rules[0]),
+		.subject_rule_count = subject_rule_count,
+		.object_rule_size = sizeof(object_rules[0]),
+		.object_rule_count = object_rule_count,
+		.exec_rule_size = sizeof(exec_rules[0]),
+		.exec_rule_count = exec_rule_count,
+		.module_rule_size = sizeof(module_rules[0]),
+		.module_rule_count = module_rule_count,
+		.firmware_rule_size = sizeof(firmware_rules[0]),
+		.firmware_rule_count = firmware_rule_count,
+		.resource_rule_size = sizeof(resource_rules[0]),
+		.resource_rule_count = resource_rule_count,
+		.generation = generation,
+		.expected_generation = expected_generation,
+		.default_profile_id = default_profile,
+		.privileged_profile_id = privileged_profile,
+	};
+	FILE *file;
+
+	file = fopen(path, "wb");
+	if (!file) {
+		perror(path);
+		return -errno;
+	}
+
+	if (fwrite(&header, sizeof(header), 1, file) != 1 ||
+	    fwrite(records, sizeof(records[0]), count, file) != count ||
+	    fwrite(subject_rules, sizeof(subject_rules[0]),
+		   subject_rule_count, file) != subject_rule_count ||
+	    fwrite(object_rules, sizeof(object_rules[0]),
+		   object_rule_count, file) != object_rule_count ||
+	    fwrite(exec_rules, sizeof(exec_rules[0]), exec_rule_count, file) !=
+	    exec_rule_count ||
+	    fwrite(module_rules, sizeof(module_rules[0]), module_rule_count,
+		   file) != module_rule_count ||
+	    fwrite(firmware_rules, sizeof(firmware_rules[0]),
+		   firmware_rule_count, file) != firmware_rule_count ||
+	    fwrite(resource_rules, sizeof(resource_rules[0]),
+		   resource_rule_count, file) != resource_rule_count) {
+		perror(path);
+		fclose(file);
+		return -EIO;
+	}
+
+	if (fclose(file)) {
+		perror(path);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static bool profile_id_present(const struct hdn_profile_record *records,
+			       uint32_t count, uint64_t id)
+{
+	uint32_t i;
+
+	for (i = 0; i < count; i++) {
+		if (records[i].profile_id == id)
+			return true;
+	}
+
+	return false;
+}
+
+static int validate_policy(const struct hdn_profile_record *records,
+			   uint32_t count,
+			   const struct hdn_subject_rule_record *subject_rules,
+			   uint32_t subject_rule_count,
+			   const struct hdn_object_rule_record *object_rules,
+			   uint32_t object_rule_count,
+			   const struct hdn_resource_rule_record *resource_rules,
+			   uint32_t resource_rule_count,
+			   uint64_t default_profile, uint64_t privileged_profile)
+{
+	uint32_t i;
+
+	if (!profile_id_present(records, count, default_profile)) {
+		fprintf(stderr, "default profile %llu is missing\n",
+			(unsigned long long)default_profile);
+		return -EINVAL;
+	}
+
+	if (!profile_id_present(records, count, privileged_profile)) {
+		fprintf(stderr, "privileged profile %llu is missing\n",
+			(unsigned long long)privileged_profile);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < subject_rule_count; i++) {
+		if (!profile_id_present(records, count,
+					subject_rules[i].profile_id)) {
+			fprintf(stderr,
+				"subject rule %u target profile %llu is missing\n",
+				i,
+				(unsigned long long)subject_rules[i].profile_id);
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < object_rule_count; i++) {
+		if (!profile_id_present(records, count,
+					object_rules[i].profile_id)) {
+			fprintf(stderr,
+				"object rule %u profile %llu is missing\n",
+				i,
+				(unsigned long long)object_rules[i].profile_id);
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < resource_rule_count; i++) {
+		if (!profile_id_present(records, count,
+					resource_rules[i].profile_id)) {
+			fprintf(stderr,
+				"resource rule %u profile %llu is missing\n",
+				i,
+				(unsigned long long)resource_rules[i].profile_id);
+			return -EINVAL;
+		}
+		if (resource_rules[i].resource >= RLIM_NLIMITS) {
+			fprintf(stderr, "resource rule %u has invalid resource\n",
+				i);
+			return -EINVAL;
+		}
+		if (resource_rules[i].soft_limit >
+		    resource_rules[i].hard_limit) {
+			fprintf(stderr,
+				"resource rule %u soft limit exceeds hard limit\n",
+				i);
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_policy_builder builder = {};
+	struct hdn_profile_record records[HDN_MAX_PROFILES] = {};
+	uint64_t generation = 1;
+	uint64_t expected_generation = HDN_POLICY_EXPECT_ANY;
+	uint64_t default_profile = HDN_PROFILE_DEFAULT;
+	uint64_t privileged_profile = HDN_PROFILE_PRIVILEGED;
+	uint32_t count;
+	int ret;
+
+	if (argc != 3) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = read_policy(argv[1], &builder, &generation, &default_profile,
+			  &privileged_profile, &expected_generation);
+	if (ret)
+		return 1;
+
+	ret = expand_roles(&builder);
+	if (ret)
+		return 1;
+
+	ret = apply_role_uses(&builder);
+	if (ret)
+		return 1;
+
+	ret = build_records(builder.profiles, records, &count);
+	if (ret) {
+		fprintf(stderr, "policy contains no profiles\n");
+		return 1;
+	}
+
+	ret = validate_policy(records, count, builder.subject_rules,
+			      builder.subject_rule_count, builder.object_rules,
+			      builder.object_rule_count, builder.resource_rules,
+			      builder.resource_rule_count, default_profile,
+			      privileged_profile);
+	if (ret)
+		return 1;
+
+	ret = write_policy(argv[2], records, count, builder.subject_rules,
+			   builder.subject_rule_count, builder.object_rules,
+			   builder.object_rule_count, builder.exec_rules,
+			   builder.exec_rule_count, builder.module_rules,
+			   builder.module_rule_count, builder.firmware_rules,
+			   builder.firmware_rule_count, builder.resource_rules,
+			   builder.resource_rule_count, generation,
+			   expected_generation,
+			   default_profile, privileged_profile,
+			   builder.required_capabilities);
+	if (ret)
+		return 1;
+
+	return 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-prompt-describe.c linux-7.0.12-hdn/tools/hardening/hdn-prompt-describe.c
--- linux-7.0.12/tools/hardening/hdn-prompt-describe.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-prompt-describe.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,417 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef HDN_PROMPT_METADATA_CONFIG
+#define HDN_PROMPT_METADATA_CONFIG "/etc/hdn/prompt-metadata.conf"
+#endif
+
+#define HDN_PROMPT_METADATA_MAX_ACTIONS 64
+#define HDN_PROMPT_METADATA_MAX_VALUE 512
+
+struct hdn_prompt_metadata {
+	char *name;
+	char *title;
+	char *message;
+	char *consequence;
+	char *risk;
+};
+
+struct hdn_prompt_metadata_config {
+	struct hdn_prompt_metadata actions[HDN_PROMPT_METADATA_MAX_ACTIONS];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] ACTION\n"
+		"\n"
+		"Prints product-approved prompt metadata for a named action.\n"
+		"Config lines: prompt NAME FIELD VALUE\n"
+		"Known fields: title, message, consequence, risk\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static char *next_word(char **cursor)
+{
+	char *word;
+	char *end;
+
+	*cursor = trim(*cursor);
+	if (!(*cursor)[0])
+		return NULL;
+
+	word = *cursor;
+	end = strpbrk(word, " \t");
+	if (!end) {
+		*cursor = word + strlen(word);
+		return word;
+	}
+
+	*end++ = '\0';
+	*cursor = end;
+	return word;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static int require_safe_text(const char *field, const char *value,
+			     unsigned int lineno)
+{
+	const unsigned char *p;
+	size_t len;
+
+	if (!value || !value[0]) {
+		fprintf(stderr,
+			"hdn-prompt-describe: missing %s text at line %u\n",
+			field, lineno);
+		return -EINVAL;
+	}
+
+	len = strlen(value);
+	if (len > HDN_PROMPT_METADATA_MAX_VALUE) {
+		fprintf(stderr,
+			"hdn-prompt-describe: %s text too long at line %u\n",
+			field, lineno);
+		return -E2BIG;
+	}
+
+	for (p = (const unsigned char *)value; *p; p++) {
+		if (*p >= 0x20 && *p <= 0x7e)
+			continue;
+		fprintf(stderr,
+			"hdn-prompt-describe: unsafe %s text at line %u\n",
+			field, lineno);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static struct hdn_prompt_metadata *
+find_metadata(struct hdn_prompt_metadata_config *config, const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->actions[i].name, name))
+			return &config->actions[i];
+	}
+
+	return NULL;
+}
+
+static struct hdn_prompt_metadata *
+find_or_add_metadata(struct hdn_prompt_metadata_config *config,
+		     const char *name, unsigned int lineno)
+{
+	struct hdn_prompt_metadata *meta;
+
+	meta = find_metadata(config, name);
+	if (meta)
+		return meta;
+
+	if (config->count >= HDN_PROMPT_METADATA_MAX_ACTIONS) {
+		fprintf(stderr,
+			"hdn-prompt-describe: too many prompt metadata actions\n");
+		errno = E2BIG;
+		return NULL;
+	}
+
+	meta = &config->actions[config->count];
+	meta->name = strdup(name);
+	if (!meta->name) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	config->count++;
+	(void)lineno;
+	return meta;
+}
+
+static int set_field(char **slot, const char *field, const char *value,
+		     unsigned int lineno)
+{
+	char *copy;
+	int ret;
+
+	if (*slot) {
+		fprintf(stderr,
+			"hdn-prompt-describe: duplicate %s field at line %u\n",
+			field, lineno);
+		return -EINVAL;
+	}
+
+	ret = require_safe_text(field, value, lineno);
+	if (ret)
+		return ret;
+
+	copy = strdup(value);
+	if (!copy)
+		return -ENOMEM;
+
+	*slot = copy;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_prompt_metadata_config *config,
+			     char *line, unsigned int lineno)
+{
+	struct hdn_prompt_metadata *meta;
+	char *cursor;
+	char *key;
+	char *name;
+	char *field;
+	char *value;
+
+	cursor = trim(line);
+	if (!cursor[0] || cursor[0] == '#')
+		return 0;
+
+	key = next_word(&cursor);
+	name = next_word(&cursor);
+	field = next_word(&cursor);
+	value = trim(cursor);
+
+	if (!key || strcmp(key, "prompt")) {
+		fprintf(stderr,
+			"hdn-prompt-describe: unknown config key at line %u: %s\n",
+			lineno, key ? key : "(null)");
+		return -EINVAL;
+	}
+	if (!name || !field || !value[0]) {
+		fprintf(stderr,
+			"hdn-prompt-describe: prompt line %u needs NAME FIELD VALUE\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (!safe_name(name)) {
+		fprintf(stderr,
+			"hdn-prompt-describe: unsafe action name at line %u: %s\n",
+			lineno, name);
+		return -EINVAL;
+	}
+
+	meta = find_or_add_metadata(config, name, lineno);
+	if (!meta)
+		return -errno;
+
+	if (!strcmp(field, "title"))
+		return set_field(&meta->title, field, value, lineno);
+	if (!strcmp(field, "message"))
+		return set_field(&meta->message, field, value, lineno);
+	if (!strcmp(field, "consequence"))
+		return set_field(&meta->consequence, field, value, lineno);
+	if (!strcmp(field, "risk"))
+		return set_field(&meta->risk, field, value, lineno);
+
+	fprintf(stderr,
+		"hdn-prompt-describe: unknown prompt metadata field at line %u: %s\n",
+		lineno, field);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-prompt-describe: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-prompt-describe: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-prompt-describe: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_prompt_metadata_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_prompt_metadata_config *config)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		free(config->actions[i].name);
+		free(config->actions[i].title);
+		free(config->actions[i].message);
+		free(config->actions[i].consequence);
+		free(config->actions[i].risk);
+	}
+}
+
+static int describe_action(struct hdn_prompt_metadata_config *config,
+			   const char *action)
+{
+	struct hdn_prompt_metadata *meta;
+
+	meta = find_metadata(config, action);
+	if (!meta) {
+		fprintf(stderr,
+			"hdn-prompt-describe: prompt action is not product-approved: %s\n",
+			action);
+		return 1;
+	}
+
+	if (!meta->title || !meta->message || !meta->consequence) {
+		fprintf(stderr,
+			"hdn-prompt-describe: prompt action has incomplete metadata: %s\n",
+			action);
+		return 1;
+	}
+
+	printf("HDN_PROMPT_METADATA_V1\n");
+	printf("action=%s\n", meta->name);
+	printf("title=%s\n", meta->title);
+	printf("message=%s\n", meta->message);
+	printf("consequence=%s\n", meta->consequence);
+	if (meta->risk)
+		printf("risk=%s\n", meta->risk);
+	return ferror(stdout) ? 1 : 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_prompt_metadata_config config;
+	const char *config_path = HDN_PROMPT_METADATA_CONFIG;
+	const char *action = NULL;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!action) {
+			action = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!action || !safe_name(action)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	ret = describe_action(&config, action);
+	free_config(&config);
+	return ret;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-prompt-dispatch.c linux-7.0.12-hdn/tools/hardening/hdn-prompt-dispatch.c
--- linux-7.0.12/tools/hardening/hdn-prompt-dispatch.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-prompt-dispatch.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,727 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_PROMPT_DISPATCH_CONFIG
+#define HDN_PROMPT_DISPATCH_CONFIG "/etc/hdn/prompt-actions.conf"
+#endif
+
+#ifndef HDN_ADMIN_BROKER_PATH
+#define HDN_ADMIN_BROKER_PATH "/usr/libexec/hdn-admin-broker"
+#endif
+
+#ifndef HDN_APPROVAL_TOKEN_PATH
+#define HDN_APPROVAL_TOKEN_PATH "/usr/libexec/hdn-approval-token"
+#endif
+
+#ifndef HDN_APPROVAL_TOKEN_DIR
+#define HDN_APPROVAL_TOKEN_DIR "/run/hdn/approvals"
+#endif
+
+#define HDN_PROMPT_MAX_RULES 64
+#define HDN_PROMPT_MAX_ARGS 32
+#define HDN_PROMPT_TOKEN_TTL_DEFAULT_MS 30000ULL
+#define HDN_PROMPT_TOKEN_TTL_MAX_MS 300000ULL
+
+struct hdn_prompt_rule {
+	char *name;
+	char *intent;
+	char *args[HDN_PROMPT_MAX_ARGS + 1];
+	unsigned int argc;
+};
+
+struct hdn_prompt_config {
+	struct hdn_prompt_rule rules[HDN_PROMPT_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--broker PATH] [--token-issuer PATH]\n"
+		"       [--token-dir DIR] [--ttl-ms MS] [--dry-run] ACTION\n"
+		"\n"
+		"Runs a named post-auth product action through hdn-admin-broker.\n"
+		"Config lines: action NAME INTENT [ARG...]\n"
+		"Known intents: rofs-apply, rofs-transaction, policy-commit, policy-rollback\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool known_intent(const char *intent)
+{
+	return !strcmp(intent, "rofs-apply") ||
+	       !strcmp(intent, "rofs-transaction") ||
+	       !strcmp(intent, "policy-commit") ||
+	       !strcmp(intent, "policy-rollback");
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int require_safe_dir(const char *path)
+{
+	int ret = require_safe_absolute("token directory", path);
+
+	if (ret)
+		return ret;
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: token directory / is too broad\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int parse_u64(const char *text, unsigned long long *value)
+{
+	char *end;
+
+	errno = 0;
+	*value = strtoull(text, &end, 10);
+	if (errno || end == text || *end)
+		return -EINVAL;
+	return 0;
+}
+
+static int validate_rofs_apply_args(char **args, unsigned int argc,
+				    unsigned int lineno)
+{
+	bool saw_target = false;
+	unsigned int i;
+
+	for (i = 0; i < argc; i++) {
+		if (!strcmp(args[i], "-r") || !strcmp(args[i], "--recursive"))
+			continue;
+		if (!strcmp(args[i], "-f") || !strcmp(args[i], "--file")) {
+			if (++i >= argc)
+				goto bad;
+			if (require_safe_absolute("readonly mount list",
+						  args[i]))
+				return -EINVAL;
+			saw_target = true;
+			continue;
+		}
+		if (args[i][0] == '-')
+			goto bad;
+		if (require_safe_absolute("mountpoint", args[i]))
+			return -EINVAL;
+		saw_target = true;
+	}
+
+	if (saw_target)
+		return 0;
+
+bad:
+	fprintf(stderr,
+		"hdn-prompt-dispatch: invalid rofs-apply action at line %u\n",
+		lineno);
+	return -EINVAL;
+}
+
+static int validate_rofs_transaction_args(char **args, unsigned int argc,
+					  unsigned int lineno)
+{
+	if (argc < 3 || strcmp(args[1], "--")) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: rofs-transaction action at line %u needs MOUNTPOINT -- WORKER [ARG...]\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("mountpoint", args[0]) ||
+	    require_safe_absolute("worker", args[2]))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int validate_policy_commit_args(char **args, unsigned int argc,
+				       unsigned int lineno)
+{
+	if (argc != 1) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: policy-commit action at line %u needs SIGNED_POLICY\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	return require_safe_absolute("signed policy", args[0]);
+}
+
+static int validate_rule_args(const char *intent, char **args,
+			      unsigned int argc, unsigned int lineno)
+{
+	if (!strcmp(intent, "rofs-apply"))
+		return validate_rofs_apply_args(args, argc, lineno);
+	if (!strcmp(intent, "rofs-transaction"))
+		return validate_rofs_transaction_args(args, argc, lineno);
+	if (!strcmp(intent, "policy-commit"))
+		return validate_policy_commit_args(args, argc, lineno);
+	if (!strcmp(intent, "policy-rollback")) {
+		if (!argc)
+			return 0;
+		fprintf(stderr,
+			"hdn-prompt-dispatch: policy-rollback takes no arguments at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	return -EINVAL;
+}
+
+static int add_rule(struct hdn_prompt_config *config, char **tokens,
+		    unsigned int count, unsigned int lineno)
+{
+	struct hdn_prompt_rule *rule;
+	unsigned int argc;
+	unsigned int i;
+
+	if (count < 3) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: action line %u needs NAME INTENT\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_PROMPT_MAX_RULES) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: too many prompt actions\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1])) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: unsafe action name at line %u: %s\n",
+			lineno, tokens[1]);
+		return -EINVAL;
+	}
+	if (!known_intent(tokens[2])) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: unknown intent at line %u: %s\n",
+			lineno, tokens[2]);
+		return -EINVAL;
+	}
+
+	argc = count - 3;
+	if (argc > HDN_PROMPT_MAX_ARGS) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: too many action arguments at line %u\n",
+			lineno);
+		return -E2BIG;
+	}
+	if (validate_rule_args(tokens[2], &tokens[3], argc, lineno))
+		return -EINVAL;
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->intent = strdup(tokens[2]);
+	if (!rule->name || !rule->intent)
+		return -ENOMEM;
+
+	for (i = 0; i < argc; i++) {
+		rule->args[rule->argc] = strdup(tokens[i + 3]);
+		if (!rule->args[rule->argc])
+			return -ENOMEM;
+		rule->argc++;
+	}
+	rule->args[rule->argc] = NULL;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_prompt_config *config, char *line,
+			     unsigned int lineno)
+{
+	char *tokens[HDN_PROMPT_MAX_ARGS + 3];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-prompt-dispatch: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (strcmp(tokens[0], "action")) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: unknown config key at line %u: %s\n",
+			lineno, tokens[0]);
+		return -EINVAL;
+	}
+
+	return add_rule(config, tokens, count, lineno);
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-prompt-dispatch: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-prompt-dispatch: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path, struct hdn_prompt_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_prompt_config *config)
+{
+	unsigned int i;
+	unsigned int j;
+
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].intent);
+		for (j = 0; j < config->rules[i].argc; j++)
+			free(config->rules[i].args[j]);
+	}
+}
+
+static const struct hdn_prompt_rule *
+find_rule(const struct hdn_prompt_config *config, const char *action)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, action))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int read_token_path(int fd, char *token, size_t size)
+{
+	size_t done = 0;
+
+	while (done + 1 < size) {
+		ssize_t ret = read(fd, token + done, size - done - 1);
+
+		if (ret < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (!ret)
+			break;
+		done += (size_t)ret;
+	}
+	token[done] = '\0';
+
+	while (done && (token[done - 1] == '\n' ||
+			token[done - 1] == '\r' ||
+			token[done - 1] == ' ' ||
+			token[done - 1] == '\t'))
+		token[--done] = '\0';
+
+	if (!done || strchr(token, '\n'))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int issue_token(const char *issuer, const char *intent,
+		       const char *token_dir, unsigned long long ttl_ms,
+		       char *token, size_t token_size)
+{
+	char ttl_text[32];
+	int pipefd[2];
+	int status;
+	pid_t child;
+	int ret;
+
+	if (snprintf(ttl_text, sizeof(ttl_text), "%llu", ttl_ms) >=
+	    (int)sizeof(ttl_text))
+		return 1;
+	if (pipe(pipefd)) {
+		fprintf(stderr, "hdn-prompt-dispatch: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-prompt-dispatch: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(126);
+		close(pipefd[1]);
+		execl(issuer, "hdn-approval-token", "--dir", token_dir,
+		      "--intent", intent, "--ttl-ms", ttl_text, NULL);
+		fprintf(stderr, "hdn-prompt-dispatch: exec %s failed: %s\n",
+			issuer, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[1]);
+	ret = read_token_path(pipefd[0], token, token_size);
+	close(pipefd[0]);
+
+	if (waitpid(child, &status, 0) < 0) {
+		fprintf(stderr, "hdn-prompt-dispatch: wait failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status)) {
+		if (WIFEXITED(status))
+			return WEXITSTATUS(status) ? WEXITSTATUS(status) : 1;
+		return 1;
+	}
+	if (ret) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: token issuer returned an invalid token path\n");
+		return 1;
+	}
+	if (require_safe_absolute("approval token", token))
+		return 1;
+
+	return 0;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_rule(const char *broker, const char *token,
+		    const struct hdn_prompt_rule *rule, bool dry_run)
+{
+	char **argv;
+	unsigned int argc = 0;
+	unsigned int i;
+	int exec_errno;
+
+	argv = calloc((size_t)rule->argc + 6, sizeof(*argv));
+	if (!argv) {
+		fprintf(stderr, "hdn-prompt-dispatch: allocation failed\n");
+		unlink(token);
+		return 1;
+	}
+
+	argv[argc++] = (char *)broker;
+	if (dry_run)
+		argv[argc++] = "--dry-run";
+	argv[argc++] = "--approval-token";
+	argv[argc++] = (char *)token;
+	argv[argc++] = rule->intent;
+	for (i = 0; i < rule->argc; i++)
+		argv[argc++] = rule->args[i];
+	argv[argc] = NULL;
+
+	if (dry_run) {
+		pid_t child;
+		int ret;
+
+		child = fork();
+		if (child < 0) {
+			fprintf(stderr, "hdn-prompt-dispatch: fork failed: %s\n",
+				strerror(errno));
+			free(argv);
+			unlink(token);
+			return 1;
+		}
+
+		if (!child) {
+			execv(broker, argv);
+			exec_errno = errno;
+			fprintf(stderr,
+				"hdn-prompt-dispatch: exec %s failed: %s\n",
+				broker, strerror(exec_errno));
+			_exit(exec_errno == ENOENT ? 127 : 126);
+		}
+
+		ret = child_status_result(child);
+		free(argv);
+		if (unlink(token)) {
+			fprintf(stderr,
+				"hdn-prompt-dispatch: cleanup token %s failed: %s\n",
+				token, strerror(errno));
+			if (!ret)
+				ret = 1;
+		}
+		return ret;
+	}
+
+		execv(broker, argv);
+	exec_errno = errno;
+	fprintf(stderr, "hdn-prompt-dispatch: exec %s failed: %s\n",
+		broker, strerror(exec_errno));
+	free(argv);
+	unlink(token);
+	return exec_errno == ENOENT ? 127 : 126;
+}
+
+int main(int argc, char **argv)
+{
+	const char *config_path = HDN_PROMPT_DISPATCH_CONFIG;
+	const char *broker_path = HDN_ADMIN_BROKER_PATH;
+	const char *issuer_path = HDN_APPROVAL_TOKEN_PATH;
+	const char *token_dir = HDN_APPROVAL_TOKEN_DIR;
+	unsigned long long ttl_ms = HDN_PROMPT_TOKEN_TTL_DEFAULT_MS;
+	const struct hdn_prompt_rule *rule;
+	struct hdn_prompt_config config;
+	const char *action = NULL;
+	bool dry_run = false;
+	char token[PATH_MAX];
+	int ret = 0;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		}
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc)
+				goto bad_args;
+			config_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--broker")) {
+			if (++i >= argc)
+				goto bad_args;
+			broker_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--token-issuer")) {
+			if (++i >= argc)
+				goto bad_args;
+			issuer_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--token-dir")) {
+			if (++i >= argc)
+				goto bad_args;
+			token_dir = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--ttl-ms")) {
+			if (++i >= argc || parse_u64(argv[i], &ttl_ms))
+				goto bad_args;
+			continue;
+		}
+		if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+			continue;
+		}
+		if (argv[i][0] == '-')
+			goto bad_args;
+		if (action)
+			goto bad_args;
+		action = argv[i];
+	}
+
+	if (!action || !safe_name(action))
+		goto bad_args;
+	if (geteuid() != 0) {
+		fprintf(stderr, "hdn-prompt-dispatch: must run as root\n");
+		return 1;
+	}
+	if (!ttl_ms || ttl_ms > HDN_PROMPT_TOKEN_TTL_MAX_MS) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: ttl-ms must be between 1 and %llu\n",
+			HDN_PROMPT_TOKEN_TTL_MAX_MS);
+		return 1;
+	}
+	if (require_safe_absolute("config", config_path) ||
+	    require_safe_absolute("broker", broker_path) ||
+	    require_safe_absolute("token issuer", issuer_path) ||
+	    require_safe_dir(token_dir))
+		return 1;
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	rule = find_rule(&config, action);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-prompt-dispatch: action is not product-approved: %s\n",
+			action);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = issue_token(issuer_path, rule->intent, token_dir, ttl_ms, token,
+			  sizeof(token));
+	if (!ret)
+		ret = run_rule(broker_path, token, rule, dry_run);
+	free_config(&config);
+	return ret;
+
+bad_args:
+	usage(argv[0]);
+	return 2;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-prompt-portal.c linux-7.0.12-hdn/tools/hardening/hdn-prompt-portal.c
--- linux-7.0.12/tools/hardening/hdn-prompt-portal.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-prompt-portal.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_PROMPT_PORTAL_CONFIG
+#define HDN_PROMPT_PORTAL_CONFIG "/etc/hdn/prompt-portal.conf"
+#endif
+
+#ifndef HDN_PROMPT_SESSION_PATH
+#define HDN_PROMPT_SESSION_PATH "/usr/libexec/hdn-prompt-session"
+#endif
+
+#ifndef HDN_PROMPT_ELEVATION_PATH
+#define HDN_PROMPT_ELEVATION_PATH "/usr/bin/pkexec"
+#endif
+
+#define HDN_PROMPT_PORTAL_MAX_RULES 64
+
+struct hdn_prompt_portal_rule {
+	char *name;
+	char *session_action;
+};
+
+struct hdn_prompt_portal_config {
+	char *session_helper;
+	char *elevation_helper;
+	struct hdn_prompt_portal_rule rules[HDN_PROMPT_PORTAL_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run] ACTION\n"
+		"\n"
+		"Runs a product-approved desktop prompt action.\n"
+		"Config lines:\n"
+		"  session-helper PATH\n"
+		"  elevation-helper PATH\n"
+		"  action DESKTOP_ACTION PROMPT_SESSION_ACTION\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr, "hdn-prompt-portal: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-prompt-portal: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-prompt-portal: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_session_helper(struct hdn_prompt_portal_config *config,
+			      char **tokens, unsigned int count,
+			      unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-prompt-portal: session-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("session-helper", tokens[1]))
+		return -EINVAL;
+	return replace_string(&config->session_helper, tokens[1]);
+}
+
+static int set_elevation_helper(struct hdn_prompt_portal_config *config,
+				char **tokens, unsigned int count,
+				unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-prompt-portal: elevation-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("elevation-helper", tokens[1]))
+		return -EINVAL;
+	return replace_string(&config->elevation_helper, tokens[1]);
+}
+
+static int add_action(struct hdn_prompt_portal_config *config, char **tokens,
+		      unsigned int count, unsigned int lineno)
+{
+	struct hdn_prompt_portal_rule *rule;
+
+	if (count != 3) {
+		fprintf(stderr,
+			"hdn-prompt-portal: action line %u needs DESKTOP_ACTION PROMPT_SESSION_ACTION\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_PROMPT_PORTAL_MAX_RULES) {
+		fprintf(stderr, "hdn-prompt-portal: too many action rules\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1]) || !safe_name(tokens[2])) {
+		fprintf(stderr,
+			"hdn-prompt-portal: unsafe action name at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->session_action = strdup(tokens[2]);
+	if (!rule->name || !rule->session_action)
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_prompt_portal_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[3];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-prompt-portal: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "session-helper"))
+		return set_session_helper(config, tokens, count, lineno);
+	if (!strcmp(tokens[0], "elevation-helper"))
+		return set_elevation_helper(config, tokens, count, lineno);
+	if (!strcmp(tokens[0], "action"))
+		return add_action(config, tokens, count, lineno);
+
+	fprintf(stderr, "hdn-prompt-portal: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-prompt-portal: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-prompt-portal: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-prompt-portal: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_prompt_portal_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->session_helper, HDN_PROMPT_SESSION_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->elevation_helper,
+			     HDN_PROMPT_ELEVATION_PATH);
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_prompt_portal_config *config)
+{
+	unsigned int i;
+
+	free(config->session_helper);
+	free(config->elevation_helper);
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].session_action);
+	}
+}
+
+static const struct hdn_prompt_portal_rule *
+find_action(const struct hdn_prompt_portal_config *config, const char *action)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, action))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_prompt_session(const char *helper, const char *elevation,
+			      const char *action, bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-prompt-portal: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (geteuid() == 0) {
+			if (dry_run)
+				execl(helper, "hdn-prompt-session", "--dry-run",
+				      action, NULL);
+			else
+				execl(helper, "hdn-prompt-session", action, NULL);
+		} else if (dry_run) {
+			execl(elevation, "pkexec", helper, "--authorized",
+			      "--dry-run", action, NULL);
+		} else {
+			execl(elevation, "pkexec", helper, "--authorized",
+			      action, NULL);
+		}
+		fprintf(stderr, "hdn-prompt-portal: exec failed: %s\n",
+			strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_prompt_portal_config config;
+	const struct hdn_prompt_portal_rule *rule;
+	const char *config_path = HDN_PROMPT_PORTAL_CONFIG;
+	const char *action = NULL;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!action) {
+			action = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!action || !safe_name(action)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	rule = find_action(&config, action);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-prompt-portal: action is not product-approved: %s\n",
+			action);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_prompt_session(config.session_helper, config.elevation_helper,
+				 rule->session_action, dry_run);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-prompt-session.c linux-7.0.12-hdn/tools/hardening/hdn-prompt-session.c
--- linux-7.0.12/tools/hardening/hdn-prompt-session.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-prompt-session.c	2026-07-15 13:46:19.744867686 -0500
@@ -0,0 +1,670 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_PROMPT_SESSION_CONFIG
+#define HDN_PROMPT_SESSION_CONFIG "/etc/hdn/prompt-session.conf"
+#endif
+
+#ifndef HDN_PROMPT_DESCRIBE_PATH
+#define HDN_PROMPT_DESCRIBE_PATH "/usr/libexec/hdn-prompt-describe"
+#endif
+
+#ifndef HDN_PROMPT_DISPATCH_PATH
+#define HDN_PROMPT_DISPATCH_PATH "/usr/libexec/hdn-prompt-dispatch"
+#endif
+
+#ifndef HDN_PROMPT_AUTH_PATH
+#define HDN_PROMPT_AUTH_PATH "/usr/libexec/hdn-auth-prompt"
+#endif
+
+#define HDN_PROMPT_SESSION_MAX_ARGS 16
+#define HDN_PROMPT_SESSION_MAX_METADATA 8192
+
+struct hdn_prompt_session_config {
+	char *describe_helper;
+	char *dispatch_helper;
+	char *auth_argv[HDN_PROMPT_SESSION_MAX_ARGS + 1];
+	unsigned int auth_argc;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run] [--authorized] ACTION\n"
+		"\n"
+		"Runs a named prompt session: describe, authenticate, then dispatch.\n"
+		"--authorized is reserved for a root process started by the product\n"
+		"desktop authorization boundary.\n"
+		"Config lines:\n"
+		"  describe-helper PATH\n"
+		"  auth-helper PATH [ARG...]\n"
+		"  dispatch-helper PATH\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr, "hdn-prompt-session: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-prompt-session: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-prompt-session: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int require_safe_arg(const char *arg, unsigned int lineno)
+{
+	const unsigned char *p;
+
+	if (!arg || !arg[0]) {
+		fprintf(stderr,
+			"hdn-prompt-session: empty helper argument at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	for (p = (const unsigned char *)arg; *p; p++) {
+		if (*p >= 0x21 && *p <= 0x7e)
+			continue;
+		fprintf(stderr,
+			"hdn-prompt-session: unsafe helper argument at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_helper_path(char **slot, const char *kind, char **tokens,
+			   unsigned int count, unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-prompt-session: %s line %u needs exactly one path\n",
+			kind, lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute(kind, tokens[1]))
+		return -EINVAL;
+	return replace_string(slot, tokens[1]);
+}
+
+static int set_auth_helper(struct hdn_prompt_session_config *config,
+			   char **tokens, unsigned int count,
+			   unsigned int lineno)
+{
+	unsigned int i;
+
+	if (count < 2) {
+		fprintf(stderr,
+			"hdn-prompt-session: auth-helper line %u needs PATH [ARG...]\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (count > HDN_PROMPT_SESSION_MAX_ARGS) {
+		fprintf(stderr,
+			"hdn-prompt-session: too many auth-helper arguments at line %u\n",
+			lineno);
+		return -E2BIG;
+	}
+	if (require_safe_absolute("auth-helper", tokens[1]))
+		return -EINVAL;
+
+	for (i = 2; i < count; i++) {
+		if (require_safe_arg(tokens[i], lineno))
+			return -EINVAL;
+	}
+
+	for (i = 0; i < config->auth_argc; i++)
+		free(config->auth_argv[i]);
+	config->auth_argc = 0;
+
+	for (i = 1; i < count; i++) {
+		config->auth_argv[config->auth_argc] = strdup(tokens[i]);
+		if (!config->auth_argv[config->auth_argc])
+			return -ENOMEM;
+		config->auth_argc++;
+	}
+	config->auth_argv[config->auth_argc] = NULL;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_prompt_session_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[HDN_PROMPT_SESSION_MAX_ARGS + 1];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-prompt-session: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "describe-helper"))
+		return set_helper_path(&config->describe_helper,
+				       "describe-helper", tokens, count,
+				       lineno);
+	if (!strcmp(tokens[0], "dispatch-helper"))
+		return set_helper_path(&config->dispatch_helper,
+				       "dispatch-helper", tokens, count,
+				       lineno);
+	if (!strcmp(tokens[0], "auth-helper"))
+		return set_auth_helper(config, tokens, count, lineno);
+
+	fprintf(stderr, "hdn-prompt-session: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-prompt-session: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-prompt-session: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-prompt-session: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_prompt_session_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->describe_helper, HDN_PROMPT_DESCRIBE_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->dispatch_helper, HDN_PROMPT_DISPATCH_PATH);
+	if (ret)
+		return ret;
+	config->auth_argv[0] = strdup(HDN_PROMPT_AUTH_PATH);
+	if (!config->auth_argv[0])
+		return -ENOMEM;
+	config->auth_argc = 1;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_prompt_session_config *config)
+{
+	unsigned int i;
+
+	free(config->describe_helper);
+	free(config->dispatch_helper);
+	for (i = 0; i < config->auth_argc; i++)
+		free(config->auth_argv[i]);
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int read_metadata_from_describe(const char *helper, const char *action,
+				       char **metadata)
+{
+	char buf[HDN_PROMPT_SESSION_MAX_METADATA + 1];
+	size_t done = 0;
+	int pipefd[2];
+	pid_t child;
+	int status;
+
+	if (pipe(pipefd)) {
+		fprintf(stderr, "hdn-prompt-session: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-prompt-session: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(126);
+		close(pipefd[1]);
+		execl(helper, "hdn-prompt-describe", action, NULL);
+		fprintf(stderr, "hdn-prompt-session: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[1]);
+	for (;;) {
+		ssize_t len;
+
+		len = read(pipefd[0], buf + done,
+			   HDN_PROMPT_SESSION_MAX_METADATA - done);
+		if (len < 0) {
+			if (errno == EINTR)
+				continue;
+			fprintf(stderr,
+				"hdn-prompt-session: read prompt metadata failed: %s\n",
+				strerror(errno));
+			close(pipefd[0]);
+			(void)child_status_result(child);
+			return 1;
+		}
+		if (!len)
+			break;
+		done += (size_t)len;
+		if (done == HDN_PROMPT_SESSION_MAX_METADATA) {
+			fprintf(stderr,
+				"hdn-prompt-session: prompt metadata too large\n");
+			close(pipefd[0]);
+			(void)child_status_result(child);
+			return 1;
+		}
+	}
+	close(pipefd[0]);
+
+	status = child_status_result(child);
+	if (status)
+		return status;
+	if (!done) {
+		fprintf(stderr, "hdn-prompt-session: empty prompt metadata\n");
+		return 1;
+	}
+
+	buf[done] = '\0';
+	*metadata = strdup(buf);
+	if (!*metadata)
+		return 1;
+	return 0;
+}
+
+static bool metadata_has_line(const char *metadata, const char *line)
+{
+	const char *match = metadata;
+	size_t line_len = strlen(line);
+
+	while ((match = strstr(match, line))) {
+		if ((match == metadata || match[-1] == '\n') &&
+		    match[line_len] == '\n')
+			return true;
+		match += line_len;
+	}
+
+	return false;
+}
+
+static int validate_metadata(const char *metadata, const char *action)
+{
+	char expected[256];
+
+	if (!metadata_has_line(metadata, "HDN_PROMPT_METADATA_V1")) {
+		fprintf(stderr,
+			"hdn-prompt-session: prompt metadata missing magic\n");
+		return 1;
+	}
+	if (snprintf(expected, sizeof(expected), "action=%s", action) >=
+	    (int)sizeof(expected)) {
+		fprintf(stderr, "hdn-prompt-session: action name too long\n");
+		return 1;
+	}
+	if (!metadata_has_line(metadata, expected)) {
+		fprintf(stderr,
+			"hdn-prompt-session: prompt metadata action mismatch\n");
+		return 1;
+	}
+
+	return 0;
+}
+
+static int write_all(int fd, const char *buf, size_t size)
+{
+	size_t done = 0;
+
+	while (done < size) {
+		ssize_t ret = write(fd, buf + done, size - done);
+
+		if (ret < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (!ret)
+			return -EIO;
+		done += (size_t)ret;
+	}
+
+	return 0;
+}
+
+static int run_auth_helper(const struct hdn_prompt_session_config *config,
+			   const char *action, const char *metadata)
+{
+	char *argv[HDN_PROMPT_SESSION_MAX_ARGS + 2];
+	int pipefd[2];
+	unsigned int i;
+	pid_t child;
+	int write_ret;
+	int status;
+
+	if (pipe(pipefd)) {
+		fprintf(stderr, "hdn-prompt-session: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-prompt-session: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[1]);
+		if (dup2(pipefd[0], STDIN_FILENO) < 0)
+			_exit(126);
+		close(pipefd[0]);
+		for (i = 0; i < config->auth_argc; i++)
+			argv[i] = config->auth_argv[i];
+		argv[config->auth_argc] = (char *)action;
+		argv[config->auth_argc + 1] = NULL;
+		execv(config->auth_argv[0], argv);
+		fprintf(stderr, "hdn-prompt-session: exec %s failed: %s\n",
+			config->auth_argv[0], strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[0]);
+	write_ret = write_all(pipefd[1], metadata, strlen(metadata));
+	close(pipefd[1]);
+	status = child_status_result(child);
+	if (write_ret && !status) {
+		fprintf(stderr,
+			"hdn-prompt-session: auth helper input failed: %s\n",
+			strerror(-write_ret));
+		return 1;
+	}
+	return status ? 1 : 0;
+}
+
+static int run_dispatch_helper(const char *helper, const char *action,
+			       bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-prompt-session: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(helper, "hdn-prompt-dispatch", "--dry-run",
+			      action, NULL);
+		else
+			execl(helper, "hdn-prompt-dispatch", action, NULL);
+		fprintf(stderr, "hdn-prompt-session: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_prompt_session_config config;
+	const char *config_path = HDN_PROMPT_SESSION_CONFIG;
+	const char *action = NULL;
+	char *metadata = NULL;
+	bool authorized = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "--authorized")) {
+			authorized = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!action) {
+			action = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!action || !safe_name(action)) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (authorized && geteuid() != 0) {
+		fprintf(stderr,
+			"hdn-prompt-session: --authorized requires root\n");
+		return 1;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	ret = read_metadata_from_describe(config.describe_helper, action,
+					  &metadata);
+	if (ret)
+		goto out;
+
+	ret = validate_metadata(metadata, action);
+	if (ret)
+		goto out;
+
+	if (!dry_run && !authorized) {
+		ret = run_auth_helper(&config, action, metadata);
+		if (ret) {
+			fprintf(stderr,
+				"hdn-prompt-session: prompt authentication denied: %s\n",
+				action);
+			goto out;
+		}
+	}
+
+	ret = run_dispatch_helper(config.dispatch_helper, action, true);
+	if (!ret && !dry_run)
+		ret = run_dispatch_helper(config.dispatch_helper, action, false);
+	if (ret)
+		fprintf(stderr,
+			"hdn-prompt-session: prompt dispatch failed for %s\n",
+			action);
+
+out:
+	free(metadata);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-action.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-action.c
--- linux-7.0.12/tools/hardening/hdn-recovery-action.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-action.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef HDN_RECOVERY_ACTION_CONFIG
+#define HDN_RECOVERY_ACTION_CONFIG "/etc/hdn/recovery-actions.conf"
+#endif
+
+#ifndef HDN_ADMIN_BROKER_PATH
+#define HDN_ADMIN_BROKER_PATH "/usr/libexec/hdn-admin-broker"
+#endif
+
+#ifndef HDN_SYSTEM_TRANSACTION_PATH
+#define HDN_SYSTEM_TRANSACTION_PATH "/usr/libexec/hdn-system-transaction"
+#endif
+
+#define HDN_RECOVERY_MAX_RULES 64
+
+enum hdn_recovery_backend {
+	HDN_RECOVERY_POLICY_ROLLBACK,
+	HDN_RECOVERY_SYSTEM_TRANSACTION,
+};
+
+struct hdn_recovery_rule {
+	char *name;
+	enum hdn_recovery_backend backend;
+	char *argument;
+};
+
+struct hdn_recovery_config {
+	struct hdn_recovery_rule rules[HDN_RECOVERY_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--broker PATH] [--system-transaction PATH] [--dry-run] ACTION\n"
+		"\n"
+		"Runs a product-approved recovery action.\n"
+		"Config lines:\n"
+		"  action NAME policy-rollback\n"
+		"  action NAME system-transaction TRANSACTION\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-recovery-action: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-recovery-action: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static int add_rule(struct hdn_recovery_config *config, char **tokens,
+		    unsigned int count, unsigned int lineno)
+{
+	struct hdn_recovery_rule *rule;
+
+	if (count < 3) {
+		fprintf(stderr,
+			"hdn-recovery-action: action line %u needs NAME BACKEND\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_RECOVERY_MAX_RULES) {
+		fprintf(stderr,
+			"hdn-recovery-action: too many recovery actions\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1])) {
+		fprintf(stderr,
+			"hdn-recovery-action: unsafe action name at line %u: %s\n",
+			lineno, tokens[1]);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	if (!rule->name)
+		return -ENOMEM;
+
+	if (!strcmp(tokens[2], "policy-rollback")) {
+		if (count != 3) {
+			fprintf(stderr,
+				"hdn-recovery-action: policy-rollback takes no argument at line %u\n",
+				lineno);
+			return -EINVAL;
+		}
+		rule->backend = HDN_RECOVERY_POLICY_ROLLBACK;
+	} else if (!strcmp(tokens[2], "system-transaction")) {
+		if (count != 4 || !safe_name(tokens[3])) {
+			fprintf(stderr,
+				"hdn-recovery-action: invalid system transaction at line %u\n",
+				lineno);
+			return -EINVAL;
+		}
+		rule->backend = HDN_RECOVERY_SYSTEM_TRANSACTION;
+		rule->argument = strdup(tokens[3]);
+		if (!rule->argument)
+			return -ENOMEM;
+	} else {
+		fprintf(stderr,
+			"hdn-recovery-action: unknown backend at line %u: %s\n",
+			lineno, tokens[2]);
+		return -EINVAL;
+	}
+
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_recovery_config *config, char *line,
+			     unsigned int lineno)
+{
+	char *tokens[5];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-recovery-action: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (strcmp(tokens[0], "action")) {
+		fprintf(stderr,
+			"hdn-recovery-action: unknown config key at line %u: %s\n",
+			lineno, tokens[0]);
+		return -EINVAL;
+	}
+
+	return add_rule(config, tokens, count, lineno);
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-recovery-action: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-recovery-action: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-recovery-action: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path, struct hdn_recovery_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_recovery_config *config)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].argument);
+	}
+}
+
+static const struct hdn_recovery_rule *
+find_rule(const struct hdn_recovery_config *config, const char *action)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, action))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int run_rule(const char *broker, const char *system_transaction,
+		    const struct hdn_recovery_rule *rule, bool dry_run)
+{
+	if (rule->backend == HDN_RECOVERY_POLICY_ROLLBACK) {
+		char *const dry_argv[] = {
+			(char *)broker,
+			"--dry-run",
+			"policy-rollback",
+			NULL,
+		};
+		char *const real_argv[] = {
+			(char *)broker,
+			"policy-rollback",
+			NULL,
+		};
+
+		execv(broker, dry_run ? dry_argv : real_argv);
+		fprintf(stderr, "hdn-recovery-action: exec %s failed: %s\n",
+			broker, strerror(errno));
+		return errno == ENOENT ? 127 : 126;
+	}
+
+	if (rule->backend == HDN_RECOVERY_SYSTEM_TRANSACTION) {
+		char *const dry_argv[] = {
+			(char *)system_transaction,
+			"--dry-run",
+			rule->argument,
+			NULL,
+		};
+		char *const real_argv[] = {
+			(char *)system_transaction,
+			rule->argument,
+			NULL,
+		};
+
+		execv(system_transaction, dry_run ? dry_argv : real_argv);
+		fprintf(stderr, "hdn-recovery-action: exec %s failed: %s\n",
+			system_transaction, strerror(errno));
+		return errno == ENOENT ? 127 : 126;
+	}
+
+	return 1;
+}
+
+int main(int argc, char **argv)
+{
+	const char *config_path = HDN_RECOVERY_ACTION_CONFIG;
+	const char *broker_path = HDN_ADMIN_BROKER_PATH;
+	const char *system_transaction_path = HDN_SYSTEM_TRANSACTION_PATH;
+	const char *action = NULL;
+	const struct hdn_recovery_rule *rule;
+	struct hdn_recovery_config config;
+	bool dry_run = false;
+	int ret = 0;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		}
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc)
+				goto bad_args;
+			config_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--broker")) {
+			if (++i >= argc)
+				goto bad_args;
+			broker_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--system-transaction")) {
+			if (++i >= argc)
+				goto bad_args;
+			system_transaction_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+			continue;
+		}
+		if (argv[i][0] == '-')
+			goto bad_args;
+		if (action)
+			goto bad_args;
+		action = argv[i];
+	}
+
+	if (!action || !safe_name(action))
+		goto bad_args;
+	if (require_safe_absolute("config", config_path) ||
+	    require_safe_absolute("broker", broker_path) ||
+	    require_safe_absolute("system transaction", system_transaction_path))
+		return 1;
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	rule = find_rule(&config, action);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-recovery-action: action is not product-approved: %s\n",
+			action);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_rule(broker_path, system_transaction_path, rule, dry_run);
+	free_config(&config);
+	return ret;
+
+bad_args:
+	usage(argv[0]);
+	return 2;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-describe.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-describe.c
--- linux-7.0.12/tools/hardening/hdn-recovery-describe.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-describe.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,416 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef HDN_RECOVERY_METADATA_CONFIG
+#define HDN_RECOVERY_METADATA_CONFIG "/etc/hdn/recovery-metadata.conf"
+#endif
+
+#define HDN_RECOVERY_METADATA_MAX_ACTIONS 64
+#define HDN_RECOVERY_METADATA_MAX_VALUE 512
+
+struct hdn_recovery_metadata {
+	char *name;
+	char *title;
+	char *message;
+	char *consequence;
+	char *risk;
+};
+
+struct hdn_recovery_metadata_config {
+	struct hdn_recovery_metadata actions[HDN_RECOVERY_METADATA_MAX_ACTIONS];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] ACTION\n"
+		"\n"
+		"Prints product-approved recovery metadata for a named action.\n"
+		"Config lines: recovery NAME FIELD VALUE\n"
+		"Known fields: title, message, consequence, risk\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static char *next_word(char **cursor)
+{
+	char *word;
+	char *end;
+
+	*cursor = trim(*cursor);
+	if (!(*cursor)[0])
+		return NULL;
+
+	word = *cursor;
+	end = strpbrk(word, " \t");
+	if (!end) {
+		*cursor = word + strlen(word);
+		return word;
+	}
+
+	*end++ = '\0';
+	*cursor = end;
+	return word;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static int require_safe_text(const char *field, const char *value,
+			     unsigned int lineno)
+{
+	const unsigned char *p;
+	size_t len;
+
+	if (!value || !value[0]) {
+		fprintf(stderr,
+			"hdn-recovery-describe: missing %s text at line %u\n",
+			field, lineno);
+		return -EINVAL;
+	}
+
+	len = strlen(value);
+	if (len > HDN_RECOVERY_METADATA_MAX_VALUE) {
+		fprintf(stderr,
+			"hdn-recovery-describe: %s text too long at line %u\n",
+			field, lineno);
+		return -E2BIG;
+	}
+
+	for (p = (const unsigned char *)value; *p; p++) {
+		if (*p >= 0x20 && *p <= 0x7e)
+			continue;
+		fprintf(stderr,
+			"hdn-recovery-describe: unsafe %s text at line %u\n",
+			field, lineno);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static struct hdn_recovery_metadata *
+find_metadata(struct hdn_recovery_metadata_config *config, const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->actions[i].name, name))
+			return &config->actions[i];
+	}
+
+	return NULL;
+}
+
+static struct hdn_recovery_metadata *
+find_or_add_metadata(struct hdn_recovery_metadata_config *config,
+		     const char *name)
+{
+	struct hdn_recovery_metadata *meta;
+
+	meta = find_metadata(config, name);
+	if (meta)
+		return meta;
+
+	if (config->count >= HDN_RECOVERY_METADATA_MAX_ACTIONS) {
+		fprintf(stderr,
+			"hdn-recovery-describe: too many recovery metadata actions\n");
+		errno = E2BIG;
+		return NULL;
+	}
+
+	meta = &config->actions[config->count];
+	meta->name = strdup(name);
+	if (!meta->name) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	config->count++;
+	return meta;
+}
+
+static int set_field(char **slot, const char *field, const char *value,
+		     unsigned int lineno)
+{
+	char *copy;
+	int ret;
+
+	if (*slot) {
+		fprintf(stderr,
+			"hdn-recovery-describe: duplicate %s field at line %u\n",
+			field, lineno);
+		return -EINVAL;
+	}
+
+	ret = require_safe_text(field, value, lineno);
+	if (ret)
+		return ret;
+
+	copy = strdup(value);
+	if (!copy)
+		return -ENOMEM;
+
+	*slot = copy;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_recovery_metadata_config *config,
+			     char *line, unsigned int lineno)
+{
+	struct hdn_recovery_metadata *meta;
+	char *cursor;
+	char *key;
+	char *name;
+	char *field;
+	char *value;
+
+	cursor = trim(line);
+	if (!cursor[0] || cursor[0] == '#')
+		return 0;
+
+	key = next_word(&cursor);
+	name = next_word(&cursor);
+	field = next_word(&cursor);
+	value = trim(cursor);
+
+	if (!key || strcmp(key, "recovery")) {
+		fprintf(stderr,
+			"hdn-recovery-describe: unknown config key at line %u: %s\n",
+			lineno, key ? key : "(null)");
+		return -EINVAL;
+	}
+	if (!name || !field || !value[0]) {
+		fprintf(stderr,
+			"hdn-recovery-describe: recovery line %u needs NAME FIELD VALUE\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (!safe_name(name)) {
+		fprintf(stderr,
+			"hdn-recovery-describe: unsafe action name at line %u: %s\n",
+			lineno, name);
+		return -EINVAL;
+	}
+
+	meta = find_or_add_metadata(config, name);
+	if (!meta)
+		return -errno;
+
+	if (!strcmp(field, "title"))
+		return set_field(&meta->title, field, value, lineno);
+	if (!strcmp(field, "message"))
+		return set_field(&meta->message, field, value, lineno);
+	if (!strcmp(field, "consequence"))
+		return set_field(&meta->consequence, field, value, lineno);
+	if (!strcmp(field, "risk"))
+		return set_field(&meta->risk, field, value, lineno);
+
+	fprintf(stderr,
+		"hdn-recovery-describe: unknown recovery metadata field at line %u: %s\n",
+		lineno, field);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-recovery-describe: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-recovery-describe: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-recovery-describe: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_recovery_metadata_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_recovery_metadata_config *config)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		free(config->actions[i].name);
+		free(config->actions[i].title);
+		free(config->actions[i].message);
+		free(config->actions[i].consequence);
+		free(config->actions[i].risk);
+	}
+}
+
+static int describe_action(struct hdn_recovery_metadata_config *config,
+			   const char *action)
+{
+	struct hdn_recovery_metadata *meta;
+
+	meta = find_metadata(config, action);
+	if (!meta) {
+		fprintf(stderr,
+			"hdn-recovery-describe: recovery action is not product-approved: %s\n",
+			action);
+		return 1;
+	}
+
+	if (!meta->title || !meta->message || !meta->consequence) {
+		fprintf(stderr,
+			"hdn-recovery-describe: recovery action has incomplete metadata: %s\n",
+			action);
+		return 1;
+	}
+
+	printf("HDN_RECOVERY_METADATA_V1\n");
+	printf("action=%s\n", meta->name);
+	printf("title=%s\n", meta->title);
+	printf("message=%s\n", meta->message);
+	printf("consequence=%s\n", meta->consequence);
+	if (meta->risk)
+		printf("risk=%s\n", meta->risk);
+	return ferror(stdout) ? 1 : 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_recovery_metadata_config config;
+	const char *config_path = HDN_RECOVERY_METADATA_CONFIG;
+	const char *action = NULL;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!action) {
+			action = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!action || !safe_name(action)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	ret = describe_action(&config, action);
+	free_config(&config);
+	return ret;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-panel.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-panel.c
--- linux-7.0.12/tools/hardening/hdn-recovery-panel.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-panel.c	2026-07-15 13:46:19.748867681 -0500
@@ -0,0 +1,504 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_RECOVERY_PANEL_CONFIG
+#define HDN_RECOVERY_PANEL_CONFIG "/etc/hdn/recovery-panel.conf"
+#endif
+
+#ifndef HDN_RECOVERY_DESCRIBE_PATH
+#define HDN_RECOVERY_DESCRIBE_PATH "/usr/libexec/hdn-recovery-describe"
+#endif
+
+#ifndef HDN_RECOVERY_PORTAL_PATH
+#define HDN_RECOVERY_PORTAL_PATH "/usr/libexec/hdn-recovery-portal"
+#endif
+
+#define HDN_RECOVERY_PANEL_MAX_RULES 64
+
+struct hdn_recovery_panel_rule {
+	char *name;
+	char *describe_action;
+	char *portal_action;
+};
+
+struct hdn_recovery_panel_config {
+	char *describe_helper;
+	char *portal_helper;
+	struct hdn_recovery_panel_rule rules[HDN_RECOVERY_PANEL_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] describe RECOVERY_ACTION\n"
+		"       %s [--config FILE] [--dry-run] [--authorized] action RECOVERY_ACTION\n"
+		"       %s [--config FILE] [--dry-run] [--authorized] repair\n"
+		"       %s [--config FILE] [--dry-run] [--authorized] rollback\n"
+		"\n"
+		"Stable product-facing entry point for recovery panels.\n"
+		"Config lines:\n"
+		"  describe-helper PATH\n"
+		"  portal-helper PATH\n"
+		"  action RECOVERY_ACTION DESCRIBE_ACTION PORTAL_ACTION\n",
+		prog, prog, prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-recovery-panel: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-recovery-panel: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-recovery-panel: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_helper(char **slot, const char *kind, char **tokens,
+		      unsigned int count, unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-recovery-panel: %s line %u needs exactly one path\n",
+			kind, lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute(kind, tokens[1]))
+		return -EINVAL;
+	return replace_string(slot, tokens[1]);
+}
+
+static int add_action(struct hdn_recovery_panel_config *config, char **tokens,
+		      unsigned int count, unsigned int lineno)
+{
+	struct hdn_recovery_panel_rule *rule;
+
+	if (count != 4) {
+		fprintf(stderr,
+			"hdn-recovery-panel: action line %u needs RECOVERY_ACTION DESCRIBE_ACTION PORTAL_ACTION\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_RECOVERY_PANEL_MAX_RULES) {
+		fprintf(stderr, "hdn-recovery-panel: too many action rules\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1]) || !safe_name(tokens[2]) ||
+	    !safe_name(tokens[3])) {
+		fprintf(stderr,
+			"hdn-recovery-panel: unsafe action name at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->describe_action = strdup(tokens[2]);
+	rule->portal_action = strdup(tokens[3]);
+	if (!rule->name || !rule->describe_action || !rule->portal_action)
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_recovery_panel_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[4];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-recovery-panel: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "describe-helper"))
+		return set_helper(&config->describe_helper, "describe-helper",
+				  tokens, count, lineno);
+	if (!strcmp(tokens[0], "portal-helper"))
+		return set_helper(&config->portal_helper, "portal-helper",
+				  tokens, count, lineno);
+	if (!strcmp(tokens[0], "action"))
+		return add_action(config, tokens, count, lineno);
+
+	fprintf(stderr,
+		"hdn-recovery-panel: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-recovery-panel: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-recovery-panel: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-recovery-panel: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_recovery_panel_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->describe_helper,
+			     HDN_RECOVERY_DESCRIBE_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->portal_helper, HDN_RECOVERY_PORTAL_PATH);
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_recovery_panel_config *config)
+{
+	unsigned int i;
+
+	free(config->describe_helper);
+	free(config->portal_helper);
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].describe_action);
+		free(config->rules[i].portal_action);
+	}
+}
+
+static const struct hdn_recovery_panel_rule *
+find_action(const struct hdn_recovery_panel_config *config, const char *action)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, action))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_describe(const char *helper, const char *action)
+{
+	int err;
+
+	execl(helper, "hdn-recovery-describe", action, NULL);
+	err = errno;
+	fprintf(stderr, "hdn-recovery-panel: exec %s failed: %s\n",
+		helper, strerror(err));
+	return err == ENOENT ? 127 : 126;
+}
+
+static int run_portal_child(const char *helper, const char *action,
+			    bool dry_run, bool authorized)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-panel: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run && authorized)
+			execl(helper, "hdn-recovery-portal", "--dry-run",
+			      "--authorized", action, NULL);
+		else if (dry_run)
+			execl(helper, "hdn-recovery-portal", "--dry-run",
+			      action, NULL);
+		else if (authorized)
+			execl(helper, "hdn-recovery-portal", "--authorized",
+			      action, NULL);
+		else
+			execl(helper, "hdn-recovery-portal", action, NULL);
+		fprintf(stderr, "hdn-recovery-panel: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+static int run_panel_action(const char *portal_helper, const char *action,
+			    bool dry_run, bool authorized)
+{
+	return run_portal_child(portal_helper, action, dry_run, authorized);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_recovery_panel_config config;
+	const struct hdn_recovery_panel_rule *rule;
+	const char *config_path = HDN_RECOVERY_PANEL_CONFIG;
+	const char *command = NULL;
+	const char *action = NULL;
+	bool authorized = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "--authorized")) {
+			authorized = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else {
+			command = argv[i++];
+			break;
+		}
+	}
+
+	if (!command) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (authorized && geteuid() != 0) {
+		fprintf(stderr,
+			"hdn-recovery-panel: --authorized requires root\n");
+		return 1;
+	}
+
+	if (!strcmp(command, "repair")) {
+		action = "repair-system";
+		if (i != argc) {
+			usage(argv[0]);
+			return 2;
+		}
+	} else if (!strcmp(command, "rollback")) {
+		action = "rollback-policy";
+		if (i != argc) {
+			usage(argv[0]);
+			return 2;
+		}
+	} else if (!strcmp(command, "describe") ||
+		   !strcmp(command, "action")) {
+		if (i + 1 != argc || !safe_name(argv[i])) {
+			usage(argv[0]);
+			return 2;
+		}
+		action = argv[i];
+	} else {
+		usage(argv[0]);
+		return 2;
+	}
+
+	if (dry_run && !strcmp(command, "describe")) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	rule = find_action(&config, action);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-recovery-panel: action is not product-approved: %s\n",
+			action);
+		free_config(&config);
+		return 1;
+	}
+
+	if (!strcmp(command, "describe"))
+		ret = run_describe(config.describe_helper,
+				   rule->describe_action);
+	else
+		ret = run_panel_action(config.portal_helper,
+				       rule->portal_action, dry_run,
+				       authorized);
+
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-portal.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-portal.c
--- linux-7.0.12/tools/hardening/hdn-recovery-portal.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-portal.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,433 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_RECOVERY_PORTAL_CONFIG
+#define HDN_RECOVERY_PORTAL_CONFIG "/etc/hdn/recovery-portal.conf"
+#endif
+
+#ifndef HDN_RECOVERY_SESSION_PATH
+#define HDN_RECOVERY_SESSION_PATH "/usr/libexec/hdn-recovery-session"
+#endif
+
+#define HDN_RECOVERY_PORTAL_MAX_RULES 64
+
+struct hdn_recovery_portal_rule {
+	char *name;
+	char *session_action;
+};
+
+struct hdn_recovery_portal_config {
+	char *session_helper;
+	struct hdn_recovery_portal_rule rules[HDN_RECOVERY_PORTAL_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run] [--authorized] ACTION\n"
+		"\n"
+		"Runs a product-approved recovery UI action.\n"
+		"Config lines:\n"
+		"  session-helper PATH\n"
+		"  action RECOVERY_UI_ACTION RECOVERY_SESSION_ACTION\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-recovery-portal: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-recovery-portal: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-recovery-portal: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_session_helper(struct hdn_recovery_portal_config *config,
+			      char **tokens, unsigned int count,
+			      unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-recovery-portal: session-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("session-helper", tokens[1]))
+		return -EINVAL;
+	return replace_string(&config->session_helper, tokens[1]);
+}
+
+static int add_action(struct hdn_recovery_portal_config *config, char **tokens,
+		      unsigned int count, unsigned int lineno)
+{
+	struct hdn_recovery_portal_rule *rule;
+
+	if (count != 3) {
+		fprintf(stderr,
+			"hdn-recovery-portal: action line %u needs RECOVERY_UI_ACTION RECOVERY_SESSION_ACTION\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_RECOVERY_PORTAL_MAX_RULES) {
+		fprintf(stderr, "hdn-recovery-portal: too many action rules\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1]) || !safe_name(tokens[2])) {
+		fprintf(stderr,
+			"hdn-recovery-portal: unsafe action name at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->session_action = strdup(tokens[2]);
+	if (!rule->name || !rule->session_action)
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_recovery_portal_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[3];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-recovery-portal: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "session-helper"))
+		return set_session_helper(config, tokens, count, lineno);
+	if (!strcmp(tokens[0], "action"))
+		return add_action(config, tokens, count, lineno);
+
+	fprintf(stderr,
+		"hdn-recovery-portal: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-recovery-portal: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-recovery-portal: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-recovery-portal: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_recovery_portal_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->session_helper, HDN_RECOVERY_SESSION_PATH);
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_recovery_portal_config *config)
+{
+	unsigned int i;
+
+	free(config->session_helper);
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].session_action);
+	}
+}
+
+static const struct hdn_recovery_portal_rule *
+find_action(const struct hdn_recovery_portal_config *config,
+	    const char *action)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, action))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_recovery_session(const char *helper, const char *action,
+				bool dry_run, bool authorized)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-portal: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run && authorized)
+			execl(helper, "hdn-recovery-session", "--dry-run",
+			      "--authorized", action, NULL);
+		else if (dry_run)
+			execl(helper, "hdn-recovery-session", "--dry-run",
+			      action, NULL);
+		else if (authorized)
+			execl(helper, "hdn-recovery-session", "--authorized",
+			      action, NULL);
+		else
+			execl(helper, "hdn-recovery-session", action, NULL);
+		fprintf(stderr, "hdn-recovery-portal: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_recovery_portal_config config;
+	const struct hdn_recovery_portal_rule *rule;
+	const char *config_path = HDN_RECOVERY_PORTAL_CONFIG;
+	const char *action = NULL;
+	bool authorized = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "--authorized")) {
+			authorized = true;
+		} else if (!action) {
+			action = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!action || !safe_name(action)) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (authorized && geteuid() != 0) {
+		fprintf(stderr,
+			"hdn-recovery-portal: --authorized requires root\n");
+		return 1;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	rule = find_action(&config, action);
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-recovery-portal: action is not product-approved: %s\n",
+			action);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_recovery_session(config.session_helper, rule->session_action,
+				   dry_run, authorized);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-prompt.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-prompt.c
--- linux-7.0.12/tools/hardening/hdn-recovery-prompt.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-prompt.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#define HDN_RECOVERY_PROMPT_MAX_METADATA 8192
+#define HDN_RECOVERY_PROMPT_MAX_TEXT 512
+
+struct hdn_recovery_metadata {
+	char *action;
+	char *title;
+	char *message;
+	char *consequence;
+	char *risk;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--test-approve|--test-deny] ACTION\n"
+		"\n"
+		"Reads HDN recovery metadata on stdin, shows a recovery confirmation\n"
+		"prompt, and exits 0 only when the user approves.\n",
+		prog);
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool safe_text(const char *text)
+{
+	const unsigned char *p;
+	size_t len;
+
+	if (!text || !text[0])
+		return false;
+
+	len = strlen(text);
+	if (len > HDN_RECOVERY_PROMPT_MAX_TEXT)
+		return false;
+
+	for (p = (const unsigned char *)text; *p; p++) {
+		if (*p >= 0x20 && *p <= 0x7e)
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static int read_metadata(char **metadata)
+{
+	char *buf;
+	size_t done = 0;
+
+	buf = calloc(HDN_RECOVERY_PROMPT_MAX_METADATA + 1, 1);
+	if (!buf)
+		return -ENOMEM;
+
+	for (;;) {
+		ssize_t len;
+
+		len = read(STDIN_FILENO, buf + done,
+			   HDN_RECOVERY_PROMPT_MAX_METADATA - done);
+		if (len < 0) {
+			if (errno == EINTR)
+				continue;
+			free(buf);
+			return -errno;
+		}
+		if (!len)
+			break;
+		done += (size_t)len;
+		if (done == HDN_RECOVERY_PROMPT_MAX_METADATA) {
+			free(buf);
+			return -E2BIG;
+		}
+	}
+
+	if (!done) {
+		free(buf);
+		return -EINVAL;
+	}
+
+	buf[done] = '\0';
+	*metadata = buf;
+	return 0;
+}
+
+static int set_field(char **slot, char *value, bool action)
+{
+	if (*slot)
+		return -EINVAL;
+	if (action) {
+		if (!safe_name(value))
+			return -EINVAL;
+	} else if (!safe_text(value)) {
+		return -EINVAL;
+	}
+
+	*slot = value;
+	return 0;
+}
+
+static int parse_metadata(char *blob, struct hdn_recovery_metadata *metadata)
+{
+	char *save = NULL;
+	char *line;
+	bool magic = false;
+
+	memset(metadata, 0, sizeof(*metadata));
+
+	for (line = strtok_r(blob, "\n", &save); line;
+	     line = strtok_r(NULL, "\n", &save)) {
+		size_t len = strlen(line);
+
+		if (len && line[len - 1] == '\r')
+			line[--len] = '\0';
+		if (!len)
+			continue;
+		if (!strcmp(line, "HDN_RECOVERY_METADATA_V1")) {
+			magic = true;
+			continue;
+		}
+		if (!strncmp(line, "action=", 7)) {
+			if (set_field(&metadata->action, line + 7, true))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "title=", 6)) {
+			if (set_field(&metadata->title, line + 6, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "message=", 8)) {
+			if (set_field(&metadata->message, line + 8, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "consequence=", 12)) {
+			if (set_field(&metadata->consequence, line + 12, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "risk=", 5)) {
+			if (set_field(&metadata->risk, line + 5, false))
+				return -EINVAL;
+			continue;
+		}
+
+		return -EINVAL;
+	}
+
+	if (!magic || !metadata->action || !metadata->title ||
+	    !metadata->message || !metadata->consequence)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_prompt_tool(const char *path, char *const argv[])
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-prompt: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		execv(path, argv);
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child) ? 1 : 0;
+}
+
+static bool desktop_session_available(void)
+{
+	const char *display = getenv("DISPLAY");
+	const char *wayland = getenv("WAYLAND_DISPLAY");
+
+	return (display && display[0]) || (wayland && wayland[0]);
+}
+
+static int show_graphical_prompt(const struct hdn_recovery_metadata *metadata)
+{
+	char body[2048];
+
+	if (!desktop_session_available()) {
+		fprintf(stderr,
+			"hdn-recovery-prompt: no graphical session available; denying request\n");
+		return 1;
+	}
+
+	if (metadata->risk) {
+		snprintf(body, sizeof(body), "%s\n\n%s\n\nRisk: %s",
+			 metadata->message, metadata->consequence,
+			 metadata->risk);
+	} else {
+		snprintf(body, sizeof(body), "%s\n\n%s",
+			 metadata->message, metadata->consequence);
+	}
+
+	if (!access("/usr/bin/zenity", X_OK)) {
+		char *const argv[] = {
+			"zenity", "--question", "--title", metadata->title,
+			"--width", "480", "--ok-label", "Continue",
+			"--cancel-label", "Cancel", "--text", body, NULL
+		};
+
+		return run_prompt_tool("/usr/bin/zenity", argv);
+	}
+
+	if (!access("/usr/bin/kdialog", X_OK)) {
+		char *const argv[] = {
+			"kdialog", "--title", metadata->title,
+			"--yes-label", "Continue", "--no-label", "Cancel",
+			"--yesno", body, NULL
+		};
+
+		return run_prompt_tool("/usr/bin/kdialog", argv);
+	}
+
+	if (!access("/usr/bin/xmessage", X_OK)) {
+		char *const argv[] = {
+			"xmessage", "-center", "-title", metadata->title,
+			"-buttons", "Continue:0,Cancel:1", body, NULL
+		};
+
+		return run_prompt_tool("/usr/bin/xmessage", argv);
+	}
+
+	fprintf(stderr,
+		"hdn-recovery-prompt: no supported graphical prompt helper found\n");
+	return 1;
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_recovery_metadata metadata;
+	const char *action = NULL;
+	bool test_approve = false;
+	bool test_deny = false;
+	char *blob = NULL;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--help") || !strcmp(argv[i], "-h")) {
+			usage(argv[0]);
+			return 0;
+		}
+		if (!strcmp(argv[i], "--test-approve")) {
+			test_approve = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--test-deny")) {
+			test_deny = true;
+			continue;
+		}
+		if (!action) {
+			action = argv[i];
+			continue;
+		}
+		usage(argv[0]);
+		return 2;
+	}
+
+	if (!action || !safe_name(action) || (test_approve && test_deny)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = read_metadata(&blob);
+	if (ret) {
+		fprintf(stderr, "hdn-recovery-prompt: invalid recovery metadata\n");
+		return 1;
+	}
+
+	ret = parse_metadata(blob, &metadata);
+	if (ret || strcmp(metadata.action, action)) {
+		fprintf(stderr, "hdn-recovery-prompt: rejected recovery metadata\n");
+		free(blob);
+		return 1;
+	}
+
+	if (test_approve) {
+		free(blob);
+		return 0;
+	}
+	if (test_deny) {
+		free(blob);
+		return 1;
+	}
+
+	ret = show_graphical_prompt(&metadata);
+	free(blob);
+	return ret;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-session.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-session.c
--- linux-7.0.12/tools/hardening/hdn-recovery-session.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-session.c	2026-07-15 13:46:19.748867681 -0500
@@ -0,0 +1,672 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_RECOVERY_SESSION_CONFIG
+#define HDN_RECOVERY_SESSION_CONFIG "/etc/hdn/recovery-session.conf"
+#endif
+
+#ifndef HDN_RECOVERY_DESCRIBE_PATH
+#define HDN_RECOVERY_DESCRIBE_PATH "/usr/libexec/hdn-recovery-describe"
+#endif
+
+#ifndef HDN_RECOVERY_ACTION_PATH
+#define HDN_RECOVERY_ACTION_PATH "/usr/libexec/hdn-recovery-action"
+#endif
+
+#ifndef HDN_RECOVERY_CONFIRM_PATH
+#define HDN_RECOVERY_CONFIRM_PATH "/usr/libexec/hdn-recovery-confirm"
+#endif
+
+#define HDN_RECOVERY_SESSION_MAX_ARGS 16
+#define HDN_RECOVERY_SESSION_MAX_METADATA 8192
+
+struct hdn_recovery_session_config {
+	char *describe_helper;
+	char *action_helper;
+	char *confirm_argv[HDN_RECOVERY_SESSION_MAX_ARGS + 1];
+	unsigned int confirm_argc;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run] [--authorized] ACTION\n"
+		"\n"
+		"Runs a named recovery session: describe, confirm, then act.\n"
+		"Config lines:\n"
+		"  describe-helper PATH\n"
+		"  confirm-helper PATH [ARG...]\n"
+		"  action-helper PATH\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-recovery-session: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-recovery-session: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-recovery-session: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int require_safe_arg(const char *arg, unsigned int lineno)
+{
+	const unsigned char *p;
+
+	if (!arg || !arg[0]) {
+		fprintf(stderr,
+			"hdn-recovery-session: empty helper argument at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	for (p = (const unsigned char *)arg; *p; p++) {
+		if (*p >= 0x21 && *p <= 0x7e)
+			continue;
+		fprintf(stderr,
+			"hdn-recovery-session: unsafe helper argument at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_helper_path(char **slot, const char *kind, char **tokens,
+			   unsigned int count, unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-recovery-session: %s line %u needs exactly one path\n",
+			kind, lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute(kind, tokens[1]))
+		return -EINVAL;
+	return replace_string(slot, tokens[1]);
+}
+
+static int set_confirm_helper(struct hdn_recovery_session_config *config,
+			      char **tokens, unsigned int count,
+			      unsigned int lineno)
+{
+	unsigned int i;
+
+	if (count < 2) {
+		fprintf(stderr,
+			"hdn-recovery-session: confirm-helper line %u needs PATH [ARG...]\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (count > HDN_RECOVERY_SESSION_MAX_ARGS) {
+		fprintf(stderr,
+			"hdn-recovery-session: too many confirm-helper arguments at line %u\n",
+			lineno);
+		return -E2BIG;
+	}
+	if (require_safe_absolute("confirm-helper", tokens[1]))
+		return -EINVAL;
+
+	for (i = 2; i < count; i++) {
+		if (require_safe_arg(tokens[i], lineno))
+			return -EINVAL;
+	}
+
+	for (i = 0; i < config->confirm_argc; i++)
+		free(config->confirm_argv[i]);
+	config->confirm_argc = 0;
+
+	for (i = 1; i < count; i++) {
+		config->confirm_argv[config->confirm_argc] =
+			strdup(tokens[i]);
+		if (!config->confirm_argv[config->confirm_argc])
+			return -ENOMEM;
+		config->confirm_argc++;
+	}
+	config->confirm_argv[config->confirm_argc] = NULL;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_recovery_session_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[HDN_RECOVERY_SESSION_MAX_ARGS + 1];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-recovery-session: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "describe-helper"))
+		return set_helper_path(&config->describe_helper,
+				       "describe-helper", tokens, count,
+				       lineno);
+	if (!strcmp(tokens[0], "action-helper"))
+		return set_helper_path(&config->action_helper,
+				       "action-helper", tokens, count,
+				       lineno);
+	if (!strcmp(tokens[0], "confirm-helper"))
+		return set_confirm_helper(config, tokens, count, lineno);
+
+	fprintf(stderr,
+		"hdn-recovery-session: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-recovery-session: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-recovery-session: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-recovery-session: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_recovery_session_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret = 0;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->describe_helper,
+			     HDN_RECOVERY_DESCRIBE_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->action_helper, HDN_RECOVERY_ACTION_PATH);
+	if (ret)
+		return ret;
+	config->confirm_argv[0] = strdup(HDN_RECOVERY_CONFIRM_PATH);
+	if (!config->confirm_argv[0])
+		return -ENOMEM;
+	config->confirm_argc = 1;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_recovery_session_config *config)
+{
+	unsigned int i;
+
+	free(config->describe_helper);
+	free(config->action_helper);
+	for (i = 0; i < config->confirm_argc; i++)
+		free(config->confirm_argv[i]);
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int read_metadata_from_describe(const char *helper, const char *action,
+				       char **metadata)
+{
+	char buf[HDN_RECOVERY_SESSION_MAX_METADATA + 1];
+	size_t done = 0;
+	int pipefd[2];
+	pid_t child;
+	int status;
+
+	if (pipe(pipefd)) {
+		fprintf(stderr, "hdn-recovery-session: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-session: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(126);
+		close(pipefd[1]);
+		execl(helper, "hdn-recovery-describe", action, NULL);
+		fprintf(stderr, "hdn-recovery-session: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[1]);
+	for (;;) {
+		ssize_t len;
+
+		len = read(pipefd[0], buf + done,
+			   HDN_RECOVERY_SESSION_MAX_METADATA - done);
+		if (len < 0) {
+			if (errno == EINTR)
+				continue;
+			fprintf(stderr,
+				"hdn-recovery-session: read recovery metadata failed: %s\n",
+				strerror(errno));
+			close(pipefd[0]);
+			(void)child_status_result(child);
+			return 1;
+		}
+		if (!len)
+			break;
+		done += (size_t)len;
+		if (done == HDN_RECOVERY_SESSION_MAX_METADATA) {
+			fprintf(stderr,
+				"hdn-recovery-session: recovery metadata too large\n");
+			close(pipefd[0]);
+			(void)child_status_result(child);
+			return 1;
+		}
+	}
+	close(pipefd[0]);
+
+	status = child_status_result(child);
+	if (status)
+		return status;
+	if (!done) {
+		fprintf(stderr, "hdn-recovery-session: empty recovery metadata\n");
+		return 1;
+	}
+
+	buf[done] = '\0';
+	*metadata = strdup(buf);
+	if (!*metadata)
+		return 1;
+	return 0;
+}
+
+static bool metadata_has_line(const char *metadata, const char *line)
+{
+	const char *match = metadata;
+	size_t line_len = strlen(line);
+
+	while ((match = strstr(match, line))) {
+		if ((match == metadata || match[-1] == '\n') &&
+		    match[line_len] == '\n')
+			return true;
+		match += line_len;
+	}
+
+	return false;
+}
+
+static int validate_metadata(const char *metadata, const char *action)
+{
+	char expected[256];
+
+	if (!metadata_has_line(metadata, "HDN_RECOVERY_METADATA_V1")) {
+		fprintf(stderr,
+			"hdn-recovery-session: recovery metadata missing magic\n");
+		return 1;
+	}
+	if (snprintf(expected, sizeof(expected), "action=%s", action) >=
+	    (int)sizeof(expected)) {
+		fprintf(stderr, "hdn-recovery-session: action name too long\n");
+		return 1;
+	}
+	if (!metadata_has_line(metadata, expected)) {
+		fprintf(stderr,
+			"hdn-recovery-session: recovery metadata action mismatch\n");
+		return 1;
+	}
+
+	return 0;
+}
+
+static int write_all(int fd, const char *buf, size_t size)
+{
+	size_t done = 0;
+
+	while (done < size) {
+		ssize_t ret = write(fd, buf + done, size - done);
+
+		if (ret < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (!ret)
+			return -EIO;
+		done += (size_t)ret;
+	}
+
+	return 0;
+}
+
+static int run_confirm_helper(const struct hdn_recovery_session_config *config,
+			      const char *action, const char *metadata)
+{
+	char *argv[HDN_RECOVERY_SESSION_MAX_ARGS + 2];
+	int pipefd[2];
+	unsigned int i;
+	pid_t child;
+	int write_ret;
+	int status;
+
+	if (pipe(pipefd)) {
+		fprintf(stderr, "hdn-recovery-session: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-session: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[1]);
+		if (dup2(pipefd[0], STDIN_FILENO) < 0)
+			_exit(126);
+		close(pipefd[0]);
+		for (i = 0; i < config->confirm_argc; i++)
+			argv[i] = config->confirm_argv[i];
+		argv[config->confirm_argc] = (char *)action;
+		argv[config->confirm_argc + 1] = NULL;
+		execv(config->confirm_argv[0], argv);
+		fprintf(stderr, "hdn-recovery-session: exec %s failed: %s\n",
+			config->confirm_argv[0], strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[0]);
+	write_ret = write_all(pipefd[1], metadata, strlen(metadata));
+	close(pipefd[1]);
+	status = child_status_result(child);
+	if (write_ret && !status) {
+		fprintf(stderr,
+			"hdn-recovery-session: confirm helper input failed: %s\n",
+			strerror(-write_ret));
+		return 1;
+	}
+	return status ? 1 : 0;
+}
+
+static int run_action_helper(const char *helper, const char *action,
+			     bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-session: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(helper, "hdn-recovery-action", "--dry-run",
+			      action, NULL);
+		else
+			execl(helper, "hdn-recovery-action", action, NULL);
+		fprintf(stderr, "hdn-recovery-session: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_recovery_session_config config;
+	const char *config_path = HDN_RECOVERY_SESSION_CONFIG;
+	const char *action = NULL;
+	char *metadata = NULL;
+	bool authorized = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "--authorized")) {
+			authorized = true;
+		} else if (!action) {
+			action = argv[i];
+		} else {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	if (!action || !safe_name(action)) {
+		usage(argv[0]);
+		return 2;
+	}
+	if (authorized && geteuid() != 0) {
+		fprintf(stderr,
+			"hdn-recovery-session: --authorized requires root\n");
+		return 1;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	ret = read_metadata_from_describe(config.describe_helper, action,
+					  &metadata);
+	if (ret)
+		goto out;
+
+	ret = validate_metadata(metadata, action);
+	if (ret)
+		goto out;
+
+	if (!dry_run && !authorized) {
+		ret = run_confirm_helper(&config, action, metadata);
+		if (ret) {
+			fprintf(stderr,
+				"hdn-recovery-session: recovery confirmation denied: %s\n",
+				action);
+			goto out;
+		}
+	}
+
+	ret = run_action_helper(config.action_helper, action, true);
+	if (!ret && !dry_run)
+		ret = run_action_helper(config.action_helper, action, false);
+	if (ret)
+		fprintf(stderr,
+			"hdn-recovery-session: recovery action failed for %s\n",
+			action);
+
+out:
+	free(metadata);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-recovery-ui.c linux-7.0.12-hdn/tools/hardening/hdn-recovery-ui.c
--- linux-7.0.12/tools/hardening/hdn-recovery-ui.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-recovery-ui.c	2026-07-15 13:46:19.748867681 -0500
@@ -0,0 +1,835 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_RECOVERY_UI_CONFIG
+#define HDN_RECOVERY_UI_CONFIG "/etc/hdn/recovery-ui.conf"
+#endif
+
+#ifndef HDN_RECOVERY_PANEL_PATH
+#define HDN_RECOVERY_PANEL_PATH "/usr/libexec/hdn-recovery-panel"
+#endif
+
+#define HDN_RECOVERY_UI_MAX_ACTIONS 16
+#define HDN_RECOVERY_UI_MAX_METADATA 8192
+#define HDN_RECOVERY_UI_MAX_TEXT 512
+
+struct hdn_recovery_ui_action {
+	char *name;
+	char *title;
+};
+
+struct hdn_recovery_ui_config {
+	char *panel_helper;
+	char *title;
+	char *message;
+	struct hdn_recovery_ui_action actions[HDN_RECOVERY_UI_MAX_ACTIONS];
+	unsigned int count;
+};
+
+struct hdn_recovery_ui_metadata {
+	char *action;
+	char *title;
+	char *message;
+	char *consequence;
+	char *risk;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run]\n"
+		"       %s [--config FILE] [--dry-run] --test-choice RECOVERY_ACTION\n"
+		"       %s [--config FILE] --test-cancel\n"
+		"\n"
+		"Graphical recovery UI entry point above hdn-recovery-panel.\n"
+		"Config lines:\n"
+		"  panel-helper PATH\n"
+		"  title TEXT\n"
+		"  message TEXT\n"
+		"  action RECOVERY_ACTION\n",
+		prog, prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool safe_text(const char *text)
+{
+	const unsigned char *p;
+	size_t len;
+
+	if (!text || !text[0])
+		return false;
+
+	len = strlen(text);
+	if (len > HDN_RECOVERY_UI_MAX_TEXT)
+		return false;
+
+	for (p = (const unsigned char *)text; *p; p++) {
+		if (*p >= 0x20 && *p <= 0x7e)
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-recovery-ui: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr, "hdn-recovery-ui: %s / is too broad\n",
+			what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-recovery-ui: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int parse_panel_helper(struct hdn_recovery_ui_config *config,
+			      char *rest, unsigned int lineno)
+{
+	char *path = trim(rest);
+
+	if (!path[0] || strchr(path, ' ') || strchr(path, '\t')) {
+		fprintf(stderr,
+			"hdn-recovery-ui: panel-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("panel-helper", path))
+		return -EINVAL;
+	return replace_string(&config->panel_helper, path);
+}
+
+static int parse_text_field(char **slot, const char *key, char *rest,
+			    unsigned int lineno)
+{
+	char *value = trim(rest);
+
+	if (!safe_text(value)) {
+		fprintf(stderr,
+			"hdn-recovery-ui: unsafe %s text at line %u\n",
+			key, lineno);
+		return -EINVAL;
+	}
+	return replace_string(slot, value);
+}
+
+static int add_action(struct hdn_recovery_ui_config *config, char *rest,
+		      unsigned int lineno)
+{
+	struct hdn_recovery_ui_action *action;
+	char *name = trim(rest);
+
+	if (!safe_name(name) || strchr(name, ' ') || strchr(name, '\t')) {
+		fprintf(stderr,
+			"hdn-recovery-ui: unsafe action name at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_RECOVERY_UI_MAX_ACTIONS) {
+		fprintf(stderr, "hdn-recovery-ui: too many actions\n");
+		return -E2BIG;
+	}
+
+	action = &config->actions[config->count];
+	action->name = strdup(name);
+	if (!action->name)
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_recovery_ui_config *config,
+			     char *line, unsigned int lineno)
+{
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	if (!strncmp(line, "panel-helper", 12) &&
+	    (line[12] == ' ' || line[12] == '\t'))
+		return parse_panel_helper(config, line + 12, lineno);
+	if (!strncmp(line, "title", 5) &&
+	    (line[5] == ' ' || line[5] == '\t'))
+		return parse_text_field(&config->title, "title",
+					line + 5, lineno);
+	if (!strncmp(line, "message", 7) &&
+	    (line[7] == ' ' || line[7] == '\t'))
+		return parse_text_field(&config->message, "message",
+					line + 7, lineno);
+	if (!strncmp(line, "action", 6) &&
+	    (line[6] == ' ' || line[6] == '\t'))
+		return add_action(config, line + 6, lineno);
+
+	fprintf(stderr,
+		"hdn-recovery-ui: unknown config key at line %u\n",
+		lineno);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-recovery-ui: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-recovery-ui: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-recovery-ui: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path, struct hdn_recovery_ui_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->panel_helper, HDN_RECOVERY_PANEL_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->title, "System Recovery");
+	if (ret)
+		return ret;
+	ret = replace_string(&config->message, "Choose a recovery action.");
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+
+	if (!ret && !config->count) {
+		fprintf(stderr, "hdn-recovery-ui: no approved actions\n");
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+static void free_config(struct hdn_recovery_ui_config *config)
+{
+	unsigned int i;
+
+	free(config->panel_helper);
+	free(config->title);
+	free(config->message);
+	for (i = 0; i < config->count; i++) {
+		free(config->actions[i].name);
+		free(config->actions[i].title);
+	}
+}
+
+static struct hdn_recovery_ui_action *
+find_action(struct hdn_recovery_ui_config *config, const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->actions[i].name, name))
+			return &config->actions[i];
+	}
+
+	return NULL;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int read_pipe_limited(int fd, char **out)
+{
+	char *buf;
+	size_t done = 0;
+
+	buf = calloc(HDN_RECOVERY_UI_MAX_METADATA + 1, 1);
+	if (!buf)
+		return -ENOMEM;
+
+	for (;;) {
+		ssize_t len;
+
+		len = read(fd, buf + done, HDN_RECOVERY_UI_MAX_METADATA - done);
+		if (len < 0) {
+			if (errno == EINTR)
+				continue;
+			free(buf);
+			return -errno;
+		}
+		if (!len)
+			break;
+		done += (size_t)len;
+		if (done == HDN_RECOVERY_UI_MAX_METADATA) {
+			free(buf);
+			return -E2BIG;
+		}
+	}
+
+	buf[done] = '\0';
+	*out = buf;
+	return 0;
+}
+
+static int run_capture(char *const argv[], char **out)
+{
+	int pipefd[2];
+	pid_t child;
+	int ret;
+
+	if (pipe2(pipefd, O_CLOEXEC)) {
+		fprintf(stderr, "hdn-recovery-ui: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-ui: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(126);
+		close(pipefd[1]);
+		execv(argv[0], argv);
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[1]);
+	ret = read_pipe_limited(pipefd[0], out);
+	close(pipefd[0]);
+	if (ret) {
+		(void)child_status_result(child);
+		return 1;
+	}
+
+	ret = child_status_result(child);
+	return ret ? 1 : 0;
+}
+
+static int set_field(char **slot, char *value, bool action)
+{
+	if (*slot)
+		return -EINVAL;
+	if (action) {
+		if (!safe_name(value))
+			return -EINVAL;
+	} else if (!safe_text(value)) {
+		return -EINVAL;
+	}
+
+	*slot = value;
+	return 0;
+}
+
+static int parse_metadata(char *blob,
+			  struct hdn_recovery_ui_metadata *metadata)
+{
+	char *save = NULL;
+	char *line;
+	bool magic = false;
+
+	memset(metadata, 0, sizeof(*metadata));
+
+	for (line = strtok_r(blob, "\n", &save); line;
+	     line = strtok_r(NULL, "\n", &save)) {
+		size_t len = strlen(line);
+
+		if (len && line[len - 1] == '\r')
+			line[--len] = '\0';
+		if (!len)
+			continue;
+		if (!strcmp(line, "HDN_RECOVERY_METADATA_V1")) {
+			magic = true;
+			continue;
+		}
+		if (!strncmp(line, "action=", 7)) {
+			if (set_field(&metadata->action, line + 7, true))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "title=", 6)) {
+			if (set_field(&metadata->title, line + 6, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "message=", 8)) {
+			if (set_field(&metadata->message, line + 8, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "consequence=", 12)) {
+			if (set_field(&metadata->consequence, line + 12, false))
+				return -EINVAL;
+			continue;
+		}
+		if (!strncmp(line, "risk=", 5)) {
+			if (set_field(&metadata->risk, line + 5, false))
+				return -EINVAL;
+			continue;
+		}
+
+		return -EINVAL;
+	}
+
+	if (!magic || !metadata->action || !metadata->title ||
+	    !metadata->message || !metadata->consequence)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int describe_action(const char *helper, const char *action, char **title)
+{
+	struct hdn_recovery_ui_metadata metadata;
+	char *argv[] = {
+		(char *)helper, "describe", (char *)action, NULL
+	};
+	char *blob = NULL;
+	int ret;
+
+	ret = run_capture(argv, &blob);
+	if (ret) {
+		free(blob);
+		return ret;
+	}
+
+	ret = parse_metadata(blob, &metadata);
+	if (ret) {
+		fprintf(stderr,
+			"hdn-recovery-ui: rejected recovery metadata for %s\n",
+			action);
+		free(blob);
+		return 1;
+	}
+
+	ret = replace_string(title, metadata.title);
+	free(blob);
+	return ret ? 1 : 0;
+}
+
+static int describe_config_actions(struct hdn_recovery_ui_config *config)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		int ret;
+
+		ret = describe_action(config->panel_helper,
+				      config->actions[i].name,
+				      &config->actions[i].title);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static bool desktop_session_available(void)
+{
+	const char *display = getenv("DISPLAY");
+	const char *wayland = getenv("WAYLAND_DISPLAY");
+
+	return (display && display[0]) || (wayland && wayland[0]);
+}
+
+static int capture_selection(char *const argv[], char **selection)
+{
+	char *out = NULL;
+	char *chosen;
+	int ret;
+
+	ret = run_capture(argv, &out);
+	if (ret) {
+		free(out);
+		return ret;
+	}
+
+	chosen = trim(out);
+	if (!safe_name(chosen)) {
+		fprintf(stderr,
+			"hdn-recovery-ui: graphical selection was invalid\n");
+		free(out);
+		return 1;
+	}
+
+	ret = replace_string(selection, chosen);
+	free(out);
+	return ret ? 1 : 0;
+}
+
+static int choose_with_zenity(const struct hdn_recovery_ui_config *config,
+			      char **selection)
+{
+	char **argv;
+	unsigned int argc = 0;
+	unsigned int i;
+	int ret;
+
+	argv = calloc(14 + config->count * 2, sizeof(*argv));
+	if (!argv)
+		return 1;
+
+	argv[argc++] = "/usr/bin/zenity";
+	argv[argc++] = "--list";
+	argv[argc++] = "--title";
+	argv[argc++] = config->title;
+	argv[argc++] = "--width";
+	argv[argc++] = "640";
+	argv[argc++] = "--height";
+	argv[argc++] = "360";
+	argv[argc++] = "--column";
+	argv[argc++] = "Action";
+	argv[argc++] = "--column";
+	argv[argc++] = "Description";
+	argv[argc++] = "--print-column=1";
+	for (i = 0; i < config->count; i++) {
+		argv[argc++] = config->actions[i].name;
+		argv[argc++] = config->actions[i].title;
+	}
+	argv[argc] = NULL;
+
+	ret = capture_selection(argv, selection);
+	free(argv);
+	return ret;
+}
+
+static int choose_with_kdialog(const struct hdn_recovery_ui_config *config,
+			       char **selection)
+{
+	char **argv;
+	unsigned int argc = 0;
+	unsigned int i;
+	int ret;
+
+	argv = calloc(7 + config->count * 2, sizeof(*argv));
+	if (!argv)
+		return 1;
+
+	argv[argc++] = "/usr/bin/kdialog";
+	argv[argc++] = "--title";
+	argv[argc++] = config->title;
+	argv[argc++] = "--menu";
+	argv[argc++] = config->message;
+	for (i = 0; i < config->count; i++) {
+		argv[argc++] = config->actions[i].name;
+		argv[argc++] = config->actions[i].title;
+	}
+	argv[argc] = NULL;
+
+	ret = capture_selection(argv, selection);
+	free(argv);
+	return ret;
+}
+
+static int choose_graphical_action(struct hdn_recovery_ui_config *config,
+				   char **selection)
+{
+	int ret;
+
+	if (!desktop_session_available()) {
+		fprintf(stderr,
+			"hdn-recovery-ui: no graphical session available; denying request\n");
+		return 1;
+	}
+
+	ret = describe_config_actions(config);
+	if (ret)
+		return ret;
+
+	if (!access("/usr/bin/zenity", X_OK))
+		return choose_with_zenity(config, selection);
+	if (!access("/usr/bin/kdialog", X_OK))
+		return choose_with_kdialog(config, selection);
+
+	fprintf(stderr,
+		"hdn-recovery-ui: no supported graphical selection helper found\n");
+	return 1;
+}
+
+static int run_panel_child(const char *helper, const char *action, bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-recovery-ui: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(helper, "hdn-recovery-panel", "--dry-run",
+			      "action", action, NULL);
+		else
+			execl(helper, "hdn-recovery-panel", "action",
+			      action, NULL);
+		fprintf(stderr, "hdn-recovery-ui: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+static int run_selected_action(const struct hdn_recovery_ui_config *config,
+			       const char *action, bool dry_run)
+{
+	char *title = NULL;
+	int ret;
+
+	ret = describe_action(config->panel_helper, action, &title);
+	free(title);
+	if (ret)
+		return ret;
+
+	return run_panel_child(config->panel_helper, action, dry_run);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_recovery_ui_config config;
+	const char *config_path = HDN_RECOVERY_UI_CONFIG;
+	const char *test_choice = NULL;
+	char *selection = NULL;
+	bool test_cancel = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--test-choice")) {
+			if (++i >= argc || !safe_name(argv[i])) {
+				usage(argv[0]);
+				return 2;
+			}
+			test_choice = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--test-cancel")) {
+			test_cancel = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--help") || !strcmp(argv[i], "-h")) {
+			usage(argv[0]);
+			return 0;
+		}
+		usage(argv[0]);
+		return 2;
+	}
+
+	if ((test_choice && test_cancel) || (test_cancel && dry_run)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	if (test_cancel) {
+		free_config(&config);
+		return 1;
+	}
+
+	if (test_choice) {
+		if (!find_action(&config, test_choice)) {
+			fprintf(stderr,
+				"hdn-recovery-ui: action is not product-approved: %s\n",
+				test_choice);
+			free_config(&config);
+			return 1;
+		}
+		ret = run_selected_action(&config, test_choice, dry_run);
+		free_config(&config);
+		return ret ? 1 : 0;
+	}
+
+	ret = choose_graphical_action(&config, &selection);
+	if (ret) {
+		free_config(&config);
+		return 1;
+	}
+
+	if (!find_action(&config, selection)) {
+		fprintf(stderr,
+			"hdn-recovery-ui: selected action is not approved: %s\n",
+			selection);
+		free(selection);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_selected_action(&config, selection, dry_run);
+	free(selection);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-rofs-apply.c linux-7.0.12-hdn/tools/hardening/hdn-rofs-apply.c
--- linux-7.0.12/tools/hardening/hdn-rofs-apply.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-rofs-apply.c	2026-07-15 13:50:37.436497090 -0500
@@ -0,0 +1,430 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <linux/mount.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/mount.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#ifndef AT_RECURSIVE
+#define AT_RECURSIVE 0x8000
+#endif
+
+enum hdn_rofs_requirement {
+	HDN_ROFS_REQUIRED,
+	HDN_ROFS_OPTIONAL,
+	HDN_ROFS_BIND,
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [-r|--recursive] [-f PATHS.conf] [MOUNTPOINT...]\n"
+		"PATHS.conf entries: PATH, required PATH, optional PATH, or bind PATH\n",
+		prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static int decode_mountinfo_path(const char *src, char *dst, size_t dst_size)
+{
+	size_t di = 0;
+
+	while (*src) {
+		unsigned char ch;
+
+		if (di + 1 >= dst_size)
+			return -ENAMETOOLONG;
+
+		if (src[0] == '\\' &&
+		    src[1] >= '0' && src[1] <= '7' &&
+		    src[2] >= '0' && src[2] <= '7' &&
+		    src[3] >= '0' && src[3] <= '7') {
+			ch = ((src[1] - '0') << 6) |
+			     ((src[2] - '0') << 3) |
+			     (src[3] - '0');
+			src += 4;
+		} else {
+			ch = *src++;
+		}
+
+		dst[di++] = ch;
+	}
+
+	dst[di] = '\0';
+	return 0;
+}
+
+static int fallback_path_is_mountpoint(const char *path)
+{
+	char parent[PATH_MAX];
+	struct stat st;
+	struct stat parent_st;
+	size_t len;
+
+	if (!strcmp(path, "/"))
+		return 1;
+
+	len = strlen(path);
+	if (len + 4 > sizeof(parent))
+		return -ENAMETOOLONG;
+
+	memcpy(parent, path, len);
+	if (len > 1 && parent[len - 1] == '/')
+		memcpy(parent + len, "..", 3);
+	else
+		memcpy(parent + len, "/..", 4);
+
+	if (stat(path, &st))
+		return -errno;
+	if (stat(parent, &parent_st))
+		return -errno;
+
+	return st.st_dev != parent_st.st_dev ||
+	       (st.st_dev == parent_st.st_dev && st.st_ino == parent_st.st_ino);
+}
+
+static int path_is_mountpoint(const char *path)
+{
+	char *line = NULL;
+	size_t size = 0;
+	FILE *file;
+	int ret = 0;
+
+	file = fopen("/proc/self/mountinfo", "r");
+	if (!file)
+		return fallback_path_is_mountpoint(path);
+
+	while (getline(&line, &size, file) >= 0) {
+		char decoded[PATH_MAX];
+		char *fields = line;
+		char *mountpoint = NULL;
+		int i;
+
+		for (i = 0; i < 5; i++) {
+			mountpoint = strsep(&fields, " ");
+			if (!mountpoint)
+				break;
+		}
+		if (!mountpoint)
+			continue;
+
+		if (decode_mountinfo_path(mountpoint, decoded,
+					  sizeof(decoded)))
+			continue;
+		if (!strcmp(decoded, path)) {
+			ret = 1;
+			break;
+		}
+	}
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static int parse_config_entry(char *entry, const char **path,
+			      enum hdn_rofs_requirement *requirement)
+{
+	char *first = entry;
+	char *rest;
+
+	*requirement = HDN_ROFS_REQUIRED;
+	*path = entry;
+
+	if (entry[0] == '/')
+		return 0;
+
+	rest = first;
+	while (*rest && !isspace((unsigned char)*rest))
+		rest++;
+	if (*rest) {
+		*rest++ = '\0';
+		rest = trim(rest);
+	}
+
+	if (!strcmp(first, "required")) {
+		*requirement = HDN_ROFS_REQUIRED;
+		*path = rest;
+	} else if (!strcmp(first, "optional")) {
+		*requirement = HDN_ROFS_OPTIONAL;
+		*path = rest;
+	} else if (!strcmp(first, "bind")) {
+		*requirement = HDN_ROFS_BIND;
+		*path = rest;
+	} else {
+		fprintf(stderr,
+			"hdn-rofs-apply: unknown path-list directive: %s\n",
+			first);
+		return -EINVAL;
+	}
+
+	if (!*path || !(*path)[0]) {
+		fprintf(stderr,
+			"hdn-rofs-apply: missing path for %s entry\n", first);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int apply_mount_readonly(const char *path, bool recursive,
+				 bool bind_remount)
+{
+#ifdef __NR_mount_setattr
+	struct mount_attr attr = {
+		.attr_set = MOUNT_ATTR_RDONLY,
+	};
+	int flags = recursive ? AT_RECURSIVE : 0;
+
+	if (!syscall(__NR_mount_setattr, AT_FDCWD, path, flags, &attr,
+		     sizeof(attr)))
+		return 0;
+	if (errno != ENOSYS && errno != EINVAL && errno != EOPNOTSUPP)
+		return -errno;
+#endif
+
+	if (!recursive) {
+		unsigned long flags = MS_REMOUNT | MS_RDONLY;
+
+		if (bind_remount)
+			flags |= MS_BIND;
+		if (!mount(NULL, path, NULL, flags, NULL))
+			return 0;
+		return -errno;
+	}
+
+	return -EOPNOTSUPP;
+}
+
+static int ensure_bind_mount(const char *path, bool *created)
+{
+	int ret;
+
+	*created = false;
+	ret = path_is_mountpoint(path);
+	if (ret < 0)
+		return ret;
+	if (ret)
+		return 0;
+
+	if (mount(path, path, NULL, MS_BIND, NULL))
+		return -errno;
+	*created = true;
+	return 0;
+}
+
+static int apply_path(const char *path, bool recursive,
+		      enum hdn_rofs_requirement requirement)
+{
+	bool created_bind = false;
+	int ret;
+
+	if (!path[0] || path[0] != '/') {
+		fprintf(stderr, "hdn-rofs-apply: path must be absolute: %s\n",
+			path);
+		return -EINVAL;
+	}
+
+	if (requirement == HDN_ROFS_OPTIONAL) {
+		ret = path_is_mountpoint(path);
+		if (ret < 0) {
+			if (ret == -ENOENT) {
+				fprintf(stderr,
+					"hdn-rofs-apply: skipping absent optional path %s\n",
+					path);
+				return 0;
+			}
+			fprintf(stderr,
+				"hdn-rofs-apply: cannot inspect optional path %s: %s\n",
+				path, strerror(-ret));
+			return ret;
+		}
+		if (!ret) {
+			fprintf(stderr,
+				"hdn-rofs-apply: skipping optional non-mountpoint %s\n",
+				path);
+			return 0;
+		}
+	}
+
+	if (requirement == HDN_ROFS_BIND) {
+		ret = ensure_bind_mount(path, &created_bind);
+		if (ret) {
+			fprintf(stderr,
+				"hdn-rofs-apply: failed to establish bind mount at %s: %s\n",
+				path, strerror(-ret));
+			return ret;
+		}
+	}
+
+	ret = apply_mount_readonly(path, recursive, created_bind);
+	if (ret) {
+		fprintf(stderr,
+			"hdn-rofs-apply: failed to make %s read-only: %s\n",
+			path, strerror(-ret));
+		if (created_bind && umount2(path, MNT_DETACH))
+			fprintf(stderr,
+				"hdn-rofs-apply: failed to remove unsealed bind mount at %s: %s\n",
+				path, strerror(errno));
+	}
+
+	return ret;
+}
+
+static int apply_file(const char *path, bool recursive)
+{
+	char *line = NULL;
+	size_t size = 0;
+	ssize_t len;
+	FILE *file;
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+	int ret = 0;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-rofs-apply: cannot open %s: %s\n", path,
+			strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		ret = -errno;
+		fprintf(stderr, "hdn-rofs-apply: cannot stat %s: %s\n", path,
+			strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-rofs-apply: refusing unsafe path list %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		fprintf(stderr, "hdn-rofs-apply: fdopen %s failed: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		char *entry = trim(line);
+		enum hdn_rofs_requirement requirement;
+		const char *entry_path;
+		int path_ret;
+
+		(void)len;
+		if (!entry[0] || entry[0] == '#')
+			continue;
+
+		path_ret = parse_config_entry(entry, &entry_path,
+					      &requirement);
+		if (!path_ret)
+			path_ret = apply_path(entry_path, recursive,
+					      requirement);
+		if (path_ret && !ret)
+			ret = path_ret;
+	}
+
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+int main(int argc, char **argv)
+{
+	bool recursive = false;
+	const char *config = NULL;
+	bool saw_path = false;
+	int ret = 0;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "-r") || !strcmp(argv[i], "--recursive")) {
+			recursive = true;
+			continue;
+		} else if (!strcmp(argv[i], "-f") ||
+			   !strcmp(argv[i], "--file")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config = argv[i];
+			continue;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else if (!strcmp(argv[i], "--")) {
+			i++;
+			break;
+		} else if (argv[i][0] != '-') {
+			break;
+		}
+
+		usage(argv[0]);
+		return 2;
+	}
+
+	if (config) {
+		ret = apply_file(config, recursive);
+		if (ret)
+			return 1;
+	}
+
+	for (; i < argc; i++) {
+		int path_ret = apply_path(argv[i], recursive,
+					  HDN_ROFS_REQUIRED);
+
+		saw_path = true;
+		if (path_ret && !ret)
+			ret = path_ret;
+	}
+
+	if (!config && !saw_path) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-rofs-transaction.c linux-7.0.12-hdn/tools/hardening/hdn-rofs-transaction.c
--- linux-7.0.12/tools/hardening/hdn-rofs-transaction.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-rofs-transaction.c	2026-07-15 14:22:07.965697193 -0500
@@ -0,0 +1,490 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/mount.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/statvfs.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#define HDN_SEAL_RETRIES 20
+#define HDN_SEAL_RETRY_NS 250000000L
+#define HDN_CANCEL_POLL_NS 50000000L
+#define HDN_CANCEL_GRACE_POLLS 40
+
+static unsigned long legacy_remount_flags(const struct statvfs *state,
+					  bool readonly)
+{
+	unsigned long flags = MS_REMOUNT;
+
+	if (readonly)
+		flags |= MS_RDONLY;
+#ifdef ST_NOSUID
+	if (state->f_flag & ST_NOSUID)
+		flags |= MS_NOSUID;
+#endif
+#ifdef ST_NODEV
+	if (state->f_flag & ST_NODEV)
+		flags |= MS_NODEV;
+#endif
+#ifdef ST_NOEXEC
+	if (state->f_flag & ST_NOEXEC)
+		flags |= MS_NOEXEC;
+#endif
+#ifdef ST_SYNCHRONOUS
+	if (state->f_flag & ST_SYNCHRONOUS)
+		flags |= MS_SYNCHRONOUS;
+#endif
+#ifdef ST_MANDLOCK
+	if (state->f_flag & ST_MANDLOCK)
+		flags |= MS_MANDLOCK;
+#endif
+#ifdef ST_NOATIME
+	if (state->f_flag & ST_NOATIME)
+		flags |= MS_NOATIME;
+#endif
+#ifdef ST_NODIRATIME
+	if (state->f_flag & ST_NODIRATIME)
+		flags |= MS_NODIRATIME;
+#endif
+#ifdef ST_RELATIME
+	if (state->f_flag & ST_RELATIME)
+		flags |= MS_RELATIME;
+#endif
+#ifdef ST_NOSYMFOLLOW
+	if (state->f_flag & ST_NOSYMFOLLOW)
+		flags |= MS_NOSYMFOLLOW;
+#endif
+
+	return flags;
+}
+
+static int read_mount_state(const char *path, struct statvfs *state)
+{
+	if (!statvfs(path, state))
+		return 0;
+
+	return -errno;
+}
+
+static bool mount_state_matches(const struct statvfs *state, bool readonly)
+{
+	return !!(state->f_flag & ST_RDONLY) == readonly;
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr, "Usage: %s MOUNTPOINT -- COMMAND [ARG...]\n", prog);
+}
+
+static int remount_state_once(const char *path, bool readonly)
+{
+	struct statvfs state;
+	unsigned long flags;
+	int ret;
+
+#ifdef __NR_mount_setattr
+	struct mount_attr attr = {
+		.attr_set = readonly ? MOUNT_ATTR_RDONLY : 0,
+		.attr_clr = readonly ? 0 : MOUNT_ATTR_RDONLY,
+	};
+
+	if (!syscall(__NR_mount_setattr, AT_FDCWD, path, 0, &attr,
+		     sizeof(attr))) {
+		ret = read_mount_state(path, &state);
+		if (ret)
+			return ret;
+		if (mount_state_matches(&state, readonly))
+			return 0;
+		/* The superblock can remain read-only after clearing the mount bit. */
+	} else if (errno != ENOSYS && errno != EINVAL &&
+		   errno != EOPNOTSUPP) {
+		return -errno;
+	} else {
+		ret = read_mount_state(path, &state);
+		if (ret)
+			return ret;
+	}
+#else
+	ret = read_mount_state(path, &state);
+	if (ret)
+		return ret;
+#endif
+
+	flags = legacy_remount_flags(&state, readonly);
+	if (mount(NULL, path, NULL, flags, NULL))
+		return -errno;
+	ret = read_mount_state(path, &state);
+	if (ret)
+		return ret;
+	if (!mount_state_matches(&state, readonly))
+		return readonly ? -EIO : -EROFS;
+
+	return 0;
+}
+
+static int remount_state(const char *path, bool readonly)
+{
+	struct timespec delay = {
+		.tv_nsec = HDN_SEAL_RETRY_NS,
+	};
+	unsigned int attempts = readonly ? HDN_SEAL_RETRIES : 1;
+	unsigned int attempt;
+	int ret = -EIO;
+
+	for (attempt = 0; attempt < attempts; attempt++) {
+		ret = remount_state_once(path, readonly);
+		if (!ret)
+			return 0;
+		if (ret != -EBUSY || attempt + 1 == attempts)
+			break;
+		sync();
+		while (nanosleep(&delay, &delay) && errno == EINTR)
+			;
+		delay.tv_sec = 0;
+		delay.tv_nsec = HDN_SEAL_RETRY_NS;
+	}
+
+	fprintf(stderr, "hdn-rofs-transaction: remount %s %s failed: %s\n",
+		path, readonly ? "read-only" : "writable", strerror(-ret));
+	return ret;
+}
+
+static int status_code(int status)
+{
+	if (WIFEXITED(status))
+		return WEXITSTATUS(status);
+	if (WIFSIGNALED(status))
+		return 128 + WTERMSIG(status);
+
+	return 1;
+}
+
+static int next_cancel_signal(const sigset_t *cancel_set,
+			      const struct timespec *timeout)
+{
+	int signal;
+
+	for (;;) {
+		signal = sigtimedwait(cancel_set, NULL, timeout);
+		if (signal >= 0)
+			return signal;
+		if (errno == EAGAIN)
+			return 0;
+		if (errno != EINTR) {
+			fprintf(stderr,
+				"hdn-rofs-transaction: signal wait failed: %s\n",
+				strerror(errno));
+			return -errno;
+		}
+	}
+}
+
+static void signal_worker(pid_t child, bool worker_group, int signal)
+{
+	pid_t target = worker_group ? -child : child;
+
+	if (kill(target, signal) && errno != ESRCH)
+		fprintf(stderr,
+			"hdn-rofs-transaction: signal worker failed: %s\n",
+			strerror(errno));
+}
+
+static void reap_worker_group(pid_t child)
+{
+	int status;
+
+	for (;;) {
+		pid_t ret;
+
+		/* Each reap can adopt a deeper process-group member. */
+		signal_worker(child, true, SIGKILL);
+		ret = waitpid(-child, &status, 0);
+
+		if (ret > 0)
+			continue;
+		if (ret < 0 && errno == EINTR)
+			continue;
+		if (ret < 0 && errno != ECHILD)
+			fprintf(stderr,
+				"hdn-rofs-transaction: descendant wait failed: %s\n",
+				strerror(errno));
+		return;
+	}
+}
+
+static void cancel_worker(pid_t child, bool worker_group, int signal,
+			  int *status)
+{
+	const struct timespec delay = {
+		.tv_nsec = HDN_CANCEL_POLL_NS,
+	};
+	bool child_exited = false;
+	bool child_waitable = true;
+	unsigned int attempt;
+
+	signal_worker(child, worker_group, signal);
+	for (attempt = 0; attempt < HDN_CANCEL_GRACE_POLLS; attempt++) {
+		siginfo_t info = {};
+		int ret;
+
+		ret = waitid(P_PID, child, &info, WEXITED | WNOHANG | WNOWAIT);
+		if (!ret && info.si_pid == child) {
+			child_exited = true;
+			break;
+		}
+		if (ret && errno != EINTR) {
+			if (errno == ECHILD)
+				child_waitable = false;
+			else
+				fprintf(stderr,
+					"hdn-rofs-transaction: wait failed: %s\n",
+					strerror(errno));
+			break;
+		}
+		nanosleep(&delay, NULL);
+	}
+
+	/*
+	 * Stop descendants in the worker's process group before reaping the
+	 * direct child. Keeping the child waitable pins its PID and prevents a
+	 * reused process-group ID from being signaled here.
+	 */
+	if (worker_group && child_waitable)
+		signal_worker(child, true, SIGKILL);
+	else if (!child_exited && child_waitable)
+		signal_worker(child, false, SIGKILL);
+
+	while (child_waitable) {
+		pid_t ret = waitpid(child, status, 0);
+
+		if (ret == child) {
+			if (worker_group)
+				reap_worker_group(child);
+			return;
+		}
+		if (ret < 0 && errno == ECHILD)
+			return;
+		if (ret < 0 && errno != EINTR) {
+			fprintf(stderr,
+				"hdn-rofs-transaction: wait failed: %s\n",
+				strerror(errno));
+			return;
+		}
+	}
+}
+
+static int finish_worker(pid_t child, bool worker_group, int *status)
+{
+	/*
+	 * A successful direct worker must not be able to leave a background
+	 * writer behind. The waitid(WNOWAIT) caller keeps the direct child (and
+	 * therefore its process-group ID) pinned until the complete group has
+	 * been stopped and the child can be reaped safely.
+	 */
+	if (worker_group)
+		signal_worker(child, true, SIGKILL);
+
+	for (;;) {
+		pid_t ret = waitpid(child, status, 0);
+
+		if (ret == child) {
+			if (worker_group)
+				reap_worker_group(child);
+			return status_code(*status);
+		}
+		if (ret < 0 && errno == EINTR)
+			continue;
+		if (ret < 0)
+			fprintf(stderr,
+				"hdn-rofs-transaction: wait failed: %s\n",
+				strerror(errno));
+		return 1;
+	}
+}
+
+static int run_command(char **argv, const sigset_t *cancel_set,
+		       const sigset_t *old_mask, int *cancel_signal)
+{
+	const struct timespec no_wait = {};
+	const struct timespec poll_delay = {
+		.tv_nsec = HDN_CANCEL_POLL_NS,
+	};
+	bool worker_group = false;
+	int status = 0;
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-rofs-transaction: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (setpgid(0, 0)) {
+			fprintf(stderr,
+				"hdn-rofs-transaction: worker process group failed: %s\n",
+				strerror(errno));
+			_exit(126);
+		}
+		if (sigprocmask(SIG_SETMASK, old_mask, NULL)) {
+			fprintf(stderr,
+				"hdn-rofs-transaction: worker signal restore failed: %s\n",
+				strerror(errno));
+			_exit(126);
+		}
+		execv(argv[0], argv);
+		fprintf(stderr, "hdn-rofs-transaction: exec %s failed: %s\n",
+			argv[0], strerror(errno));
+		_exit(127);
+	}
+
+	if (!setpgid(child, child) || getpgid(child) == child)
+		worker_group = true;
+
+	for (;;) {
+		siginfo_t info = {};
+		int signal;
+		int ret;
+
+		signal = next_cancel_signal(cancel_set, &no_wait);
+		if (signal < 0) {
+			cancel_worker(child, worker_group, SIGTERM, &status);
+			return 1;
+		}
+		if (signal > 0) {
+			*cancel_signal = signal;
+			cancel_worker(child, worker_group, signal, &status);
+			return 128 + signal;
+		}
+
+		ret = waitid(P_PID, child, &info, WEXITED | WNOHANG | WNOWAIT);
+		if (!ret && info.si_pid == child)
+			return finish_worker(child, worker_group, &status);
+		if (ret && errno != EINTR) {
+			fprintf(stderr, "hdn-rofs-transaction: wait failed: %s\n",
+				strerror(errno));
+			cancel_worker(child, worker_group, SIGTERM, &status);
+			return 1;
+		}
+
+		signal = next_cancel_signal(cancel_set, &poll_delay);
+		if (signal < 0) {
+			cancel_worker(child, worker_group, SIGTERM, &status);
+			return 1;
+		}
+		if (signal > 0) {
+			*cancel_signal = signal;
+			cancel_worker(child, worker_group, signal, &status);
+			return 128 + signal;
+		}
+	}
+}
+
+int main(int argc, char **argv)
+{
+	const char *mountpoint;
+	const struct timespec no_wait = {};
+	sigset_t cancel_set;
+	sigset_t old_mask;
+	int command_arg = 2;
+	int command_status;
+	int cancel_signal = 0;
+	int seal_ret;
+	int signal;
+
+	if (argc < 4) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	mountpoint = argv[1];
+	if (mountpoint[0] != '/') {
+		fprintf(stderr,
+			"hdn-rofs-transaction: mountpoint must be absolute: %s\n",
+			mountpoint);
+		return 2;
+	}
+
+	if (!strcmp(argv[command_arg], "--")) {
+		command_arg++;
+		if (command_arg >= argc) {
+			usage(argv[0]);
+			return 2;
+		}
+	}
+
+	sigemptyset(&cancel_set);
+	sigaddset(&cancel_set, SIGHUP);
+	sigaddset(&cancel_set, SIGINT);
+	sigaddset(&cancel_set, SIGQUIT);
+	sigaddset(&cancel_set, SIGTERM);
+	if (sigprocmask(SIG_BLOCK, &cancel_set, &old_mask)) {
+		fprintf(stderr,
+			"hdn-rofs-transaction: signal setup failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	signal = next_cancel_signal(&cancel_set, &no_wait);
+	if (signal) {
+		sigprocmask(SIG_SETMASK, &old_mask, NULL);
+		return signal > 0 ? 128 + signal : 1;
+	}
+	if (prctl(PR_SET_CHILD_SUBREAPER, 1)) {
+		fprintf(stderr,
+			"hdn-rofs-transaction: subreaper setup failed: %s\n",
+			strerror(errno));
+		sigprocmask(SIG_SETMASK, &old_mask, NULL);
+		return 1;
+	}
+
+	if (remount_state(mountpoint, false)) {
+		sigprocmask(SIG_SETMASK, &old_mask, NULL);
+		return 1;
+	}
+
+	signal = next_cancel_signal(&cancel_set, &no_wait);
+	if (signal > 0) {
+		cancel_signal = signal;
+		command_status = 128 + signal;
+	} else if (signal < 0) {
+		command_status = 1;
+	} else {
+		command_status = run_command(&argv[command_arg], &cancel_set,
+					     &old_mask, &cancel_signal);
+	}
+
+	seal_ret = remount_state(mountpoint, true);
+	for (;;) {
+		signal = next_cancel_signal(&cancel_set, &no_wait);
+		if (signal <= 0)
+			break;
+		if (!cancel_signal)
+			cancel_signal = signal;
+	}
+	if (sigprocmask(SIG_SETMASK, &old_mask, NULL)) {
+		fprintf(stderr,
+			"hdn-rofs-transaction: signal restore failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+	if (seal_ret)
+		return 1;
+	if (cancel_signal)
+		return 128 + cancel_signal;
+
+	return command_status;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-settings-panel.c linux-7.0.12-hdn/tools/hardening/hdn-settings-panel.c
--- linux-7.0.12/tools/hardening/hdn-settings-panel.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-settings-panel.c	2026-07-15 13:46:19.744867686 -0500
@@ -0,0 +1,482 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_SETTINGS_PANEL_CONFIG
+#define HDN_SETTINGS_PANEL_CONFIG "/etc/hdn/settings-panel.conf"
+#endif
+
+#ifndef HDN_CONTROL_CENTER_PATH
+#define HDN_CONTROL_CENTER_PATH "/usr/libexec/hdn-control-center"
+#endif
+
+#define HDN_SETTINGS_PANEL_MAX_RULES 128
+
+struct hdn_settings_panel_rule {
+	char *name;
+	char *control_action;
+};
+
+struct hdn_settings_panel_config {
+	char *control_center;
+	struct hdn_settings_panel_rule rules[HDN_SETTINGS_PANEL_MAX_RULES];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] status [HDN_STATUS_ARGS...]\n"
+		"       %s [--config FILE] [--dry-run] action SETTINGS_ACTION\n"
+		"       %s [--config FILE] [--dry-run] update\n"
+		"\n"
+		"Stable product-facing entry point for graphical settings panels.\n"
+		"Config lines:\n"
+		"  control-center-helper PATH\n"
+		"  action SETTINGS_ACTION CONTROL_CENTER_ACTION\n",
+		prog, prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-settings-panel: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr,
+			"hdn-settings-panel: %s / is too broad\n", what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-settings-panel: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int set_control_center(struct hdn_settings_panel_config *config,
+			      char **tokens, unsigned int count,
+			      unsigned int lineno)
+{
+	if (count != 2) {
+		fprintf(stderr,
+			"hdn-settings-panel: control-center-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("control-center-helper", tokens[1]))
+		return -EINVAL;
+	return replace_string(&config->control_center, tokens[1]);
+}
+
+static int add_action(struct hdn_settings_panel_config *config, char **tokens,
+		      unsigned int count, unsigned int lineno)
+{
+	struct hdn_settings_panel_rule *rule;
+
+	if (count != 3) {
+		fprintf(stderr,
+			"hdn-settings-panel: action line %u needs SETTINGS_ACTION CONTROL_CENTER_ACTION\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_SETTINGS_PANEL_MAX_RULES) {
+		fprintf(stderr, "hdn-settings-panel: too many action rules\n");
+		return -E2BIG;
+	}
+	if (!safe_name(tokens[1]) || !safe_name(tokens[2])) {
+		fprintf(stderr,
+			"hdn-settings-panel: unsafe action name at line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+
+	rule = &config->rules[config->count];
+	rule->name = strdup(tokens[1]);
+	rule->control_action = strdup(tokens[2]);
+	if (!rule->name || !rule->control_action)
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_settings_panel_config *config,
+			     char *line, unsigned int lineno)
+{
+	char *tokens[3];
+	unsigned int count = 0;
+	char *save = NULL;
+	char *word;
+
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	for (word = strtok_r(line, " \t", &save); word;
+	     word = strtok_r(NULL, " \t", &save)) {
+		if (count >= sizeof(tokens) / sizeof(tokens[0])) {
+			fprintf(stderr,
+				"hdn-settings-panel: too many fields at line %u\n",
+				lineno);
+			return -E2BIG;
+		}
+		tokens[count++] = word;
+	}
+
+	if (!count)
+		return 0;
+	if (!strcmp(tokens[0], "control-center-helper"))
+		return set_control_center(config, tokens, count, lineno);
+	if (!strcmp(tokens[0], "action"))
+		return add_action(config, tokens, count, lineno);
+
+	fprintf(stderr,
+		"hdn-settings-panel: unknown config key at line %u: %s\n",
+		lineno, tokens[0]);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-settings-panel: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-settings-panel: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-settings-panel: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path,
+		       struct hdn_settings_panel_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->control_center, HDN_CONTROL_CENTER_PATH);
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+	return ret;
+}
+
+static void free_config(struct hdn_settings_panel_config *config)
+{
+	unsigned int i;
+
+	free(config->control_center);
+	for (i = 0; i < config->count; i++) {
+		free(config->rules[i].name);
+		free(config->rules[i].control_action);
+	}
+}
+
+static const struct hdn_settings_panel_rule *
+find_action(const struct hdn_settings_panel_config *config, const char *action)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->rules[i].name, action))
+			return &config->rules[i];
+	}
+
+	return NULL;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int run_status(const char *control_center, int argc, char **argv)
+{
+	char **status_argv;
+	int err;
+	int i;
+
+	status_argv = calloc((size_t)argc + 3, sizeof(*status_argv));
+	if (!status_argv)
+		return 1;
+
+	status_argv[0] = "hdn-control-center";
+	status_argv[1] = "status";
+	for (i = 0; i < argc; i++)
+		status_argv[i + 2] = argv[i];
+	status_argv[argc + 2] = NULL;
+
+	execv(control_center, status_argv);
+	err = errno;
+	fprintf(stderr, "hdn-settings-panel: exec %s failed: %s\n",
+		control_center, strerror(err));
+	free(status_argv);
+	return err == ENOENT ? 127 : 126;
+}
+
+static int run_control_action_child(const char *control_center,
+				    const char *action, bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-settings-panel: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(control_center, "hdn-control-center",
+			      "--dry-run", "action", action, NULL);
+		else
+			execl(control_center, "hdn-control-center",
+			      "action", action, NULL);
+		fprintf(stderr, "hdn-settings-panel: exec %s failed: %s\n",
+			control_center, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+static int run_settings_action(const char *control_center, const char *action,
+			       bool dry_run)
+{
+	return run_control_action_child(control_center, action, dry_run);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_settings_panel_config config;
+	const struct hdn_settings_panel_rule *rule;
+	const char *config_path = HDN_SETTINGS_PANEL_CONFIG;
+	const char *command = NULL;
+	int command_index = 0;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+		} else if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+		} else if (!strcmp(argv[i], "-h") ||
+			   !strcmp(argv[i], "--help")) {
+			usage(argv[0]);
+			return 0;
+		} else {
+			command = argv[i];
+			command_index = i + 1;
+			break;
+		}
+	}
+
+	if (!command) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	if (!strcmp(command, "status")) {
+		if (dry_run) {
+			free_config(&config);
+			usage(argv[0]);
+			return 2;
+		}
+		ret = run_status(config.control_center, argc - command_index,
+				 &argv[command_index]);
+		free_config(&config);
+		return ret;
+	}
+
+	if (!strcmp(command, "update")) {
+		if (command_index != argc) {
+			free_config(&config);
+			usage(argv[0]);
+			return 2;
+		}
+		rule = find_action(&config, "updates.install");
+	} else if (!strcmp(command, "action")) {
+		if (command_index + 1 != argc ||
+		    !safe_name(argv[command_index])) {
+			free_config(&config);
+			usage(argv[0]);
+			return 2;
+		}
+		rule = find_action(&config, argv[command_index]);
+	} else {
+		free_config(&config);
+		usage(argv[0]);
+		return 2;
+	}
+
+	if (!rule) {
+		fprintf(stderr,
+			"hdn-settings-panel: action is not product-approved\n");
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_settings_action(config.control_center, rule->control_action,
+				  dry_run);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/tools/hardening/hdn-settings-ui.c linux-7.0.12-hdn/tools/hardening/hdn-settings-ui.c
--- linux-7.0.12/tools/hardening/hdn-settings-ui.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/tools/hardening/hdn-settings-ui.c	2026-07-15 13:46:19.748867681 -0500
@@ -0,0 +1,744 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef HDN_SETTINGS_UI_CONFIG
+#define HDN_SETTINGS_UI_CONFIG "/etc/hdn/settings-ui.conf"
+#endif
+
+#ifndef HDN_SETTINGS_PANEL_PATH
+#define HDN_SETTINGS_PANEL_PATH "/usr/libexec/hdn-settings-panel"
+#endif
+
+#define HDN_SETTINGS_UI_MAX_ACTIONS 32
+#define HDN_SETTINGS_UI_MAX_TEXT 512
+#define HDN_SETTINGS_UI_MAX_STATUS 8192
+
+struct hdn_settings_ui_action {
+	char *name;
+	char *label;
+};
+
+struct hdn_settings_ui_config {
+	char *settings_panel;
+	char *title;
+	char *message;
+	struct hdn_settings_ui_action actions[HDN_SETTINGS_UI_MAX_ACTIONS];
+	unsigned int count;
+};
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s [--config FILE] [--dry-run]\n"
+		"       %s [--config FILE] [--dry-run] --test-choice SETTINGS_ACTION\n"
+		"       %s [--config FILE] --test-cancel\n"
+		"\n"
+		"Graphical settings UI entry point above hdn-settings-panel.\n"
+		"Config lines:\n"
+		"  settings-panel-helper PATH\n"
+		"  title TEXT\n"
+		"  message TEXT\n"
+		"  action SETTINGS_ACTION LABEL\n",
+		prog, prog, prog);
+}
+
+static char *trim(char *line)
+{
+	char *end;
+
+	while (*line == ' ' || *line == '\t' || *line == '\r' ||
+	       *line == '\n')
+		line++;
+
+	end = line + strlen(line);
+	while (end > line &&
+	       (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+		end[-1] == '\n'))
+		*--end = '\0';
+
+	return line;
+}
+
+static bool safe_name(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || !strcmp(name, ".") || !strcmp(name, ".."))
+		return false;
+
+	for (p = name; *p; p++) {
+		if ((*p >= 'A' && *p <= 'Z') ||
+		    (*p >= 'a' && *p <= 'z') ||
+		    (*p >= '0' && *p <= '9') ||
+		    *p == '.' || *p == '_' || *p == '-')
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool safe_text(const char *text)
+{
+	const unsigned char *p;
+	size_t len;
+
+	if (!text || !text[0])
+		return false;
+
+	len = strlen(text);
+	if (len > HDN_SETTINGS_UI_MAX_TEXT)
+		return false;
+
+	for (p = (const unsigned char *)text; *p; p++) {
+		if (*p >= 0x20 && *p <= 0x7e)
+			continue;
+		return false;
+	}
+
+	return true;
+}
+
+static bool path_has_dot_component(const char *path)
+{
+	const char *part = path;
+
+	while (*part) {
+		const char *slash;
+		size_t len;
+
+		while (*part == '/')
+			part++;
+		if (!*part)
+			break;
+
+		slash = strchr(part, '/');
+		len = slash ? (size_t)(slash - part) : strlen(part);
+		if ((len == 1 && part[0] == '.') ||
+		    (len == 2 && part[0] == '.' && part[1] == '.'))
+			return true;
+		part += len;
+	}
+
+	return false;
+}
+
+static int require_safe_absolute(const char *what, const char *path)
+{
+	if (!path || path[0] != '/') {
+		fprintf(stderr,
+			"hdn-settings-ui: %s must be absolute: %s\n",
+			what, path ? path : "(null)");
+		return -EINVAL;
+	}
+	if (!strcmp(path, "/")) {
+		fprintf(stderr, "hdn-settings-ui: %s / is too broad\n",
+			what);
+		return -EINVAL;
+	}
+	if (path_has_dot_component(path)) {
+		fprintf(stderr,
+			"hdn-settings-ui: %s must not contain . or .. path components: %s\n",
+			what, path);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int replace_string(char **slot, const char *value)
+{
+	char *copy = strdup(value);
+
+	if (!copy)
+		return -ENOMEM;
+	free(*slot);
+	*slot = copy;
+	return 0;
+}
+
+static int parse_settings_panel(struct hdn_settings_ui_config *config,
+				char *rest, unsigned int lineno)
+{
+	char *path = trim(rest);
+
+	if (!path[0] || strchr(path, ' ') || strchr(path, '\t')) {
+		fprintf(stderr,
+			"hdn-settings-ui: settings-panel-helper line %u needs exactly one path\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (require_safe_absolute("settings-panel-helper", path))
+		return -EINVAL;
+	return replace_string(&config->settings_panel, path);
+}
+
+static int parse_text_field(char **slot, const char *key, char *rest,
+			    unsigned int lineno)
+{
+	char *value = trim(rest);
+
+	if (!safe_text(value)) {
+		fprintf(stderr,
+			"hdn-settings-ui: unsafe %s text at line %u\n",
+			key, lineno);
+		return -EINVAL;
+	}
+	return replace_string(slot, value);
+}
+
+static int add_action(struct hdn_settings_ui_config *config, char *rest,
+		      unsigned int lineno)
+{
+	struct hdn_settings_ui_action *action;
+	char *name = trim(rest);
+	char *label;
+
+	label = strpbrk(name, " \t");
+	if (!label) {
+		fprintf(stderr,
+			"hdn-settings-ui: action line %u needs SETTINGS_ACTION LABEL\n",
+			lineno);
+		return -EINVAL;
+	}
+	*label++ = '\0';
+	label = trim(label);
+
+	if (!safe_name(name) || !safe_text(label)) {
+		fprintf(stderr,
+			"hdn-settings-ui: unsafe action line %u\n",
+			lineno);
+		return -EINVAL;
+	}
+	if (config->count >= HDN_SETTINGS_UI_MAX_ACTIONS) {
+		fprintf(stderr, "hdn-settings-ui: too many actions\n");
+		return -E2BIG;
+	}
+
+	action = &config->actions[config->count];
+	action->name = strdup(name);
+	action->label = strdup(label);
+	if (!action->name || !action->label)
+		return -ENOMEM;
+	config->count++;
+	return 0;
+}
+
+static int parse_config_line(struct hdn_settings_ui_config *config,
+			     char *line, unsigned int lineno)
+{
+	line = trim(line);
+	if (!line[0] || line[0] == '#')
+		return 0;
+
+	if (!strncmp(line, "settings-panel-helper", 21) &&
+	    (line[21] == ' ' || line[21] == '\t'))
+		return parse_settings_panel(config, line + 21, lineno);
+	if (!strncmp(line, "title", 5) &&
+	    (line[5] == ' ' || line[5] == '\t'))
+		return parse_text_field(&config->title, "title",
+					line + 5, lineno);
+	if (!strncmp(line, "message", 7) &&
+	    (line[7] == ' ' || line[7] == '\t'))
+		return parse_text_field(&config->message, "message",
+					line + 7, lineno);
+	if (!strncmp(line, "action", 6) &&
+	    (line[6] == ' ' || line[6] == '\t'))
+		return add_action(config, line + 6, lineno);
+
+	fprintf(stderr,
+		"hdn-settings-ui: unknown config key at line %u\n",
+		lineno);
+	return -EINVAL;
+}
+
+static int open_config(const char *path)
+{
+	struct stat st;
+	int flags = O_RDONLY | O_CLOEXEC;
+	int fd;
+
+#ifdef O_NOFOLLOW
+	flags |= O_NOFOLLOW;
+#endif
+
+	fd = open(path, flags);
+	if (fd < 0) {
+		fprintf(stderr, "hdn-settings-ui: cannot open %s: %s\n",
+			path, strerror(errno));
+		return -errno;
+	}
+
+	if (fstat(fd, &st)) {
+		int ret = -errno;
+
+		fprintf(stderr, "hdn-settings-ui: cannot stat %s: %s\n",
+			path, strerror(errno));
+		close(fd);
+		return ret;
+	}
+
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022)) {
+		fprintf(stderr,
+			"hdn-settings-ui: refusing unsafe config %s\n",
+			path);
+		close(fd);
+		return -EACCES;
+	}
+
+	return fd;
+}
+
+static int load_config(const char *path, struct hdn_settings_ui_config *config)
+{
+	char *line = NULL;
+	size_t size = 0;
+	unsigned int lineno = 0;
+	ssize_t len;
+	FILE *file;
+	int ret;
+	int fd;
+
+	memset(config, 0, sizeof(*config));
+
+	ret = replace_string(&config->settings_panel, HDN_SETTINGS_PANEL_PATH);
+	if (ret)
+		return ret;
+	ret = replace_string(&config->title, "System Settings");
+	if (ret)
+		return ret;
+	ret = replace_string(&config->message, "Choose an approved system action.");
+	if (ret)
+		return ret;
+
+	fd = open_config(path);
+	if (fd < 0)
+		return fd;
+
+	file = fdopen(fd, "r");
+	if (!file) {
+		ret = -errno;
+		close(fd);
+		return ret;
+	}
+
+	while ((len = getline(&line, &size, file)) >= 0) {
+		(void)len;
+		lineno++;
+		ret = parse_config_line(config, line, lineno);
+		if (ret)
+			break;
+	}
+	if (ferror(file) && !ret)
+		ret = -EIO;
+
+	free(line);
+	fclose(file);
+
+	if (!ret && !config->count) {
+		fprintf(stderr, "hdn-settings-ui: no approved actions\n");
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
+
+static void free_config(struct hdn_settings_ui_config *config)
+{
+	unsigned int i;
+
+	free(config->settings_panel);
+	free(config->title);
+	free(config->message);
+	for (i = 0; i < config->count; i++) {
+		free(config->actions[i].name);
+		free(config->actions[i].label);
+	}
+}
+
+static struct hdn_settings_ui_action *
+find_action(struct hdn_settings_ui_config *config, const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < config->count; i++) {
+		if (!strcmp(config->actions[i].name, name))
+			return &config->actions[i];
+	}
+
+	return NULL;
+}
+
+static int child_status_result(pid_t child)
+{
+	int status;
+
+	if (waitpid(child, &status, 0) < 0)
+		return 1;
+	if (!WIFEXITED(status))
+		return 1;
+	return WEXITSTATUS(status);
+}
+
+static int read_pipe_limited(int fd, char **out)
+{
+	char *buf;
+	size_t done = 0;
+
+	buf = calloc(HDN_SETTINGS_UI_MAX_STATUS + 1, 1);
+	if (!buf)
+		return -ENOMEM;
+
+	for (;;) {
+		ssize_t len;
+
+		len = read(fd, buf + done, HDN_SETTINGS_UI_MAX_STATUS - done);
+		if (len < 0) {
+			if (errno == EINTR)
+				continue;
+			free(buf);
+			return -errno;
+		}
+		if (!len)
+			break;
+		done += (size_t)len;
+		if (done == HDN_SETTINGS_UI_MAX_STATUS) {
+			free(buf);
+			return -E2BIG;
+		}
+	}
+
+	buf[done] = '\0';
+	*out = buf;
+	return 0;
+}
+
+static int run_capture(char *const argv[], char **out)
+{
+	int pipefd[2];
+	pid_t child;
+	int ret;
+
+	if (pipe2(pipefd, O_CLOEXEC)) {
+		fprintf(stderr, "hdn-settings-ui: pipe failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-settings-ui: fork failed: %s\n",
+			strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return 1;
+	}
+
+	if (!child) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(126);
+		close(pipefd[1]);
+		execv(argv[0], argv);
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	close(pipefd[1]);
+	ret = read_pipe_limited(pipefd[0], out);
+	close(pipefd[0]);
+	if (ret) {
+		(void)child_status_result(child);
+		return 1;
+	}
+
+	ret = child_status_result(child);
+	return ret ? 1 : 0;
+}
+
+static int validate_status(const char *helper)
+{
+	char *argv[] = {
+		(char *)helper, "status", NULL
+	};
+	char *status = NULL;
+	int ret;
+
+	ret = run_capture(argv, &status);
+	if (ret) {
+		free(status);
+		return ret;
+	}
+
+	if (!status || !strstr(status, "available=1")) {
+		fprintf(stderr,
+			"hdn-settings-ui: settings status is not available\n");
+		free(status);
+		return 1;
+	}
+
+	free(status);
+	return 0;
+}
+
+static bool desktop_session_available(void)
+{
+	const char *display = getenv("DISPLAY");
+	const char *wayland = getenv("WAYLAND_DISPLAY");
+
+	return (display && display[0]) || (wayland && wayland[0]);
+}
+
+static int capture_selection(char *const argv[], char **selection)
+{
+	char *out = NULL;
+	char *chosen;
+	int ret;
+
+	ret = run_capture(argv, &out);
+	if (ret) {
+		free(out);
+		return ret;
+	}
+
+	chosen = trim(out);
+	if (!safe_name(chosen)) {
+		fprintf(stderr,
+			"hdn-settings-ui: graphical selection was invalid\n");
+		free(out);
+		return 1;
+	}
+
+	ret = replace_string(selection, chosen);
+	free(out);
+	return ret ? 1 : 0;
+}
+
+static int choose_with_zenity(const struct hdn_settings_ui_config *config,
+			      char **selection)
+{
+	char **argv;
+	unsigned int argc = 0;
+	unsigned int i;
+	int ret;
+
+	argv = calloc(14 + config->count * 2, sizeof(*argv));
+	if (!argv)
+		return 1;
+
+	argv[argc++] = "/usr/bin/zenity";
+	argv[argc++] = "--list";
+	argv[argc++] = "--title";
+	argv[argc++] = config->title;
+	argv[argc++] = "--width";
+	argv[argc++] = "640";
+	argv[argc++] = "--height";
+	argv[argc++] = "360";
+	argv[argc++] = "--column";
+	argv[argc++] = "Action";
+	argv[argc++] = "--column";
+	argv[argc++] = "Description";
+	argv[argc++] = "--print-column=1";
+	for (i = 0; i < config->count; i++) {
+		argv[argc++] = config->actions[i].name;
+		argv[argc++] = config->actions[i].label;
+	}
+	argv[argc] = NULL;
+
+	ret = capture_selection(argv, selection);
+	free(argv);
+	return ret;
+}
+
+static int choose_with_kdialog(const struct hdn_settings_ui_config *config,
+			       char **selection)
+{
+	char **argv;
+	unsigned int argc = 0;
+	unsigned int i;
+	int ret;
+
+	argv = calloc(7 + config->count * 2, sizeof(*argv));
+	if (!argv)
+		return 1;
+
+	argv[argc++] = "/usr/bin/kdialog";
+	argv[argc++] = "--title";
+	argv[argc++] = config->title;
+	argv[argc++] = "--menu";
+	argv[argc++] = config->message;
+	for (i = 0; i < config->count; i++) {
+		argv[argc++] = config->actions[i].name;
+		argv[argc++] = config->actions[i].label;
+	}
+	argv[argc] = NULL;
+
+	ret = capture_selection(argv, selection);
+	free(argv);
+	return ret;
+}
+
+static int choose_graphical_action(struct hdn_settings_ui_config *config,
+				   char **selection)
+{
+	int ret;
+
+	if (!desktop_session_available()) {
+		fprintf(stderr,
+			"hdn-settings-ui: no graphical session available; denying request\n");
+		return 1;
+	}
+
+	ret = validate_status(config->settings_panel);
+	if (ret)
+		return ret;
+
+	if (!access("/usr/bin/zenity", X_OK))
+		return choose_with_zenity(config, selection);
+	if (!access("/usr/bin/kdialog", X_OK))
+		return choose_with_kdialog(config, selection);
+
+	fprintf(stderr,
+		"hdn-settings-ui: no supported graphical selection helper found\n");
+	return 1;
+}
+
+static int run_panel_child(const char *helper, const char *action, bool dry_run)
+{
+	pid_t child;
+
+	child = fork();
+	if (child < 0) {
+		fprintf(stderr, "hdn-settings-ui: fork failed: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	if (!child) {
+		if (dry_run)
+			execl(helper, "hdn-settings-panel", "--dry-run",
+			      "action", action, NULL);
+		else
+			execl(helper, "hdn-settings-panel", "action",
+			      action, NULL);
+		fprintf(stderr, "hdn-settings-ui: exec %s failed: %s\n",
+			helper, strerror(errno));
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+
+	return child_status_result(child);
+}
+
+static int run_selected_action(const struct hdn_settings_ui_config *config,
+			       const char *action, bool dry_run)
+{
+	int ret;
+
+	ret = validate_status(config->settings_panel);
+	if (ret)
+		return ret;
+
+	return run_panel_child(config->settings_panel, action, dry_run);
+}
+
+int main(int argc, char **argv)
+{
+	struct hdn_settings_ui_config config;
+	const char *config_path = HDN_SETTINGS_UI_CONFIG;
+	const char *test_choice = NULL;
+	char *selection = NULL;
+	bool test_cancel = false;
+	bool dry_run = false;
+	int ret;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--config")) {
+			if (++i >= argc) {
+				usage(argv[0]);
+				return 2;
+			}
+			config_path = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--dry-run")) {
+			dry_run = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--test-choice")) {
+			if (++i >= argc || !safe_name(argv[i])) {
+				usage(argv[0]);
+				return 2;
+			}
+			test_choice = argv[i];
+			continue;
+		}
+		if (!strcmp(argv[i], "--test-cancel")) {
+			test_cancel = true;
+			continue;
+		}
+		if (!strcmp(argv[i], "--help") || !strcmp(argv[i], "-h")) {
+			usage(argv[0]);
+			return 0;
+		}
+		usage(argv[0]);
+		return 2;
+	}
+
+	if ((test_choice && test_cancel) || (test_cancel && dry_run)) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	ret = load_config(config_path, &config);
+	if (ret)
+		return 1;
+
+	if (test_cancel) {
+		free_config(&config);
+		return 1;
+	}
+
+	if (test_choice) {
+		if (!find_action(&config, test_choice)) {
+			fprintf(stderr,
+				"hdn-settings-ui: action is not product-approved: %s\n",
+				test_choice);
+			free_config(&config);
+			return 1;
+		}
+		ret = run_selected_action(&config, test_choice, dry_run);
+		free_config(&config);
+		return ret ? 1 : 0;
+	}
+
+	ret = choose_graphical_action(&config, &selection);
+	if (ret) {
+		free_config(&config);
+		return 1;
+	}
+
+	if (!find_action(&config, selection)) {
+		fprintf(stderr,
+			"hdn-settings-ui: selected action is not approved: %s\n",
+			selection);
+		free(selection);
+		free_config(&config);
+		return 1;
+	}
+
+	ret = run_selected_action(&config, selection, dry_run);
+	free(selection);
+	free_config(&config);
+	return ret ? 1 : 0;
+}
