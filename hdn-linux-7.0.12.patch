+static bool securityfs_status_has_line(const char *expected)
+{
+	char buf[8192] = {};
+	char *line;
+	char *save;
+	int fd;
+	ssize_t len;
+
+	fd = open(HDN_STATUS, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	len = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (len <= 0)
+		return false;
+
+	for (line = strtok_r(buf, "\n", &save); line;
+	     line = strtok_r(NULL, "\n", &save)) {
+		if (!strcmp(line, expected))
+			return true;
+	}
+
+	return false;
+}
+
+static bool securityfs_status_u64(const char *key, unsigned long long *value)
+{
+	char buf[8192] = {};
+	size_t key_len = strlen(key);
+	char *line;
+	char *save;
+	int fd;
+	ssize_t len;
+
+	fd = open(HDN_STATUS, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	len = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (len <= 0)
+		return false;
+
+	for (line = strtok_r(buf, "\n", &save); line;
+	     line = strtok_r(NULL, "\n", &save)) {
+		char *end;
+
+		if (strncmp(line, key, key_len))
+			continue;
+		line += key_len;
+		while (*line == ' ' || *line == '\t')
+			line++;
+		errno = 0;
+		*value = strtoull(line, &end, 0);
+		return !errno && end != line;
+	}
+
+	return false;
+}
