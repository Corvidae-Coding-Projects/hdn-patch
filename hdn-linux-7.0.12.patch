+	HDN_ALLOC_KEY_AUTH,
+	HDN_ALLOC_KEYRING_NODE,
+	HDN_ALLOC_KEYRING_SHORTCUT,
+	HDN_ALLOC_SEAL_METADATA,
+	HDN_ALLOC_MODULE,
+	HDN_ALLOC_CRED,
+	HDN_ALLOC_FILE,
+	HDN_ALLOC_BACKING_FILE,
+	HDN_ALLOC_KEY,
+	HDN_ALLOC_NSPROXY,
+	HDN_ALLOC_PID_NAMESPACE,
+	HDN_ALLOC_USER_NAMESPACE,
+	HDN_ALLOC_UTS_NAMESPACE,
+	HDN_ALLOC_NET_NAMESPACE,
+	HDN_ALLOC_MOUNT,
