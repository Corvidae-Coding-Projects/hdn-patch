+static int proc_self_ipaddr_equals(const char *expected)
+{
+	char buf[64] = {};
+	int fd;
+	ssize_t len;
+
+	fd = open(HDN_PROC_SELF_IPADDR, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
