+#include <linux/module.h>
+
+static unsigned int mode;
+module_param(mode, uint, 0400);
+
+extern int hdn_bpf_execmem_test_run(unsigned int mode);
+
+static int __init hdn_bpf_execmem_test_init(void)
+{
+	int error = hdn_bpf_execmem_test_run(mode);
+
+	if (!error)
+		pr_info("HDN_BPF_EXECMEM_GUEST_READY mode=%u\n", mode);
+	return error;
+}
+
+static void __exit hdn_bpf_execmem_test_exit(void)
+{
+}
+
+module_init(hdn_bpf_execmem_test_init);
+module_exit(hdn_bpf_execmem_test_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HDN BPF executable-memory destructive fixture");
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/capabilities.c linux-7.0.12-hdn/security/hardening/capabilities.c
--- linux-7.0.12/security/hardening/capabilities.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/capabilities.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/hdn_capabilities.h>
+#include <linux/hdn_slab.h>
+#include <linux/hdn_alloc.h>
+#include <linux/hdn_jitter.h>
+#include <linux/kernel.h>
+#include <linux/seq_file.h>
+
+static const char *const capability_names[] = {
+#define HDN_CAP_NAME(symbol, name) [HDN_CAP_##symbol] = #name,
+	HDN_CAPABILITY_LIST(HDN_CAP_NAME)
+#undef HDN_CAP_NAME
+};
+static_assert(ARRAY_SIZE(capability_names) == HDN_CAP__MAX);
+static_assert(HDN_CAP__MAX < 32);
+
+#ifndef CONFIG_HDN_ARCH_CONTRACT
+static struct hdn_capability_record unsupported(enum hdn_capability_id id)
+{
+	return hdn_cap_record(id, HDN_CAP_UNSUPPORTED, HDN_CAP_BACKING_NONE);
+}
+const struct hdn_arch_contract hdn_arch_contract = {
+	.name = "unsupported", .query = unsupported,
+};
+#endif
+
+bool hdn_capability_record_valid(enum hdn_capability_id id,
+				 const struct hdn_capability_record *record)
+{
+	return (unsigned int)id < HDN_CAP__MAX && record && record->id == id &&
+	       record->state <= HDN_CAP_NOT_APPLICABLE &&
+	       record->backing <= HDN_CAP_BACKING_HYBRID;
+}
+
+bool hdn_capability_state_satisfies_requirement(enum hdn_capability_state state)
+{
+	return state == HDN_CAP_ENFORCED || state == HDN_CAP_NOT_APPLICABLE;
+}
+
+struct hdn_capability_record hdn_capability(enum hdn_capability_id id)
+{
+	struct hdn_capability_record cap;
+
+	switch (id) {
+	case HDN_CAP_IMMUTABLE_POLICY:
+		return hdn_cap_option(id, IS_ENABLED(CONFIG_SECURITY_HARDENING_KERNSEAL));
+	case HDN_CAP_SYSFS_VIEW:
+		return hdn_cap_option(id, IS_ENABLED(CONFIG_SECURITY_HARDENING_SYSFS_VIEW));
+	case HDN_CAP_TYPED_SLAB:
+#ifdef CONFIG_SECURITY_HARDENING_AUTOSLAB
+	{
+		struct hdn_alloc_stats stats;
+
+		hdn_alloc_get_stats(&stats);
+		return hdn_cap_record(id, stats.ready ? HDN_CAP_ENFORCED :
+				     HDN_CAP_INITIALIZING, HDN_CAP_BACKING_SOFTWARE);
+	}
+#else
+		return hdn_cap_option(id, false);
+#endif
+	case HDN_CAP_CRITICAL_JITTER:
+#ifdef CONFIG_SECURITY_HARDENING_SLAB_JITTER
+	{
+		struct hdn_jitter_stats stats;
+
+		hdn_jitter_get_stats(&stats);
+		return hdn_cap_record(id, !stats.entropy_ready ? HDN_CAP_INITIALIZING :
+				     stats.early_live ? HDN_CAP_DEGRADED :
+				     HDN_CAP_ENFORCED, HDN_CAP_BACKING_SOFTWARE);
+	}
+#else
+		return hdn_cap_option(id, false);
+#endif
+	case HDN_CAP_SLAB_LAYOUT:
+#ifdef CONFIG_SECURITY_HARDENING_SLAB_LAYOUT
+	{
+		struct hdn_slab_layout_stats stats;
+
+		hdn_slab_layout_stats(&stats);
+		return hdn_cap_record(id, stats.active ? HDN_CAP_ENFORCED :
+				     HDN_CAP_INITIALIZING, HDN_CAP_BACKING_SOFTWARE);
+	}
+#else
+		return hdn_cap_option(id, false);
+#endif
+	default:
+		cap = hdn_arch_contract.query(id);
+		if (!hdn_capability_record_valid(id, &cap))
+			return hdn_cap_record(id, HDN_CAP_UNDECLARED, HDN_CAP_BACKING_NONE);
+		return cap;
+	}
+}
+
+int hdn_capabilities_require(u32 required)
+{
+	unsigned int id;
+
+	if (required & ~HDN_CAP_KNOWN_MASK)
+		return -EINVAL;
+	for (id = 0; id < HDN_CAP__MAX; id++) {
+		struct hdn_capability_record cap;
+
+		if (!(required & HDN_CAP_REQUIRED(id)))
+			continue;
+		cap = hdn_capability(id);
+		if (!hdn_capability_state_satisfies_requirement(cap.state))
+			return -EOPNOTSUPP;
+	}
+	return 0;
+}
+
+void hdn_capabilities_show(struct seq_file *m)
+{
+	static const char *const states[] = {
+		"undeclared", "unsupported", "disabled", "initializing", "degraded",
+		"enforced", "not-applicable",
+	};
+	static const char *const backing[] = { "none", "hardware", "software", "hybrid" };
+	unsigned int id;
+
+	seq_printf(m, "capability_version: %u\n", HDN_CAPABILITY_ABI_VERSION);
+	seq_printf(m, "capability_architecture: %s\n", hdn_arch_contract.name);
+	for (id = 0; id < HDN_CAP__MAX; id++) {
+		struct hdn_capability_record cap = hdn_capability(id);
+
+		seq_printf(m, "capability.%s: %s,%s\n", capability_names[id],
+			   states[cap.state], backing[cap.backing]);
+	}
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/capabilities_test.c linux-7.0.12-hdn/security/hardening/capabilities_test.c
--- linux-7.0.12/security/hardening/capabilities_test.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/capabilities_test.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/hdn_capabilities.h>
+
+static void hdn_capability_states_test(struct kunit *test)
+{
+	enum hdn_capability_state state;
+	enum hdn_capability_backing backing;
+
+	for (state = HDN_CAP_UNDECLARED; state <= HDN_CAP_NOT_APPLICABLE; state++) {
+		for (backing = HDN_CAP_BACKING_NONE;
+		     backing <= HDN_CAP_BACKING_HYBRID; backing++) {
+			struct hdn_capability_record record =
+				hdn_cap_record(HDN_CAP_KERNEL_WX, state, backing);
+
+			KUNIT_EXPECT_TRUE(test, hdn_capability_record_valid(
+				HDN_CAP_KERNEL_WX, &record));
+		}
+	}
+}
+
+static void hdn_capability_invalid_test(struct kunit *test)
+{
+	struct hdn_capability_record record = hdn_cap_record(
+		HDN_CAP_KERNEL_WX, HDN_CAP_ENFORCED, HDN_CAP_BACKING_SOFTWARE);
+
+	KUNIT_EXPECT_FALSE(test, hdn_capability_record_valid(HDN_CAP__MAX, &record));
+	KUNIT_EXPECT_FALSE(test, hdn_capability_record_valid(HDN_CAP_KERNEL_WX, NULL));
+	record.id = HDN_CAP_STATIC_ALIASES;
+	KUNIT_EXPECT_FALSE(test, hdn_capability_record_valid(HDN_CAP_KERNEL_WX, &record));
+	record.id = HDN_CAP_KERNEL_WX;
+	record.state = HDN_CAP_NOT_APPLICABLE + 1;
+	KUNIT_EXPECT_FALSE(test, hdn_capability_record_valid(HDN_CAP_KERNEL_WX, &record));
+	record.state = HDN_CAP_ENFORCED;
+	record.backing = HDN_CAP_BACKING_HYBRID + 1;
+	KUNIT_EXPECT_FALSE(test, hdn_capability_record_valid(HDN_CAP_KERNEL_WX, &record));
+}
+
+static void hdn_capability_requirement_states_test(struct kunit *test)
+{
+	enum hdn_capability_state state;
+
+	for (state = HDN_CAP_UNDECLARED; state <= HDN_CAP_NOT_APPLICABLE; state++)
+		KUNIT_EXPECT_EQ(test,
+			hdn_capability_state_satisfies_requirement(state),
+			state == HDN_CAP_ENFORCED || state == HDN_CAP_NOT_APPLICABLE);
+}
+
+static void hdn_capability_inventory_test(struct kunit *test)
+{
+	enum hdn_capability_id id;
+
+	for (id = 0; id < HDN_CAP__MAX; id++) {
+		struct hdn_capability_record record = hdn_capability(id);
+
+		KUNIT_EXPECT_TRUE(test, hdn_capability_record_valid(id, &record));
+	}
+	KUNIT_EXPECT_EQ(test, hdn_capabilities_require(~HDN_CAP_KNOWN_MASK), -EINVAL);
+}
+
+static struct kunit_case hdn_capability_cases[] = {
+	KUNIT_CASE(hdn_capability_states_test),
+	KUNIT_CASE(hdn_capability_invalid_test),
+	KUNIT_CASE(hdn_capability_requirement_states_test),
+	KUNIT_CASE(hdn_capability_inventory_test),
+	{}
+};
+
+static struct kunit_suite hdn_capability_suite = {
+	.name = "hdn-architecture-capabilities",
+	.test_cases = hdn_capability_cases,
+};
+
+kunit_test_suite(hdn_capability_suite);
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/constify_target_module.c linux-7.0.12-hdn/security/hardening/constify_target_module.c
--- linux-7.0.12/security/hardening/constify_target_module.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/constify_target_module.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Load first; its post-init section is sealed before the probe module starts. */
+#include <linux/cache.h>
+#include <linux/init.h>
+#include <linux/module.h>
+
+#define HDN_CONSTIFY_MODULE_MAGIC 0xc0571f1ed5ea1edULL
+
+static u64 hdn_constify_module_value __ro_after_init;
+
+const u64 *hdn_constify_module_probe_value(void)
+{
+	return &hdn_constify_module_value;
+}
+EXPORT_SYMBOL_GPL(hdn_constify_module_probe_value);
+
+static int __init hdn_constify_target_init(void)
+{
+	hdn_constify_module_value = HDN_CONSTIFY_MODULE_MAGIC;
+	return 0;
+}
+module_init(hdn_constify_target_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HDN post-init immutable module target");
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/security/hardening/constify_test_module.c linux-7.0.12-hdn/security/hardening/constify_test_module.c
--- linux-7.0.12/security/hardening/constify_test_module.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/security/hardening/constify_test_module.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Load only after constify_target_module has reached MODULE_STATE_LIVE. */
+#include <kunit/test.h>
+#include <linux/highmem.h>
+#include <linux/module.h>
+#include <linux/set_memory.h>
+#include <linux/uaccess.h>
+#include <linux/vmalloc.h>
+#include <asm/pgtable.h>
+
+#define HDN_CONSTIFY_MODULE_MAGIC 0xc0571f1ed5ea1edULL
+
+extern const u64 *hdn_constify_module_probe_value(void);
+
+static void hdn_constify_module_storage(struct kunit *test)
+{
+	const u64 *target = hdn_constify_module_probe_value();
+	struct page *page;
+	unsigned int level;
+	pte_t *pte;
+	void *alias;
+	u64 value;
+	int error;
+
+	KUNIT_ASSERT_NOT_NULL(test, target);
+	KUNIT_ASSERT_EQ(test, READ_ONCE(*target), HDN_CONSTIFY_MODULE_MAGIC);
+	pte = lookup_address((unsigned long)target, &level);
+	KUNIT_ASSERT_NOT_NULL(test, pte);
+	KUNIT_EXPECT_TRUE(test, pte_present(*pte));
+	KUNIT_EXPECT_FALSE(test, pte_write(*pte));
+
+	value = READ_ONCE(*target);
+	KUNIT_EXPECT_LT(test, copy_to_kernel_nofault((void *)target, &value,
+						      sizeof(value)), 0);
+	error = set_memory_rw((unsigned long)target & PAGE_MASK, 1);
+	KUNIT_EXPECT_EQ(test, error, -EPERM);
+	if (!error)
+		KUNIT_ASSERT_EQ(test,
+			set_memory_ro((unsigned long)target & PAGE_MASK, 1), 0);
+
+	page = vmalloc_to_page(target);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	KUNIT_EXPECT_LT(test, copy_from_kernel_nofault(&value, page_address(page),
+							sizeof(value)), 0);
+	alias = vmap(&page, 1, VM_MAP, PAGE_KERNEL);
+	KUNIT_EXPECT_PTR_EQ(test, alias, NULL);
+	if (alias)
+		vunmap(alias);
+	KUNIT_EXPECT_EQ(test, READ_ONCE(*target), HDN_CONSTIFY_MODULE_MAGIC);
+}
+
+static struct kunit_case hdn_constify_module_cases[] = {
+	KUNIT_CASE(hdn_constify_module_storage),
+	{}
+};
+
+static struct kunit_suite hdn_constify_module_suite = {
+	.name = "hdn-constify-module",
+	.test_cases = hdn_constify_module_cases,
+};
+kunit_test_suite(hdn_constify_module_suite);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HDN post-init immutable module probes");
