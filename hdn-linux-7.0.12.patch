+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_internal.h	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _X86_HDN_RAP_INTERNAL_H
+#define _X86_HDN_RAP_INTERNAL_H
+
+#include <linux/hdn_rap.h>
+
+struct hdn_rap_module {
+	const struct module *owner;
+	struct hdn_rap_module *next;
+	unsigned long header_pfn;
+	unsigned long text, text_size, init_text, init_size, init_live;
+	/* Compiler pointers are translated by offset into our sealed copy. */
+	struct hdn_rap_section original_types, types, functions;
+	struct hdn_rap_section static_calls, static_sites;
+	size_t count, site_count;
+	struct hdn_rap_target targets[];
+};
+
+/* Sealed identities for the finite ftrace template producer. They grant only
+ * exact return-site admission, never permission to call arbitrary JIT text. */
+struct hdn_rap_image {
+	struct hdn_rap_image *next;
+	unsigned long header_pfn, address, size, callback_site;
+	size_t site_count;
+	struct hdn_rap_target sites[];
+};
+
+extern struct hdn_rap_image *hdn_rap_images;
+void hdn_rap_registry_synchronize(void);
+
+enum hdn_rap_bpf_edge_kind {
+	HDN_RAP_BPF_LOCAL = 1, HDN_RAP_BPF_TAIL, HDN_RAP_BPF_THROW,
+	HDN_RAP_BPF_PATCH_TAIL, HDN_RAP_BPF_PATCH_BYPASS,
+};
+struct hdn_rap_bpf_edge {
+	unsigned long site, kind, target;
+};
+struct hdn_rap_bpf_unlink {
+	unsigned long link, start, end;
+};
+/* A program's identity and jump permissions survive independently of mutable
+ * bpf_prog/aux and instruction-array storage. All pointers refer to this sealed
+ * allocation, immutable builtin types, or opaque owner identities. */
+struct hdn_rap_bpf_image {
+	struct hdn_rap_bpf_image *next;
+	unsigned long header_pfn, address, size, owner, active, trampoline;
+	struct hdn_rap_target target;
+	struct hdn_rap_function function;
+	struct hdn_rap_function reference;
+	struct hdn_rap_section types, template;
+	unsigned long tramp_flags, original, skip, after_call, epilogue;
+	struct hdn_rap_section unlink;
+	unsigned long tail, boundary, frame_depth, exception, subprog;
+	size_t edge_count, label_count, site_count;
+	/* Edges, then label addresses, then bound CALL return-site records. */
+	struct hdn_rap_bpf_edge edges[];
+};
+static inline const unsigned long *hdn_rap_bpf_labels(const struct hdn_rap_bpf_image *image)
+{
+	return (const void *)(image->edges + image->edge_count);
+}
+static inline const struct hdn_rap_target *hdn_rap_bpf_sites(const struct hdn_rap_bpf_image *image)
+{
+	return (const void *)(hdn_rap_bpf_labels(image) + image->label_count);
+}
+extern struct hdn_rap_bpf_image *hdn_rap_bpf_images;
+const struct hdn_rap_bpf_image *hdn_rap_bpf_find(unsigned long address);
+unsigned long hdn_rap_bpf_validate_jump(unsigned long target, unsigned long site);
+unsigned long hdn_rap_bpf_dispatch_target(unsigned long target);
+int hdn_rap_function_copy(unsigned long address, struct hdn_rap_function *function,
+		struct hdn_rap_type *type, size_t capacity);
+unsigned long hdn_rap_bpf_original_target(unsigned long site, unsigned long resume);
+bool hdn_rap_trace_compatible(unsigned long resume, const struct hdn_rap_type *expected);
+
+extern struct hdn_rap_module *hdn_rap_modules;
+extern unsigned long hdn_rap_builtin_init_live;
+extern const struct hdn_rap_build __hdn_rap_build_start[], __hdn_rap_build_end[];
+extern const struct hdn_rap_target __hdn_rap_targets_start[], __hdn_rap_targets_end[];
+extern const struct hdn_rap_target __hdn_rap_sites_start[], __hdn_rap_sites_end[];
+extern const struct hdn_rap_function __hdn_rap_entries_start[], __hdn_rap_entries_end[];
+extern const struct hdn_rap_static_call __hdn_rap_static_calls_start[], __hdn_rap_static_calls_end[];
+extern const struct hdn_rap_static_site __hdn_rap_static_sites_start[], __hdn_rap_static_sites_end[];
+extern const char __hdn_rap_types_start[], __hdn_rap_types_end[];
+
+#endif
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_rap_kexec.c linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_kexec.c
--- linux-7.0.12/arch/x86/kernel/hdn_rap_kexec.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_kexec.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Protected admission and one-shot return state for the kexec terminal ABI. */
+#include <linux/hdn_rap.h>
+#include <linux/kexec.h>
+#include <linux/sched.h>
+#include <asm/cacheflush.h>
+#include <asm/hdn_rap_kexec.h>
+#include <asm/hdn_stack_mm.h>
+#include <asm/irqflags.h>
+#include <asm/msr.h>
+#include <asm/sections.h>
+#include <asm/tlbflush.h>
+#include "hdn_rap_context_internal.h"
+#include "../mm/hdn_pgtable_internal.h"
+
+/* kexec_lock serializes staging, replacement, teardown and both entry paths.
+ * Two published images plus one staging image can coexist. Keep one spare
+ * slot so a stale registration is rejected rather than replacing live data. */
+struct rap_kexec_image {
+	struct kimage *image;
+	struct hdn_rap_kexec_launch launch;
+};
+static struct {
+	struct rap_kexec_image images[4];
+	struct hdn_rap_kexec_launch launch;
+	struct rap_context *context;
+	struct rap_record last;
+	unsigned long slot, top, cpu, active;
+} kexec_state __ro_after_init;
+
+struct hdn_rap_kexec_state hdn_rap_kexec_state __ro_after_init;
+
+static void noinstr kexec_store(unsigned long *word, unsigned long value)
+{
+	unsigned long address = (unsigned long)word;
+	unsigned long private = (unsigned long)&kexec_state;
+	unsigned long cpu = (unsigned long)&hdn_rap_kexec_state;
+
+	if (!IS_ALIGNED(address, sizeof(*word)) ||
+	    !((address >= private && address - private <= sizeof(kexec_state) - sizeof(*word)) ||
+	      (address >= cpu && address - cpu <= sizeof(hdn_rap_kexec_state) - sizeof(*word))))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	hdn_pt_window_update(__pa_symbol(word) >> PAGE_SHIFT,
+			     offset_in_page(word), value, 0, HDN_PT_STORE);
+}
+
+static void noinstr kexec_copy(void *target, const void *source, unsigned long size)
+{
+	const volatile unsigned char *bytes = source;
+	unsigned long *out = target;
+
+	for (unsigned long offset = 0; offset < size; offset += sizeof(long)) {
+		unsigned long word = 0;
+
+		for (unsigned int i = 0; i < sizeof(long) && offset + i < size; i++)
+			word |= (unsigned long)bytes[offset + i] << (i * 8);
+		kexec_store(out++, word);
+	}
+}
+
+int noinstr hdn_rap_kexec_publish(struct kimage *image,
+		const struct hdn_rap_kexec_launch *launch)
+{
+	unsigned long flags = native_local_irq_save();
+	unsigned int empty = ARRAY_SIZE(kexec_state.images);
+	int error = -EINVAL;
+
+	if (kexec_state.active || !image || !launch->control || !launch->table ||
+	    !PAGE_ALIGNED(launch->control) || !PAGE_ALIGNED(launch->table) ||
+	    (launch->head & ~PAGE_MASK) != IND_INDIRECTION ||
+	    launch->code != (unsigned long)boot_phys_to_virt(launch->control) +
+		(unsigned long)relocate_kernel - (unsigned long)__relocate_kernel_start ||
+	    launch->entry > KEXEC_DESTINATION_MEMORY_LIMIT ||
+	    (launch->flags & ~RELOC_KERNEL_PRESERVE_CONTEXT) ||
+	    ((launch->flags & RELOC_KERNEL_PRESERVE_CONTEXT) && !launch->swap))
+		goto out;
+	for (unsigned int i = 0; i < ARRAY_SIZE(kexec_state.images); i++) {
+		if (kexec_state.images[i].image == image)
+			goto out;
+		if (!kexec_state.images[i].image)
+			empty = i;
+	}
+	if (empty == ARRAY_SIZE(kexec_state.images)) {
+		error = -ENOSPC;
+		goto out;
+	}
+	kexec_copy(&kexec_state.images[empty].launch, launch, sizeof(*launch));
+	kexec_store((unsigned long *)&kexec_state.images[empty].image, (unsigned long)image);
+	error = 0;
+out:
+	native_local_irq_restore(flags);
+	return error;
+}
+
+void noinstr hdn_rap_kexec_release(struct kimage *image)
+{
+	unsigned long flags = native_local_irq_save();
+
+	if (kexec_state.active)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	for (unsigned int i = 0; i < ARRAY_SIZE(kexec_state.images); i++)
+		if (kexec_state.images[i].image == image)
+			kexec_store((unsigned long *)&kexec_state.images[i].image, 0);
+	native_local_irq_restore(flags);
+}
+
+const struct hdn_rap_kexec_launch *noinstr hdn_rap_kexec_enter(struct kimage *image,
+		unsigned long sp)
+{
+	struct rap_context *context = hdn_rap_context_for(sp);
+	const struct rap_record *last;
+	struct hdn_rap_kexec_state cpu __uninitialized;
+	volatile unsigned char *bytes = (void *)&cpu;
+	unsigned long live_sp, slot = sp + 6 * sizeof(long), index;
+
+	asm volatile("movq %%rsp,%0" : "=r" (live_sp));
+	if (!native_irqs_disabled_flags(native_save_fl()) || kexec_state.active ||
+	    !context || !context->top || context->top > RAP_FRAMES ||
+	    slot < sp || slot >= context->end || live_sp > sp || sp - live_sp > 1024)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	for (index = 0; index < ARRAY_SIZE(kexec_state.images); index++)
+		if (kexec_state.images[index].image == image)
+			break;
+	if (index == ARRAY_SIZE(kexec_state.images))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	last = &context->records[context->top - 1];
+	if (!last->sequence || last->slot != slot || last->hooks ||
+	    READ_ONCE(*(unsigned long *)slot) != hdn_rap_record_target(context, last))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	if ((kexec_state.images[index].launch.flags & RELOC_KERNEL_PRESERVE_CONTEXT) &&
+	    (context->domain != RAP_TASK || context->owner != current || context->async_top ||
+	     context->probe_top || context->bpf_top || !hdn_stack_mm_active(current, sp)))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	for (unsigned int i = 0; i < sizeof(cpu); i++)
+		bytes[i] = 0;
+	cpu.cr0 = native_read_cr0();
+	cpu.cr3 = __native_read_cr3();
+	cpu.cr4 = native_read_cr4();
+	cpu.gsbase = __rdmsr(MSR_GS_BASE);
+	cpu.sp = slot;
+	cpu.flags = native_save_fl();
+	cpu.r15 = READ_ONCE(((unsigned long *)sp)[0]);
+	cpu.r14 = READ_ONCE(((unsigned long *)sp)[1]);
+	cpu.r13 = READ_ONCE(((unsigned long *)sp)[2]);
+	cpu.r12 = READ_ONCE(((unsigned long *)sp)[3]);
+	cpu.bp = READ_ONCE(((unsigned long *)sp)[4]);
+	cpu.bx = READ_ONCE(((unsigned long *)sp)[5]);
+	native_store_gdt(&cpu.gdt);
+	store_idt(&cpu.idt);
+	kexec_copy(&hdn_rap_kexec_state, &cpu, sizeof(cpu));
+	kexec_copy(&kexec_state.launch, &kexec_state.images[index].launch,
+		   sizeof(kexec_state.launch));
+	if (this_cpu_read(cache_state_incoherent))
+		kexec_store(&kexec_state.launch.flags,
+			    kexec_state.launch.flags | RELOC_KERNEL_CACHE_INCOHERENT);
+	kexec_store((unsigned long *)&kexec_state.context, (unsigned long)context);
+	kexec_copy(&kexec_state.last, last, sizeof(*last));
+	kexec_store(&kexec_state.top, context->top);
+	kexec_store(&kexec_state.slot, index);
+	kexec_store(&kexec_state.cpu, hdn_pt_cpu());
+	kexec_store(&kexec_state.active, 1);
+	return &kexec_state.launch;
+}
+
+void noinstr hdn_rap_kexec_finish(unsigned long entry)
+{
+	struct rap_context *context = kexec_state.context;
+	const struct rap_record *last;
+	unsigned long sp;
+
+	asm volatile("movq %%rsp,%0" : "=r" (sp));
+	if (!native_irqs_disabled_flags(native_save_fl()) || kexec_state.active != 1 ||
+	    !(kexec_state.launch.flags & RELOC_KERNEL_PRESERVE_CONTEXT) ||
+	    kexec_state.cpu != hdn_pt_cpu() || !context ||
+	    context != hdn_rap_context_for(sp) || context->owner != current ||
+	    context->domain != RAP_TASK || context->top != kexec_state.top ||
+	    !context->top || context->top > RAP_FRAMES || context->async_top ||
+	    context->probe_top || context->bpf_top || !hdn_stack_mm_active(current, sp) ||
+	    (__native_read_cr3() & CR3_ADDR_MASK) != (hdn_rap_kexec_state.cr3 & CR3_ADDR_MASK) ||
+	    kexec_state.slot >= ARRAY_SIZE(kexec_state.images) ||
+	    entry > KEXEC_DESTINATION_MEMORY_LIMIT)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	last = &context->records[context->top - 1];
+	if (last->slot != kexec_state.last.slot || last->target != kexec_state.last.target ||
+	    last->sequence != kexec_state.last.sequence || last->hooks != kexec_state.last.hooks ||
+	    READ_ONCE(*(unsigned long *)last->slot) != hdn_rap_record_target(context, last))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	/* The peer supplies its next entry as part of the established kexec-jump
+ * ABI. Accept it only at this authenticated return from that peer. */
+	kexec_store(&kexec_state.images[kexec_state.slot].launch.entry, entry);
+	kexec_store(&kexec_state.active, 0);
+}
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_rap_kexec_asm.S linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_kexec_asm.S
--- linux-7.0.12/arch/x86/kernel/hdn_rap_kexec_asm.S	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_kexec_asm.S	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/asm.h>
+#include <asm/asm-offsets.h>
+#include <asm/hdn_rap.h>
+#include <asm/msr.h>
+#include <asm/nospec-branch.h>
+#include <asm/segment.h>
+#include <asm/unwind_hints.h>
+
+	.text
+/* A compiler-bound direct call creates the checkpoint's protected record.
+ * Once GS has been reset, there are no C calls until the fixed return entry. */
+SYM_FUNC_START(hdn_rap_kexec)
+	HDN_KEXEC_FUNC hdn_rap_kexec, 10
+	HDN_FUNC_ENTER
+	pushq %rbx
+	pushq %rbp
+	pushq %r12
+	pushq %r13
+	pushq %r14
+	pushq %r15
+	movq %rsp, %rsi
+	HDN_C_CALL hdn_rap_kexec_enter
+	movq %rax, %r11
+	movq HDN_KEXEC_HEAD(%r11), %rdi
+	movq HDN_KEXEC_CONTROL(%r11), %rsi
+	movq HDN_KEXEC_ENTRY(%r11), %rdx
+	movq HDN_KEXEC_FLAGS(%r11), %rcx
+	movq HDN_KEXEC_TABLE(%r11), %r8
+	movq HDN_KEXEC_CODE(%r11), %r11
+	movl $__KERNEL_DS, %eax
+	movl %eax, %ds
+	movl %eax, %es
+	movl %eax, %ss
+	movl %eax, %fs
+	movl %eax, %gs
+	ANNOTATE_RETPOLINE_SAFE
+	jmp *%r11
+SYM_FUNC_END(hdn_rap_kexec)
+STACK_FRAME_NON_STANDARD hdn_rap_kexec
+_ASM_NOKPROBE(hdn_rap_kexec)
+
+/* The terminal copy code returns only here. It restored CRs from the physical
+ * checkpoint; install the matching virtual stack and per-CPU base first. */
+SYM_FUNC_START(hdn_rap_kexec_return)
+	HDN_KEXEC_FUNC hdn_rap_kexec_return, 12
+	UNWIND_HINT_UNDEFINED
+	movq $hdn_rap_kexec_state, %rsi
+	movq HDN_KEXEC_GS(%rsi), %rax
+	movq %rax, %rdx
+	shrq $32, %rdx
+	movl $MSR_GS_BASE, %ecx
+	wrmsr
+	movq HDN_KEXEC_SP(%rsi), %rsp
+	lgdt HDN_KEXEC_GDT(%rsi)
+	lidt HDN_KEXEC_IDT(%rsi)
+	UNWIND_HINT_FUNC
+	pushq %rbp
+	movq %rbp, %rdi
+	HDN_C_CALL hdn_rap_kexec_finish
+	popq %rax
+	movq $hdn_rap_kexec_state, %rdx
+	movq HDN_KEXEC_R15(%rdx), %r15
+	movq HDN_KEXEC_R14(%rdx), %r14
+	movq HDN_KEXEC_R13(%rdx), %r13
+	movq HDN_KEXEC_R12(%rdx), %r12
+	movq HDN_KEXEC_BP(%rdx), %rbp
+	movq HDN_KEXEC_BX(%rdx), %rbx
+	pushq HDN_KEXEC_RFLAGS(%rdx)
+	popfq
+	HDN_ENTRY_ROOT_RETURN
+SYM_FUNC_END(hdn_rap_kexec_return)
+STACK_FRAME_NON_STANDARD hdn_rap_kexec_return
+_ASM_NOKPROBE(hdn_rap_kexec_return)
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_rap_resume.c linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_resume.c
--- linux-7.0.12/arch/x86/kernel/hdn_rap_resume.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_resume.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,291 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Closed nonlocal suspend/hibernate transitions. No allocation or ordinary C. */
+#include <linux/hdn_rap.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <asm/hdn_rap_resume.h>
+#include <asm/hdn_stack_mm.h>
+#include <asm/irqflags.h>
+#include <asm/special_insns.h>
+#include <asm/sections.h>
+#include <asm/tlbflush.h>
+#include "hdn_rap_context_internal.h"
+#include "../mm/hdn_pgtable_internal.h"
+
+extern struct saved_context saved_context;
+u32 hdn_rap_pm_msr_ids[HDN_RAP_PM_MSRS] __ro_after_init;
+unsigned long hdn_rap_pm_msr_count __ro_after_init;
+
+/* The system sleep core serializes these operations with the other CPUs
+ * offline. The active task and hardware CPU identity are checked separately;
+ * this is not an arbitrary setjmp/longjmp API. */
+struct {
+	struct saved_context cpu __aligned(sizeof(unsigned long));
+	struct saved_msr msrs[HDN_RAP_PM_MSRS] __aligned(sizeof(unsigned long));
+	struct rap_context *context;
+	unsigned long processor_live, cpu_id, kind, top;
+	struct rap_record last;
+#ifdef CONFIG_HIBERNATION
+	struct hdn_rap_hibernate_launch launch;
+	unsigned long image_physical, image_owner, image_live, copy_live, launch_live;
+#endif
+} hdn_rap_resume_state __ro_after_init;
+static_assert(offsetof(typeof(hdn_rap_resume_state), cpu) == 0);
+
+static void noinstr resume_store(unsigned long *word, unsigned long value)
+{
+	unsigned long address = (unsigned long)word;
+
+	if (address < (unsigned long)&hdn_rap_resume_state ||
+	    address - (unsigned long)&hdn_rap_resume_state > sizeof(hdn_rap_resume_state) - sizeof(*word) ||
+	    !IS_ALIGNED(address, sizeof(*word)))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	hdn_pt_window_update(__pa_symbol(word) >> PAGE_SHIFT,
+			     offset_in_page(word), value, 0, HDN_PT_STORE);
+}
+
+/* Packed CPU state is copied exactly once. Zero the last word's padding and
+ * avoid a compiler-generated memcpy call in this recursion-boundary unit. */
+static void noinstr resume_copy(void *target, const void *source, unsigned long size)
+{
+	const volatile unsigned char *bytes = source;
+	unsigned long *out = target;
+
+	for (unsigned long offset = 0; offset < size; offset += sizeof(long)) {
+		unsigned long word = 0;
+
+		for (unsigned int byte = 0; byte < sizeof(long) && offset + byte < size; byte++)
+			word |= (unsigned long)bytes[offset + byte] << (8 * byte);
+		resume_store(out++, word);
+	}
+}
+
+void noinstr hdn_rap_processor_save(const struct saved_context *source)
+{
+	struct saved_context copy __uninitialized;
+	volatile unsigned char *out = (void *)&copy;
+	const volatile unsigned char *in = (const void *)source;
+	unsigned int cpu = hdn_pt_cpu();
+
+	if (!native_irqs_disabled_flags(native_save_fl()) || source != &saved_context ||
+	    hdn_rap_resume_state.processor_live || hdn_rap_resume_state.kind ||
+	    hdn_rap_pm_msr_count > HDN_RAP_PM_MSRS)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	for (unsigned int i = 0; i < sizeof(copy); i++)
+		out[i] = in[i];
+	/* Read the control state at the transition, independently of the
+	 * writable compatibility copy consumed by feature-off kernels. */
+	copy.cr0 = native_read_cr0();
+	copy.cr2 = native_read_cr2();
+	copy.cr3 = __native_read_cr3();
+	copy.cr4 = native_read_cr4();
+	copy.kernelmode_gs_base = __rdmsr(MSR_GS_BASE);
+	copy.usermode_gs_base = __rdmsr(MSR_KERNEL_GS_BASE);
+	copy.fs_base = __rdmsr(MSR_FS_BASE);
+	copy.efer = __rdmsr(MSR_EFER);
+	native_store_gdt(&copy.gdt_desc);
+	store_idt(&copy.idt);
+	copy.saved_msrs.num = hdn_rap_pm_msr_count;
+	copy.saved_msrs.array = hdn_rap_resume_state.msrs;
+	for (unsigned int i = 0; i < hdn_rap_pm_msr_count; i++) {
+		struct saved_msr msr __uninitialized;
+		volatile unsigned char *p = (void *)&msr;
+
+		for (unsigned int j = 0; j < sizeof(msr); j++)
+			p[j] = 0;
+		msr.valid = true;
+		msr.info.msr_no = hdn_rap_pm_msr_ids[i];
+		msr.info.reg.q = __rdmsr(msr.info.msr_no);
+		resume_copy(&hdn_rap_resume_state.msrs[i], &msr, sizeof(msr));
+	}
+	resume_copy(&hdn_rap_resume_state.cpu, &copy, sizeof(copy));
+	resume_store(&hdn_rap_resume_state.cpu_id, cpu);
+	resume_store(&hdn_rap_resume_state.processor_live, 1);
+}
+
+const struct saved_context *noinstr hdn_rap_processor_state(void)
+{
+	if (!native_irqs_disabled_flags(native_save_fl()) || !hdn_rap_resume_state.processor_live ||
+	    hdn_rap_resume_state.cpu_id != hdn_pt_cpu() || hdn_rap_resume_state.kind)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	return &hdn_rap_resume_state.cpu;
+}
+
+void noinstr hdn_rap_processor_finish(void)
+{
+	if (!native_irqs_disabled_flags(native_save_fl()) || !hdn_rap_resume_state.processor_live ||
+	    hdn_rap_resume_state.kind || hdn_rap_resume_state.cpu_id != hdn_pt_cpu())
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	resume_store(&hdn_rap_resume_state.processor_live, 0);
+}
+
+void noinstr hdn_rap_resume_save(unsigned long kind, unsigned long sp)
+{
+	struct rap_context *context = hdn_rap_context_for(sp);
+	const struct rap_record *last;
+	unsigned long live_sp;
+
+	asm volatile("movq %%rsp,%0" : "=r" (live_sp));
+	if (!native_irqs_disabled_flags(native_save_fl()) || !hdn_rap_resume_state.processor_live ||
+	    hdn_rap_resume_state.kind || hdn_rap_resume_state.cpu_id != hdn_pt_cpu() ||
+	    (kind != HDN_RAP_RESUME_S3 && kind != HDN_RAP_RESUME_IMAGE) ||
+	    !context || context->owner != current || context->domain != RAP_TASK ||
+	    context->async_top || context->probe_top || !context->top || context->top > RAP_FRAMES ||
+	    !hdn_stack_mm_active(current, sp) || live_sp > sp || sp - live_sp > 1024 ||
+	    sp != READ_ONCE(saved_context.regs.sp))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	last = &context->records[context->top - 1];
+	if (!last->sequence || (last->hooks & RAP_HOOK_ENTERED) || last->slot < sp ||
+	    last->slot - sp != (kind == HDN_RAP_RESUME_IMAGE ? 0 :
+			       IS_ENABLED(CONFIG_FRAME_POINTER) ? 16 : 8) ||
+	    (READ_ONCE(saved_context.regs.flags) & X86_EFLAGS_IF) ||
+	    last->slot >= context->end ||
+	    READ_ONCE(*(unsigned long *)last->slot) != hdn_rap_record_target(context, last))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	resume_copy(&hdn_rap_resume_state.cpu.regs, &saved_context.regs, sizeof(struct pt_regs));
+	resume_store((unsigned long *)&hdn_rap_resume_state.context, (unsigned long)context);
+	resume_store(&hdn_rap_resume_state.top, context->top);
+	resume_copy(&hdn_rap_resume_state.last, last, sizeof(*last));
+	resume_store(&hdn_rap_resume_state.kind, kind);
+	if (kind == HDN_RAP_RESUME_S3)
+		hdn_stack_mm_resume_prepare(sp);
+}
+
+const struct saved_context *noinstr hdn_rap_resume_restore(unsigned long kind)
+{
+	struct rap_context *context = hdn_rap_resume_state.context;
+	const struct rap_record *last;
+	unsigned long live_sp;
+
+	asm volatile("movq %%rsp,%0" : "=r" (live_sp));
+	if (!native_irqs_disabled_flags(native_save_fl()) || !hdn_rap_resume_state.processor_live ||
+	    !kind || hdn_rap_resume_state.kind != kind || hdn_rap_resume_state.cpu_id != hdn_pt_cpu() ||
+	    !context || context != hdn_rap_context_for(live_sp) ||
+	    context->owner != current || context->async_top || context->probe_top ||
+	    !hdn_stack_mm_active(current, live_sp) ||
+	    !hdn_rap_resume_state.top || hdn_rap_resume_state.top > context->top || context->top > RAP_FRAMES ||
+	    (hdn_rap_resume_state.cpu.cr3 & CR3_ADDR_MASK) != (__native_read_cr3() & CR3_ADDR_MASK))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	last = &context->records[hdn_rap_resume_state.top - 1];
+	if (last->slot != hdn_rap_resume_state.last.slot || last->target != hdn_rap_resume_state.last.target ||
+	    last->sequence != hdn_rap_resume_state.last.sequence ||
+	    last->hooks != hdn_rap_resume_state.last.hooks ||
+	    READ_ONCE(*(unsigned long *)last->slot) != hdn_rap_record_target(context, last))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	/* Only frames created after this exact checkpoint may be abandoned.
+	 * Never rewind the generation counter or accept replacement return data. */
+	for (unsigned long i = hdn_rap_resume_state.top; i < context->top; i++)
+		hdn_rap_record_discard(context, &context->records[i]);
+	hdn_rap_context_store(context, &context->top, hdn_rap_resume_state.top);
+	if (kind == HDN_RAP_RESUME_S3)
+		hdn_stack_mm_resume_finish();
+	resume_store(&hdn_rap_resume_state.kind, 0);
+	return &hdn_rap_resume_state.cpu;
+}
+
+#ifdef CONFIG_HIBERNATION
+/* The snapshot loader already owns image compatibility and authorization.
+ * Capture its accepted header before device quiescence. This protects the
+ * in-kernel handoff from later pointer replacement; it does not authenticate
+ * an external hibernation image or extend RAP across the image-copy boundary. */
+int noinstr hdn_rap_hibernate_header(unsigned long entry, unsigned long physical,
+		unsigned long cr3)
+{
+	unsigned long flags = native_local_irq_save();
+	int error = -EINVAL;
+
+	if (hdn_rap_resume_state.image_live || hdn_rap_resume_state.launch_live)
+		goto out;
+	if (!PAGE_ALIGNED(entry) || entry < __START_KERNEL_map ||
+	    entry - __START_KERNEL_map >= KERNEL_IMAGE_SIZE ||
+	    !physical || !PAGE_ALIGNED(physical) || (physical & ~PTE_PFN_MASK) ||
+	    !cr3 || (cr3 & ~CR3_ADDR_MASK))
+		goto out;
+	resume_store(&hdn_rap_resume_state.launch.entry, entry);
+	resume_store(&hdn_rap_resume_state.launch.cr3, cr3);
+	resume_store(&hdn_rap_resume_state.image_physical, physical);
+	resume_store(&hdn_rap_resume_state.image_live, 1);
+	error = 0;
+out:
+	native_local_irq_restore(flags);
+	return error;
+}
+
+int noinstr hdn_rap_hibernate_prepare(unsigned long temporary_cr3, unsigned long code)
+{
+	unsigned long flags = native_local_irq_save();
+	int error = -EINVAL;
+
+	if (!hdn_rap_resume_state.image_live || !hdn_rap_resume_state.copy_live ||
+	    hdn_rap_resume_state.launch_live ||
+	    READ_ONCE(restore_jump_address) != hdn_rap_resume_state.launch.entry ||
+	    READ_ONCE(jump_address_phys) != hdn_rap_resume_state.image_physical ||
+	    READ_ONCE(restore_cr3) != hdn_rap_resume_state.launch.cr3 ||
+	    !temporary_cr3 || (temporary_cr3 & ~CR3_ADDR_MASK) ||
+	    !code || !PAGE_ALIGNED(code))
+		goto out;
+	resume_store(&hdn_rap_resume_state.launch.temporary_cr3, temporary_cr3);
+	resume_store(&hdn_rap_resume_state.launch.code, code);
+	resume_store(&hdn_rap_resume_state.launch.cr4, mmu_cr4_features);
+	/* Loading through /dev/snapshot may precede a descriptor handoff.
+	 * Bind the executing task only when the PM core commits preparation. */
+	resume_store(&hdn_rap_resume_state.image_owner, (unsigned long)current);
+	resume_store(&hdn_rap_resume_state.launch_live, 1);
+	error = 0;
+out:
+	native_local_irq_restore(flags);
+	return error;
+}
+
+int noinstr hdn_rap_hibernate_copy_publish(unsigned long pages)
+{
+	unsigned long flags = native_local_irq_save();
+	int error = -EINVAL;
+
+	if (!hdn_rap_resume_state.image_live || hdn_rap_resume_state.copy_live ||
+	    hdn_rap_resume_state.launch_live ||
+	    (pages && !IS_ALIGNED(pages, sizeof(unsigned long))))
+		goto out;
+	resume_store(&hdn_rap_resume_state.launch.pages, pages);
+	resume_store(&hdn_rap_resume_state.copy_live, 1);
+	error = 0;
+out:
+	native_local_irq_restore(flags);
+	return error;
+}
+
+const struct hdn_rap_hibernate_launch *noinstr hdn_rap_hibernate_enter(void)
+{
+	unsigned long sp;
+	struct rap_context *context;
+
+	asm volatile("movq %%rsp,%0" : "=r" (sp));
+	context = hdn_rap_context_for(sp);
+	if (!native_irqs_disabled_flags(native_save_fl()) ||
+	    !hdn_rap_resume_state.image_live || hdn_rap_resume_state.launch_live != 1 ||
+	    hdn_rap_resume_state.image_owner != (unsigned long)current ||
+	    !hdn_rap_resume_state.processor_live || hdn_rap_resume_state.kind ||
+	    hdn_rap_resume_state.cpu_id != hdn_pt_cpu() ||
+	    !context || context->owner != current || context->domain != RAP_TASK ||
+	    context->async_top || context->probe_top || context->bpf_top ||
+	    !hdn_stack_mm_active(current, sp))
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	/* Retain the descriptor until the irreversible image copy has consumed
+	 * it. A second entry in this kernel cannot reuse the authorization. */
+	resume_store(&hdn_rap_resume_state.launch_live, 2);
+	return &hdn_rap_resume_state.launch;
+}
+
+void noinstr hdn_rap_hibernate_release(void)
+{
+	unsigned long flags = native_local_irq_save();
+
+	if (hdn_rap_resume_state.launch_live == 2)
+		__hdn_rap_fail(HDN_RAP_FAIL_SWITCH);
+	resume_store(&hdn_rap_resume_state.launch_live, 0);
+	resume_store(&hdn_rap_resume_state.copy_live, 0);
+	resume_store(&hdn_rap_resume_state.image_live, 0);
+	resume_store(&hdn_rap_resume_state.image_owner, 0);
+	native_local_irq_restore(flags);
+}
+#endif
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_rap_thunks.S linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_thunks.S
--- linux-7.0.12/arch/x86/kernel/hdn_rap_thunks.S	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_thunks.S	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,372 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <linux/export.h>
+#include <asm/nospec-branch.h>
+#include <asm/unwind_hints.h>
+#include <asm/asm-offsets.h>
+#include <asm/hdn_rap.h>
+#include <asm/msr.h>
+#include <asm/smap.h>
+#include <linux/threads.h>
+
+	.text
+/* These adapters have private register/stack ABIs. Kind 4 requires objtool's
+ * exact sequence verifier; it does not exempt arbitrary assembly from RAP. */
+.macro RAP_ADAPTER name:req
+	.pushsection .discard.hdn_rap.functions, "", @progbits
+	.balign 8
+	.quad \name, 4, 0
+	.popsection
+.endm
+/* Save the call-clobbered state and one frame register. r10/r11 are reserved
+ * by the compiler protocol. The original flags survive even for local jumps.
+ * The runtime may not sleep, trace, allocate, or enable interrupts. */
+.macro RAP_SAVE
+	pushq %rbp
+	movq %rsp, %rbp
+	/* Save and clear AC before calling ordinary kernel C. Keeping PUSHF and
+	 * POPF in alternatives also exposes the saved AC state to objtool. LASS
+	 * alone needs the same protocol, including on CPUs without SMAP. */
+	/* Without either feature AC has no access-control meaning. Analyze both
+	 * feature-bearing alternatives, as smap_save()/smap_restore() do. */
+	ANNOTATE_IGNORE_ALTERNATIVE
+	ALTERNATIVE_2 "pushfq", "pushfq; clac", X86_FEATURE_SMAP, "pushfq; clac", X86_FEATURE_LASS
+	cli
+	pushq %rax
+	pushq %rcx
+	pushq %rdx
+	pushq %rsi
+	pushq %rdi
+	pushq %r8
+	pushq %r9
+	pushq %r10
+	pushq %r11
+	andq $-16, %rsp
+.endm
+
+/* r11 is the validated transfer value returned by the runtime. Do not reload
+ * the pre-validation candidate from a saved stack slot after its check. */
+.macro RAP_RESTORE
+	leaq -72(%rbp), %rsp
+	popq %r10
+	popq %r9
+	popq %r8
+	popq %rdi
+	popq %rsi
+	popq %rdx
+	popq %rcx
+	popq %rax
+	ANNOTATE_IGNORE_ALTERNATIVE
+	ALTERNATIVE_2 "popfq", "popfq", X86_FEATURE_SMAP, "popfq", X86_FEATURE_LASS
+	popq %rbp
+.endm
+
+/* r11: candidate target; r10: compiler-bound return site. Metadata for that
+ * exact site supplies the expected type. Preserve all integer arguments and
+ * the caller's stack layout, including variadic and stack-passed arguments. */
+SYM_FUNC_START(__hdn_rap_call)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_call_site
+	RAP_SAVE
+	movq %r11, %rdi
+	movq %r10, %rsi
+	HDN_C_CALL hdn_rap_validate_call
+	movq %rax, %r11
+	RAP_RESTORE
+	jmp __x86_indirect_thunk_r11
+.Lhdn_rap_bad_call_site:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_call)
+RAP_ADAPTER __hdn_rap_call
+_ASM_NOKPROBE(__hdn_rap_call)
+EXPORT_SYMBOL_GPL(__hdn_rap_call)
+
+/* Intra-function jumps preserve every non-reserved register and flags. */
+SYM_FUNC_START(__hdn_rap_jump)
+	ANNOTATE_NOENDBR
+	RAP_SAVE
+	movq %r11, %rdi
+	movq %r10, %rsi
+	HDN_C_CALL hdn_rap_validate
+	movq %rax, %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+SYM_INNER_LABEL(__hdn_rap_jump_transfer, SYM_L_GLOBAL)
+	jmp __hdn_rap_transfer
+SYM_INNER_LABEL(__hdn_rap_jump_transfer_end, SYM_L_GLOBAL)
+SYM_FUNC_END(__hdn_rap_jump)
+RAP_ADAPTER __hdn_rap_jump
+_ASM_NOKPROBE(__hdn_rap_jump)
+EXPORT_SYMBOL_GPL(__hdn_rap_jump)
+
+/* Generated local/tail jumps carry an exact return-site identity instead of
+ * a writable target-set pointer. The sealed image supplies the allowed set. */
+SYM_FUNC_START(__hdn_rap_bpf_jump)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_bpf_jump
+	RAP_SAVE
+	movq %r11, %rdi
+	movq %r10, %rsi
+	HDN_C_CALL hdn_rap_bpf_validate_jump
+	movq %rax, %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_bpf_jump:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_jump)
+RAP_ADAPTER __hdn_rap_bpf_jump
+_ASM_NOKPROBE(__hdn_rap_bpf_jump)
+
+/* Dispatcher entry is a transparent typed tail adapter. Preserve the incoming
+ * R10 binding so the selected BPF function records the original caller slot. */
+SYM_FUNC_START(__hdn_rap_bpf_dispatch)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_bpf_dispatch
+	RAP_SAVE
+	movq %r11, %rdi
+	HDN_C_CALL hdn_rap_bpf_dispatch_target
+	movq %rax, %r11
+	RAP_RESTORE
+	jmp __x86_indirect_thunk_r11
+.Lhdn_rap_bad_bpf_dispatch:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_dispatch)
+RAP_ADAPTER __hdn_rap_bpf_dispatch
+_ASM_NOKPROBE(__hdn_rap_bpf_dispatch)
+
+/* Entered before the callee prologue. r10 names its caller's exact return
+ * site; r11 names the compiler-generated continuation after this adapter.
+ * The caller return slot is eight bytes above this adapter's own return. */
+	.pushsection .noinstr.text, "ax"
+.macro RAP_ENTER name:req caller_offset:req
+SYM_FUNC_START(\name)
+	ANNOTATE_NOENDBR
+	cmpq %r11, (%rsp)
+	jne .Lhdn_rap_bad_entry_\@
+	RAP_SAVE
+	leaq \caller_offset(%rbp), %rdi
+	movq %r10, %rsi
+	HDN_C_CALL hdn_rap_push
+	/* This continuation was checked before the runtime call. Protecting its
+	 * saved register, like every other assembly save, is part of the private
+	 * stack and asynchronous frame protocol. */
+	movq -80(%rbp), %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+SYM_INNER_LABEL(\name\()_transfer, SYM_L_GLOBAL)
+	jmp __hdn_rap_transfer
+SYM_INNER_LABEL(\name\()_transfer_end, SYM_L_GLOBAL)
+.Lhdn_rap_bad_entry_\@:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(\name)
+RAP_ADAPTER \name
+_ASM_NOKPROBE(\name)
+.endm
+
+RAP_ENTER __hdn_rap_enter, 16
+/* ftrace_regs_caller saves flags before its protected entry. Its own return
+ * slot is therefore one word above the ordinary entry adapter's slot. */
+RAP_ENTER __hdn_rap_enter_flags, 24
+EXPORT_SYMBOL_GPL(__hdn_rap_enter)
+
+SYM_FUNC_START(__hdn_rap_bpf_boundary)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_bpf_boundary
+	RAP_SAVE
+	leaq 16(%rbp), %rdi
+	movq (%rbp), %rsi
+	movq %r10, %rdx
+	HDN_C_CALL hdn_rap_bpf_boundary_save
+	movq -72(%rbp), %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_bpf_boundary:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_boundary)
+RAP_ADAPTER __hdn_rap_bpf_boundary
+_ASM_NOKPROBE(__hdn_rap_bpf_boundary)
+
+SYM_FUNC_START(__hdn_rap_bpf_exception)
+	ANNOTATE_NOENDBR
+	cmpq %r11, (%rsp)
+	jne .Lhdn_rap_bad_bpf_exception
+	RAP_SAVE
+	movq %r11, %rdi
+	leaq 16(%rbp), %rsi
+	HDN_C_CALL hdn_rap_bpf_exception_restore
+	/* Replace the two untrusted walker arguments with sealed coordinates.
+	 * The subsequent fixed JIT prologue restores the sealed callee saves. */
+	movq HDN_RAP_BPF_SP(%rax), %rdx
+	movq %rdx, -40(%rbp)
+	movq HDN_RAP_BPF_BP(%rax), %rdx
+	movq %rdx, -32(%rbp)
+	movq -80(%rbp), %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_bpf_exception:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_exception)
+RAP_ADAPTER __hdn_rap_bpf_exception
+_ASM_NOKPROBE(__hdn_rap_bpf_exception)
+
+SYM_FUNC_START(__hdn_rap_bpf_tramp_enter)
+	ANNOTATE_NOENDBR
+	cmpq %r11, (%rsp)
+	jne .Lhdn_rap_bad_bpf_tramp_enter
+	RAP_SAVE
+	leaq 16(%rbp), %rdi
+	movq %r11, %rsi
+	movq %r10, %rdx
+	HDN_C_CALL hdn_rap_bpf_tramp_enter
+	movq -80(%rbp), %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_bpf_tramp_enter:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_tramp_enter)
+RAP_ADAPTER __hdn_rap_bpf_tramp_enter
+_ASM_NOKPROBE(__hdn_rap_bpf_tramp_enter)
+
+SYM_FUNC_START(__hdn_rap_bpf_original)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_bpf_original
+	RAP_SAVE
+	leaq 8(%rbp), %rdi
+	movq %r10, %rsi
+	movq (%rbp), %rdx
+	HDN_C_CALL hdn_rap_bpf_original_enter
+	movq %rax, %r11
+	RAP_RESTORE
+	/* Keep the CALL slot for the original body's authenticated epilogue. */
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_bpf_original:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_original)
+RAP_ADAPTER __hdn_rap_bpf_original
+_ASM_NOKPROBE(__hdn_rap_bpf_original)
+
+SYM_FUNC_START(__hdn_rap_bpf_skip)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_bpf_skip
+	RAP_SAVE
+	leaq 16(%rbp), %rdi
+	movq %r10, %rsi
+	HDN_C_CALL hdn_rap_bpf_skip
+	movq %rax, %r11
+	RAP_RESTORE
+	/* Consume this adapter CALL, fentry's slot, and the original return. */
+	leaq 24(%rsp), %rsp
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_bpf_skip:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_bpf_skip)
+RAP_ADAPTER __hdn_rap_bpf_skip
+_ASM_NOKPROBE(__hdn_rap_bpf_skip)
+
+/* The epilogue jumps here with its original return slot at RSP. Transfer the
+ * protected target returned in rax, preserving both scalar return registers.
+ * The ordinary return slot is consumed without loading its value again. */
+SYM_FUNC_START(__hdn_rap_return)
+	ANNOTATE_NOENDBR
+	RAP_SAVE
+	leaq 8(%rbp), %rdi
+	HDN_C_CALL hdn_rap_pop
+	movq %rax, %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+SYM_INNER_LABEL(__hdn_rap_return_transfer, SYM_L_GLOBAL)
+	jmp __hdn_rap_transfer
+SYM_INNER_LABEL(__hdn_rap_return_transfer_end, SYM_L_GLOBAL)
+SYM_FUNC_END(__hdn_rap_return)
+RAP_ADAPTER __hdn_rap_return
+_ASM_NOKPROBE(__hdn_rap_return)
+EXPORT_SYMBOL_GPL(__hdn_rap_return)
+
+/* A NULL static-call trampoline has not entered a callee and owns no return
+ * record. Authenticate its still-register-bound caller continuation, consume
+ * exactly that CALL slot, and retain the architecture return mitigation. */
+SYM_FUNC_START(__hdn_rap_static_null)
+	ANNOTATE_NOENDBR
+	cmpq %r10, (%rsp)
+	jne .Lhdn_rap_bad_static_null
+	movq %r10, %r11
+	leaq 8(%rsp), %rsp
+	jmp __hdn_rap_transfer
+.Lhdn_rap_bad_static_null:
+	movl $HDN_RAP_FAIL_RETURN_CLASS, %edi
+	jmp __hdn_rap_fail
+SYM_FUNC_END(__hdn_rap_static_null)
+RAP_ADAPTER __hdn_rap_static_null
+_ASM_NOKPROBE(__hdn_rap_static_null)
+EXPORT_SYMBOL_GPL(__hdn_rap_static_null)
+
+/* A return hook retains the intercepted record until its final handler has
+ * returned. R11 carries the handler's candidate; the root checks it against
+ * the original protected target or the next fixed hook in the sealed chain. */
+.macro RAP_HOOK_RETURN name:req kind:req
+SYM_FUNC_START(\name)
+	ANNOTATE_NOENDBR
+	RAP_SAVE
+	leaq 8(%rbp), %rdi
+	movl $\kind, %esi
+	movq -80(%rbp), %rdx
+	HDN_C_CALL hdn_rap_hook_finish
+	movq %rax, %r11
+	RAP_RESTORE
+	leaq 8(%rsp), %rsp
+SYM_INNER_LABEL(\name\()_transfer, SYM_L_GLOBAL)
+	jmp __hdn_rap_transfer
+SYM_INNER_LABEL(\name\()_transfer_end, SYM_L_GLOBAL)
+SYM_FUNC_END(\name)
+RAP_ADAPTER \name
+_ASM_NOKPROBE(\name)
+.endm
+
+#ifdef CONFIG_FUNCTION_GRAPH_TRACER
+RAP_HOOK_RETURN __hdn_rap_graph_return, 1
+#endif
+#ifdef CONFIG_RETHOOK
+RAP_HOOK_RETURN __hdn_rap_rethook_return, 2
+#endif
+
+/* Validated intra-function continuations are not IBT function entries. Keep
+ * this fixed retpoline instead of entering an alternative which might emit
+ * an IBT-tracked indirect jump. The final RET still uses the architecture's
+ * return mitigation and return-site patching. Those preserve the authenticated
+ * target installed below; replacing this entire capture with an indirect jump
+ * would lose both its speculation trap and its interior-continuation ABI. */
+SYM_FUNC_START(__hdn_rap_transfer)
+	ANNOTATE_NOENDBR
+	UNWIND_HINT_UNDEFINED
+	ANNOTATE_INTRA_FUNCTION_CALL
+	call .Lhdn_rap_transfer_capture
+	int3
+.Lhdn_rap_transfer_capture:
+SYM_INNER_LABEL(__hdn_rap_transfer_capture, SYM_L_GLOBAL)
+	movq %r11, (%rsp)
+SYM_INNER_LABEL(__hdn_rap_transfer_ready, SYM_L_GLOBAL)
+	UNWIND_HINT_FUNC
+	RET
+SYM_FUNC_END(__hdn_rap_transfer)
+RAP_ADAPTER __hdn_rap_transfer
+_ASM_NOKPROBE(__hdn_rap_transfer)
+	.popsection
diff -ruN '--exclude=.git' '--exclude=.config' '--exclude=*.o' '--exclude=*.cmd' '--exclude=.tmp_*' '--exclude=certs/signing_key*' linux-7.0.12/arch/x86/kernel/hdn_rap_validate.c linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_validate.c
--- linux-7.0.12/arch/x86/kernel/hdn_rap_validate.c	1969-12-31 18:00:00.000000000 -0600
+++ linux-7.0.12-hdn/arch/x86/kernel/hdn_rap_validate.c	2026-11-06 08:08:58.000000000 -0600
@@ -0,0 +1,666 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Transfer-time lookup: immutable ranges/copies, no allocator or module calls. */
+#include <linux/init.h>
+#include <linux/bpf.h>
+#include <linux/export.h>
+#include <linux/ftrace.h>
+#include <linux/kernel.h>
+#include <asm/irqflags.h>
+#include <asm/hdn_rap_bpf.h>
+#include <asm/hdn_rap_probe.h>
+#include <asm/sections.h>
+#include "hdn_rap_internal.h"
+
+extern long __static_call_return0(void);
+
+static __always_inline bool inside(unsigned long address, size_t size,
+		unsigned long base, size_t extent)
+{
+	return address >= base && size <= extent && address - base <= extent - size;
+}
+
+static __always_inline bool in_section(const void *address, size_t size,
+		struct hdn_rap_section section)
+{
+	return inside((unsigned long)address, size, (unsigned long)section.data, section.size);
+}
+
+static noinstr bool valid_type(const struct hdn_rap_type *type, struct hdn_rap_section section)
+{
+	unsigned int i;
+
+	if (!IS_ALIGNED((unsigned long)type, 8) || !in_section(type, sizeof(*type), section) ||
+	    type->version != HDN_RAP_VERSION || !type->length || type->length > HDN_RAP_TYPE_MAX ||
+	    !in_section(type, sizeof(*type) + type->length + 1, section))
+		return false;
+	/* Volatile byte reads prevent conversion into an instrumented libc call. */
+	for (i = 0; i < type->length; i++)
+		if (!READ_ONCE(type->canonical[i]))
+			return false;
+	return !READ_ONCE(type->canonical[i]);
+}
+
+static noinstr const struct hdn_rap_type *type_view(const struct hdn_rap_type *type)
+{
+	struct hdn_rap_section builtin = { __hdn_rap_types_start,
+		__hdn_rap_types_end - __hdn_rap_types_start };
+	const struct hdn_rap_module *view;
+	const struct hdn_rap_bpf_image *image;
+
+	if (in_section(type, sizeof(*type), builtin))
