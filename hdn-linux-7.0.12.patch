+	actual = record(address, false);
+	expected = record(reference, false);
+	if (actual && expected && (a = type_view(actual->type)) &&
+	    (b = type_view(expected->type)))
+		valid = same_type(a, b);
+	native_local_irq_restore(flags);
+	return valid;
