@@ -4,6 +4,11 @@
 #include <linux/memblock.h>
 #include <linux/cc_platform.h>
 #include <linux/pgtable.h>
+#include <linux/hdn_pgtable.h>
+#include <asm/hdn_pgtable.h>
+#ifdef CONFIG_SECURITY_HARDENING_PGTABLE
+#include "../mm/hdn_pgtable_internal.h"
