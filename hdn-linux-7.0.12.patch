+		const char *name = kernfs_rcu_name(kn);
+
+		sensitive = !strcmp(name, "vmcoreinfo") ||
+			    !strcmp(name, "notes");
+	} else if (parent && !strcmp(kernfs_rcu_name(parent), "boot_params")) {
+		grandparent = kernfs_parent(parent);
+		const char *name = kernfs_rcu_name(kn);
